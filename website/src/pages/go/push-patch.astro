  --paper: #f3f6f9;      /* cool light-grey sections */
  --white: #ffffff;
  --text: #0f172a;       /* body text on light */
  --muted: #475569;
  --line: #dbe3ec;       /* hairlines on light */
  --accent: #22d3ee;     /* cyan: CTAs, highlights on dark */
  --accent-deep: #0e7490;/* cyan, deep: text/borders on light (AA on white) */
  --accent-wash: #ecfeff;

  color-scheme: light;
  font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
  color: var(--text);
  background: var(--ink);
