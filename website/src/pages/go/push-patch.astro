.pp-modal-x:focus-visible, .pp-modal-link:focus-visible, .pp-modal input:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
.pp-modal .pp-cta:focus-visible { outline-color: #ffffff; }
.pp-modal-form[hidden], .pp-modal-stop[hidden] { display: none; }
