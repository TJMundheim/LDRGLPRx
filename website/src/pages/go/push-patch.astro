.pp-modal-box { position: relative; padding: 1.4rem 0 0; }
@media (min-width: 480px) { .pp-modal-box { padding-top: 1.8rem; } }
.pp-modal h2 { flex: none; font-size: 1.4rem; font-weight: 800; line-height: 1.2; margin: 0 3.2rem 0.7rem 1.1rem; color: #ffffff; letter-spacing: -0.02em; }
@media (min-width: 480px) { .pp-modal h2 { margin-left: 1.6rem; } }
.pp-modal-x { position: absolute; top: 0.6rem; right: 0.6rem; width: 2.5rem; height: 2.5rem; border: none; background: transparent; color: var(--on-ink-muted); font-size: 1.7rem; line-height: 1; cursor: pointer; border-radius: 8px; }
