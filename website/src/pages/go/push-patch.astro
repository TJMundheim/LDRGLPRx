---
// LANDING PAGE — Genesis Push Patch. One message, one action: every blend card has
// its own one-click Stripe checkout button (12-hour wear only; no wear choice).
// Near-standalone (hideChrome) with its own clinical/tech look (TJ direction 2026-09-30) — deliberately NOT the site theme:
// deep-slate sections, one cyan accent, Inter for headings (no Playfair).
// Audience: peptide users with needle fatigue + people who never started because
// of needles. Technical product voice; Dr. TJ is not mentioned on this page.
// Copy source: docs/launch/push-patch/lp-copy.md. Every {/* TJ CONFIRM */} comment
// below marks text awaiting TJ approval (Astro comments, so they never ship).
// This page intentionally ignores COORDINATOR_MODE: it sells direct, no consult door.
// Blend data is the single source of truth in src/data/pushPatch.ts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PUSH_PATCH_BLENDS } from '../../data/pushPatch';
import { SCREENING, SCREENING_VERSION } from '../../data/screening';

const title = 'Genesis Push Patch — Needle-Free Peptides Through the Skin — My4MLife';
const description = 'A weekly iontophoresis patch that delivers peptide and NAD+ blends through the skin over 12 hours. No needles, no pills, no IV chair.';
const canonical = 'https://www.my4mlife.com/go/push-patch';

const API_BASE = import.meta.env.PUBLIC_LEAD_CAPTURE_API_URL ?? 'https://v9svm8ds74.execute-api.us-east-2.amazonaws.com';

// One-line benefit per blend (lp-copy.md section 6). TJ must approve each line.
const BENEFITS: Record<string, string> = {
  'push-patch-nad-ghk': 'A high-dose NAD+ blend that may help support cellular energy, with GHK-Cu, which may support skin and tissue quality.',
  'push-patch-bpc-nad-ghk': 'BPC-157 is a peptide studied for tissue repair; paired with NAD+ and GHK-Cu, this blend may support recovery after hard training.',
  'push-patch-kpv-nad-ghk': "KPV is a peptide studied for its role in the body's inflammatory signaling; this blend may help support a calmer, steadier feeling day to day.",
  'push-patch-nad-motsc-ghk': 'MOTS-c is a peptide studied for its role in mitochondrial and metabolic signaling; this blend may support energy and metabolic health.',
  'push-patch-enhanced-glow': 'Our highest-GHK-Cu blend, which may help support skin appearance and tissue quality, with TB-500, BPC-157 and NAD+ in support.',
  'push-patch-wolverine': 'For people who train hard: TB-500 and BPC-157 are peptides studied for tissue repair, and this blend may support faster recovery between sessions.',
  'push-patch-glutathione-ghk': "Glutathione is one of the body's main antioxidants; this NAD+-free blend may help support skin quality and general wellbeing.",
};

// Injection vs Push Patch — delivery method only, never results.
const COMPARE = [
  { row: 'Needle', inj: 'Yes, at every dose', patch: 'None' },
  { row: 'How often', inj: 'Often daily or several times a week, depending on the protocol', patch: 'One patch a week' },
  { row: 'Delivery curve', inj: 'Fast spike, then cleared, often within hours', patch: 'Steady release over 12 hours' },
  { row: 'Route', inj: 'Under the skin, through a needle', patch: 'Through the skin, moved by a small electrical charge' },
  { row: 'Setup', inj: 'Syringes, needles, a sharps container', patch: 'Mix the blend, wet the pad, apply like kinesiology tape, wear' },
];

// Real Genesis product photos supplied by TJ 2026-09-30. No lifestyle placeholder
// on this page; if TJ later supplies the Artlist "applying it at home" render
// (lp-copy.md section 12), it can go in the How-to-wear section.
const IMG = {
  pouches: '/images/push-patch/pouches.jpg',
  kit: '/images/push-patch/kit-contents.jpg',
};

// Pre-payment safety check (plan addendum 2026-10-02). Config is the single source of
// truth in src/data/screening.ts; the modal below and the script both read from it.
const SCREEN = SCREENING['push-patch'];
const SCREEN_AREA_ID = SCREEN.noSuitableAreaId;
// All six questions are shown up front, each a required Yes / No pair, in two visual groups:
// "Safety questions" (the knockouts) and "Where you'll wear it" (placement + suitable area).
type Item = { id: string; question: string; kind: 'knockout' | 'placement' | 'area'; ifYes?: string };
const SAFETY_ITEMS: Item[] = SCREEN.knockouts.map((k): Item => ({ id: k.id, question: k.question, kind: 'knockout' }));
const WEAR_ITEMS: Item[] = [
  ...SCREEN.placement.map((q): Item => ({ id: q.id, question: q.question, kind: 'placement', ifYes: q.ifYes })),
  ...(SCREEN_AREA_ID && SCREEN.suitableAreaQuestion
    ? [{ id: SCREEN_AREA_ID, question: SCREEN.suitableAreaQuestion, kind: 'area' } as Item]
    : []),
];
const SCREEN_CLIENT = {
  lane: 'push-patch',
  version: SCREENING_VERSION,
  knockoutIds: SCREEN.knockouts.map((k) => k.id),
  areaId: SCREEN_AREA_ID ?? null,
};
---
<BaseLayout title={title} description={description} canonical={canonical} robots="noindex,follow" hideChrome={true}>

<Fragment slot="head">
  {/* Private $2 test link (?t=<token>). Runs BEFORE the PostHog snippet: keep the token in memory + sessionStorage,
      then scrub it from the address bar so analytics/referrers never see it. Sent only in the checkout POST body. */}
  <script is:inline>
  (function () {
    try {
      var u = new URL(location.href), t = u.searchParams.get('t');
      if (t) {
        window.__ppT = t;
        try { sessionStorage.setItem('pp_t', t); } catch (e) {}
        u.searchParams.delete('t');
        history.replaceState(null, '', u.pathname + u.search + u.hash);
      } else {
        try { window.__ppT = sessionStorage.getItem('pp_t') || undefined; } catch (e) {}
      }
    } catch (e) {}
  })();
  </script>
</Fragment>

<div class="pp">

  <header class="pp-top">
    <a class="pp-mark" href="/">My<b>4M</b>Life</a>
    <span class="pp-top-tag">Needle-free delivery</span>
  </header>

  {/* HERO */}
  <section class="pp-hero">
    <div class="pp-wrap">
      <h1>Stop sticking yourself. <span>Same peptides. No needle. One patch a week.</span></h1>
      <div class="pp-proof">
        <p class="pp-proof-line">An injection spikes and clears, often in under an hour. The patch keeps delivering for 12.</p>
      </div>
      {/* TJ CONFIRM: sub-line speaks to both audiences (needle fatigue + never started because of needles) */}
      <p class="pp-sub">Done with syringes, sharps containers and bracing for the morning stick? Or are needles the reason you've never started? The Push Patch delivers peptide and NAD+ blends through your skin, steadily, over 12 hours.</p>
      <a class="pp-cta" href="#blends" onclick="window.posthog && posthog.capture('lp_patch_cta_hero')">Choose your blend</a>
      <ul class="pp-chips">
        <li>No needles</li>
        <li>No pills</li>
        <li>No IV chair</li>
        <li>One patch a week</li>
      </ul>
      <p class="pp-by">Brought to you by <span class="pp-by-mark">My<b>4M</b>Life</span></p>
      {/* TJ CONFIRM: permission to publish Push Patch LLC AUC figures */}
      <div class="pp-hero-row">
        <img class="pp-hero-img" src={IMG.pouches} alt="Three black Push Patch pouches labeled 12 HOUR: NAD+ with GHK-Cu, BPC-157 and NAD+ with GHK-Cu, and KPV and NAD+" width="1173" height="428" loading="eager" />
        <div class="pp-hero-stats" id="auc">
          <div class="pp-stats">
            <div class="pp-stat">
              <strong>276%</strong>
              <span>more NAD+ in your system than daily 50 mg injections<sup><a href="#auc">*</a></sup></span>
            </div>
            <div class="pp-stat">
              <strong>163%</strong>
              <span>more NAD+ in your system than a 500 mg weekly IV<sup><a href="#auc">*</a></sup></span>
            </div>
          </div>
          <p class="pp-proof-source">*Total exposure over time (area under the curve), data from Push Patch, LLC. Delivery data only; individual results vary.</p>
        {/* TJ CONFIRM: schematic of the delivery pattern (spike vs steady); illustrative only; measured figures are in the AUC stats above */}
        <figure class="pp-curve">
          <svg viewBox="0 0 600 222" role="img" aria-labelledby="pp-curve-title">
            <title id="pp-curve-title">Illustration: an injection delivers its dose at once; the Push Patch delivers steadily over 12 hours.</title>
            <line x1="40" y1="190" x2="580" y2="190" class="pp-axis" />
            <line x1="40" y1="20" x2="40" y2="190" class="pp-axis" />
            <path d="M40 188 C 70 188, 78 40, 92 36 C 110 32, 140 150, 200 176 C 260 188, 320 188, 580 188" class="pp-line-inj" />
            <path d="M40 188 C 70 188, 80 104, 120 100 L 480 100 C 510 100, 520 186, 580 188" class="pp-line-patch" />
            <text x="104" y="30" class="pp-lbl pp-lbl-inj">Injection</text>
            <text x="300" y="86" class="pp-lbl pp-lbl-patch" text-anchor="middle">Push Patch: 12 hours</text>
            <text x="578" y="214" class="pp-lbl pp-lbl-axis" text-anchor="end">Time</text>
          </svg>
          <figcaption>Illustration of delivery pattern; measured figures above.</figcaption>
        </figure>
        </div>
      </div>
    </div>
  </section>

  {/* PAIN POINTS — written for people who have self-injected peptides for months */}
  <section class="pp-sec pp-light" id="routine">
    <div class="pp-wrap">
      <p class="pp-eyebrow">If you've been injecting</p>
      <h2>You know the routine.</h2>
      {/* TJ CONFIRM: pain-point lines (insider language for subcutaneous peptide users); empathetic, no medical claims */}
      <ul class="pp-pains">
        <li>Sticking yourself with a needle, week after week.</li>
        <li>Pinching belly fat at 6 a.m. and bracing for the stick.</li>
        <li>Rotating injection sites and still finding bruises and little lumps.</li>
        <li>A sharps container on the bathroom shelf.</li>
        <li>Packing syringes every time you travel.</li>
        <li>Skipping a dose because you just couldn't face the needle tonight.</li>
      </ul>
      <p class="pp-turn">One patch. Once a week. <span>No needle.</span></p>
      <p class="pp-never"><strong>Never started because of needles?</strong> If needles are the reason you've never started, there is no needle at any step. You mix the blend, wet the pad, apply the patch like a strip of kinesiology tape, and wear it.</p>
    </div>
  </section>

  {/* THE TECHNOLOGY */}
  <section class="pp-sec pp-white" id="how">
    <div class="pp-wrap">
      <p class="pp-eyebrow">The delivery technology</p>
      <h2>Iontophoresis: a small charge does the work a needle used to do</h2>
      {/* TJ CONFIRM: "used in medicine for decades" is the approved substitute for any regulatory language about the patch; do not add to it */}
      <p class="pp-lead">The Push Patch uses iontophoresis. A small electrical charge moves charged molecules through the skin, so the blend reaches you without an injection. Iontophoresis is an established delivery technology used in medicine for decades.</p>

      <div class="pp-specs">
        <div class="pp-spec">
          <span class="pp-spec-k">Route</span>
          {/* TJ CONFIRM: phrase "bypasses the digestive tract" exactly as the one-pager does; no percentage claims about the route */}
          <strong>Through the skin</strong>
          <span>Bypasses the digestive tract. Nothing to swallow.</span>
        </div>
        <div class="pp-spec">
          <span class="pp-spec-k">Curve</span>
          <strong>Steady, not a spike</strong>
          <span>Delivered over 12 hours instead of all at once.</span>
        </div>
        <div class="pp-spec">
          <span class="pp-spec-k">Setup</span>
          <strong>Nothing to inject</strong>
          <span>No needles, no pills, no IV chair. Applied like kinesiology tape.</span>
        </div>
        <div class="pp-spec">
          <span class="pp-spec-k">Frequency</span>
          <strong>Once a week</strong>
          <span>One single-use patch a week. Six patches, six weeks.</span>
        </div>
      </div>

      <h3 class="pp-h3">Why steady beats a spike</h3>
      <p class="pp-lead">Area under the curve (AUC) is the total amount of a molecule in your system over time. Peptides like BPC-157 and KPV clear from the bloodstream quickly after an injection, often within an hour or a few hours, so most of the day is spent below the level you injected for. The Push Patch releases its blend slowly and continuously over 12 hours.</p>
    </div>
  </section>

  {/* INJECTION VS PUSH PATCH */}
  <section class="pp-sec pp-light" id="compare">
    <div class="pp-wrap">
      <p class="pp-eyebrow">Side by side</p>
      <h2>Injection vs. Push Patch</h2>
      {/* TJ CONFIRM: injection frequency and setup rows are general descriptions of self-injected peptide protocols; confirm wording */}
      <table class="pp-table">
        <thead>
          <tr><th scope="col"><span class="pp-sr">Feature</span></th><th scope="col">Injection</th><th scope="col" class="pp-col-patch">Push Patch</th></tr>
        </thead>
        <tbody>
          {COMPARE.map((c) => (
            <tr><th scope="row">{c.row}</th><td>{c.inj}</td><td class="pp-col-patch">{c.patch}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="pp-fine">A comparison of delivery method only, not of results. Individual experience varies.</p>
    </div>
  </section>

  {/* HOW TO WEAR IT */}
  <section class="pp-sec pp-white" id="wear">
    <div class="pp-wrap">
      <p class="pp-eyebrow">How to wear it</p>
      <h2>Prepare. Apply. Wear.</h2>
      <ol class="pp-steps">
        {/* Steps follow the manufacturer IFU "Handling Instructions for PushPatch Kits+" (research doc section 2). Water volume deliberately not printed: IFU says 2 ml, brochure says 1.5 ml. */}
        <li><strong>Prepare.</strong> Add the sterile water provided to the powder vial, cap it and shake to mix. Press the white pad of the patch against the open vial, turn it over, and wet the whole pad.</li>
        {/* IFU does not name an arm/shoulder site; removed 2026-10-01. */}
        <li><strong>Apply.</strong> On clean, dry skin, peel the backing and press the patch down flat, like kinesiology tape. Pull the activation tab all the way out.</li>
        <li><strong>Wear.</strong> Wear it for 12 hours, then remove it: wet it with warm soapy water and peel slowly. Wait at least 24 hours before using the same spot again. One patch a week for six weeks.</li>
      </ol>
      <p class="pp-fine">Full instructions are printed in every kit. Follow the insert in your kit for the exact amount of water.</p>
    </div>
  </section>

  {/* BLEND PICKER */}
  <section class="pp-sec pp-light" id="blends">
    <div class="pp-wrap">
      <p class="pp-eyebrow">Choose your blend</p>
      <h2>Seven blends. Six patches each. Six weeks.</h2>
      {/* TJ CONFIRM: "NAD+ Restore is the simplest place to start" is a soft recommendation drafted by the copywriter; approve or delete */}
      <p class="pp-lead">Every blend ships as a six-patch set. Blends with NAD+ are $650; the Glutathione blend has no NAD+ and is $550. Not sure which fits? NAD+ Restore is the simplest place to start.</p>

      {/* TJ CONFIRM: all five proposed display names (NAD+ Restore, Repair, Calm Gut, Metabolic, Glutathione Radiance) and every per-blend benefit line */}
      <div class="pp-edge">
        <p class="pp-edge-head">More in your system. No needle.</p>
        <p class="pp-edge-sub">One patch a week, delivering for 12 hours.</p>
      </div>
      <div class="pp-cards" id="patch-grid">
        {PUSH_PATCH_BLENDS.map((b) => (
          <article class="pp-card">
            <div class="pp-card-top">
              <h3 class="pp-card-name">{b.name}</h3>
              <span class="pp-card-price">${b.priceUsd}</span>
            </div>
            <p class="pp-card-benefit">{BENEFITS[b.skuId]}</p>
            <p class="pp-card-formula">{b.formula}</p>
            <button type="button" class="pp-cta pp-buy" data-sku={b.skuId} data-label={`Buy — $${b.priceUsd}`}>Buy — ${b.priceUsd}</button>
            <p class="pp-error" role="alert" hidden></p>
          </article>
        ))}
      </div>
      {/* TJ CONFIRM: one-time purchase, no auto-ship (Genesis offers patient auto-ship but the plan sells one-time) */}
      <p class="pp-fine pp-fine-center">Secure checkout by Stripe. Apple Pay, Google Pay and cards accepted. Not cleared? Full refund. Final once shipped.</p>
      <p class="pp-fine pp-fine-center">After checkout: a 2-minute health questionnaire, physician review within an hour during business hours, then your kit ships direct. Prepared within 1–3 business days, then ground delivery in 3–5 business days.</p>
      <p class="pp-fine pp-fine-center">All six-patch sets are one-time purchases, not subscriptions.</p>
    </div>
  </section>

  {/* IN THE BOX */}
  <section class="pp-sec pp-dark">
    <div class="pp-wrap">
      <p class="pp-eyebrow">In the box</p>
      <h2>What arrives at your door</h2>
      <div class="pp-box-wrap">
        <img class="pp-kit-img" src={IMG.kit} alt="Push Patch kit contents: a shaped adhesive patch with a round pad, a small amber blend vial, and a clear graduated tube" width="882" height="674" loading="lazy" />
        {/* TJ CONFIRM: per-set counts (IFU shows one amber powder vial + one sterile-water ampule per kit; assumed one of each per patch) */}
        <ul class="pp-box">
          <li><strong>6</strong><span>Single-use patches, one for each week of the six-week set.</span></li>
          <li><strong>6</strong><span>Powder vials of blend, one for each patch.</span></li>
          <li><strong>6</strong><span>Sterile water ampules, one for each blend.</span></li>
        </ul>
      </div>
      {/* Seven CoAs are published by Genesis (research doc section 3) */}
      <p class="pp-trust">Every active ingredient is third-party tested. Certificates of analysis (HPLC purity and mass-spec identity) for BPC-157, NAD+, GHK-Cu, glutathione, KPV, TB-500 and MOTS-c are available on request.</p>
    </div>
  </section>

  {/* FAQ */}
  <section class="pp-sec pp-white" id="faq">
    <div class="pp-wrap">
      <p class="pp-eyebrow">Questions</p>
      <h2>Before you order</h2>
      <div class="pp-faq">
        <details>
          <summary>Is there a needle anywhere in the process?</summary>
          <p>No. The Push Patch is needle-free. There are no syringes and no injection at any step. You mix the blend, wet the pad, apply the patch like a strip of kinesiology tape, and wear it.</p>
        </details>
        <details>
          <summary>Does it hurt, and what about sensitive skin?</summary>
          {/* TJ CONFIRM: "light tingle" line is an assumption about how iontophoresis feels (confirm with Genesis or delete); skin-contact warning wording from Genesis */}
          <p>Iontophoresis uses a small electrical charge and is described as pain-free. Most people describe the feeling as a light tingle or nothing at all. Do not apply a patch to broken or irritated skin.</p>
        </details>
        <details>
          <summary>I already inject peptides. Can I switch to the patch?</summary>
          <p>Yes, many people switch. The formula on each blend card shows exactly what is in that patch, so you can compare it with what you use now.</p>
        </details>
        <details>
          <summary>What is iontophoresis, and is it established?</summary>
          {/* TJ CONFIRM: do not add any regulatory or approval statements about the patch beyond this */}
          <p>Iontophoresis uses a small electrical charge to move charged molecules through the skin. It is an established delivery technology used in medicine for decades. The Push Patch applies it in a wearable, single-use patch.</p>
        </details>
        <details>
          <summary>How long do I wear a patch, and how often?</summary>
          <p>One patch a week for six weeks. Wear each patch for 12 hours, then remove it: wet it with warm soapy water and peel slowly. Wait at least 24 hours before using the same spot again.</p>
        </details>
        <details>
          <summary>What is actually in my blend?</summary>
          <p>The formula on each blend card is exactly what is in your patch, with the amounts shown. Six of the seven blends contain NAD+; the Glutathione blend does not.</p>
        </details>
        <details>
          <summary>Who should not use the Push Patch?</summary>
          <p>Do not use it if you have epilepsy or a history of seizures, a pacemaker or any other implanted electronic device, or are pregnant or could be pregnant. We ask about these in a quick safety check before checkout. The patch goes on clean, easy-to-reach skin with little or no hair, such as the upper arm, shoulder, upper chest, forearm, thigh or side of the abdomen. If you have a metal implant, or an open wound, recent skin graft or scar, choose an area away from it.</p>
        </details>
        <details>
          <summary>What is your refund policy?</summary>
          <p>Not cleared? Full refund. Final once shipped.</p>
        </details>
        <details>
          <summary>How long does shipping take?</summary>
          <p>Prepared within 1–3 business days, then ground delivery in 3–5 business days. At checkout you enter your shipping address, and you confirm it again after payment before anything ships.</p>
        </details>
        <details>
          <summary>I have a question before I order. Who do I ask?</summary>
          {/* TJ CONFIRM: /consult currently runs in coordinator mode and begins an intake; confirm it is the right door for a pre-purchase question or use a plain email address */}
          <p>Start with our care coordinator at <a href="/consult">/consult</a>. They can help you choose a blend and answer questions about wear.</p>
        </details>
      </div>
    </div>
  </section>

  {/* CLOSE */}
  <section class="pp-close">
    <div class="pp-wrap">
      <h2>Retire the sharps container.</h2>
      <p class="pp-sub">One patch a week, applied like tape, worn for 12 hours. No needles, no pills, no IV chair.</p>
      <a class="pp-cta" href="#blends" onclick="window.posthog && posthog.capture('lp_patch_cta_close')">Choose your blend</a>
    </div>
  </section>

  <footer class="pp-foot">
    <div class="pp-wrap">
      <p class="pp-by">Brought to you by <span class="pp-by-mark">My<b>4M</b>Life</span></p>
      <p class="pp-tagline">Don't lose your identity and your dignity while you still have a choice.</p>
      {/* TJ CONFIRM: legal wording of the patch-specific disclaimer; the page must not claim regulatory approval of the patch. Shared MedicalDisclaimer intentionally not used (GLP-1 / compounded-medication language). */}
      <p class="pp-disclaimer">These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, prevent or alleviate any condition. Results vary by person.</p>
      <p class="pp-legal"><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href="/">my4mlife.com</a> · We use cookies for site analytics.</p>
    </div>
  </footer>

  {/* PRE-PAYMENT SAFETY CHECK (modal). Opened by every Buy button; copy in src/data/screening.ts. */}
  <dialog class="pp-modal" id="pp-screen" aria-labelledby="pp-screen-title">
    <div class="pp-modal-box">
      <button type="button" class="pp-modal-x" id="pp-screen-x" aria-label="Close safety check">&times;</button>
      <h2 id="pp-screen-title">Quick safety check</h2>

      <form id="pp-screen-detail" class="pp-modal-form" novalidate>
        <div class="pp-modal-scroll">
          {SCREEN.siteNote && <p class="pp-modal-note">{SCREEN.siteNote}</p>}
          {[{ title: 'Safety questions', items: SAFETY_ITEMS }, { title: "Where you'll wear it", items: WEAR_ITEMS }].map((g) => (
            <div class="pp-qgroup" role="group" aria-label={g.title}>
              <p class="pp-qgroup-title">{g.title}</p>
              {g.items.map((it) => (
                <fieldset class="pp-q" data-id={it.id} data-kind={it.kind}>
                  <legend>{it.question}</legend>
                  <div class="pp-q-opts">
                    <label><input type="radio" name={`pp-${it.id}`} value="yes" required /> Yes</label>
                    <label><input type="radio" name={`pp-${it.id}`} value="no" required /> No</label>
                  </div>
                  {it.ifYes && <p class="pp-q-note" hidden>{it.ifYes}</p>}
                </fieldset>
              ))}
            </div>
          ))}
        </div>
        <div class="pp-modal-foot">
          <p class="pp-modal-confirm">By continuing, I confirm my answers are accurate.</p>
          <button type="submit" class="pp-cta pp-modal-go" id="pp-screen-go" disabled>Continue to checkout</button>
        </div>
      </form>

      <div id="pp-screen-stop" class="pp-modal-stop" role="alert" hidden>
        <p><strong>The Push Patch isn't the right fit for you right now.</strong> Our care coordinators can walk you through other options.</p>
        <a class="pp-cta pp-modal-go" href="/consult">Talk to a care coordinator</a>
        <button type="button" class="pp-modal-link" id="pp-screen-back">Change my answers</button>
      </div>
    </div>
  </dialog>

</div>

</BaseLayout>

<script is:inline define:vars={{ API_BASE, SCREEN_CLIENT }}>
(function () {
  var grid = document.getElementById('patch-grid');
  var dlg = document.getElementById('pp-screen');
  if (!grid || !dlg) return;

  function track(name, props) {
    try { window.posthog && posthog.capture(name, props); } catch (e) {}
  }
  track('lp_patch_view');

  var GENERIC = 'We could not open checkout. Please try again in a moment.';
  var C = SCREEN_CLIENT;

  var detail = document.getElementById('pp-screen-detail');
  var stop = document.getElementById('pp-screen-stop');
  var goBtn = document.getElementById('pp-screen-go');
  var cur = null; // { btn, skuId, label }

  function focusables() {
    var list = dlg.querySelectorAll('button, a[href], input, [tabindex]:not([tabindex="-1"])');
    var out = [];
    for (var i = 0; i < list.length; i++) {
      var el = list[i];
      if (el.disabled || el.closest('[hidden]')) continue;
      out.push(el);
    }
    return out;
  }

  function show(which) {
    detail.hidden = which !== 'detail';
    stop.hidden = which !== 'stop';
  }

  // Continue stays disabled until all six questions have an explicit Yes / No.
  function allAnswered() {
    var fs = detail.querySelectorAll('.pp-q');
    for (var i = 0; i < fs.length; i++) {
      if (!fs[i].querySelector('input:checked')) return false;
    }
    return fs.length > 0;
  }
  function syncGo() { goBtn.disabled = !allAnswered(); }

  function openModal(btn) {
    cur = { btn: btn, skuId: btn.getAttribute('data-sku'), label: btn.getAttribute('data-label') };
    detail.reset();
    syncGo();
    var sc = detail.querySelector('.pp-modal-scroll');
    if (sc) sc.scrollTop = 0;
    var notes = detail.querySelectorAll('.pp-q-note');
    for (var i = 0; i < notes.length; i++) notes[i].hidden = true;
    show('detail');
    if (typeof dlg.showModal === 'function') { dlg.showModal(); } else { dlg.setAttribute('open', ''); }
    document.body.style.overflow = 'hidden';
    var firstRadio = detail.querySelector('input');
    if (firstRadio) firstRadio.focus();
    track('lp_patch_screen_open', { skuId: cur.skuId });
  }

  function closeModal() {
    if (typeof dlg.close === 'function') { if (dlg.open) dlg.close(); } else { dlg.removeAttribute('open'); onClosed(); }
  }

  function onClosed() {
    document.body.style.overflow = '';
    var b = cur && cur.btn;
    if (b && !b.disabled) { try { b.focus(); } catch (e) {} }
  }
  dlg.addEventListener('close', onClosed);

  // Click outside the box closes; Tab is trapped (native in showModal, manual for the fallback);
  // Esc is native, handled here only when showModal is unavailable.
  dlg.addEventListener('click', function (ev) { if (ev.target === dlg) closeModal(); });
  dlg.addEventListener('keydown', function (ev) {
    if (ev.key === 'Escape' && typeof dlg.showModal !== 'function') { ev.preventDefault(); closeModal(); return; }
    if (ev.key !== 'Tab') return;
    var f = focusables();
    if (!f.length) return;
    var first = f[0], last = f[f.length - 1];
    if (ev.shiftKey && document.activeElement === first) { ev.preventDefault(); last.focus(); }
    else if (!ev.shiftKey && document.activeElement === last) { ev.preventDefault(); first.focus(); }
  });
  document.getElementById('pp-screen-x').addEventListener('click', closeModal);

  grid.addEventListener('click', function (ev) {
    var btn = ev.target.closest ? ev.target.closest('.pp-buy') : null;
    if (!btn || btn.disabled) return;
    openModal(btn);
  });

  document.getElementById('pp-screen-back').addEventListener('click', function () {
    show('detail');
    var first = detail.querySelector('input');
    if (first) first.focus();
  });

  // Placement "Yes" shows its inline note and stays allowed.
  detail.addEventListener('change', function (ev) {
    var fs = ev.target.closest ? ev.target.closest('.pp-q') : null;
    if (!fs) return;
    var note = fs.querySelector('.pp-q-note');
    if (note) note.hidden = ev.target.value !== 'yes';
    syncGo();
  });

  function startCheckout(answers) {
    var btn = cur.btn, skuId = cur.skuId, label = cur.label;
    var err = btn.parentNode.querySelector('.pp-error');
    track('lp_patch_screen_pass', { skuId: skuId, path: 'detailed' });
    closeModal();
    err.hidden = true;
    btn.disabled = true;
    btn.textContent = 'Opening checkout…';
    track('lp_patch_checkout', { skuId: skuId });

    function fail(msg) {
      err.textContent = msg;
      err.hidden = false;
      btn.disabled = false;
      btn.textContent = label;
    }

    fetch(API_BASE + '/api/create-checkout-session', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ skuId: skuId, screening: { version: C.version, answers: answers }, testToken: window.__ppT || undefined }),
    }).then(function (r) {
      if (r.status === 503) { fail("This blend isn't available yet."); return null; }
      if (!r.ok) { fail(GENERIC); return null; }
      return r.json();
    }).then(function (res) {
      if (!res) return;
      if (res.url) { window.location = res.url; }
      else { fail(GENERIC); }
    }).catch(function () {
      fail('We could not open checkout. Please check your connection and try again.');
    });
  }

  detail.addEventListener('submit', function (ev) {
    ev.preventDefault();
    var a = {};
    var fs = detail.querySelectorAll('.pp-q');
    for (var i = 0; i < fs.length; i++) {
      var checked = fs[i].querySelector('input:checked');
      if (!checked) {
        var miss = fs[i].querySelector('input');
        if (miss) miss.focus();
        return;
      }
      a[fs[i].getAttribute('data-id')] = checked.value === 'yes';
    }
    var ids = [];
    C.knockoutIds.forEach(function (id) { if (a[id] === true) ids.push(id); });
    if (C.areaId && a[C.areaId] === false) ids.push(C.areaId);
    if (ids.length) {
      track('lp_patch_screen_fail', { skuId: cur.skuId, ids: ids });
      show('stop');
      var link = stop.querySelector('a');
      if (link) link.focus();
      return;
    }
    startCheckout(a);
  });
})();
</script>

<style>
/* Push Patch look (2026-09-30): clinical/tech, independent of the site theme.
   Every section sets its own background + text colour, so the page renders the
   same under light or dark system settings. One accent hue (cyan): bright tint
   on dark sections, deep tint for text/borders on light sections. */
.pp {
  --ink: #0b1220;        /* near-black slate: dark sections */
