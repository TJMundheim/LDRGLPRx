---
// LANDING PAGE — Genesis Push Patch. One message, one action: pick a blend, pick a
// wear time, one-click Stripe checkout. Near-standalone (hideChrome) with its own
// clinical/tech look (TJ direction 2026-09-30) — deliberately NOT the site theme:
// deep-slate sections, one cyan accent, Inter for headings (no Playfair).
// Audience: peptide users with needle fatigue + people who never started because
// of needles. Technical product voice; Dr. TJ is not mentioned on this page.
// Copy source: docs/launch/push-patch/lp-copy.md. Every {/* TJ CONFIRM */} comment
// below marks text awaiting TJ approval (Astro comments, so they never ship).
// This page intentionally ignores COORDINATOR_MODE: it sells direct, no consult door.
// Blend data is the single source of truth in src/data/pushPatch.ts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PUSH_PATCH_BLENDS, WEAR_OPTIONS } from '../../data/pushPatch';

const title = 'Genesis Push Patch — Needle-Free Peptides Through the Skin — My4MLife';
const description = 'A weekly iontophoresis patch that delivers peptide and NAD+ blends through the skin over 12 or 14 hours. No needles, no pills, no IV chair.';
const canonical = 'https://www.my4mlife.com/go/push-patch';

const API_BASE = import.meta.env.PUBLIC_LEAD_CAPTURE_API_URL ?? 'https://v9svm8ds74.execute-api.us-east-2.amazonaws.com';

const DEFAULT_SKU = 'push-patch-nad-ghk'; // NAD+ Restore
const DEFAULT_WEAR = '12h';

// One-line benefit per blend (lp-copy.md section 6). TJ must approve each line.
const BENEFITS: Record<string, string> = {
  'push-patch-nad-ghk': 'A high-dose NAD+ blend that may help support cellular energy, with GHK-Cu, which may support skin and tissue quality.',
  'push-patch-bpc-nad-ghk': 'BPC-157 is a peptide studied for tissue repair; paired with NAD+ and GHK-Cu, this blend may support recovery after hard training.',
  'push-patch-kpv-nad-ghk': "KPV is a peptide studied for its role in the body's inflammatory signaling; this blend may help support a calmer, steadier feeling day to day.",
  'push-patch-nad-motsc-ghk': 'MOTS-c is a peptide studied for its role in mitochondrial and metabolic signaling; this blend may support energy and metabolic health.',
  'push-patch-enhanced-glow': 'Our highest-GHK-Cu blend, which may help support skin appearance and tissue quality, with TB-500, BPC-157 and NAD+ in support.',
  'push-patch-wolverine': 'For people who train hard: TB-500 and BPC-157 are peptides studied for tissue repair, and this blend may support faster recovery between sessions.',
  'push-patch-glutathione-ghk': "Glutathione is one of the body's main antioxidants; this NAD+-free blend may help support skin quality and general wellbeing.",
};

const WEAR_HELP: Record<string, string> = {
  '12h': 'For people who train or stay on the move.',
  '14h': 'A longer, gentler delivery for sensitive skin.',
};

// Injection vs Push Patch — delivery method only, never results.
const COMPARE = [
  { row: 'Needle', inj: 'Yes, at every dose', patch: 'None' },
  { row: 'How often', inj: 'Often daily or several times a week, depending on the protocol', patch: 'One patch a week' },
  { row: 'Delivery curve', inj: 'Fast spike, then cleared, often within hours', patch: 'Steady release over 12 to 14 hours' },
  { row: 'Route', inj: 'Under the skin, through a needle', patch: 'Through the skin, moved by a small electrical charge' },
  { row: 'Setup', inj: 'Syringes, needles, a sharps container', patch: 'Prepare the pad, apply like kinesiology tape, wear' },
];

const defaultBlend = PUSH_PATCH_BLENDS.find((b) => b.skuId === DEFAULT_SKU)!;

// Real Genesis product photos supplied by TJ 2026-09-30. No lifestyle placeholder
// on this page; if TJ later supplies the Artlist "applying it at home" render
// (lp-copy.md section 12), it can go in the How-to-wear section.
const IMG = {
  pouches: '/images/push-patch/pouches.jpg',
  kit: '/images/push-patch/kit-contents.jpg',
};
---
<BaseLayout title={title} description={description} canonical={canonical} robots="noindex,follow" hideChrome={true}>

<div class="pp">

  <header class="pp-top">
    <a class="pp-mark" href="/">My<b>4M</b>Life</a>
    <span class="pp-top-tag">Needle-free delivery</span>
  </header>

  {/* HERO */}
  <section class="pp-hero">
    <div class="pp-wrap">
      <p class="pp-kicker">Genesis Push Patch</p>
      <h1>Needle-free peptides. <span>Delivered through your skin.</span></h1>
      {/* TJ CONFIRM: sub-line speaks to both audiences (needle fatigue + never started because of needles) */}
      <p class="pp-sub">Done with syringes, sharps containers and bracing for the morning stick? Or are needles the reason you've never started? The Push Patch delivers peptide and NAD+ blends through your skin, steadily, over 12 or 14 hours. One patch a week.</p>
      {/* TJ CONFIRM: Genesis's tagline, used as a secondary line; confirm permission to use verbatim */}
      <p class="pp-tagline-genesis">More energy. Better focus. Faster recovery. Needle free.</p>
      <a class="pp-cta" href="#blends" onclick="window.posthog && posthog.capture('lp_patch_cta_hero')">Choose your blend</a>
      <ul class="pp-chips">
        <li>No needles</li>
        <li>No pills</li>
        <li>No IV chair</li>
        <li>One patch a week</li>
      </ul>
      <p class="pp-by">Brought to you by <span class="pp-by-mark">My<b>4M</b>Life</span></p>
      <img class="pp-hero-img" src={IMG.pouches} alt="Three black Push Patch pouches labeled 12 HOUR: NAD+ with GHK-Cu, BPC-157 and NAD+ with GHK-Cu, and KPV and NAD+" width="1173" height="428" loading="eager" />
    </div>
  </section>

  {/* PAIN POINTS — written for people who have self-injected peptides for months */}
  <section class="pp-sec pp-light" id="routine">
    <div class="pp-wrap">
      <p class="pp-eyebrow">If you've been injecting</p>
      <h2>You know the routine.</h2>
      {/* TJ CONFIRM: pain-point lines (insider language for subcutaneous peptide users); empathetic, no medical claims */}
      <ul class="pp-pains">
        <li>Sticking yourself with a needle, week after week.</li>
        <li>Pinching belly fat at 6 a.m. and bracing for the stick.</li>
        <li>Rotating injection sites and still finding bruises and little lumps.</li>
        <li>A sharps container on the bathroom shelf.</li>
        <li>Packing syringes every time you travel.</li>
        <li>Skipping a dose because you just couldn't face the needle tonight.</li>
      </ul>
      <p class="pp-turn">One patch. Once a week. <span>No needle.</span></p>
      <p class="pp-never"><strong>Never started because of needles?</strong> If needles are the reason you've never started, there is no needle at any step. You prepare the pad, apply the patch like a strip of kinesiology tape, and wear it.</p>
    </div>
  </section>

  {/* THE TECHNOLOGY */}
  <section class="pp-sec pp-white" id="how">
    <div class="pp-wrap">
      <p class="pp-eyebrow">The delivery technology</p>
      <h2>Iontophoresis: a small charge does the work a needle used to do</h2>
      {/* TJ CONFIRM: "used in medicine for decades" is the approved substitute for any regulatory language about the patch; do not add to it */}
      <p class="pp-lead">The Push Patch uses iontophoresis. A small electrical charge moves charged molecules through the skin, so the blend reaches you without an injection. Iontophoresis is an established delivery technology used in medicine for decades.</p>

      <div class="pp-specs">
        <div class="pp-spec">
          <span class="pp-spec-k">Route</span>
          {/* TJ CONFIRM: phrase "bypasses the digestive tract" exactly as the one-pager does; no absorption-percentage claims */}
          <strong>Through the skin</strong>
          <span>Bypasses the digestive tract. Nothing to swallow.</span>
        </div>
        <div class="pp-spec">
          <span class="pp-spec-k">Curve</span>
          <strong>Steady, not a spike</strong>
          <span>Delivered over 12 or 14 hours instead of all at once.</span>
        </div>
        <div class="pp-spec">
          <span class="pp-spec-k">Setup</span>
          <strong>Nothing to inject</strong>
          <span>No needles, no pills, no IV chair. Applied like kinesiology tape.</span>
        </div>
        <div class="pp-spec">
          <span class="pp-spec-k">Frequency</span>
          <strong>Once a week</strong>
          <span>One single-use patch a week. Six patches, six weeks.</span>
        </div>
      </div>

      <h3 class="pp-h3">Why steady beats a spike</h3>
      <p class="pp-lead">Area under the curve (AUC) is the total amount of a molecule in your system over time. Peptides like BPC-157 and KPV clear from the bloodstream quickly after an injection, often within an hour or a few hours, so most of the day is spent below the level you injected for. The Push Patch releases its blend slowly and continuously over 12 to 14 hours.</p>
      {/* TJ CONFIRM: permission to publish Push Patch LLC AUC figures */}
      <div class="pp-stats">
        <div class="pp-stat">
          <strong>276%</strong>
          <span>more cellular exposure than daily 50 mg NAD+ injections</span>
        </div>
        <div class="pp-stat">
          <strong>163%</strong>
          <span>more cellular exposure than a 500 mg weekly NAD+ IV</span>
        </div>
      </div>
      <p class="pp-fine">Area-under-the-curve figures provided by Push Patch, LLC. Delivery data only; individual results vary.</p>

      {/* TJ CONFIRM: schematic of the delivery pattern (spike vs steady); illustrative only; measured figures are in the AUC stats above */}
      <figure class="pp-curve">
        <svg viewBox="0 0 600 222" role="img" aria-labelledby="pp-curve-title">
          <title id="pp-curve-title">Illustration: an injection delivers its dose at once; the Push Patch delivers steadily over 12 or 14 hours.</title>
          <line x1="40" y1="190" x2="580" y2="190" class="pp-axis" />
          <line x1="40" y1="20" x2="40" y2="190" class="pp-axis" />
          <path d="M40 188 C 70 188, 78 40, 92 36 C 110 32, 140 150, 200 176 C 260 188, 320 188, 580 188" class="pp-line-inj" />
          <path d="M40 188 C 70 188, 80 104, 120 100 L 480 100 C 510 100, 520 186, 580 188" class="pp-line-patch" />
          <text x="104" y="30" class="pp-lbl pp-lbl-inj">Injection</text>
          <text x="300" y="86" class="pp-lbl pp-lbl-patch" text-anchor="middle">Push Patch: 12 or 14 hours</text>
          <text x="578" y="214" class="pp-lbl pp-lbl-axis" text-anchor="end">Time</text>
        </svg>
        <figcaption>Illustration of delivery pattern. See figures above.</figcaption>
      </figure>
    </div>
  </section>

  {/* INJECTION VS PUSH PATCH */}
  <section class="pp-sec pp-light" id="compare">
    <div class="pp-wrap">
      <p class="pp-eyebrow">Side by side</p>
      <h2>Injection vs. Push Patch</h2>
      {/* TJ CONFIRM: injection frequency and setup rows are general descriptions of self-injected peptide protocols; confirm wording */}
      <table class="pp-table">
        <thead>
          <tr><th scope="col"><span class="pp-sr">Feature</span></th><th scope="col">Injection</th><th scope="col" class="pp-col-patch">Push Patch</th></tr>
        </thead>
        <tbody>
          {COMPARE.map((c) => (
            <tr><th scope="row">{c.row}</th><td>{c.inj}</td><td class="pp-col-patch">{c.patch}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="pp-fine">A comparison of delivery method only, not of results. Individual experience varies.</p>
    </div>
  </section>

  {/* HOW TO WEAR IT */}
  <section class="pp-sec pp-white" id="wear">
    <div class="pp-wrap">
      <p class="pp-eyebrow">How to wear it</p>
      <h2>Prepare. Apply. Wear.</h2>
      <ol class="pp-steps">
        {/* TJ CONFIRM: exact prep steps (vial + applicator tube + pad) from Genesis's instructions; keep neutral until confirmed */}
        <li><strong>Prepare the pad.</strong> Each week's patch comes with its own blend vial and applicator tube to prepare the pad.</li>
        {/* TJ CONFIRM: upper arm/shoulder placement; exact site must come from Genesis's instructions */}
        <li><strong>Apply.</strong> The patch goes on like kinesiology tape, on clean skin of the upper arm or shoulder.</li>
        {/* TJ CONFIRM: plain-language 12-hour (active) vs 14-hour (sensitive skin); removal after 12/14 hours */}
        <li><strong>Wear.</strong> The patch delivers over 12 or 14 hours. Choose 12-hour if you are active and want to train or work in it; choose 14-hour if your skin is sensitive. One patch a week for six weeks.</li>
      </ol>
    </div>
  </section>

  {/* BLEND PICKER */}
  <section class="pp-sec pp-light" id="blends">
    <div class="pp-wrap">
      <p class="pp-eyebrow">Choose your blend</p>
      <h2>Seven blends. Six patches each. Six weeks.</h2>
      {/* TJ CONFIRM: "NAD+ Restore is the simplest place to start" is a soft recommendation drafted by the copywriter; approve or delete */}
      <p class="pp-lead">Every blend ships as a six-patch set. Blends with NAD+ are $650; the Glutathione blend has no NAD+ and is $550. Not sure which fits? NAD+ Restore is the simplest place to start.</p>

      <form id="patch-form" class="pp-form" novalidate>
        {/* TJ CONFIRM: all five proposed display names (NAD+ Restore, Repair, Calm Gut, Metabolic, Glutathione Glow) and every per-blend benefit line */}
        <fieldset class="pp-fieldset">
          <legend class="pp-legend">Blend</legend>
          <div class="pp-cards">
            {PUSH_PATCH_BLENDS.map((b) => (
              <label class="pp-opt">
                <input type="radio" name="blend" value={b.skuId} data-price={b.priceUsd} data-name={b.name} checked={b.skuId === DEFAULT_SKU} />
                <span class="pp-card">
                  <span class="pp-card-top">
                    <span class="pp-card-name">{b.name}</span>
                    <span class="pp-card-price">${b.priceUsd}</span>
                  </span>
                  <span class="pp-card-benefit">{BENEFITS[b.skuId]}</span>
                  <span class="pp-card-formula">{b.formula}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>
        {/* TJ CONFIRM: one-time purchase, no auto-ship (Genesis offers patient auto-ship but the plan sells one-time) */}
        <p class="pp-fine">All six-patch sets are one-time purchases, not subscriptions.</p>

        <fieldset class="pp-fieldset">
          <legend class="pp-legend">Wear time</legend>
          <div class="pp-wears">
            {WEAR_OPTIONS.map((w) => (
              <label class="pp-opt">
                <input type="radio" name="wear" value={w.id} checked={w.id === DEFAULT_WEAR} />
                <span class="pp-card pp-card-wear">
                  <span class="pp-card-name">{w.label}</span>
                  <span class="pp-card-benefit">{WEAR_HELP[w.id]}</span>
                </span>
              </label>
            ))}
          </div>
          <p class="pp-fine">Same price either way.</p>
        </fieldset>

        <div class="pp-order">
          <button type="submit" id="order-btn" class="pp-cta pp-order-btn">Order — ${defaultBlend.priceUsd}</button>
          <p id="order-error" class="pp-error" role="alert" hidden></p>
        </div>
      </form>
    </div>
  </section>

  {/* IN THE BOX */}
  <section class="pp-sec pp-dark">
    <div class="pp-wrap">
      <p class="pp-eyebrow">In the box</p>
      <h2>What arrives at your door</h2>
      <div class="pp-box-wrap">
        <img class="pp-kit-img" src={IMG.kit} alt="Push Patch kit contents: a shaped adhesive patch with a round pad, a small amber blend vial, and a clear graduated applicator tube" width="882" height="674" loading="lazy" />
        {/* TJ CONFIRM: exact contents per set + prep steps (photo shows patch, amber blend vial "Net 1 g", graduated tube; is there a printed guide?) */}
        <ul class="pp-box">
          <li><strong>6</strong><span>Single-use patches, one for each week of the six-week set.</span></li>
          <li><strong>6</strong><span>Blend vials, one for each patch.</span></li>
          <li><strong>6</strong><span>Applicator tubes, one for each patch.</span></li>
        </ul>
      </div>
      {/* TJ CONFIRM: COA availability; MOTS-c COA not in deck */}
      <p class="pp-trust">Every active ingredient is third-party tested. Certificates of analysis (HPLC purity and mass-spec identity) for BPC-157, NAD+, GHK-Cu, glutathione, KPV and TB-500 are available on request.</p>
      {/* TJ CONFIRM: shipper not settled (own stock first, Genesis drop-ship later); this line may need to become "Ships to the United States" only */}
      <p class="pp-fine pp-fine-dark">Ships from My4MLife.</p>
    </div>
  </section>

  {/* FAQ */}
  <section class="pp-sec pp-white" id="faq">
    <div class="pp-wrap">
      <p class="pp-eyebrow">Questions</p>
      <h2>Before you order</h2>
      <div class="pp-faq">
        <details>
          <summary>Is there a needle anywhere in the process?</summary>
          {/* TJ CONFIRM: prep wording stays neutral until Genesis's prep steps are confirmed */}
          <p>No. The Push Patch is needle-free. There are no syringes and no injection at any step. You prepare the pad, apply the patch like a strip of kinesiology tape, and wear it.</p>
        </details>
        <details>
          <summary>Does it hurt, and what about sensitive skin?</summary>
          {/* TJ CONFIRM: "light tingle" line is an assumption about how iontophoresis feels (confirm with Genesis or delete); skin-contact warning wording from Genesis */}
          <p>Iontophoresis uses a small electrical charge and is described as pain-free. Most people describe the feeling as a light tingle or nothing at all. If your skin is sensitive, choose the 14-hour option, which was designed for sensitive skin. Do not apply a patch to broken or irritated skin.</p>
        </details>
        <details>
          <summary>I already inject peptides. Can I switch to the patch?</summary>
          {/* TJ CONFIRM: switching answer drafted by the copywriter; defers to the person's own provider, no medical advice */}
          <p>Talk to the healthcare provider who manages your current protocol before changing how you take anything. The formula on each blend card shows exactly what is in that patch, so you can compare it with what you use now.</p>
        </details>
        <details>
          <summary>What is iontophoresis, and is it established?</summary>
          {/* TJ CONFIRM: do not add any regulatory or approval statements about the patch beyond this */}
          <p>Iontophoresis uses a small electrical charge to move charged molecules through the skin. It is an established delivery technology used in medicine for decades. The Push Patch applies it in a wearable, single-use patch.</p>
        </details>
        <details>
          <summary>How long do I wear a patch, and how often?</summary>
          {/* TJ CONFIRM: wear/removal instructions; page must be explicit about removal after 12/14 hours vs worn through the week */}
          <p>One patch a week for six weeks. You choose 12-hour or 14-hour wear at checkout. Choose 12-hour if you are active; choose 14-hour if your skin is sensitive. The price is the same.</p>
        </details>
        <details>
          <summary>What is actually in my blend?</summary>
          <p>The formula on each blend card is exactly what is in your patch, with the amounts shown. Six of the seven blends contain NAD+; the Glutathione blend does not.</p>
        </details>
        <details>
          <summary>Who should check with a clinician first?</summary>
          {/* TJ CONFIRM: standard-caution list drafted by the copywriter, not sourced from Genesis; legal/Genesis must supply the real contraindications, especially implanted devices and the electrical charge */}
          <p>Anyone who is pregnant or nursing, has an implanted electronic device such as a pacemaker, has a known skin condition at the application site, or takes regular prescription medication should talk to their own healthcare provider before using a patch.</p>
        </details>
        <details>
          <summary>How fast does my order ship, and where?</summary>
          {/* TJ CONFIRM: ship speed ([X] business days), shipping cost, states we cannot ship to, carrier */}
          <p>We ship within the United States. You will get a confirmation email when you check out and a shipping update when the set goes out. Expect your set within [X] business days of ordering.</p>
        </details>
        <details>
          <summary>What is your refund policy?</summary>
          {/* TJ CONFIRM: decide supplement rule (unopened, within 14 days of delivery) vs no-returns rule, then state it in one sentence here */}
          <p>Questions about an order or a refund go to <a href="mailto:refunds@my4mlife.com">refunds@my4mlife.com</a>, and our full policy is at <a href="/refund-policy">/refund-policy</a>.</p>
        </details>
        <details>
          <summary>I have a question before I order. Who do I ask?</summary>
          {/* TJ CONFIRM: /consult currently runs in coordinator mode and begins an intake; confirm it is the right door for a pre-purchase question or use a plain email address */}
          <p>Start with our care coordinator at <a href="/consult">/consult</a>. They can help you choose a blend and answer questions about wear and shipping.</p>
        </details>
      </div>
    </div>
  </section>

  {/* CLOSE */}
  <section class="pp-close">
    <div class="pp-wrap">
      <h2>Retire the sharps container.</h2>
      <p class="pp-sub">One patch a week, applied like tape, worn for 12 or 14 hours. No needles, no pills, no IV chair.</p>
      <a class="pp-cta" href="#blends" onclick="window.posthog && posthog.capture('lp_patch_cta_close')">Choose your blend</a>
    </div>
  </section>

  <footer class="pp-foot">
    <div class="pp-wrap">
      <p class="pp-by">Brought to you by <span class="pp-by-mark">My<b>4M</b>Life</span></p>
      <p class="pp-tagline">Don't lose your identity and your dignity while you still have a choice.</p>
      {/* TJ CONFIRM: legal wording of the patch-specific disclaimer; the page must not claim regulatory approval of the patch. Shared MedicalDisclaimer intentionally not used (GLP-1 / compounded-medication language). */}
      <p class="pp-disclaimer">These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, prevent or alleviate any condition. Results vary by person.</p>
      <p class="pp-legal"><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href="/refund-policy">Refund policy</a> · <a href="/">my4mlife.com</a></p>
    </div>
  </footer>

</div>

</BaseLayout>

<script is:inline define:vars={{ API_BASE }}>
(function () {
  var form = document.getElementById('patch-form');
  var btn = document.getElementById('order-btn');
  var err = document.getElementById('order-error');
  if (!form || !btn) return;

  function track(name, props) {
    try { window.posthog && posthog.capture(name, props); } catch (e) {}
  }
  function selected() {
    var b = form.querySelector('input[name="blend"]:checked');
    var w = form.querySelector('input[name="wear"]:checked');
    return { b: b, skuId: b ? b.value : '', wear: w ? w.value : '12h' };
  }
  function renderLabel() {
    var s = selected();
    if (s.b) btn.textContent = 'Order — $' + s.b.getAttribute('data-price');
  }

  track('lp_patch_view');
  renderLabel();

  form.addEventListener('change', function () {
    var s = selected();
    err.hidden = true;
    renderLabel();
    track('lp_patch_select', { skuId: s.skuId, wear: s.wear });
  });

  form.addEventListener('submit', function (ev) {
    ev.preventDefault();
    var s = selected();
    if (!s.skuId) return;
    var label = btn.textContent;
    err.hidden = true;
    btn.disabled = true;
    btn.textContent = 'Opening secure checkout…';
    track('lp_patch_checkout', { skuId: s.skuId, wear: s.wear });

    function fail(msg) {
      err.textContent = msg;
      err.hidden = false;
      btn.disabled = false;
      btn.textContent = label;
    }

    fetch(API_BASE + '/api/checkout-session', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ skuId: s.skuId, wear: s.wear }),
    }).then(function (r) {
      if (r.status === 503) { fail("This blend isn't available to order yet."); return null; }
      if (!r.ok) { fail('We could not open checkout. Please try again in a moment.'); return null; }
      return r.json();
    }).then(function (res) {
      if (!res) return;
      if (res.url) { window.location = res.url; }
      else { fail('We could not open checkout. Please try again in a moment.'); }
    }).catch(function () {
      fail('We could not open checkout. Please check your connection and try again.');
    });
  });
})();
</script>

<style>
/* Push Patch look (2026-09-30): clinical/tech, independent of the site theme.
   Every section sets its own background + text colour, so the page renders the
   same under light or dark system settings. One accent hue (cyan): bright tint
   on dark sections, deep tint for text/borders on light sections. */
.pp {
  --ink: #0b1220;        /* near-black slate: dark sections */
  --ink-2: #131d31;      /* raised panels on dark */
  --ink-line: #26344d;   /* hairlines on dark */
  --on-ink: #e6edf7;     /* body text on dark */
  --on-ink-muted: #9fb0c8;
  --paper: #f3f6f9;      /* cool light-grey sections */
  --white: #ffffff;
  --text: #0f172a;       /* body text on light */
  --muted: #475569;
