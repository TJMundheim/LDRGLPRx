---
// Push Patch order confirmation — Stripe success_url target. Standalone (hideChrome),
// same palette/fonts as /go/push-patch (styles duplicated minimally, scoped).
// Fires posthog lp_patch_purchase with the sku from ?sku=. noindex.
// Reads ?session_id= and asks GET /api/push-patch-intake which of three states the order is in:
//   complete   -> health form was taken before payment and the order is finalized ("Order complete.")
//   processing -> paid, finalize still running (poll every 3 s for up to 60 s)
//   payment-pending (HTTP 402) -> bank transfer still clearing: calm "Payment processing." panel, no form
//   needs-form -> legacy / expired pre-intake: today's post-payment health form + ship-to confirmation,
//                 POSTed to /api/push-patch-intake. Copy: docs/launch/push-patch/async-visit-copy.md.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HealthForm from '../../../components/push-patch/HealthForm.astro';

const title = 'Order received — Push Patch — My4MLife';
const description = 'Your Push Patch order has been received.';
const canonical = 'https://www.my4mlife.com/go/push-patch/thank-you';
const API_BASE = import.meta.env.PUBLIC_LEAD_CAPTURE_API_URL ?? 'https://v9svm8ds74.execute-api.us-east-2.amazonaws.com';

const US_STATES: [string, string][] = [
  ['AL','Alabama'],['AK','Alaska'],['AZ','Arizona'],['AR','Arkansas'],['CA','California'],['CO','Colorado'],['CT','Connecticut'],
  ['DE','Delaware'],['DC','District of Columbia'],['FL','Florida'],['GA','Georgia'],['HI','Hawaii'],['ID','Idaho'],['IL','Illinois'],
  ['IN','Indiana'],['IA','Iowa'],['KS','Kansas'],['KY','Kentucky'],['LA','Louisiana'],['ME','Maine'],['MD','Maryland'],
  ['MA','Massachusetts'],['MI','Michigan'],['MN','Minnesota'],['MS','Mississippi'],['MO','Missouri'],['MT','Montana'],
  ['NE','Nebraska'],['NV','Nevada'],['NH','New Hampshire'],['NJ','New Jersey'],['NM','New Mexico'],['NY','New York'],
  ['NC','North Carolina'],['ND','North Dakota'],['OH','Ohio'],['OK','Oklahoma'],['OR','Oregon'],['PA','Pennsylvania'],
  ['RI','Rhode Island'],['SC','South Carolina'],['SD','South Dakota'],['TN','Tennessee'],['TX','Texas'],['UT','Utah'],
  ['VT','Vermont'],['VA','Virginia'],['WA','Washington'],['WV','West Virginia'],['WI','Wisconsin'],['WY','Wyoming'],
];

---
<BaseLayout title={title} description={description} canonical={canonical} robots="noindex,nofollow" hideChrome={true}>

<div class="pp">
  <header class="pp-top">
    <a class="pp-mark" href="/">My<b>4M</b>Life</a>
  </header>

  <main class="pp-ty">
    <div class="pp-wrap pp-narrow">
      <p class="pp-kicker">Push Patch</p>
      <h1 id="ty-h1">Payment received.</h1>

      <!-- Missing session_id -->
      <section id="ty-missing" hidden>
        <p class="pp-sub">We could not find your order on this page. Open the link from your receipt email, or write to <a href="mailto:support@my4mlife.com">support@my4mlife.com</a> and we will sort it out.</p>
      </section>

      <!-- Checking (brief, while the status request is in flight) -->
      <section id="ty-checking" aria-live="polite">
        <p class="pp-sub">Checking your order.</p>
      </section>

      <!-- Processing: paid, order is being finalized -->
      <section id="ty-processing" hidden aria-live="polite">
        <p class="pp-sub" id="ty-processing-msg">Finishing your order. This takes a few seconds.</p>
      </section>

      <!-- Payment still clearing (HTTP 402, e.g. bank transfer): no form -->
      <section id="ty-paying" hidden aria-live="polite">
        <p class="pp-sub">Your bank is still confirming the payment. As soon as it clears, a licensed physician in our network reviews your order and we email you. Nothing else is needed from you.</p>
      </section>

      <!-- Complete: health form was taken before payment -->
      <section id="ty-complete" hidden aria-live="polite">
        <p class="pp-sub">A licensed physician in our network is reviewing it now, usually within an hour during business hours (9 a.m.–5 p.m. Central). Nothing else is needed from you.</p>
        <p class="pp-sub pp-small">If you are not cleared, your payment is refunded in full within 10 business days.</p>
        <p class="pp-sub pp-small">If cleared, your patches are prepared within 1–3 business days, then ground delivery in 3–5 business days.</p>
        <p class="pp-sub pp-small">Check your inbox, and your spam folder, for a message from My4MLife.</p>
        <p class="pp-sub pp-small" id="ty-complete-afterhours" hidden>Submitted outside 9 a.m.–5 p.m. Central? You'll hear from us within the first hour of the next business day.</p>
      </section>

      <!-- Success after the legacy form (also shown for alreadySubmitted) -->
      <section id="ty-success" hidden aria-live="polite">
        <h2 class="pp-h2">Submitted.</h2>
        <p class="pp-sub" id="ty-success-body">One of our network's licensed physicians will review it within an hour during business hours (9 a.m.–5 p.m. Central). Your welcome email follows. If you are not cleared, your payment is refunded within 10 business days.</p>
        <p class="pp-sub pp-small" id="ty-already" hidden>We already have your answers for this order. Your welcome email follows once the review is done.</p>
        <p class="pp-sub pp-small">If cleared, your patches are prepared within 1–3 business days, then ground delivery in 3–5 business days.</p>
        <p class="pp-sub pp-small">Check your inbox, and your spam folder, for a message from My4MLife.</p>
        <p class="pp-sub pp-small" id="ty-afterhours" hidden>Submitted outside 9 a.m.–5 p.m. Central? You'll hear from us within the first hour of the next business day.</p>
      </section>

      <!-- Intake form -->
      <section id="ty-form-wrap" hidden>
        <h2 class="pp-h2">Two minutes to your physician review.</h2>
        <p class="pp-sub">Your payment is received. Answer a few health questions so one of our network's licensed physicians can review your order.</p>
        <p class="pp-sub pp-small">About 2 minutes. You will hear back within an hour during business hours, 9 a.m. to 5 p.m. Central. If you are not cleared, your payment is refunded within 10 business days.</p>
        <p class="pp-sub pp-small" id="ty-afterhours-top" hidden>Submitted outside 9 a.m.–5 p.m. Central? You'll hear from us within the first hour of the next business day.</p>
        {/* TJ CONFIRM: after-hours note: Monday to Friday business days; holidays */}

        <form id="ty-form" class="pp-form" novalidate>
          <HealthForm>
            <Fragment slot="shipping">
            <p class="pp-help">Safety check completed before checkout.</p>

            <h3 class="pp-h3">Shipping</h3>
            <fieldset class="pp-ship" id="ty-ship" aria-describedby="e-ship">
              <legend class="pp-ship-legend" id="ship-legend">Where should we ship your patches?</legend>
              <div id="ship-confirm" hidden>
                <p class="pp-ship-lead">Your patches will ship to:</p>
                <address class="pp-addr" id="ship-addr"></address>
                <label class="pp-radio"><input type="radio" name="shipChoice" value="yes" checked /> <span>Yes, ship here</span></label>
                <label class="pp-radio"><input type="radio" name="shipChoice" value="other" /> <span>Ship somewhere else</span></label>
              </div>
              <div id="ship-fields" hidden>
                <div class="pp-field">
                  <label for="s-name">Full name</label>
                  <input type="text" id="s-name" autocomplete="shipping name" aria-describedby="e-s-name" />
                  <p class="pp-err" id="e-s-name" role="alert"></p>
                </div>
                <div class="pp-field">
                  <label for="s-line1">Street address</label>
                  <input type="text" id="s-line1" autocomplete="shipping address-line1" aria-describedby="e-s-line1" />
                  <p class="pp-err" id="e-s-line1" role="alert"></p>
                </div>
                <div class="pp-field">
                  <label for="s-line2">Apt, suite, unit (optional)</label>
                  <input type="text" id="s-line2" autocomplete="shipping address-line2" />
                </div>
                <div class="pp-field">
                  <label for="s-city">City</label>
                  <input type="text" id="s-city" autocomplete="shipping address-level2" aria-describedby="e-s-city" />
                  <p class="pp-err" id="e-s-city" role="alert"></p>
                </div>
                <div class="pp-row">
                  <div class="pp-field">
                    <label for="s-state">State</label>
                    <select id="s-state" autocomplete="shipping address-level1" aria-describedby="e-s-state">
                      <option value="">Select</option>
                      {US_STATES.map(([code, name]) => <option value={code}>{name}</option>)}
                    </select>
                    <p class="pp-err" id="e-s-state" role="alert"></p>
                  </div>
                  <div class="pp-field">
                    <label for="s-zip">ZIP code</label>
                    <input type="text" id="s-zip" autocomplete="shipping postal-code" inputmode="numeric" aria-describedby="e-s-zip" />
                    <p class="pp-err" id="e-s-zip" role="alert"></p>
                  </div>
                </div>
                <p class="pp-help">United States addresses only.</p>
              </div>
              <p class="pp-help">Prepared within 1–3 business days, then ground delivery in 3–5 business days.</p>
              <p class="pp-err" id="e-ship" role="alert"></p>
            </fieldset>
            </Fragment>
          </HealthForm>

          <p class="pp-err pp-err-form" id="e-form" role="alert"></p>
          <button type="submit" class="pp-cta" id="ty-submit">Submit for physician review</button>
        </form>
      </section>
    </div>
  </main>

  <footer class="pp-foot">
    <div class="pp-wrap">
      <p class="pp-by">Brought to you by <span class="pp-by-mark">My<b>4M</b>Life</span></p>
      <p class="pp-disclaimer">These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, prevent or alleviate any condition. Results vary by person.</p>
      <p class="pp-legal"><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href="/">my4mlife.com</a> · We use cookies for site analytics.</p>
    </div>
  </footer>
</div>

</BaseLayout>

<script is:inline define:vars={{ API_BASE }}>
(function () {
  var qs = new URLSearchParams(window.location.search);
  var sessionId = qs.get('session_id') || '';
  var sku = qs.get('sku') || '';
  function $(id) { return document.getElementById(id); }
  function cap(name, props) { try { window.posthog && posthog.capture(name, props || {}); } catch (e) {} }

  cap('lp_patch_purchase', { sku: sku });

  // Business hours: Mon-Fri 9 a.m.-5 p.m. America/Chicago
  var afterHours = false;
  try {
    var parts = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Chicago', weekday: 'short', hour: 'numeric', hour12: false }).formatToParts(new Date());
    var wd = '', hr = 0;
    parts.forEach(function (p) { if (p.type === 'weekday') wd = p.value; if (p.type === 'hour') hr = parseInt(p.value, 10) % 24; });
    afterHours = wd === 'Sat' || wd === 'Sun' || hr < 9 || hr >= 17;
  } catch (e) {}
  if (afterHours) $('ty-afterhours-top').hidden = false;

  var STATES = ['ty-missing', 'ty-checking', 'ty-processing', 'ty-paying', 'ty-complete', 'ty-success', 'ty-form-wrap'];
  function only(id) {
    STATES.forEach(function (k) { $(k).hidden = k !== id; });
  }
  function toTop() { var h = $('ty-h1'); h.scrollIntoView && h.scrollIntoView(); }

  function showSuccess(already) {
    only('ty-success');
    if (already) { $('ty-already').hidden = false; }
    if (afterHours) $('ty-afterhours').hidden = false;
    toTop();
  }
  function showPaying() {
    $('ty-h1').textContent = 'Payment processing.';
    only('ty-paying');
  }
  function showComplete() {
    $('ty-h1').textContent = 'Order complete.';
    only('ty-complete');
    if (afterHours) $('ty-complete-afterhours').hidden = false;
    cap('lp_patch_intake_submitted', { sku: sku, preIntake: true });
  }

  // Looks like a Stripe Checkout session id (cs_...)
  if (!sessionId || !/^[A-Za-z0-9_]{8,200}$/.test(sessionId)) {
    only('ty-missing');
    return;
  }
  only('ty-checking');

  // ---------- Legacy form (needs-form): health fields + ship-to confirmation ----------
  var form = $('ty-form');
  var btn = $('ty-submit');
  var shipOk = false;
  function shipMode() {
    if (!shipOk) return 'ask';
    return form.querySelector('input[name="shipChoice"]:checked').value === 'other' ? 'other' : 'confirm';
  }
  function syncShip() {
    var m = shipMode();
    $('ship-fields').hidden = m === 'confirm';
    $('ship-confirm').hidden = !shipOk;
    $('ship-legend').textContent = shipOk ? 'Shipping address' : 'Where should we ship your patches?';
  }
  function showAddr(a) {
    var box = $('ship-addr'); box.textContent = '';
    [a.name, a.line1, a.line2, a.city + ', ' + a.state + ' ' + a.postalCode].forEach(function (t, i) {
      if (!t) return;
      if (i) box.appendChild(document.createElement('br'));
      box.appendChild(document.createTextNode(t));
    });
  }
  Array.prototype.forEach.call(form.querySelectorAll('input[name="shipChoice"]'), function (r) { r.addEventListener('change', syncShip); });
  syncShip();

  function showForm(shipTo) {
    var a = shipTo;
    if (a && a.line1 && a.city && a.state && a.postalCode) {
      shipOk = true; showAddr(a); $('s-name').value = a.name || '';
    } else { shipOk = false; }
    syncShip();
    only('ty-form-wrap');
  }

  function setErr(id, msg) { var el = $(id); if (el) el.textContent = msg || ''; }
  function validateShip(canFocus) {
    var ok = true, first = null;
    function bad(id, msg, focusEl) { setErr(id, msg); ok = false; if (!first) first = focusEl; }
    ['s-name','s-line1','s-city','s-state','s-zip','ship'].forEach(function (k) { setErr('e-' + k, ''); });
    if (shipMode() !== 'confirm') {
      [['name','s-name'],['line1','s-line1'],['city','s-city']].forEach(function (k) {
        if (!$(k[1]).value.trim()) bad('e-' + k[1], 'This field is required.', $(k[1]));
      });
      if (!$('s-state').value) bad('e-s-state', 'Select a state.', $('s-state'));
      if (!/^\d{5}(-?\d{4})?$/.test($('s-zip').value.trim())) bad('e-s-zip', 'Enter a 5-digit ZIP code.', $('s-zip'));
    }
    if (first && canFocus && first.focus) first.focus();
    return ok;
  }

  form.addEventListener('submit', function (ev) {
    ev.preventDefault();
    if (btn.disabled) return;
    setErr('e-form', '');
    var H = window.PPHealth;
    var healthOk = H.validateHealth();
    var shipValid = validateShip(healthOk);
    if (!healthOk || !shipValid) return;
    var payload = H.collectHealth();
    payload.sessionId = sessionId;
    payload.shipping = shipMode() === 'confirm' ? { confirmed: true } : { confirmed: false, address: {
      name: $('s-name').value.trim(), line1: $('s-line1').value.trim(), line2: $('s-line2').value.trim(),
      city: $('s-city').value.trim(), state: $('s-state').value, postalCode: $('s-zip').value.trim()
    } };
    btn.disabled = true; btn.textContent = 'Sending...';
    function fail(msg) { setErr('e-form', msg); btn.disabled = false; btn.textContent = 'Submit for physician review'; }
    fetch(API_BASE + '/api/push-patch-intake', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    }).then(function (res) {
      return res.json().catch(function () { return {}; }).then(function (data) {
        if (res.status === 200 && data && data.alreadySubmitted) { cap('lp_patch_intake_submitted', { sku: sku, alreadySubmitted: true }); showSuccess(true); return; }
        if (res.status === 200) { cap('lp_patch_intake_submitted', { sku: sku }); showSuccess(false); return; }
        if (res.status === 400) return fail('Please complete every field, including a valid shipping address, and answer every question.');
        if (res.status === 402) return fail('We could not match this page to a paid order. Check the link in your receipt email, or write to support@my4mlife.com.');
        fail('Something went wrong sending your answers. Your payment is safe. Please try again, or write to support@my4mlife.com.');
      });
    }).catch(function () {
      fail('Something went wrong sending your answers. Your payment is safe. Please try again, or write to support@my4mlife.com.');
    });
  });

  // ---------- Order status: complete | processing | needs-form ----------
  var POLL_MS = 3000, POLL_MAX_MS = 60000;
  var started = Date.now();
  var pollTimer = null;

  // Rejects with err.paying (HTTP 402) or err.retryable (network error / 5xx); other non-200s are plain errors.
  function getStatus() {
    return fetch(API_BASE + '/api/push-patch-intake?session_id=' + encodeURIComponent(sessionId)).then(function (res) {
      if (res.status === 402) { var p = new Error('status 402'); p.paying = true; throw p; }
      if (res.status !== 200) { var e = new Error('status ' + res.status); e.retryable = res.status >= 500; throw e; }
      return res.json();
    }, function (err) { err.retryable = true; throw err; });
  }
  function handle(d) {
    var st = d && d.status;
    if (st === 'complete') { showComplete(); return; }
    if (st === 'processing') {
      only('ty-processing');
      if (Date.now() - started >= POLL_MAX_MS) {
        $('ty-processing-msg').textContent = 'Your order is in and we are finishing it now. We will email you shortly; nothing else is needed from you.';
        return;
      }
      pollTimer = setTimeout(poll, POLL_MS);
      return;
    }
    // needs-form (or anything unrecognised): today's post-payment form.
    showForm(d && d.shipTo);
  }
  function poll() {
    getStatus().then(handle).catch(function (err) {
      if (err && err.paying) { showPaying(); return; }
      // Transient failure while processing: keep trying until the 60 s window closes.
      if (Date.now() - started >= POLL_MAX_MS) {
        $('ty-processing-msg').textContent = 'Your order is in and we are finishing it now. We will email you shortly; nothing else is needed from you.';
        return;
      }
      pollTimer = setTimeout(poll, POLL_MS);
    });
  }
  // First request: on a network error or 5xx, retry every 3 s for up to 60 s before falling back to the legacy form.
  function firstLoad() {
    getStatus().then(handle).catch(function (err) {
      if (err && err.paying) { showPaying(); return; }
      if (err && err.retryable && Date.now() - started < POLL_MAX_MS) {
        pollTimer = setTimeout(firstLoad, POLL_MS);
        return;
      }
      showForm(null);
    });
  }
  firstLoad();
})();
</script>

<style>
.pp {
  --ink: #0b1220; --ink-2: #131d31; --ink-line: #26344d;
  --on-ink: #e6edf7; --on-ink-muted: #9fb0c8; --accent: #22d3ee;
  color-scheme: light;
  font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
  color: var(--on-ink);
  background: var(--ink);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  -webkit-font-smoothing: antialiased;
}
:global(body) { background: #0b1220; }
.pp h1 { font-family: 'Inter', system-ui, sans-serif; letter-spacing: -0.02em; }
.pp-wrap { max-width: 920px; margin: 0 auto; padding: 0 1rem; }
@media (min-width: 640px) { .pp-wrap { padding: 0 1.5rem; } }
.pp-top { padding: 1rem; border-bottom: 1px solid var(--ink-line); }
@media (min-width: 640px) { .pp-top { padding: 1rem 1.5rem; } }
.pp-mark { font-weight: 700; font-size: 1rem; color: var(--on-ink); text-decoration: none; letter-spacing: -0.01em; }
.pp-mark b, .pp-by-mark b { color: var(--accent); font-weight: 800; }
.pp-ty { flex: 1; background: radial-gradient(120% 90% at 50% 0%, #15233d 0%, var(--ink) 65%); text-align: center; padding: 4rem 0 3.5rem; }
.pp-kicker { display: inline-block; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); border: 1px solid rgba(34, 211, 238, 0.4); border-radius: 999px; padding: 0.35rem 0.9rem; margin: 0 0 1.4rem; }
.pp-ty h1 { font-size: clamp(2.1rem, 7vw, 3.6rem); font-weight: 800; line-height: 1.05; margin: 0 auto 1.3rem; color: #ffffff; }
.pp-sub { font-size: clamp(1rem, 2.2vw, 1.18rem); line-height: 1.6; color: var(--on-ink); max-width: 56ch; margin: 0 auto 1rem; }
.pp-foot { background: var(--ink); color: var(--on-ink-muted); border-top: 1px solid var(--ink-line); padding: 2.2rem 0 2.6rem; text-align: center; }
.pp-by { font-size: 0.78rem; color: var(--on-ink-muted); margin: 0 0 1.2rem; }
.pp-by-mark { font-weight: 700; color: var(--on-ink); }
.pp-tagline { font-size: clamp(1.05rem, 2.6vw, 1.3rem); font-weight: 600; color: #ffffff; max-width: 34ch; margin: 0 auto 1.4rem; line-height: 1.4; text-wrap: balance; }
.pp-disclaimer { font-size: 0.74rem; line-height: 1.6; max-width: 640px; margin: 0 auto; color: var(--on-ink-muted); }
.pp-legal { font-size: 0.78rem; margin: 1rem 0 0; color: var(--on-ink-muted); }
.pp-legal a { color: var(--on-ink-muted); }

.pp-narrow { max-width: 640px; }
.pp-ty { text-align: left; }
.pp-ty .pp-kicker { display: inline-block; }
.pp-ty h1 { text-align: left; margin-left: 0; }
.pp-ty .pp-sub { margin-left: 0; margin-right: 0; max-width: none; }
.pp-sub a, .pp-help a { color: var(--accent); }
.pp-small { font-size: 0.9rem; color: var(--on-ink-muted); }
.pp-h2 { font-size: clamp(1.4rem, 4.5vw, 1.9rem); font-weight: 700; color: #fff; margin: 0 0 1rem; line-height: 1.2; letter-spacing: -0.02em; }
.pp-h3 { font-size: 1.1rem; font-weight: 700; color: #fff; margin: 2rem 0 0.5rem; }
.pp-form { margin-top: 1.5rem; }
.pp-field { margin: 0 0 1.25rem; }
.pp-field label { display: block; font-size: 0.95rem; font-weight: 600; color: #fff; margin: 0 0 0.4rem; }
.pp-field input, .pp-field select, .pp-field textarea {
  width: 100%; box-sizing: border-box; font: inherit; font-size: 1rem; color: var(--on-ink);
  background: var(--ink-2); border: 1px solid var(--ink-line); border-radius: 8px; padding: 0.7rem 0.8rem; color-scheme: dark;
}
.pp-field textarea { resize: vertical; min-height: 4rem; }
.pp-field input:focus-visible, .pp-field select:focus-visible, .pp-field textarea:focus-visible,
.pp-consent:focus-visible, .pp-radio input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.pp-field .pp-check { display: flex; font-weight: 400; margin: 0; align-items: flex-start; gap: 0.7rem; min-height: 44px; cursor: pointer; font-size: 0.95rem; line-height: 1.5; color: var(--on-ink); }
.pp-check input { flex: none; width: 1.2rem; height: 1.2rem; margin-top: 0.2rem; accent-color: var(--accent); }
.pp-check input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.pp-check a { color: var(--accent); }
.pp-help { font-size: 0.8rem; line-height: 1.5; color: var(--on-ink-muted); margin: 0.4rem 0 0; }
.pp-help-top { margin: 0 0 1.5rem; }
.pp-err { font-size: 0.85rem; color: #fca5a5; margin: 0.4rem 0 0; min-height: 0; }
.pp-err:empty { display: none; }
.pp-err-form { margin: 1rem 0 0; }
.pp-radios { border: 0; padding: 0; margin: 1rem 0 0; min-width: 0; }
.pp-radios legend { font-size: 0.95rem; color: #fff; padding: 0; margin: 0 0 0.5rem; line-height: 1.4; }
