---
// Push Patch order confirmation — Stripe success_url target. Standalone (hideChrome),
// same palette/fonts as /go/push-patch (styles duplicated minimally, scoped).
// Fires posthog lp_patch_purchase with the sku from ?sku=. noindex.
// Step 2 of the async-visit flow: reads ?session_id=, collects the health intake and
// POSTs it to /api/push-patch-intake. Copy: docs/launch/push-patch/async-visit-copy.md.
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Order received — Genesis Push Patch — My4MLife';
const description = 'Your Push Patch order has been received.';
const canonical = 'https://www.my4mlife.com/go/push-patch/thank-you';
const API_BASE = import.meta.env.PUBLIC_LEAD_CAPTURE_API_URL ?? 'https://v9svm8ds74.execute-api.us-east-2.amazonaws.com';

const US_STATES: [string, string][] = [
  ['AL','Alabama'],['AK','Alaska'],['AZ','Arizona'],['AR','Arkansas'],['CA','California'],['CO','Colorado'],['CT','Connecticut'],
  ['DE','Delaware'],['DC','District of Columbia'],['FL','Florida'],['GA','Georgia'],['HI','Hawaii'],['ID','Idaho'],['IL','Illinois'],
  ['IN','Indiana'],['IA','Iowa'],['KS','Kansas'],['KY','Kentucky'],['LA','Louisiana'],['ME','Maine'],['MD','Maryland'],
  ['MA','Massachusetts'],['MI','Michigan'],['MN','Minnesota'],['MS','Mississippi'],['MO','Missouri'],['MT','Montana'],
  ['NE','Nebraska'],['NV','Nevada'],['NH','New Hampshire'],['NJ','New Jersey'],['NM','New Mexico'],['NY','New York'],
  ['NC','North Carolina'],['ND','North Dakota'],['OH','Ohio'],['OK','Oklahoma'],['OR','Oregon'],['PA','Pennsylvania'],
  ['RI','Rhode Island'],['SC','South Carolina'],['SD','South Dakota'],['TN','Tennessee'],['TX','Texas'],['UT','Utah'],
  ['VT','Vermont'],['VA','Virginia'],['WA','Washington'],['WV','West Virginia'],['WI','Wisconsin'],['WY','Wyoming'],
];

const QUESTIONS = [
  { name: 'seizures', text: 'Have you ever had epilepsy or seizures?' },
  { name: 'pacemaker', text: 'Do you have a pacemaker?' },
  { name: 'metalImplantNearSite', text: 'Do you have metal implants near where the patch would sit?' },
  { name: 'pregnant', text: 'Are you pregnant? (Answer No if this does not apply to you.)' },
  { name: 'woundAtSite', text: 'Do you have a recent wound, skin graft or scar at the spot where the patch would sit?' },
];
---
<BaseLayout title={title} description={description} canonical={canonical} robots="noindex,nofollow" hideChrome={true}>

<div class="pp">
  <header class="pp-top">
    <a class="pp-mark" href="/">My<b>4M</b>Life</a>
  </header>

  <main class="pp-ty">
    <div class="pp-wrap pp-narrow">
      <p class="pp-kicker">Genesis Push Patch</p>
      <h1 id="ty-h1">Payment received.</h1>

      <!-- Missing session_id -->
      <section id="ty-missing" hidden>
        <p class="pp-sub">We could not find your order on this page. Open the link from your receipt email, or write to <a href="mailto:support@my4mlife.com">support@my4mlife.com</a> and we will sort it out.</p>
      </section>

      <!-- Success (also shown for alreadySubmitted) -->
      <section id="ty-success" hidden aria-live="polite">
        <h2 class="pp-h2">Submitted.</h2>
        <p class="pp-sub" id="ty-success-body">A licensed physician in our network will review it within an hour during business hours (9 a.m.–5 p.m. Central). Your welcome email follows. If you are not cleared, your refund is automatic.</p>
        <p class="pp-sub pp-small" id="ty-already" hidden>We already have your answers for this order. Your welcome email follows once the review is done.</p>
        <p class="pp-sub pp-small">If cleared, your patches are prepared within 1–3 business days, then ground delivery in 3–5 business days.</p>
        <p class="pp-sub pp-small">Check your inbox, and your spam folder, for a message from My4MLife.</p>
        <p class="pp-sub pp-small" id="ty-afterhours" hidden>Submitted outside 9 a.m.–5 p.m. Central? You'll hear from us within the first hour of the next business day.</p>
      </section>

      <!-- Intake form -->
      <section id="ty-form-wrap" hidden>
        <h2 class="pp-h2">Two minutes to your physician review.</h2>
        <p class="pp-sub">Your payment is received. Answer a few health questions so one of our network's licensed physicians can review your order.</p>
        <p class="pp-sub pp-small">About 2 minutes. You will hear back within an hour during business hours, 9 a.m. to 5 p.m. Central. If you are not cleared, you get a full refund automatically.</p>
        <p class="pp-sub pp-small" id="ty-afterhours-top" hidden>Submitted outside 9 a.m.–5 p.m. Central? You'll hear from us within the first hour of the next business day.</p>
        {/* TJ CONFIRM: after-hours note: Monday to Friday business days; holidays */}

        <form id="ty-form" class="pp-form" novalidate>
          <p class="pp-help pp-help-top">Your answers go only to the reviewing physician and your care record. They are never sent by text message or shown on a receipt.</p>
          {/* TJ CONFIRM: privacy helper wording matches the HIPAA architecture; no PHI in SMS */}

          <div class="pp-field">
            <label for="f-dob">Date of birth</label>
            <input type="date" id="f-dob" name="dob" autocomplete="bday" max="" required aria-describedby="h-dob e-dob" />
            <p class="pp-help" id="h-dob">Month, day, year.</p>
            <p class="pp-err" id="e-dob" role="alert"></p>
          </div>

          <div class="pp-field">
            <label for="f-sex">Sex</label>
            <select id="f-sex" name="sex" required aria-describedby="h-sex e-sex">
              <option value="">Select</option>
              <option value="male">Male</option>
              <option value="female">Female</option>
            </select>
            <p class="pp-help" id="h-sex">Used by the physician for screening.</p>
            {/* TJ CONFIRM: sex helper wording */}
            <p class="pp-err" id="e-sex" role="alert"></p>
          </div>

          <div class="pp-field">
            <label for="f-phone">Mobile phone</label>
            <input type="tel" id="f-phone" name="phone" autocomplete="tel" inputmode="tel" required aria-describedby="h-phone e-phone" />
            <p class="pp-help" id="h-phone">Used only if the physician needs to reach you about this order. We never text health information.</p>
            <p class="pp-err" id="e-phone" role="alert"></p>
          </div>

          <div class="pp-field">
            <label for="f-medications">Current medications and supplements</label>
            <textarea id="f-medications" name="medications" rows="3" required aria-describedby="h-medications e-medications"></textarea>
            <p class="pp-help" id="h-medications">List everything you take, including peptides and over-the-counter products. Write "None" if none.</p>
            <p class="pp-err" id="e-medications" role="alert"></p>
          </div>

          <div class="pp-field">
            <label for="f-allergies">Allergies</label>
            <textarea id="f-allergies" name="allergies" rows="2" required aria-describedby="h-allergies e-allergies"></textarea>
            <p class="pp-help" id="h-allergies">Include medications, adhesives, tape, latex or metals. Write "None" if none.</p>
            <p class="pp-err" id="e-allergies" role="alert"></p>
          </div>

          <div class="pp-field">
            <label for="f-conditions">Medical conditions</label>
            <textarea id="f-conditions" name="conditions" rows="3" required aria-describedby="h-conditions e-conditions"></textarea>
            <p class="pp-help" id="h-conditions">Include anything a physician has diagnosed, and any past surgeries. Write "None" if none.</p>
            <p class="pp-err" id="e-conditions" role="alert"></p>
          </div>

          <h3 class="pp-h3">Safety check</h3>
          <p class="pp-help">Answer each question Yes or No. A Yes does not cancel your order automatically; the physician reviews it.</p>
          {/* TJ CONFIRM: a Yes goes to the physician for a decision and is not an auto-decline */}
          {QUESTIONS.map((q) => (
            <fieldset class="pp-radios" aria-describedby={`e-${q.name}`}>
              <legend>{q.text}</legend>
              <label class="pp-radio"><input type="radio" name={q.name} value="yes" required /> <span>Yes</span></label>
              <label class="pp-radio"><input type="radio" name={q.name} value="no" required /> <span>No</span></label>
              <p class="pp-err" id={`e-${q.name}`} role="alert"></p>
            </fieldset>
          ))}
          {/* TJ CONFIRM: pregnancy question asked of everyone, with the "does not apply" clause */}

          <h3 class="pp-h3">Shipping</h3>
          <fieldset class="pp-ship" id="ty-ship" aria-describedby="e-ship">
            <legend class="pp-ship-legend" id="ship-legend">Where should we ship your patches?</legend>
            <div id="ship-confirm" hidden>
              <p class="pp-ship-lead">Your patches will ship to:</p>
              <address class="pp-addr" id="ship-addr"></address>
              <label class="pp-radio"><input type="radio" name="shipChoice" value="yes" checked /> <span>Yes, ship here</span></label>
              <label class="pp-radio"><input type="radio" name="shipChoice" value="other" /> <span>Ship somewhere else</span></label>
            </div>
            <div id="ship-fields" hidden>
              <div class="pp-field">
                <label for="s-name">Full name</label>
                <input type="text" id="s-name" autocomplete="shipping name" aria-describedby="e-s-name" />
                <p class="pp-err" id="e-s-name" role="alert"></p>
              </div>
              <div class="pp-field">
                <label for="s-line1">Street address</label>
                <input type="text" id="s-line1" autocomplete="shipping address-line1" aria-describedby="e-s-line1" />
                <p class="pp-err" id="e-s-line1" role="alert"></p>
              </div>
              <div class="pp-field">
                <label for="s-line2">Apt, suite, unit (optional)</label>
                <input type="text" id="s-line2" autocomplete="shipping address-line2" />
              </div>
              <div class="pp-field">
                <label for="s-city">City</label>
                <input type="text" id="s-city" autocomplete="shipping address-level2" aria-describedby="e-s-city" />
                <p class="pp-err" id="e-s-city" role="alert"></p>
              </div>
              <div class="pp-row">
                <div class="pp-field">
                  <label for="s-state">State</label>
                  <select id="s-state" autocomplete="shipping address-level1" aria-describedby="e-s-state">
                    <option value="">Select</option>
                    {US_STATES.map(([code, name]) => <option value={code}>{name}</option>)}
                  </select>
                  <p class="pp-err" id="e-s-state" role="alert"></p>
                </div>
                <div class="pp-field">
                  <label for="s-zip">ZIP code</label>
                  <input type="text" id="s-zip" autocomplete="shipping postal-code" inputmode="numeric" aria-describedby="e-s-zip" />
                  <p class="pp-err" id="e-s-zip" role="alert"></p>
                </div>
              </div>
              <p class="pp-help">United States addresses only.</p>
            </div>
            <p class="pp-help">Prepared within 1–3 business days, then ground delivery in 3–5 business days.</p>
            <p class="pp-err" id="e-ship" role="alert"></p>
          </fieldset>

          <h3 class="pp-h3">Telehealth consent</h3>
          <div class="pp-consent" tabindex="0" role="region" aria-label="Telehealth consent text">
            <p>By signing below, I consent to an asynchronous telehealth review of my order. This means a licensed physician in our network will review the health information I submit here, without a live video or phone visit, and decide whether the Push Patch is appropriate for me. I understand that this review cannot include a physical exam, that it depends on my answers being complete and truthful, and that the physician may decide I am not cleared. If I am not cleared, my payment is refunded in full automatically. I agree to give accurate information about my medications, allergies, conditions and screening answers, and to tell my physician about any change in my health. I understand that telehealth is not for emergencies; if I have a medical emergency I will call 911. I may withdraw this consent at any time without affecting my right to future care. My health information is handled under the My4MLife Privacy Policy and applicable privacy law. I authorize My4MLife and our network's licensed physicians to share my name, shipping address and phone number with our pharmacy partner to fill and ship my order. I am of legal adult age and a resident of the United States.</p>
          </div>
          {/* TJ CONFIRM: legal wording of consent paragraph */}
          <p class="pp-help">Read the full <a href="/consent" target="_blank" rel="noopener">Medical &amp; Telehealth Consent</a> and the <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>.</p>
          {/* TJ CONFIRM: /consent still carries GLP-1 and compounded-medication language; decide whether to link it */}

          <div class="pp-field">
            <label for="f-consent">Type your full legal name to sign</label>
            <input type="text" id="f-consent" name="consentName" autocomplete="name" required aria-describedby="h-consent e-consent" />
            <p class="pp-help" id="h-consent">This works as your signature. Today's date is recorded automatically.</p>
            <p class="pp-err" id="e-consent" role="alert"></p>
          </div>

          <p class="pp-err pp-err-form" id="e-form" role="alert"></p>
          <button type="submit" class="pp-cta" id="ty-submit">Submit for physician review</button>
        </form>
      </section>
    </div>
  </main>

  <footer class="pp-foot">
    <div class="pp-wrap">
      <p class="pp-by">Brought to you by <span class="pp-by-mark">My<b>4M</b>Life</span></p>
      <p class="pp-tagline">Don't lose your identity and your dignity while you still have a choice.</p>
      <p class="pp-disclaimer">These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, prevent or alleviate any condition. Results vary by person.</p>
      <p class="pp-legal"><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href="/">my4mlife.com</a> · We use cookies for site analytics.</p>
    </div>
  </footer>
</div>

</BaseLayout>

<script is:inline define:vars={{ API_BASE }}>
(function () {
  var qs = new URLSearchParams(window.location.search);
  var sessionId = qs.get('session_id') || '';
  var sku = qs.get('sku') || '';
  function $(id) { return document.getElementById(id); }
  function cap(name, props) { try { window.posthog && posthog.capture(name, props || {}); } catch (e) {} }

  cap('lp_patch_purchase', { sku: sku });

  // Business hours: Mon-Fri 9 a.m.-5 p.m. America/Chicago
  var afterHours = false;
  try {
    var parts = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Chicago', weekday: 'short', hour: 'numeric', hour12: false }).formatToParts(new Date());
    var wd = '', hr = 0;
    parts.forEach(function (p) { if (p.type === 'weekday') wd = p.value; if (p.type === 'hour') hr = parseInt(p.value, 10) % 24; });
    afterHours = wd === 'Sat' || wd === 'Sun' || hr < 9 || hr >= 17;
  } catch (e) {}
  if (afterHours) $('ty-afterhours-top').hidden = false;

  function showSuccess(already) {
    $('ty-form-wrap').hidden = true;
    $('ty-success').hidden = false;
    if (already) { $('ty-already').hidden = false; }
    if (afterHours) $('ty-afterhours').hidden = false;
    $('ty-h1').scrollIntoView && $('ty-h1').scrollIntoView();
  }

  // Looks like a Stripe Checkout session id (cs_...)
  if (!sessionId || !/^[A-Za-z0-9_]{8,200}$/.test(sessionId)) {
    $('ty-missing').hidden = false;
    return;
  }
  $('ty-form-wrap').hidden = false;

  var form = $('ty-form');
  var btn = $('ty-submit');
  var dob = $('f-dob');
  var today = new Date(); today.setMinutes(today.getMinutes() - today.getTimezoneOffset());
  dob.max = today.toISOString().slice(0, 10);

  // Ship-to: GET the Stripe address; on failure fall back to empty fields.
  var shipOk = false;
  function shipMode() {
    if (!shipOk) return 'ask';
    return form.querySelector('input[name="shipChoice"]:checked').value === 'other' ? 'other' : 'confirm';
  }
  function syncShip() {
    var m = shipMode();
    $('ship-fields').hidden = m === 'confirm';
    $('ship-confirm').hidden = !shipOk;
    $('ship-legend').textContent = shipOk ? 'Shipping address' : 'Where should we ship your patches?';
  }
  function showAddr(a) {
    var box = $('ship-addr'); box.textContent = '';
    [a.name, a.line1, a.line2, a.city + ', ' + a.state + ' ' + a.postalCode].forEach(function (t, i) {
      if (!t) return;
      if (i) box.appendChild(document.createElement('br'));
      box.appendChild(document.createTextNode(t));
    });
  }
  Array.prototype.forEach.call(form.querySelectorAll('input[name="shipChoice"]'), function (r) { r.addEventListener('change', syncShip); });
  syncShip();
  fetch(API_BASE + '/api/push-patch-intake?session_id=' + encodeURIComponent(sessionId)).then(function (res) {
    if (res.status !== 200) throw new Error('no address');
    return res.json();
  }).then(function (d) {
    var a = d && d.shipTo;
    if (!a || !a.line1 || !a.city || !a.state || !a.postalCode) throw new Error('no address');
    shipOk = true; showAddr(a); $('s-name').value = a.name || ''; syncShip();
  }).catch(function () { shipOk = false; syncShip(); });

  var QS = ['seizures', 'pacemaker', 'metalImplantNearSite', 'pregnant', 'woundAtSite'];

  function setErr(id, msg) { var el = $(id); if (el) el.textContent = msg || ''; }
  function lines(v) {
    return v.split(/\r?\n|;/).map(function (x) { return x.trim(); }).filter(Boolean);
  }
  function validate() {
    var ok = true, first = null;
    function bad(id, msg, focusEl) { setErr(id, msg); ok = false; if (!first) first = focusEl; }
    ['dob','sex','phone','medications','allergies','conditions','consent','s-name','s-line1','s-city','s-state','s-zip','ship'].concat(QS).forEach(function (k) { setErr('e-' + k, ''); });
    setErr('e-form', '');

    var d = dob.value;
    var dd = d ? new Date(d + 'T00:00:00') : null;
    if (!d) bad('e-dob', 'This field is required.', dob);
    else if (!dd || isNaN(dd.getTime()) || dd > new Date() || dd.getFullYear() < 1900) bad('e-dob', 'Enter your date of birth as month, day, year.', dob);

    if (!$('f-sex').value) bad('e-sex', 'This field is required.', $('f-sex'));

    var ph = $('f-phone').value.trim();
    var digits = ph.replace(/\D/g, '');
    if (!ph) bad('e-phone', 'This field is required.', $('f-phone'));
    else if (digits.length < 10 || digits.length > 15 || !/^[+\d\s().-]+$/.test(ph)) bad('e-phone', 'Enter a valid mobile number.', $('f-phone'));

    ['medications','allergies','conditions'].forEach(function (k) {
      if (!$('f-' + k).value.trim()) bad('e-' + k, 'This field is required.', $('f-' + k));
    });
    QS.forEach(function (q) {
      if (!form.querySelector('input[name="' + q + '"]:checked')) bad('e-' + q, 'This field is required.', form.querySelector('input[name="' + q + '"]'));
    });
    if (shipMode() !== 'confirm') {
      [['name','s-name'],['line1','s-line1'],['city','s-city']].forEach(function (k) {
        if (!$(k[1]).value.trim()) bad('e-' + k[1], 'This field is required.', $(k[1]));
      });
      if (!$('s-state').value) bad('e-s-state', 'Select a state.', $('s-state'));
      if (!/^\d{5}(-?\d{4})?$/.test($('s-zip').value.trim())) bad('e-s-zip', 'Enter a 5-digit ZIP code.', $('s-zip'));
    }
    if (!$('f-consent').value.trim()) bad('e-consent', 'Type your full legal name to continue.', $('f-consent'));
    if (first && first.focus) first.focus();
    return ok;
  }

  form.addEventListener('submit', function (ev) {
    ev.preventDefault();
    if (btn.disabled) return;
    if (!validate()) return;
    var screening = {};
    QS.forEach(function (q) { screening[q] = form.querySelector('input[name="' + q + '"]:checked').value === 'yes'; });
    var payload = {
      sessionId: sessionId,
      dob: dob.value,
      sex: $('f-sex').value,
      phone: $('f-phone').value.trim(),
      medications: lines($('f-medications').value),
      allergies: lines($('f-allergies').value),
      conditions: lines($('f-conditions').value),
      screening: screening,
      consentName: $('f-consent').value.trim(),
      shipping: shipMode() === 'confirm' ? { confirmed: true } : { confirmed: false, address: {
        name: $('s-name').value.trim(), line1: $('s-line1').value.trim(), line2: $('s-line2').value.trim(),
        city: $('s-city').value.trim(), state: $('s-state').value, postalCode: $('s-zip').value.trim()
      } }
    };
    btn.disabled = true; btn.textContent = 'Sending...';
    setErr('e-form', '');
    function fail(msg) { setErr('e-form', msg); btn.disabled = false; btn.textContent = 'Submit for physician review'; }
    fetch(API_BASE + '/api/push-patch-intake', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    }).then(function (res) {
      return res.json().catch(function () { return {}; }).then(function (data) {
        if (res.status === 200 && data && data.alreadySubmitted) { cap('lp_patch_intake_submitted', { sku: sku, alreadySubmitted: true }); showSuccess(true); return; }
        if (res.status === 200) { cap('lp_patch_intake_submitted', { sku: sku }); showSuccess(false); return; }
        if (res.status === 400) return fail('Please complete every field, including a valid shipping address, and answer every question.');
        if (res.status === 402) return fail('We could not match this page to a paid order. Check the link in your receipt email, or write to support@my4mlife.com.');
        fail('Something went wrong sending your answers. Your payment is safe. Please try again, or write to support@my4mlife.com.');
      });
    }).catch(function () {
      fail('Something went wrong sending your answers. Your payment is safe. Please try again, or write to support@my4mlife.com.');
    });
  });
})();
</script>

<style>
.pp {
  --ink: #0b1220; --ink-2: #131d31; --ink-line: #26344d;
  --on-ink: #e6edf7; --on-ink-muted: #9fb0c8; --accent: #22d3ee;
  color-scheme: light;
  font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
  color: var(--on-ink);
  background: var(--ink);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  -webkit-font-smoothing: antialiased;
}
:global(body) { background: #0b1220; }
.pp h1 { font-family: 'Inter', system-ui, sans-serif; letter-spacing: -0.02em; }
.pp-wrap { max-width: 920px; margin: 0 auto; padding: 0 1rem; }
@media (min-width: 640px) { .pp-wrap { padding: 0 1.5rem; } }
.pp-top { padding: 1rem; border-bottom: 1px solid var(--ink-line); }
@media (min-width: 640px) { .pp-top { padding: 1rem 1.5rem; } }
.pp-mark { font-weight: 700; font-size: 1rem; color: var(--on-ink); text-decoration: none; letter-spacing: -0.01em; }
.pp-mark b, .pp-by-mark b { color: var(--accent); font-weight: 800; }
.pp-ty { flex: 1; background: radial-gradient(120% 90% at 50% 0%, #15233d 0%, var(--ink) 65%); text-align: center; padding: 4rem 0 3.5rem; }
.pp-kicker { display: inline-block; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); border: 1px solid rgba(34, 211, 238, 0.4); border-radius: 999px; padding: 0.35rem 0.9rem; margin: 0 0 1.4rem; }
.pp-ty h1 { font-size: clamp(2.1rem, 7vw, 3.6rem); font-weight: 800; line-height: 1.05; margin: 0 auto 1.3rem; color: #ffffff; }
.pp-sub { font-size: clamp(1rem, 2.2vw, 1.18rem); line-height: 1.6; color: var(--on-ink); max-width: 56ch; margin: 0 auto 1rem; }
.pp-foot { background: var(--ink); color: var(--on-ink-muted); border-top: 1px solid var(--ink-line); padding: 2.2rem 0 2.6rem; text-align: center; }
.pp-by { font-size: 0.78rem; color: var(--on-ink-muted); margin: 0 0 1.2rem; }
.pp-by-mark { font-weight: 700; color: var(--on-ink); }
