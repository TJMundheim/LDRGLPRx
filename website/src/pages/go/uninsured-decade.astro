---
// LANDING PAGE — The Uninsured Decade cost-of-decline calculator.
// Standalone (hideChrome): fed by talk QR codes + advisor referrals, per
// docs/plan/uninsured-decade-calculator-and-talk-spec-2026-09-07.md PART A.
// GENDER-NEUTRAL throughout — this page is seen by advisors, spouses, mixed rooms.
// Single CTA: free MindSpan assessment, ?src= attribution passthrough.
// No product sold here. Soft gate: The Bill is free; the full breakdown unlocks after first name + email (POST /api/ud-calculator-report).
// Calculator inputs are never stored; PostHog events carry banded values only, never name/email.
import BaseLayout from '../../layouts/BaseLayout.astro';
import MedicalDisclaimer from '../../components/MedicalDisclaimer.astro';

const title = 'The Uninsured Decade — Cost of Cognitive Decline Calculator — My4MLife';
const description = 'Medicare pays $0 toward custodial care and private long-term-care insurance has largely priced itself out of reach. See what a decade of decline could cost in your state, and what you can do about your own risk.';
const canonical = 'https://www.my4mlife.com/go/uninsured-decade';
---
<BaseLayout title={title} description={description} canonical={canonical} robots="noindex,follow" hideChrome={true}>

<div class="ud">

  <header class="ud-top">
    <a class="ud-mark" href="/">My<b>4M</b>Life</a>
    <span class="ud-top-tag">The Uninsured Decade</span>
  </header>

  <!-- HERO -->
  <section class="ud-hero">
    <p class="ud-kicker">The Uninsured Decade</p>
    <h1>Medicare pays $0 toward custodial care.<br/>Here's what a decade of decline could actually cost — in your state.</h1>
    <p class="ud-punch">A policy can help fund this risk — that's a conversation for the advisor who sent you here. It can't lower the risk itself. That's what underwriting is: know the number, and know what's in your control.</p>
    <p class="ud-cta-sub">Answer six questions to see The Bill. Add your first name and email to unlock the full breakdown and get it as a PDF you can review with your advisor.</p>
  </section>

  <!-- FORM -->
  <section class="ud-block ud-form-block">
    <h2>Run your numbers</h2>
    <form id="ud-form" class="ud-form" autocomplete="off">
      <div class="ud-field">
        <label for="ud-age">Your age</label>
        <input type="number" id="ud-age" name="age" min="45" max="85" value="62" required />
      </div>

      <div class="ud-field">
        <label for="ud-spouse-age">Spouse / partner age <span class="ud-optional">(optional)</span></label>
        <input type="number" id="ud-spouse-age" name="spouseAge" min="45" max="85" value="60" />
        <label class="ud-checkbox">
          <input type="checkbox" id="ud-no-spouse" name="noSpouse" />
          I don't have a spouse/partner
        </label>
      </div>

      <div class="ud-field">
        <label for="ud-state">State</label>
        <select id="ud-state" name="state" required></select>
      </div>

      <div class="ud-field">
        <label for="ud-networth">Approximate net worth</label>
        <select id="ud-networth" name="netWorthBand" required>
          <option value="<250k">Under $250K</option>
          <option value="250k-500k">$250K – $500K</option>
          <option value="500k-1m" selected>$500K – $1M</option>
          <option value="1m-2.5m">$1M – $2.5M</option>
          <option value="2.5m-5m">$2.5M – $5M</option>
          <option value="5m+">$5M+</option>
        </select>
        <p class="ud-fine">A band only — we never ask for or show a raw figure.</p>
      </div>

      <div class="ud-field">
        <label for="ud-spend">Current monthly out-of-pocket health spend</label>
        <input type="number" id="ud-spend" name="monthlySpend" min="0" step="10" placeholder="$" value="400" />
        <p class="ud-fine">Supplements, gym, concierge care, etc. — used only to frame what you're already spending, not in the cost math below.</p>
      </div>

      <div class="ud-field">
        <label for="ud-exercise">Hours/week of exercise</label>
        <input type="number" id="ud-exercise" name="exerciseHours" min="0" max="40" step="0.5" value="3" />
      </div>

      <button type="submit" class="ud-cta ud-calc-btn">Calculate my numbers &rarr;</button>
    </form>
  </section>

  <!-- RESULTS -->
  <section class="ud-block ud-results" id="ud-results" hidden>
    <h2>Your numbers</h2>
    <div class="ud-big-numbers ud-bill-only">
      <div class="ud-big-card ud-big-bill">
        <p class="ud-big-tag">The Bill</p>
        <p class="ud-big-num" id="ud-bill">—</p>
        <p class="ud-big-sub">Illustrative 10-year staged care cost, adjusted to <span id="ud-state-name">your state</span>, in <span id="ud-onset-year">—</span> dollars</p>
        <p class="ud-why" id="ud-bill-why">—</p>
      </div>
    </div>

    <form id="ud-gate" class="ud-gate" autocomplete="off" novalidate>
      <h3>Unlock your full breakdown</h3>
      <p class="ud-gate-why">We'll email you a personalized PDF of the full ledger, so you have it to review with the professionals who help you plan.</p>
      <div class="ud-gate-fields">
        <div class="ud-field">
          <label for="ud-gate-first">First name</label>
          <input type="text" id="ud-gate-first" name="firstName" maxlength="40" autocomplete="given-name" required />
        </div>
        <div class="ud-field">
          <label for="ud-gate-email">Email</label>
          <input type="email" id="ud-gate-email" name="email" autocomplete="email" required />
        </div>
      </div>
      <div class="ud-field ud-gate-advisor-wrap">
        <label for="ud-gate-advisor">Send a copy to my financial advisor (optional)</label>
        <input type="email" id="ud-gate-advisor" name="advisorEmail" placeholder="Advisor's email" aria-label="Advisor's email" autocomplete="off" />
        <p class="ud-fine">We send the copy once, with you on it. We don't keep your advisor's email address.</p>
      </div>
      <label class="ud-checkbox ud-gate-optin-label">
        <input type="checkbox" id="ud-gate-optin" name="emailOptIn" />
        Email me occasional notes from Dr. TJ
      </label>
      <input type="text" name="hp" tabindex="-1" autocomplete="off" aria-hidden="true" class="ud-hp" />
      <p class="ud-gate-error" id="ud-gate-error" role="alert" hidden></p>
      <button type="submit" class="ud-cta" id="ud-gate-btn">Unlock and email my report</button>
      <p class="ud-fine ud-gate-fine">We use your first name and email to send this report. We don't store your age, state, net worth, or spending. Opting in is optional and you can unsubscribe any time. See our <a href="/privacy">Privacy</a> page.</p>
    </form>

    <div id="ud-locked" hidden>
    <p class="ud-gate-note" id="ud-send-note" hidden></p>
    <div class="ud-big-numbers ud-big-two">
      <div class="ud-big-card ud-big-premium">
        <p class="ud-big-tag">The Premium — new money</p>
        <p class="ud-big-num" id="ud-premium">—</p>
        <p class="ud-big-sub">What the basket costs beyond what you already spend, over 10 years — see below</p>
        <p class="ud-why" id="ud-premium-why">—</p>
      </div>
      <div class="ud-big-card ud-big-spenddown">
        <p class="ud-big-tag">Years Until Spend-Down</p>
        <p class="ud-big-num" id="ud-spenddown">—</p>
        <p class="ud-big-sub">At your net worth band, custodial care alone would take about this long to spend you down to Medicaid eligibility</p>
        <p class="ud-why" id="ud-spenddown-why">—</p>
      </div>
    </div>

    <!-- CHART -->
    <div class="ud-chart-wrap">
      <svg id="ud-chart" viewBox="0 0 320 220" preserveAspectRatio="xMidYMid meet" role="img" aria-labelledby="ud-chart-title">
        <title id="ud-chart-title">The Bill versus ten years of The Premium</title>
      </svg>
    </div>

    <!-- LEDGER -->
    <h3 class="ud-ledger-h">The ledger</h3>
    <div class="ud-table-wrap">
      <table class="ud-table">
        <thead>
          <tr><th>Line</th><th>10-year amount</th><th>Notes</th></tr>
        </thead>
        <tbody>
          <tr><td>Stage 1 — early-stage care</td><td id="ud-stage1">—</td><td>Mostly in-home support, illustrative</td></tr>
          <tr><td>Stage 2 — mid-stage care</td><td id="ud-stage2">—</td><td>Heavier in-home / adult-day support</td></tr>
          <tr><td>Stage 3 — late-stage custodial care</td><td id="ud-stage3">—</td><td>Memory care / nursing home, state-adjusted</td></tr>
          <tr class="ud-table-total"><td>The Bill (total)</td><td id="ud-bill-row">—</td><td>Sum of stages 1–3, in onset-year dollars</td></tr>
          <tr><td>The Premium — full basket (10 years)</td><td id="ud-premium-full-row">—</td><td>4M protocol basket, $675/mo ($81,000 over 10 yrs)</td></tr>
          <tr><td>Already spending (10 years)</td><td id="ud-already-spending-row">—</td><td>Your reported current monthly health spend × 120</td></tr>
          <tr class="ud-table-total"><td>New money (10 years)</td><td id="ud-new-money-row">—</td><td>The actual new spend the basket requires</td></tr>
          <tr><td>Hours to add per month</td><td id="ud-hours-row">—</td><td id="ud-hours-note">Target: 10 hrs/mo (~2.3 hrs/wk)</td></tr>
          <tr class="ud-table-assumption"><td>Expected savings, dementia-cost avoidance only <span class="ud-tag">assumption, not a guarantee</span></td><td id="ud-expected-row">—</td><td>Compared against the full basket — the honest premium</td></tr>
        </tbody>
      </table>
    </div>

    <!-- EXPECTED VALUE, STATED HONESTLY -->
    <div class="ud-honest">
      <h3>Expected value, stated honestly — for <span id="ud-honest-who">you</span></h3>
      <p>This is the part most calculators fudge. We won't. Nothing lowers your risk to zero, and nothing "prevents" dementia — the honest claim is that a sustained, structured lifestyle protocol can <em>lower the odds</em>. Here's what that's worth in dollars, using an assumption you control:</p>
      <p class="ud-honest-risk">Lifetime risk of any dementia after age 55 is <strong>42%</strong> (or, for a couple, about a <strong>66%</strong> chance at least one partner is affected) — per the largest long-running U.S. cohort study to date (Fang, Coresh et al., <em>Nature Medicine</em>, 13 Jan 2025, ARIC cohort).</p>
      <div class="ud-slider-row">
        <label for="ud-rrr">Assumed relative risk reduction: <strong id="ud-rrr-val">30%</strong></label>
        <input type="range" id="ud-rrr" min="0" max="50" step="1" value="30" list="ud-rrr-ticks" />
        <datalist id="ud-rrr-ticks">
          <option value="45" label="45%"></option>
        </datalist>
        <p class="ud-rrr-marker">45% = Lancet Commission 2024 ceiling if all 14 modifiable risk factors are addressed (a population figure, not a personal guarantee)</p>
        <p class="ud-fine">This is an assumption, not a guarantee — see disclaimer below.</p>
      </div>
      <p class="ud-honest-math" id="ud-honest-math">—</p>
      <p class="ud-honest-close"><strong>Read plainly: whichever way your number lands, dementia-cost avoidance is a single-disease bet, and this is never a single-disease decision.</strong> <span id="ud-honest-illustrative">A couple at the default 30% assumed risk reduction shows expected savings of roughly $80K against an $81K ten-year premium; at the 45% Lancet ceiling, roughly $120K.</span> The honest case for the spend is that the ledger really tips once the same modifiable factors' effect on diabetes, cardiovascular disease, and stroke — plus the wide right tail past the $405,262 average cost, plus quality-of-life and caregiver-hour value — are counted alongside dementia. None of that is captured in the math above. Insurance is a ruin-avoidance trade, not an ROI calculation — the same trade you already make on your house. You don't insure your house because you expect it to burn down; you insure it because you can't afford it if it does.</p>
      <p class="ud-honest-close"><strong>What the ledger can't count.</strong> The same premium that may lower the odds of the bill pays a dividend now, whether or not a claim ever comes: sleep, strength, energy, a retirement decade spent on your feet. That dividend is worth more than any number above, and it is the reason the people who do this keep doing it. What it protects was never really the money. Don't lose your identity and your dignity while you still have a choice.</p>
      <p class="ud-honest-close">A policy funds the risk; it can't lower it — that part is on you. Take this printout to the advisor who sent you here, and review your plan, policies, powers of attorney, and health-care directives with them — that step is necessary, not optional.</p>
      <p class="ud-honest-caveat">One more caveat: the 42% figure counts all dementia, including mild cases diagnosed late in life — so treat this as a range to reason with, not a promise about your own outcome.</p>
    </div>

    <!-- ACTIONS -->
    <div class="ud-actions">
      <a class="ud-cta" id="ud-cta-assessment" href="/assessment" onclick="window.posthog && posthog.capture('calc_cta_click', { src: window.__udSrc })">Get your free MindSpan assessment &rarr;</a>
      <button type="button" class="ud-cta ud-cta-ghost" id="ud-print-btn">Print this for your advisor</button>
    </div>
    <p class="ud-resend-wrap"><button type="button" class="ud-resend" id="ud-resend-btn">Email me the updated report</button></p>
    </div>
  </section>

  <!-- WHY THIS FRAME -->
  <section class="ud-block ud-context">
    <h2>Why underwrite it, not insure it</h2>
    <p class="ud-lead">Fewer than a dozen carriers still actively sell new standalone long-term-care policies, down from over a hundred two decades ago. The ones still selling have repriced aggressively — some policyholders have seen premium increases of 70–170% on policies they already owned. A policy still matters — it funds the risk — but for most families today it isn't the reliable backstop it used to be on its own.</p>
    <p class="ud-lead">What's still fully in your control is your own risk profile — sleep, gut health, hormones, and movement — the modifiable factors research links to lower odds of decline. That's the premium paid in hours, not dollars: roughly ten hours a month.</p>
  </section>

  <footer class="ud-foot">
    <MedicalDisclaimer />
    <p class="ud-fin-disclaimer">These figures are illustrative estimates based on published third-party cost-of-care data (Alzheimer's Association, CareScout/Genworth, USC Schaeffer Center) and a hypothetical relative-risk-reduction assumption. This is not financial, tax, insurance, or legal advice, and no protocol guarantees a reduction in your personal risk. Consult your own financial advisor and physician.</p>
    <p class="ud-legal"><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href="/">my4mlife.com</a> · We use cookies for site analytics.</p>
    <p class="ud-print-footer">my4mlife.com/go/uninsured-decade?src=advisor-print</p>
  </footer>

</div>

</BaseLayout>

<script>
  import {
    spendDownYears,
    spendDownYearsBand,
    tenYearPremium,
    expectedValue,
    ageBand,
    LIFETIME_DEMENTIA_RISK_COUPLE,
    type NetWorthBand,
  } from '../../lib/uninsured-decade-math';
  import { buildReport, money, type UdInputs, type UdReport } from '../../lib/uninsured-decade-report';
  import { COST_OF_CARE_BY_STATE } from '../../data/cost-of-care-by-state';

  // ── src attribution passthrough ──
  var params = new URLSearchParams(window.location.search);
  var src = params.get('src') || 'uninsured-decade';
  (window as any).__udSrc = src;

  var assessmentLink = document.getElementById('ud-cta-assessment') as HTMLAnchorElement;
  if (assessmentLink) assessmentLink.href = '/assessment?src=' + encodeURIComponent(src);

  // ── populate state select, Texas default ──
  var stateSelect = document.getElementById('ud-state') as HTMLSelectElement;
  COST_OF_CARE_BY_STATE.forEach(function (row) {
    var opt = document.createElement('option');
    opt.value = row.abbr;
    opt.textContent = row.state;
    if (row.abbr === 'TX') opt.selected = true;
    stateSelect.appendChild(opt);
  });

  // ── spouse toggle ──
  var noSpouseBox = document.getElementById('ud-no-spouse') as HTMLInputElement;
  var spouseAgeInput = document.getElementById('ud-spouse-age') as HTMLInputElement;
  noSpouseBox.addEventListener('change', function () {
    spouseAgeInput.disabled = noSpouseBox.checked;
  });

  // ── calc_start fires once, on first interaction ──
  var calcStarted = false;
  function fireCalcStart() {
    if (calcStarted) return;
    calcStarted = true;
    window.posthog && (window as any).posthog.capture('calc_start', { src: src });
  }
  var form = document.getElementById('ud-form') as HTMLFormElement;
  form.addEventListener('input', fireCalcStart, { once: true });

  // ── illustrative closing paragraph, derived from the basket (not the user's own inputs) ──
  (function () {
    var illustrativeEl = document.getElementById('ud-honest-illustrative');
    if (!illustrativeEl) return;
    var premium = tenYearPremium();
    var atDefault = expectedValue(405_262, 0.30, LIFETIME_DEMENTIA_RISK_COUPLE, premium);
    var atCeiling = expectedValue(405_262, 0.45, LIFETIME_DEMENTIA_RISK_COUPLE, premium);
    illustrativeEl.textContent =
      'A couple at the default 30% assumed risk reduction shows expected savings of roughly ' + money(atDefault.expectedSavings) +
      ' against a ' + money(premium) + ' ten-year premium; at the 45% Lancet ceiling, roughly ' + money(atCeiling.expectedSavings) + '.';
  })();

  // ── RRR slider ──
  var rrrInput = document.getElementById('ud-rrr') as HTMLInputElement;
  var rrrVal = document.getElementById('ud-rrr-val') as HTMLElement;
  var lastInputs: UdInputs | null = null;

  rrrInput.addEventListener('input', function () {
    rrrVal.textContent = rrrInput.value + '%';
    if (lastInputs) renderExpectedValue(buildReport({ ...lastInputs, rrrPct: Number(rrrInput.value) }));
  });

  function renderExpectedValue(r: UdReport) {
    var ev = r.ev;
    document.getElementById('ud-expected-row')!.textContent = money(ev.expectedSavings);
    var honestEl = document.getElementById('ud-honest-math')!;
    var cut = r.evVerdict.indexOf('. ') + 1;
    honestEl.innerHTML =
      'Unmitigated expected cost (probability-weighted): <strong>' + money(ev.unmitigatedExpectedCost) + '</strong>. ' +
      'With a ' + r.rrrPct + '% assumed risk reduction: <strong>' + money(ev.mitigatedExpectedCost) + '</strong>. ' +
      'Expected savings: <strong>' + money(ev.expectedSavings) + '</strong> against a ' + money(r.fullPremium) + ' ten-year premium — the full basket, the honest comparison. ' +
      '<strong>' + r.evVerdict.slice(0, cut) + '</strong>' + r.evVerdict.slice(cut);
    var whoEl = document.getElementById('ud-honest-who');
    if (whoEl) whoEl.textContent = r.isCouple ? 'the two of you' : 'you';
  }

  function svgBarChart(bill: number, premium: number): string {
    var max = Math.max(bill, premium) * 1.08;
    var chartH = 150;
    var billH = Math.round((bill / max) * chartH);
    var premH = Math.round((premium / max) * chartH);
    var baseY = 190;
    return (
      '<rect x="40" y="' + (baseY - billH) + '" width="80" height="' + billH + '" rx="4" fill="var(--ud-bill-color, #c0442e)" />' +
      '<text x="80" y="' + (baseY - billH - 8) + '" text-anchor="middle" font-size="13" font-weight="700" fill="#1f2d3d">' + money(bill) + '</text>' +
      '<text x="80" y="208" text-anchor="middle" font-size="11" fill="#3d4a5e">The Bill</text>' +
      '<rect x="200" y="' + (baseY - premH) + '" width="80" height="' + premH + '" rx="4" fill="var(--ud-premium-color, #d4af5a)" />' +
      '<text x="240" y="' + (baseY - premH - 8) + '" text-anchor="middle" font-size="13" font-weight="700" fill="#1f2d3d">' + money(premium) + '</text>' +
      '<text x="240" y="208" text-anchor="middle" font-size="11" fill="#3d4a5e">Full basket × 10 yrs</text>' +
      '<line x1="20" y1="' + baseY + '" x2="300" y2="' + baseY + '" stroke="#c9c2ab" stroke-width="1" />'
    );
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    fireCalcStart();

    var age = Number((document.getElementById('ud-age') as HTMLInputElement).value) || 62;
    var stateAbbr = stateSelect.value || 'TX';
    var stateRow = COST_OF_CARE_BY_STATE.find(function (r) { return r.abbr === stateAbbr; });
    var netWorthBand = (document.getElementById('ud-networth') as HTMLSelectElement).value as NetWorthBand;
    var isCouple = !noSpouseBox.checked && spouseAgeInput.value !== '';
    var spouseAge = isCouple ? Number(spouseAgeInput.value) : undefined;
    var monthlySpend = Number((document.getElementById('ud-spend') as HTMLInputElement).value) || 0;
    var exerciseHours = Number((document.getElementById('ud-exercise') as HTMLInputElement).value) || 0;

    lastInputs = {
      age: age, spouseAge: spouseAge, stateAbbr: stateAbbr, netWorthBand: netWorthBand,
      monthlySpend: monthlySpend, exerciseHours: exerciseHours, rrrPct: Number(rrrInput.value),
    };
    var r = buildReport(lastInputs);
    var costs = r.stages;
    var bill = r.bill;
    var ledger = r.ledger;

    document.getElementById('ud-bill')!.textContent = money(bill);
    document.getElementById('ud-state-name')!.textContent = r.stateName;
    document.getElementById('ud-onset-year')!.textContent = String(r.onsetYear);
    document.getElementById('ud-premium')!.textContent = money(ledger.newMoneyTenYear);
    document.getElementById('ud-spenddown')!.textContent = r.spendDownDisplay;

    document.getElementById('ud-bill-why')!.textContent = r.billWhy;
    document.getElementById('ud-premium-why')!.textContent = r.premiumWhy;
    document.getElementById('ud-spenddown-why')!.textContent = r.spendDownWhy;

    document.getElementById('ud-stage1')!.textContent = money(costs.stage1);
    document.getElementById('ud-stage2')!.textContent = money(costs.stage2);
    document.getElementById('ud-stage3')!.textContent = money(costs.stage3);
    document.getElementById('ud-bill-row')!.textContent = money(bill);
    document.getElementById('ud-premium-full-row')!.textContent = money(ledger.fullBasketTenYear);
    document.getElementById('ud-already-spending-row')!.textContent = money(ledger.alreadySpendingTenYear);
    document.getElementById('ud-new-money-row')!.textContent = money(ledger.newMoneyTenYear);
    document.getElementById('ud-hours-row')!.textContent = r.atTarget ? '0' : r.hoursToAdd.toFixed(1);
    document.getElementById('ud-hours-note')!.textContent = r.hoursNote;

    document.getElementById('ud-chart')!.innerHTML = svgBarChart(bill, r.fullPremium);

    renderExpectedValue(r);

    var resultsSection = document.getElementById('ud-results') as HTMLElement;
    resultsSection.hidden = false;
    if (unlocked) { setUnlocked(null); } else { markGateShown(); }
    resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });

    window.posthog && (window as any).posthog.capture('calc_complete', {
      src: src,
      state: stateAbbr,
      netWorthBand: netWorthBand,
      ageBand: ageBand(age),
      spendDownYearsBand: spendDownYearsBand(spendDownYears(netWorthBand, stateAbbr, r.onsetDrivingAge)),
    });
  });

  // ── soft gate ──
  var API_BASE: string =
    (import.meta as any).env?.PUBLIC_LEAD_CAPTURE_API_URL ??
    'https://v9svm8ds74.execute-api.us-east-2.amazonaws.com';
  var SS_KEY = 'ud-calc-unlock';
  var gateForm = document.getElementById('ud-gate') as HTMLFormElement;
  var lockedEl = document.getElementById('ud-locked') as HTMLElement;
  var gateErr = document.getElementById('ud-gate-error') as HTMLElement;
  var gateBtn = document.getElementById('ud-gate-btn') as HTMLButtonElement;
  var sendNote = document.getElementById('ud-send-note') as HTMLElement;
  var resendBtn = document.getElementById('ud-resend-btn') as HTMLButtonElement;
  var firstInput = document.getElementById('ud-gate-first') as HTMLInputElement;
  var emailInput = document.getElementById('ud-gate-email') as HTMLInputElement;
  var advisorInput = document.getElementById('ud-gate-advisor') as HTMLInputElement;
  var optinInput = document.getElementById('ud-gate-optin') as HTMLInputElement;
  var hpInput = gateForm.querySelector('input[name="hp"]') as HTMLInputElement;
  var EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
  var ERR_LINE = 'Please check your first name and email, then try again.';
  var FALLBACK_LINE = 'We couldn\u2019t email your report just now. Your full breakdown is unlocked below. Use "Print this for your advisor" to save it as a PDF.';
  var unlocked = false;
  var gateShownAt = 0;
  var gateViewed = false;
  var identity: { firstName: string; email: string } | null = null;

  function ph(ev: string, props: Record<string, unknown>) { (window as any).posthog && (window as any).posthog.capture(ev, props); }
  function markGateShown() {
    if (!gateShownAt) gateShownAt = Date.now();
    if (!gateViewed) { gateViewed = true; ph('calc_gate_view', { src: src }); }
  }
  gateForm.addEventListener('focusin', function () { if (!gateShownAt) gateShownAt = Date.now(); });

  function setUnlocked(note: string | null) {
    unlocked = true;
    lockedEl.hidden = false;
    gateForm.hidden = true;
    resendBtn.hidden = false;
    sendNote.textContent = note || '';
    sendNote.hidden = !note;
  }

  function payload(first: string, email: string, advisor: string, optIn: boolean) {
    var i = lastInputs!;
    var body: Record<string, unknown> = {
      age: i.age, stateAbbr: i.stateAbbr, netWorthBand: i.netWorthBand,
      monthlySpend: i.monthlySpend, exerciseHours: i.exerciseHours, rrrPct: Number(rrrInput.value),
      firstName: first, email: email, emailOptIn: optIn, consentVersion: 'ud-calc-v1',
      src: src, hp: hpInput.value, t: gateShownAt ? Date.now() - gateShownAt : 0,
    };
    if (i.spouseAge !== undefined) body.spouseAge = i.spouseAge;
    if (advisor) body.advisorEmail = advisor;
    return body;
  }

  // Returns HTTP status, or 0 on network error.
  async function send(body: Record<string, unknown>): Promise<number> {
    try {
      var res = await fetch(API_BASE + '/api/ud-calculator-report', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
      });
      return res.status;
    } catch (_) { return 0; }
  }

  gateForm.addEventListener('submit', async function (e) {
    e.preventDefault();
    if (!lastInputs) return;
    var first = firstInput.value.trim(), email = emailInput.value.trim(), advisor = advisorInput.value.trim();
    gateErr.hidden = true;
    if (!first || !EMAIL_RE.test(email) || (advisor && !EMAIL_RE.test(advisor))) {
      gateErr.textContent = ERR_LINE; gateErr.hidden = false; return;
    }
    if (!gateShownAt) gateShownAt = Date.now();
    gateBtn.disabled = true;
    var optIn = optinInput.checked;
    var status = await send(payload(first, email, advisor, optIn));
    gateBtn.disabled = false;
    if (status === 400) { gateErr.textContent = ERR_LINE; gateErr.hidden = false; return; }
    identity = { firstName: first, email: email };
    try { sessionStorage.setItem(SS_KEY, JSON.stringify(identity)); } catch (_) { /* storage unavailable */ }
    ph('calc_unlock', { src: src, advisor: !!advisor, optIn: !!optIn });
    setUnlocked(status === 200 ? null : FALLBACK_LINE);
  });

  resendBtn.addEventListener('click', async function () {
    if (!identity || !lastInputs) return;
    resendBtn.disabled = true;
    var status = await send(payload(identity.firstName, identity.email, '', false));
    resendBtn.disabled = false;
    sendNote.textContent = status === 200 ? 'Sent. Check your inbox for the updated report.' : FALLBACK_LINE;
    sendNote.hidden = false;
  });

  // Recalculating within the session keeps the page unlocked.
  try {
    var saved = sessionStorage.getItem(SS_KEY);
    if (saved) {
      var parsed = JSON.parse(saved);
      if (parsed && parsed.firstName && parsed.email) {
        identity = { firstName: String(parsed.firstName), email: String(parsed.email) };
        firstInput.value = identity.firstName; emailInput.value = identity.email;
        gateForm.hidden = true; // gate stays out of the way; locked content shows after first calculate
        unlocked = true;
      }
    }
  } catch (_) { /* ignore */ }
  resendBtn.hidden = true;
  if (unlocked) { lockedEl.hidden = true; }

  // ── print for advisor ──
  var printBtn = document.getElementById('ud-print-btn');
  if (printBtn) {
    printBtn.addEventListener('click', function () {
      window.print();
    });
  }
</script>

