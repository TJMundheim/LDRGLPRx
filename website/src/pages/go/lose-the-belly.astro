---
// LANDING PAGE — "Lose the belly. Keep your mind." Mass-market front door (2026-10-31).
// Clones the /go/gut-repair template: standalone (hideChrome), ONE CTA repeated, PostHog-tagged.
// Intent: docs/plan/mass-market-full-court-press-2026-10-31.md (sections 2-4, 7).
// Indexable on purpose (organic is wanted): no noindex, unlike the paid-only LPs.
// CTA = free 10-minute care-coordinator call, which works today in coordinator mode.
import BaseLayout from '../../layouts/BaseLayout.astro';
import MedicalDisclaimer from '../../components/MedicalDisclaimer.astro';
import { consultHref } from '../../lib/siteMode';

// consult.astro reads ?lane=weight-loss and pre-checks "GLP-1 weight loss".
// Always the free coordinator intake (the one CTA), regardless of COORDINATOR_MODE.
const ctaHref = `${consultHref('weight-loss')}&utm_source=lp&utm_campaign=lose-the-belly`;
const CTA_LABEL = 'Book my free 10-minute call';

const title = 'Lose the Belly. Keep Your Mind. — My4MLife';
const description = 'The belly fat you cannot lose is also the inflammation your brain pays for. Book a free 10-minute call; a licensed physician in our network can see if a GLP-1 is right for you. Results vary.';
const canonical = 'https://www.my4mlife.com/go/lose-the-belly';
---
<BaseLayout title={title} description={description} canonical={canonical} robots="index, follow" hideChrome={true}>

<div class="lp">

  <header class="lp-top">
    <a class="lp-mark" href="/">My<b>4M</b>Life</a>
    <span class="lp-top-tag">The first brain-healthspan platform</span>
  </header>

  <!-- HERO -->
  <section class="lp-hero">
    <p class="lp-kicker">Weight loss · built to last</p>
    <h1>Lose the belly.<br/>Keep your mind.</h1>
    <p class="lp-punch">The belly fat you can't lose is also the inflammation your brain pays for. A licensed physician in our network can see if a GLP-1 is right for you. The plan works with or without one.</p>
    <a class="lp-cta" href={ctaHref} onclick="window.posthog && posthog.capture('lp_belly_cta_hero')">{CTA_LABEL} &rarr;</a>
    <p class="lp-cta-sub">Free call. No card. No obligation.</p>
  </section>

  <!-- OUTCOME TILES -->
  <section class="lp-block">
    <h2>What people often report</h2>
    <div class="lp-tiles">
      <div class="lp-tile"><h3>Drop a pant size</h3><p>People often report their waistline moves first, before the scale does.</p></div>
      <div class="lp-tile"><h3>Afternoon energy back</h3><p>People often report fewer 3 p.m. crashes once blood sugar settles.</p></div>
      <div class="lp-tile"><h3>Sharper at work</h3><p>People often report clearer thinking and fewer blank moments.</p></div>
    </div>
    <p class="lp-fine lp-fine-center">Results vary. These are common reports, not promises.</p>
  </section>

  <!-- WHAT IT COSTS -->
  <section class="lp-block">
    <div class="lp-paths lp-paths-single">
      <div class="lp-path-card lp-path-primary">
        <p class="lp-path-tag">What it costs</p>
        <h3>The visit and the plan start free.</h3>
        <p>The call is free. The physician review and your plan start free.</p>
        <p>If your physician prescribes a GLP-1, brand-name medication is sold directly by the manufacturers at cash prices that start around $149 a month for the starting-dose pill. Prices vary by drug and dose. Prices verified October 2026.</p>
        <p>No insurance needed. If you are not prescribed medication, you pay nothing for it.</p>
        <a class="lp-cta" href={ctaHref} onclick="window.posthog && posthog.capture('lp_belly_cta_cost')">{CTA_LABEL} &rarr;</a>
      </div>
    </div>
  </section>

  <!-- WHY THIS PROTECTS YOUR BRAIN -->
  <section class="lp-block lp-block-navy">
    <h2>Why this protects your brain</h2>
    <p class="lp-mech-close">Belly fat is not just storage. Visceral fat, the kind packed around your organs, runs like a gland and sends out inflammation all day. That inflammation pushes blood sugar up, and high blood sugar over the years raises the risk of cognitive decline. Lose the belly and you take pressure off the organ that makes you you.</p>
  </section>

  <!-- HOW IT WORKS -->
  <section class="lp-block">
    <h2>How it works</h2>
    <ol class="lp-steps">
      <li><span class="lp-step-n">1</span><div><strong>A free 10-minute call.</strong> A care coordinator learns your goals and your history. No cost, no card.</div></li>
      <li><span class="lp-step-n">2</span><div><strong>A physician reviews.</strong> A licensed physician in our network looks at your case and decides what is right for you.</div></li>
      <li><span class="lp-step-n">3</span><div><strong>You get your plan.</strong> Medication if your physician prescribes it, plus the Count Yourself Skinny method: count chews, fasting hours and steps instead of calories.</div></li>
    </ol>
  </section>

  <!-- FAQ -->
  <section class="lp-block">
    <h2>Questions people ask</h2>
    <div class="lp-faq">
      <details><summary>Do I have to take a shot?</summary><p>No. GLP-1 medications come as pills and as shots. Your physician decides which, if any, is right for you.</p></details>
      <details><summary>Is it safe?</summary><p>GLP-1 medications are prescription drugs with real side effects and are not right for everyone. A licensed physician in our network reviews your history before anything is prescribed, and prescribes only if appropriate.</p></details>
      <details><summary>Do I need insurance?</summary><p>No. Manufacturers sell brand-name medication directly at cash prices, so you do not need insurance to start. Prices vary by drug and dose.</p></details>
      <details><summary>What if I'm not a candidate?</summary><p>The plan still works without medication. The Count Yourself Skinny method, your app and the weekly Zoom are built to work on their own. Results vary.</p></details>
    </div>
  </section>

  <!-- CLOSE -->
  <section class="lp-block lp-close">
    <h2>Lose the belly. Keep your mind.</h2>
    <p class="lp-lead">Ten minutes. Free. A real physician in the loop. <em>Begin with the end in mind.</em></p>
    <a class="lp-cta" href={ctaHref} onclick="window.posthog && posthog.capture('lp_belly_cta_close')">{CTA_LABEL} &rarr;</a>
  </section>

  <footer class="lp-foot">
    <p class="lp-tagline">Don't lose your identity and your dignity while you still have a choice.</p>
    <p class="lp-fine lp-fine-center">Prescription medication is available only if your physician prescribes it. Results vary.</p>
    <MedicalDisclaimer />
    <p class="lp-legal"><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href="/">my4mlife.com</a> · We use cookies for site analytics.</p>
  </footer>

</div>

</BaseLayout>

<style>
.lp { font-family: 'Inter', sans-serif; color: #1f2d3d; background: #fdfcf9; }
.lp h1, .lp h2, .lp h3 { font-family: 'Playfair Display', serif; }

.lp-top { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: 1.1rem 1.4rem; border-bottom: 1px solid #e8e2d4; flex-wrap: wrap; }
.lp-mark { font-family: 'Playfair Display', serif; font-weight: 700; font-size: 1.15rem; color: #0a1f44; text-decoration: none; }
.lp-mark b { color: #b9922e; }
.lp-top-tag { font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: #8a8468; overflow-wrap: break-word; }

.lp-hero { background: linear-gradient(150deg, #0a1628 0%, #0a1f44 70%); color: #f2eee3; text-align: center; padding: 4.5rem 1.4rem 4rem; }
.lp-kicker { font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: #d4af5a; margin: 0 0 1.1rem; }
.lp-hero h1 { font-size: clamp(1.7rem, 4.4vw, 2.9rem); line-height: 1.2; margin: 0 auto 1.2rem; max-width: 820px; text-wrap: balance; color: #f2eee3; text-shadow: 0 2px 12px rgba(0,0,0,0.4); }
.lp-punch { font-size: clamp(1rem, 1.8vw, 1.2rem); color: #c9d2e4; max-width: 620px; margin: 0 auto 1.8rem; line-height: 1.6; }
.lp-punch em { color: #e3c98b; font-style: italic; }

.lp-cta { display: inline-block; background: #d4af5a; color: #0a1428; font-weight: 700; font-size: 1.02rem; padding: 1rem 2.1rem; border-radius: 999px; text-decoration: none; transition: background 0.15s; }
.lp-cta:hover { background: #e3c98b; }
.lp-cta-ghost { background: transparent; border: 2px solid #0a1f44; color: #0a1f44; }
.lp-cta-ghost:hover { background: rgba(10,31,68,0.06); }
.lp-cta-sub { font-size: 0.82rem; color: #9fb0cc; max-width: 520px; margin: 1rem auto 0; line-height: 1.55; }

.lp-block { max-width: 860px; margin: 0 auto; padding: 3.5rem 1.4rem; }
.lp-block h2 { font-size: clamp(1.4rem, 3vw, 2rem); color: #0a1f44; margin: 0 0 1rem; text-wrap: balance; }
.lp-lead { font-size: 1.05rem; line-height: 1.65; color: #3d4a5e; max-width: 68ch; }

.lp-stop { list-style: none; padding: 0; margin: 1.4rem 0 0; display: flex; flex-direction: column; gap: 0.9rem; }
.lp-stop li { padding: 1rem 1.2rem; background: #fff; border: 1px solid #e8e2d4; border-left: 3px solid #c0442e; border-radius: 8px; font-size: 0.98rem; line-height: 1.55; }
.lp-stop strong { color: #0a1f44; }

.lp-block-navy { max-width: none; background: #0a1f44; color: #e8ecf5; }
.lp-block-navy > * { max-width: 860px; margin-left: auto; margin-right: auto; }
.lp-block-navy h2 { color: #f2eee3; }
.lp-mech { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; margin: 1.8rem auto; }
.lp-mech-item { background: rgba(255,255,255,0.05); border: 1px solid rgba(212,175,90,0.35); border-radius: 12px; padding: 1.3rem 1.2rem; }
.lp-mech-n { font-family: 'Playfair Display', serif; font-size: 1.9rem; font-weight: 700; color: #d4af5a; display: block; margin-bottom: 0.5rem; font-variant-numeric: tabular-nums; }
.lp-mech-item p { font-size: 0.9rem; line-height: 1.55; color: #c9d2e4; margin: 0; }
.lp-mech-close { font-size: 1rem; line-height: 1.65; color: #c9d2e4; }
@media (max-width: 680px) { .lp-mech { grid-template-columns: 1fr; } }

.lp-buy { padding-top: 2.2rem; padding-bottom: 1rem; }
.lp-buy .lp-paths { margin-top: 0; }
.lp-buy-btns { display: flex; gap: 0.7rem; flex-wrap: wrap; }
button.lp-cta { border: none; cursor: pointer; font-family: 'Inter', sans-serif; }
button.lp-cta.lp-cta-ghost { border: 2px solid #0a1f44; }
button.lp-cta:disabled { opacity: 0.6; cursor: default; }
.lp-paths-single { grid-template-columns: 1fr; max-width: 560px; margin-left: auto; margin-right: auto; }
.lp-paths { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin-top: 1.6rem; }
@media (max-width: 720px) { .lp-paths { grid-template-columns: 1fr; } }
.lp-path-card { background: #fff; border: 1px solid #e8e2d4; border-radius: 14px; padding: 1.7rem 1.5rem; display: flex; flex-direction: column; gap: 0.8rem; align-items: flex-start; }
.lp-path-primary { border: 2px solid #d4af5a; box-shadow: 0 10px 30px rgba(10,31,68,0.08); }
.lp-path-tag { font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: #b9922e; font-weight: 700; margin: 0; }
.lp-path-card h3 { font-size: 1.25rem; color: #0a1f44; margin: 0; }
.lp-path-card p { font-size: 0.95rem; line-height: 1.6; color: #3d4a5e; margin: 0; }
.lp-fine { font-size: 0.76rem; color: #8a93a5; }
.lp-bonus { font-size: 0.86rem; color: #d4af5a; margin: 10px 0 6px; line-height: 1.45; }
.lp-bonus strong { color: #e3c98b; }

.lp-close { text-align: center; }
.lp-close .lp-lead { margin: 0 auto 1.8rem; }
.lp-close em { color: #b9922e; }

.lp-foot { border-top: 1px solid #e8e2d4; padding: 2rem 1.4rem 2.5rem; text-align: center; }
.lp-ns { font-size: 0.72rem; color: #8a8468; font-style: italic; margin: 0 0 1rem; }
.lp-legal { font-size: 0.78rem; color: #8a93a5; margin-top: 1rem; }
.lp-legal a { color: #8a93a5; }

.lp-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; margin: 1.6rem 0 1rem; }
@media (max-width: 680px) { .lp-tiles { grid-template-columns: 1fr; } }
.lp-tile { background: #fff; border: 1px solid #e8e2d4; border-top: 3px solid #d4af5a; border-radius: 12px; padding: 1.4rem 1.2rem; }
.lp-tile h3 { font-size: 1.2rem; color: #0a1f44; margin: 0 0 0.5rem; }
.lp-tile p { font-size: 0.93rem; line-height: 1.55; color: #3d4a5e; margin: 0; }
.lp-fine-center { text-align: center; }
.lp-steps { list-style: none; padding: 0; margin: 1.4rem 0 0; display: flex; flex-direction: column; gap: 1rem; }
.lp-steps li { display: flex; gap: 1rem; align-items: flex-start; padding: 1rem 1.2rem; background: #fff; border: 1px solid #e8e2d4; border-radius: 10px; font-size: 0.98rem; line-height: 1.55; color: #3d4a5e; }
.lp-steps strong { color: #0a1f44; }
.lp-step-n { flex: 0 0 auto; width: 2rem; height: 2rem; border-radius: 50%; background: #0a1f44; color: #d4af5a; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; font-family: 'Playfair Display', serif; }
.lp-faq { display: flex; flex-direction: column; gap: 0.7rem; margin-top: 1.2rem; }
.lp-faq details { background: #fff; border: 1px solid #e8e2d4; border-radius: 10px; padding: 0.9rem 1.2rem; }
.lp-faq summary { cursor: pointer; font-weight: 600; color: #0a1f44; }
.lp-faq p { margin: 0.7rem 0 0; font-size: 0.95rem; line-height: 1.6; color: #3d4a5e; }
.lp-tagline { font-size: 0.85rem; color: #8a8468; font-style: italic; margin: 0 0 1rem; }
</style>
