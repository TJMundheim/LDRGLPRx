---
// DRAFT. Do not link until the app is live. noindex on purpose.
// Landing page for Count Yourself Skinny (book + iPhone app). Standalone (hideChrome), ONE CTA.
// PostHog comes from BaseLayout (posthog.capture used on the CTA, as on the other /go/ pages).
//
// TODO (CTA): the email capture below is wired (source "cys-landing", Contact upsert via
// /api/lead-capture, email only, no PHI) but is switched OFF with CTA_LIVE = false. Reason: no free
// chapter exists, and nothing delivers "the six counts by email" (the lead-capture Lambda only
// stores the Contact; it sends no email). Flip CTA_LIVE to true only after ONE of these is real:
//   a) a free first-chapter file is published and an email sends the link, then use LABEL_CHAPTER; or
//   b) an automated welcome email carrying the six counts is sent for source "cys-landing",
//      then use LABEL_COUNTS. Also add the live App Store button once the app is approved.
import BaseLayout from '../../layouts/BaseLayout.astro';
import MedicalDisclaimer from '../../components/MedicalDisclaimer.astro';

const CTA_LIVE = false;
const LABEL_CHAPTER = 'Get the first chapter';
const LABEL_COUNTS = 'Start counting today: the six counts by email';
const CTA_LABEL = LABEL_COUNTS;

const title = 'Count Yourself Skinny | My4MLife';
const description = "You'll never count a calorie. You'll count to 32 instead. A book and an iPhone app from Dr. TJ.";
const canonical = 'https://www.my4mlife.com/go/count-yourself-skinny';

const counts = [
  { n: '32', t: 'Chews', d: 'Every bite. Fork down.' },
  { n: 'HRS', t: 'Hours', d: 'The space between meals.' },
  { n: 'STEPS', t: 'Steps', d: 'The friendliest curve in health.' },
  { n: '10', t: 'Minutes', d: 'Of morning light.' },
  { n: 'ZZZ', t: 'Nights', d: 'Where the skinny is made.' },
  { n: 'H2O', t: 'Before noon', d: 'Water first.' },
];
---
<BaseLayout title={title} description={description} canonical={canonical} robots="noindex,nofollow" hideChrome={true}>

<div class="cys">

  <header class="cys-top"><span class="cys-mark">COUNT YOURSELF SKINNY</span></header>

  <section class="cys-hero">
    <p class="cys-kicker">A book and an iPhone app</p>
    <h1>COUNT TO 32.<br/>NOT CALORIES.</h1>
    <p class="cys-promise">You'll never count a calorie. You'll count to 32 instead.</p>
    <p class="cys-jab">The diet industry got fat. This book got skinny.</p>
  </section>

  <section class="cys-block">
    <h2>SIX COUNTS. THAT'S IT.</h2>
    <ul class="cys-counts">
      {counts.map((c) => (
        <li><span class="cys-n">{c.n}</span><strong>{c.t}</strong><span>{c.d}</span></li>
      ))}
    </ul>
    <p class="cys-note">No food scale. No forbidden list. No math at the table.</p>
  </section>

  <section class="cys-block cys-alt">
    <h2>YOUR AIRPODS DO THE COUNTING.</h2>
    <p>Put in your AirPods and eat. The app listens to your head motion, not your voice, and counts each chew up to 32. Fork down, 32, next bite. The motion data is processed on your phone and never leaves it.</p>
    <p>Works with AirPods Pro, AirPods (3rd generation) or later, and AirPods Max. No AirPods? The Bite Pacer is free and counts to 32 with a buzz.</p>
  </section>

  <section class="cys-block">
    <h2>THE BOOK.</h2>
    <p>Thirteen short chapters from Dr. TJ on why easy numbers beat invisible ones, and how to count the few that matter. Eating out, the grocery cart, and a one-walk, five-box morning are all in there.</p>
  </section>

  {CTA_LIVE ? (
    <section class="cys-block cys-cta" id="get">
      <h2>{CTA_LABEL.toUpperCase()}</h2>
      <form id="cys-form" novalidate>
        <label class="cys-sr" for="cys-email">Email</label>
        <input id="cys-email" type="email" inputmode="email" autocomplete="email" placeholder="you@email.com" required />
        <button type="submit">{CTA_LABEL}</button>
      </form>
      <p class="cys-done" id="cys-done" hidden>Thank you. You're on the list.</p>
      <p class="cys-fine">By entering your email you agree to get updates and offers from My4MLife. Unsubscribe anytime. <a href="/privacy">Privacy</a></p>
    </section>
  ) : null}

  <footer class="cys-foot">
    <p class="cys-tag">Don't lose your identity and your dignity while you still have a choice.</p>
    <p class="cys-fine">Count Yourself Skinny is an educational tool, not medical advice. Talk to your physician before changing how you eat or fast.</p>
    <MedicalDisclaimer />
    <p class="cys-fine"><a href="/legal/count-yourself-skinny-privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href="/">my4mlife.com</a></p>
  </footer>

</div>

</BaseLayout>

{CTA_LIVE ? (
  <script>
    import { submitLead, setFormError, attachHoneypot, LEAD_CAPTURE_ERROR } from '../../scripts/lead-capture';
    const form = document.getElementById('cys-form') as HTMLFormElement | null;
    if (form) {
      attachHoneypot(form);
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const input = document.getElementById('cys-email') as HTMLInputElement;
        const button = form.querySelector('button') as HTMLButtonElement;
        const email = input.value.trim();
        if (!email) return;
        button.disabled = true;
        setFormError(form, null);
        const ok = await submitLead(email, 'cys-landing', form);
        button.disabled = false;
        if (!ok) { setFormError(form, LEAD_CAPTURE_ERROR); return; }
        (window as any).posthog?.capture('cys_lp_email_captured');
        form.hidden = true;
        document.getElementById('cys-done')!.hidden = false;
      });
    }
  </script>
) : null}

<style>
.cys { font-family: 'Inter', system-ui, sans-serif; background: #E8352B; color: #fff; overflow-x: hidden; }
.cys h1, .cys h2, .cys-mark, .cys-n { font-family: 'Impact', 'Haettenschweiler', 'Arial Narrow Bold', 'Arial Black', sans-serif; font-weight: 900; text-transform: uppercase; letter-spacing: 0.01em; }
.cys-top { padding: 0.9rem 1rem; background: #fff; }
.cys-mark { color: #E8352B; font-size: 1.15rem; }
.cys-hero { padding: 2.5rem 1rem 2.5rem; text-align: center; }
.cys-kicker { display: inline-block; background: #FFD400; color: #111; font-weight: 800; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; padding: 0.3rem 0.7rem; margin: 0 0 1.2rem; }
.cys-hero h1 { font-size: clamp(2.6rem, 14vw, 5.5rem); line-height: 0.95; margin: 0 0 1.2rem; color: #fff; text-shadow: 3px 3px 0 rgba(0,0,0,0.25); }
.cys-promise { font-size: clamp(1.15rem, 5vw, 1.6rem); font-weight: 800; max-width: 30ch; margin: 0 auto 1rem; line-height: 1.3; }
.cys-jab { display: inline-block; background: #FFD400; color: #111; font-weight: 800; padding: 0.6rem 0.9rem; margin: 0; transform: rotate(-1deg); max-width: 100%; }
.cys-block { max-width: 820px; margin: 0 auto; padding: 2.5rem 1rem; }
.cys-block h2 { font-size: clamp(1.8rem, 8vw, 2.8rem); line-height: 1; margin: 0 0 1.2rem; color: #FFD400; }
.cys-block p { font-size: 1.02rem; line-height: 1.6; margin: 0 0 1rem; }
.cys-alt { max-width: none; background: #fff; color: #111; }
.cys-alt > * { max-width: 780px; margin-left: auto; margin-right: auto; }
.cys-alt h2 { color: #E8352B; }
.cys-counts { list-style: none; padding: 0; margin: 0 0 1rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
.cys-counts li { background: #fff; color: #111; border: 3px solid #111; padding: 0.7rem 0.6rem; display: flex; flex-direction: column; gap: 0.15rem; font-size: 0.85rem; line-height: 1.3; }
.cys-counts strong { text-transform: uppercase; font-size: 0.9rem; }
.cys-n { color: #E8352B; font-size: 2.2rem; line-height: 1; }
.cys-note { font-weight: 800; text-align: center; }
.cys-cta { text-align: center; background: #FFD400; max-width: none; color: #111; }
.cys-cta h2 { color: #E8352B; }
#cys-form { display: flex; flex-direction: column; gap: 0.7rem; max-width: 420px; margin: 0 auto; }
#cys-form input { font-size: 1rem; padding: 0.9rem; border: 3px solid #111; border-radius: 0; }
#cys-form button { background: #E8352B; color: #fff; font-weight: 900; font-size: 1.05rem; text-transform: uppercase; padding: 1rem; border: 3px solid #111; cursor: pointer; }
#cys-form button:disabled { opacity: 0.6; }
.cys-done { font-weight: 800; }
.cys-sr { position: absolute; left: -9999px; }
.cys-foot { background: #111; color: #ccc; padding: 2rem 1rem; text-align: center; }
.cys-tag { font-style: italic; color: #FFD400; }
.cys-fine { font-size: 0.78rem; line-height: 1.5; color: inherit; opacity: 0.85; }
.cys-fine a, .cys-foot a { color: inherit; }
</style>
