---
// DRAFT, unpublished (leading underscore = not routed). Landing page for readers of the book
// who type the printed address. One CTA: email (+ optional name) -> free printable Count Log.
// Posts to the existing /api/lead-capture endpoint via the shared lead-capture helpers.
// The PDF is NOT in public/ yet; it is added only after the owner approves this page.
import BaseLayout from '../../layouts/BaseLayout.astro';
import MedicalDisclaimer from '../../components/MedicalDisclaimer.astro';

const title = 'Your Free Count Log, Week 13 On | Count Yourself Skinny';
const description = 'A free printable Count Log for Week 13 onward, for readers of Count Yourself Skinny.';
const canonical = 'https://www.my4mlife.com/go/count-yourself-skinny';
---
<BaseLayout title={title} description={description} canonical={canonical} robots="noindex,nofollow" hideChrome={true}>

<div class="cys">
  <header class="cys-top"><span class="cys-mark">COUNT YOURSELF SKINNY</span></header>

  <section class="cys-hero">
    <h1>You'll never count a calorie. You'll count to 32 instead.</h1>
    <p class="cys-lead">Leave your email and get the free printable Count Log for Week 13 onward, so your counting keeps going after the book's first twelve weeks.</p>

    <form id="cys-form" novalidate>
      <label class="cys-sr" for="cys-name">First name (optional)</label>
      <input id="cys-name" type="text" autocomplete="given-name" placeholder="First name (optional)" maxlength="80" />
      <label class="cys-sr" for="cys-email">Email</label>
      <input id="cys-email" type="email" inputmode="email" autocomplete="email" placeholder="you@email.com" required />
      <button type="submit">Send me the Count Log</button>
      <p class="cys-fine">By entering your email you agree to get updates and offers from My4MLife. Unsubscribe anytime. <a href="/privacy">Privacy</a></p>
    </form>

    <div class="cys-done" id="cys-done" hidden>
      <p>Thank you. Your Count Log is ready.</p>
      <a class="cys-dl" href="/downloads/count-log-week-13-on.pdf" download onclick="window.posthog && posthog.capture('cys_book_log_download')">Download the Count Log (PDF)</a>
    </div>
  </section>

  <footer class="cys-foot">
    <p class="cys-fine">Count Yourself Skinny is an educational resource, not medical advice. Talk with your physician before changing how you eat. Results vary and nothing here is a promise of any outcome.</p>
    <p class="cys-fine">If you have, or have had, an eating disorder or disordered eating, or if counting of any kind makes food stressful, skip the counts and talk with a qualified professional first.</p>
    <MedicalDisclaimer />
    <p class="cys-fine"><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href="/">my4mlife.com</a></p>
  </footer>
</div>

</BaseLayout>

<script>
  import { attachHoneypot, botFields, setFormError, LEAD_CAPTURE_ERROR } from '../../scripts/lead-capture';

  const API_BASE: string =
    (import.meta as any).env?.PUBLIC_LEAD_CAPTURE_API_URL ??
    'https://v9svm8ds74.execute-api.us-east-2.amazonaws.com';

  const form = document.getElementById('cys-form') as HTMLFormElement | null;
  if (form) {
    attachHoneypot(form);
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('cys-email') as HTMLInputElement).value.trim();
      const firstName = (document.getElementById('cys-name') as HTMLInputElement).value.trim();
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { setFormError(form, 'Please enter a valid email address.'); return; }
      const button = form.querySelector('button') as HTMLButtonElement;
      button.disabled = true;
      setFormError(form, null);
      let ok = false;
      try {
        const res = await fetch(`${API_BASE}/api/lead-capture`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            ...(firstName ? { firstName } : {}),
            consent: true,
            source: 'cys-book',
            ...botFields(form),
          }),
        });
        ok = res.ok;
      } catch (_) { ok = false; }
      button.disabled = false;
      if (!ok) { setFormError(form, LEAD_CAPTURE_ERROR); return; }
      (window as any).posthog?.capture('cys_book_email_captured');
      form.hidden = true;
      document.getElementById('cys-done')!.hidden = false;
    });
  }
</script>

<style>
.cys { font-family: 'Inter', system-ui, sans-serif; background: #fdfcf9; color: #1f2d3d; min-height: 100vh; }
.cys-top { padding: 0.9rem 1rem; border-bottom: 1px solid #e8e2d4; }
.cys-mark { font-weight: 800; letter-spacing: 0.08em; font-size: 0.95rem; }
.cys-hero { max-width: 560px; margin: 0 auto; padding: 3rem 1rem; text-align: center; }
.cys-hero h1 { font-size: clamp(1.9rem, 7vw, 2.8rem); line-height: 1.15; margin: 0 0 1rem; text-wrap: balance; }
.cys-lead { font-size: 1.05rem; line-height: 1.6; margin: 0 0 1.8rem; }
#cys-form { display: flex; flex-direction: column; gap: 0.7rem; }
#cys-form input { font-size: 1rem; padding: 0.9rem; border: 2px solid #1f2d3d; border-radius: 6px; }
#cys-form button { background: #1f2d3d; color: #fff; font-weight: 700; font-size: 1.05rem; padding: 1rem; border: 0; border-radius: 6px; cursor: pointer; }
#cys-form button:disabled { opacity: 0.6; }
.cys-done { font-weight: 700; }
.cys-dl { display: inline-block; margin-top: 0.5rem; background: #1f2d3d; color: #fff; padding: 1rem 1.6rem; border-radius: 6px; text-decoration: none; }
.cys-sr { position: absolute; left: -9999px; }
.cys-foot { max-width: 640px; margin: 0 auto; padding: 2rem 1rem; text-align: center; }
.cys-fine { font-size: 0.78rem; line-height: 1.5; opacity: 0.85; }
.cys-fine a { color: inherit; }
</style>
