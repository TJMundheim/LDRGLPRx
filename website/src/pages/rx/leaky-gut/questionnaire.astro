---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Leaky Gut Repair — Health Questionnaire | My4MLife';
const description = 'Complete your health questionnaire for the My4MLife Leaky Gut Repair protocol. Physician review. Card on file but no charge until approved.';
const canonical = 'https://www.my4mlife.com/rx/leaky-gut/questionnaire';
---
<BaseLayout title={title} description={description} canonical={canonical} robots="noindex, nofollow">

<section class="q-section">
  <div class="container q-inner">
    <header class="q-header">
      <p class="q-eyebrow">Leaky Gut Repair Telemedicine Intake</p>
      <h1 id="q-step-title">Let's get you matched with a physician</h1>
      <div class="q-progress" aria-hidden="true">
        <div class="q-progress-bar" id="q-progress-bar" style="width:14%"></div>
      </div>
      <p class="q-step-counter" id="q-step-counter">Step 1 of 6</p>
    </header>

    <!-- ── Step 1 — Demographics ── -->
    <section class="q-step" data-step="1">
      <h2>About you</h2>
      <p class="q-step-sub">We need this to ship your medication and verify your identity.</p>
      <div class="q-grid-2">
        <label class="q-field">First name <input type="text" data-q="firstName" required></label>
        <label class="q-field">Last name <input type="text" data-q="lastName" required></label>
        <label class="q-field">Email <input type="email" data-q="email" required></label>
        <label class="q-field">Phone <input type="tel" data-q="phone" placeholder="+1 555-555-5555" required></label>
        <label class="q-field">Date of birth <input type="date" data-q="dob" required></label>
        <label class="q-field">Biological sex
          <select data-q="sex" required>
            <option value="">Select…</option>
            <option value="male">Male</option>
            <option value="female">Female</option>
          </select>
        </label>
      </div>
      <h3>Shipping address</h3>
      <div class="q-grid-2">
        <label class="q-field q-field-wide">Street address <input type="text" data-q="address1" required></label>
        <label class="q-field q-field-wide">Apt / Suite (optional) <input type="text" data-q="address2"></label>
        <label class="q-field">City <input type="text" data-q="city" required></label>
        <label class="q-field">State <select data-q="state" id="q-state" required><option value="">Select state…</option></select></label>
        <label class="q-field">ZIP <input type="text" data-q="zip" required></label>
      </div>
    </section>

    <!-- ── Step 2 — Health History ── -->
    <section class="q-step" data-step="2" hidden>
      <h2>General health history</h2>
      <p class="q-step-sub">Basic background the physician needs to review.</p>
      <div class="q-grid-2">
        <label class="q-field">Height (feet) <input type="number" min="3" max="8" data-q="heightFt" required></label>
        <label class="q-field">Height (inches) <input type="number" min="0" max="11" data-q="heightIn" required></label>
        <label class="q-field">Current weight (lbs) <input type="number" min="80" max="700" data-q="weightLb" required></label>
        <label class="q-field">Target weight (lbs) <input type="number" min="80" max="700" data-q="targetLb" required></label>
      </div>
      <label class="q-field q-field-block">Current medications (include dose if known — separate with commas)
        <textarea data-q="currentMeds" rows="2" placeholder="e.g., metformin 1000mg, lisinopril 10mg, none"></textarea>
      </label>
      <label class="q-field q-field-block">Drug or food allergies
        <textarea data-q="allergies" rows="2" placeholder="e.g., penicillin, sulfa, none"></textarea>
      </label>
      <label class="q-field q-field-block">Major medical conditions (current or past)
        <textarea data-q="conditions" rows="2" placeholder="e.g., hypertension, type 2 diabetes, none"></textarea>
      </label>
    </section>

    <!-- ── Step 3 — Leaky-Gut Specific Screening ── -->
    <section class="q-step" data-step="3" hidden>
      <h2>Leaky gut candidacy screening</h2>
      <p class="q-step-sub">A few targeted questions so the physician can evaluate your gut-barrier status and prescribe safely.</p>

      <fieldset class="q-radio-group">
        <legend>Primary symptom pattern — select all that apply (at least one required)</legend>
        <label class="q-checkbox-inline"><input type="checkbox" name="symptomBloating" data-q-check="symptomBloating" value="bloating"> Bloating after meals</label>
        <label class="q-checkbox-inline"><input type="checkbox" name="symptomStool" data-q-check="symptomStool" value="irregular-stools"> Irregular stools (loose, constipated, or alternating)</label>
        <label class="q-checkbox-inline"><input type="checkbox" name="symptomBrainFog" data-q-check="symptomBrainFog" value="brain-fog"> Brain fog 30 min post-meal</label>
        <label class="q-checkbox-inline"><input type="checkbox" name="symptomSensitivities" data-q-check="symptomSensitivities" value="food-sensitivities"> New food sensitivities</label>
        <label class="q-checkbox-inline"><input type="checkbox" name="symptomJoint" data-q-check="symptomJoint" value="joint-pain"> Joint pain</label>
        <label class="q-checkbox-inline"><input type="checkbox" name="symptomSkin" data-q-check="symptomSkin" value="skin-issues"> Skin issues (acne / eczema / rashes)</label>
      </fieldset>

      <fieldset class="q-radio-group q-warn" id="q-ibd-block">
        <legend>Diagnosed Crohn's disease, ulcerative colitis, or microscopic colitis?</legend>
        <label class="q-radio"><input type="radio" name="ibdStatus" data-q="ibdStatus" value="no" required> No</label>
        <label class="q-radio"><input type="radio" name="ibdStatus" data-q="ibdStatus" value="yes"> Yes</label>
        <label class="q-radio"><input type="radio" name="ibdStatus" data-q="ibdStatus" value="unsure"> Unsure</label>
        <p class="q-warn-note" id="q-ibd-warn" hidden>⚠ Active inflammatory bowel condition — physician will review carefully before prescribing.</p>
      </fieldset>

      <fieldset class="q-radio-group">
        <legend>Are you currently taking probiotics or fermented foods regularly?</legend>
        <label class="q-radio"><input type="radio" name="probioticsUse" data-q="probioticsUse" value="yes" required> Yes, regularly</label>
        <label class="q-radio"><input type="radio" name="probioticsUse" data-q="probioticsUse" value="no"> No</label>
        <label class="q-radio"><input type="radio" name="probioticsUse" data-q="probioticsUse" value="stopped-recently"> Stopped recently (within 30 days)</label>
      </fieldset>

      <fieldset class="q-radio-group">
        <legend>Have you taken antibiotics in the past 90 days?</legend>
        <label class="q-radio"><input type="radio" name="antibioticUse" data-q="antibioticUse" value="no" required> No</label>
        <label class="q-radio"><input type="radio" name="antibioticUse" data-q="antibioticUse" value="yes"> Yes</label>
      </fieldset>

      <fieldset class="q-radio-group">
        <legend>Do you have a diagnosed autoimmune condition (Hashimoto's, RA, lupus, psoriasis, MS, etc.)?</legend>
        <label class="q-radio"><input type="radio" name="autoimmuneStatus" data-q="autoimmuneStatus" value="no" required> No</label>
        <label class="q-radio"><input type="radio" name="autoimmuneStatus" data-q="autoimmuneStatus" value="yes"> Yes</label>
        <label class="q-radio"><input type="radio" name="autoimmuneStatus" data-q="autoimmuneStatus" value="unsure"> Unsure</label>
      </fieldset>
      <label class="q-field q-field-block" id="q-autoimmune-detail" hidden>
        Which autoimmune condition(s)?
        <textarea data-q="autoimmuneDetail" rows="2"></textarea>
      </label>

      <fieldset class="q-radio-group">
        <legend>Do you take NSAIDs (ibuprofen, aspirin, naproxen) regularly — more than 2x/week?</legend>
        <label class="q-radio"><input type="radio" name="nsaidUse" data-q="nsaidUse" value="no" required> No</label>
        <label class="q-radio"><input type="radio" name="nsaidUse" data-q="nsaidUse" value="yes"> Yes</label>
      </fieldset>

      <fieldset class="q-radio-group" id="q-pregnancy-block" hidden>
        <legend>Are you pregnant, breastfeeding, or actively trying to become pregnant?</legend>
        <p class="q-warn-note">⚠ Some compounded ingredients may require caution.</p>
        <label class="q-radio"><input type="radio" name="pregnancy" data-q="pregnancy" value="no"> No</label>
        <label class="q-radio"><input type="radio" name="pregnancy" data-q="pregnancy" value="yes"> Yes</label>
      </fieldset>

      <label class="q-field q-field-block">List any known food sensitivities, intolerances, or trigger foods (optional)
        <textarea data-q="foodSensitivities" rows="2" placeholder="e.g., gluten, dairy, FODMAPs, eggs"></textarea>
      </label>

      <label class="q-field q-field-block">Anything else the physician should know? (optional)
        <textarea data-q="other" rows="2"></textarea>
      </label>
    </section>

    <!-- ── Step 4 — Medication Selection (single, pre-selected) ── -->
    <section class="q-step" data-step="4" hidden>
      <h2>Your prescribed protocol</h2>
      <p class="q-step-sub">Based on your intake, one physician-reviewed protocol is available. Please review it below and confirm before continuing.</p>

      <div class="q-med-grid">
        <label class="q-med-card q-med-card-solo">
          <input type="radio" name="medication" value="biome-ns-rx" data-q="medication" data-price="PLACEHOLDER_LEAKY_GUT_PRICE_ID" checked>
          <div class="q-med-body">
            <p class="q-med-tier">Biome NS Rx — Gut-Brain Repair Protocol</p>
            <h3>Biome NS Rx</h3>
            <p class="q-med-tag">Compounded BPC-157 + L-Glutamine + Aloe vera. Barrier repair, epithelial fuel, and mucosal soothing in one prescription protocol.</p>
            <p class="q-med-price">$199<span>/month</span></p>
            <p class="q-med-follow">Subscription delivers a 30-day supply with physician follow-up at month 3 and 6.</p>
          </div>
        </label>
      </div>
      <p class="q-med-solo-note">This is the only protocol available for your intake profile. By continuing you acknowledge the protocol above.</p>
    </section>

    <!-- ── Step 5 — Card Capture (Stripe SetupIntent) ── -->
    <section class="q-step" data-step="5" hidden>
      <h2>Save your payment method</h2>
      <div class="q-noscope-box">
        <strong>⚡ Your card will not be charged today.</strong>
        It is saved securely with Stripe and will only be charged once a physician reviews your case and approves your script. If you are not approved, no charge is made.
      </div>

      <div id="stripe-card-element" class="q-stripe-card"></div>
      <p id="stripe-card-error" class="q-stripe-error" role="alert"></p>

      <p class="q-disclaimer">By continuing you authorize My4MLife and our network physicians to use this saved payment method to charge your selected monthly subscription if and when a script is written for you. You can cancel anytime by emailing <a href="mailto:support@my4mlife.com">support@my4mlife.com</a>.</p>
    </section>

    <!-- ── Step 6 — Review & Submit ── -->
    <section class="q-step" data-step="6" hidden>
      <h2>Review and submit</h2>
      <p class="q-step-sub">Confirm everything looks right. After submission, our care coordinator will email you within 24 hours to confirm next steps with the network physician.</p>

      <div id="q-review-summary" class="q-review-summary"></div>

      <label class="q-checkbox-row">
        <input type="checkbox" id="q-attestation" required>
        <span>I attest the information above is accurate to the best of my knowledge. I understand a real physician will review my submission, and that no medication will ship without a written script. I authorize My4MLife and the network physician to contact me by email or phone.</span>
      </label>
    </section>

    <!-- ── Submission state ── -->
    <section class="q-step" data-step="success" hidden>
      <div class="q-success">
        <div class="q-success-icon">✓</div>
        <h2>Your submission is in.</h2>
        <p>Our care coordinator will email you within 24 hours to confirm the next step with the network physician. Your card has been saved securely with Stripe — no charge has been made and none will be made until your script is approved.</p>
        <p class="q-success-fine">Questions? Email <a href="mailto:support@my4mlife.com">support@my4mlife.com</a>.</p>
      </div>
    </section>

    <div class="q-nav" id="q-nav">
      <button type="button" class="q-btn q-btn-secondary" id="q-back" hidden>← Back</button>
      <button type="button" class="q-btn q-btn-primary" id="q-next">Continue →</button>
      <button type="button" class="q-btn q-btn-primary" id="q-submit" hidden>Submit My Questionnaire →</button>
    </div>
  </div>
</section>

<script is:inline src="https://js.stripe.com/v3/"></script>
<script is:inline define:vars={{
  API_BASE: 'https://v9svm8ds74.execute-api.us-east-2.amazonaws.com',
}}>
(function() {
  // ── State ──
  var totalSteps = 6;
  var currentStep = 1;
  var payload = {};
  var stripe = null;
  var elements = null;
  var cardElement = null;
  var setupIntentClientSecret = null;
  var paymentMethodId = null;

  // ── Helpers ──
  function $(sel) { return document.querySelector(sel); }
  function $$(sel) { return document.querySelectorAll(sel); }

  function showStep(n) {
    $$('.q-step').forEach(function(el) { el.hidden = true; });
    var target = document.querySelector('[data-step="' + n + '"]');
    if (target) target.hidden = false;
    window.scrollTo({ top: 0, behavior: 'smooth' });

    var header = document.querySelector('.q-header');
    var nav = document.getElementById('q-nav');

    if (n === 'success') {
      if (header) header.style.display = 'none';
      if (nav) nav.style.display = 'none';
      return;
    }

    if (header) header.style.display = '';
    if (nav) nav.style.display = '';

    var pct = (n / totalSteps) * 100;
    $('#q-progress-bar').style.width = Math.min(pct, 100) + '%';
    $('#q-step-counter').textContent = 'Step ' + n + ' of ' + totalSteps;
    $('#q-back').hidden = (n === 1);
    $('#q-next').hidden = (n === totalSteps);
    $('#q-submit').hidden = (n !== totalSteps);
  }

  // Friendly labels for error messages — keep in sync with data-q attributes
  var FIELD_LABELS = {
    firstName: 'First name', lastName: 'Last name', email: 'Email', phone: 'Phone',
    dob: 'Date of birth', sex: 'Biological sex',
    address1: 'Street address', city: 'City', state: 'State', zip: 'ZIP',
    heightFt: 'Height (feet)', heightIn: 'Height (inches)',
    weightLb: 'Current weight', targetLb: 'Target weight',
    currentMeds: 'Current medications', allergies: 'Allergies', conditions: 'Medical conditions',
    ibdStatus: 'IBD / colitis status',
    probioticsUse: 'Probiotic use',
    antibioticUse: 'Antibiotic use (past 90 days)',
    autoimmuneStatus: 'Autoimmune condition',
    nsaidUse: 'NSAID use',
    pregnancy: 'Pregnancy status',
    medication: 'Protocol selection',
    symptoms: 'Primary symptom pattern',
  };

  function collectStep(n) {
    var step = document.querySelector('[data-step="' + n + '"]');
    if (!step) return true;
    var missing = [];
    var firstMissingEl = null;

    // Clear previous error highlights on this step
    step.querySelectorAll('.q-error').forEach(function(el) { el.classList.remove('q-error'); });

    // Step 3 — collect symptom checkboxes (required: at least one)
    if (n === 3) {
      var checked = [];
      step.querySelectorAll('[data-q-check]').forEach(function(cb) {
        if (cb.checked) checked.push(cb.value);
      });
      if (checked.length === 0) {
        missing.push(FIELD_LABELS['symptoms']);
        var symFieldset = step.querySelector('[data-q-check]') && step.querySelector('[data-q-check]').closest('fieldset');
        if (symFieldset) { symFieldset.classList.add('q-error'); if (!firstMissingEl) firstMissingEl = symFieldset; }
      } else {
        payload.symptoms = checked.join(', ');
      }
    }

    // Step 4 — auto-set medication from checked radio (pre-selected)
    if (n === 4) {
      var medRadio = step.querySelector('input[name="medication"]:checked');
      if (medRadio) payload.medication = medRadio.value;
    }

    // Inputs / selects / textareas with data-q (skip radios — handled below)
    step.querySelectorAll('[data-q]').forEach(function(field) {
      if (field.type === 'radio') return;
      var name = field.getAttribute('data-q');
      var val = (field.value || '').trim();
      if (field.offsetParent === null && field.tagName !== 'SELECT') return;
      if (val) payload[name] = val;
      if (field.hasAttribute('required') && !val) {
        missing.push(FIELD_LABELS[name] || name);
        field.classList.add('q-error');
        if (!firstMissingEl) firstMissingEl = field;
      }
    });

    // Radio groups
    var radioGroups = {};
    step.querySelectorAll('input[type=radio]').forEach(function(r) {
      var name = r.name;
      var parentFieldset = r.closest('fieldset');
      if (parentFieldset && parentFieldset.offsetParent === null) return;
      if (!radioGroups[name]) {
        radioGroups[name] = {
          dataQ: r.getAttribute('data-q') || name,
          required: r.hasAttribute('required'),
          any: false,
          firstEl: r,
        };
      }
      if (r.checked) {
        radioGroups[name].any = true;
        payload[radioGroups[name].dataQ] = r.value;
      }
    });
    Object.keys(radioGroups).forEach(function(name) {
      var g = radioGroups[name];
      if (g.required && !g.any) {
        missing.push(FIELD_LABELS[g.dataQ] || g.dataQ);
        if (g.firstEl) {
          var fs = g.firstEl.closest('fieldset');
          if (fs) fs.classList.add('q-error');
          if (!firstMissingEl) firstMissingEl = g.firstEl;
        }
      }
    });

    if (missing.length) {
      alert('Please complete: ' + missing.join(', '));
      if (firstMissingEl && firstMissingEl.scrollIntoView) {
        firstMissingEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        if (firstMissingEl.focus) firstMissingEl.focus();
      }
      return false;
    }
    return true;
  }

  function buildReviewSummary() {
    function row(label, val) {
      if (val === undefined || val === null || val === '') return '';
      var esc = String(val).replace(/[<>&"]/g, function(c){ return {'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c]; });
      return '<div class="q-review-row"><span class="q-review-label">' + label + '</span><span class="q-review-value">' + esc + '</span></div>';
    }
    function section(title, body) {
      if (!body) return '';
      return '<div class="q-review-section"><h3 class="q-review-section-title">' + title + '</h3>' + body + '</div>';
    }

    var demographics = '';
    demographics += row('Name', (payload.firstName || '') + ' ' + (payload.lastName || ''));
    demographics += row('Email', payload.email);
    demographics += row('Phone', payload.phone);
    demographics += row('Date of birth', payload.dob);
    demographics += row('Sex', payload.sex);
    var addrLine1 = [(payload.address1||''), (payload.address2||'')].filter(function(p){return p;}).join(', ');
    var addrLine2 = [(payload.city||''), (payload.state||''), (payload.zip||'')].filter(function(p){return p;}).join(', ').replace(/, (\w{2}), /, ', $1 ');
    demographics += row('Address', [addrLine1, addrLine2].filter(function(p){return p;}).join(' • '));

    var health = '';
    health += row('Height', (payload.heightFt || '') + "' " + (payload.heightIn || '') + '"');
    health += row('Current weight', (payload.weightLb || '') + ' lbs');
    health += row('Target weight', (payload.targetLb || '') + ' lbs');
    health += row('Current medications', payload.currentMeds);
    health += row('Allergies', payload.allergies);
    health += row('Conditions', payload.conditions);

    var screening = '';
    screening += row('Primary symptoms', payload.symptoms);
    screening += row('IBD / colitis status', payload.ibdStatus);
    screening += row('Probiotic use', payload.probioticsUse);
    screening += row('Antibiotic use (90 days)', payload.antibioticUse);
    screening += row('Autoimmune condition', payload.autoimmuneStatus);
    screening += row('Autoimmune detail', payload.autoimmuneDetail);
    screening += row('NSAID use', payload.nsaidUse);
    screening += row('Pregnancy status', payload.pregnancy);
    screening += row('Food sensitivities', payload.foodSensitivities);
    screening += row('Other notes', payload.other);

    var medLabels = {
      'biome-ns-rx': 'Biome NS Rx — Gut-Brain Repair Protocol — $199/mo',
    };
    var program = '';
    program += row('Protocol', medLabels[payload.medication] || payload.medication);
    program += row('Payment method', paymentMethodId ? 'Card saved (Stripe …' + paymentMethodId.slice(-6) + ')' : '— not yet saved');

    var html = '';
    html += section('Demographics', demographics);
    html += section('Health', health);
    html += section('Gut Repair Screening', screening);
    html += section('Selected Protocol', program);

    $('#q-review-summary').innerHTML = html;
  }

  async function initStripeCard() {
    if (cardElement) return;
    if (!window.Stripe) {
      $('#stripe-card-error').textContent = 'Stripe failed to load. Refresh and try again.';
      return;
    }

    var resp = await fetch(API_BASE + '/api/create-setup-intent', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: payload.email || '', firstName: payload.firstName || '', category: 'leaky-gut' }),
    });
    var json = await resp.json();
    if (!json.clientSecret || !json.publishableKey) {
      $('#stripe-card-error').textContent = 'Unable to start secure card capture. Please try again.';
      return;
    }
    stripe = Stripe(json.publishableKey);
    setupIntentClientSecret = json.clientSecret;

    elements = stripe.elements();
    cardElement = elements.create('card', {
      style: {
        base: { fontSize: '16px', color: '#1a1a1a', '::placeholder': { color: '#999' } },
        invalid: { color: '#d4351c' },
      },
    });
    cardElement.mount('#stripe-card-element');
    cardElement.addEventListener('change', function(e) {
      $('#stripe-card-error').textContent = (e.error && e.error.message) || '';
    });
  }

  async function confirmStripeCard() {
    if (!stripe || !cardElement || !setupIntentClientSecret) {
      $('#stripe-card-error').textContent = 'Stripe is not ready yet.';
      return false;
    }
    var result = await stripe.confirmCardSetup(setupIntentClientSecret, {
      payment_method: {
        card: cardElement,
        billing_details: {
          name: (payload.firstName || '') + ' ' + (payload.lastName || ''),
          email: payload.email,
          phone: payload.phone,
        },
      },
    });
    if (result.error) {
      $('#stripe-card-error').textContent = result.error.message || 'Card could not be saved.';
      return false;
    }
    paymentMethodId = result.setupIntent.payment_method;
    return true;
  }

  async function submitQuestionnaire() {
    if (!$('#q-attestation').checked) {
      alert('Please confirm the attestation to submit.');
      return;
    }
    payload.paymentMethodId = paymentMethodId;
    payload.savedAt = new Date().toISOString();
    var fields = {};
    Object.keys(payload).forEach(function(k){ fields[k] = String(payload[k]); });
    fields.scores = JSON.stringify({});
    var resp = await fetch(API_BASE + '/api/contact-form', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        kind: 'form',
        formId: 'leaky-gut-questionnaire',
        fields: fields,
      }),
    });
    if (resp.ok) {
      showStep('success');
    } else {
      alert('Submission failed. Please try again or email support@my4mlife.com.');
    }
  }

  function populateStateDropdown() {
    var sel = document.getElementById('q-state');
    if (!sel) return;
    var us = 'Alabama:AL,Alaska:AK,Arizona:AZ,Arkansas:AR,California:CA,Colorado:CO,Connecticut:CT,Delaware:DE,District of Columbia:DC,Florida:FL,Georgia:GA,Hawaii:HI,Idaho:ID,Illinois:IL,Indiana:IN,Iowa:IA,Kansas:KS,Kentucky:KY,Louisiana:LA,Maine:ME,Maryland:MD,Massachusetts:MA,Michigan:MI,Minnesota:MN,Mississippi:MS,Missouri:MO,Montana:MT,Nebraska:NE,Nevada:NV,New Hampshire:NH,New Jersey:NJ,New Mexico:NM,New York:NY,North Carolina:NC,North Dakota:ND,Ohio:OH,Oklahoma:OK,Oregon:OR,Pennsylvania:PA,Rhode Island:RI,South Carolina:SC,South Dakota:SD,Tennessee:TN,Texas:TX,Utah:UT,Vermont:VT,Virginia:VA,Washington:WA,West Virginia:WV,Wisconsin:WI,Wyoming:WY';
    us.split(',').forEach(function(pair) {
      var parts = pair.split(':');
      var opt = document.createElement('option');
      opt.value = parts[1];
      opt.textContent = parts[0];
      sel.appendChild(opt);
    });
  }

  // ── Wire up navigation ──
  document.addEventListener('DOMContentLoaded', function() {
    populateStateDropdown();

    // Pre-set medication payload since it's auto-selected
    payload.medication = 'biome-ns-rx';

    showStep(1);

    // Conditional UI: IBD warn note
    document.querySelectorAll('[name="ibdStatus"]').forEach(function(r) {
      r.addEventListener('change', function() {
        var warn = document.getElementById('q-ibd-warn');
        if (warn) warn.hidden = (r.value !== 'yes');
      });
    });

    // Conditional UI: autoimmune detail textarea
    document.querySelectorAll('[name="autoimmuneStatus"]').forEach(function(r) {
      r.addEventListener('change', function() {
        var detail = document.getElementById('q-autoimmune-detail');
        if (detail) detail.hidden = (r.value !== 'yes');
      });
    });

    // Conditional UI: pregnancy block — only show for female
    document.querySelectorAll('[data-q="sex"]').forEach(function(el) {
      el.addEventListener('change', function() {
        var pb = document.getElementById('q-pregnancy-block');
        if (pb) pb.hidden = (el.value !== 'female');
      });
    });

    $('#q-next').addEventListener('click', async function() {
      if (!collectStep(currentStep)) return;
      currentStep++;
      if (currentStep === 5) {
        await initStripeCard();
      }
      if (currentStep === 6) {
        var ok = await confirmStripeCard();
        if (!ok) { currentStep--; return; }
        buildReviewSummary();
      }
      showStep(currentStep);
    });

    $('#q-back').addEventListener('click', function() {
      if (currentStep > 1) {
        currentStep--;
        showStep(currentStep);
      }
    });

    $('#q-submit').addEventListener('click', async function() {
      await submitQuestionnaire();
    });
  });
})();
</script>

</BaseLayout>

