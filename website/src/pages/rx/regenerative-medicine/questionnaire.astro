---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Regenerative Medicine — Care Coordinator Intake | My4MLife';
const description = 'Brief intake form for our regenerative medicine portfolio. Save a card on file — no charge today. A care coordinator reaches out within 24 hours with a custom quote; nothing is charged until you approve it.';
const canonical = 'https://www.my4mlife.com/rx/regenerative-medicine/questionnaire';
---
<BaseLayout title={title} description={description} canonical={canonical} robots="noindex, nofollow">

<section class="q-section">
  <div class="container q-inner">
    <header class="q-header">
      <p class="q-eyebrow">Regenerative Medicine — Care Coordinator Intake</p>
      <h1 id="q-step-title">Let's get you matched with the right protocol</h1>
      <div class="q-progress" aria-hidden="true">
        <div class="q-progress-bar" id="q-progress-bar" style="width:20%"></div>
      </div>
      <p class="q-step-counter" id="q-step-counter">Step 1 of 5</p>
    </header>

    <!-- ── Step 1 — Demographics ── -->
    <section class="q-step" data-step="1">
      <h2>About you</h2>
      <p class="q-step-sub">A care coordinator will use this to follow up within 24 hours.</p>
      <div class="q-grid-2">
        <label class="q-field">First name <input type="text" data-q="firstName" required></label>
        <label class="q-field">Last name <input type="text" data-q="lastName" required></label>
        <label class="q-field">Email <input type="email" data-q="email" required></label>
        <label class="q-field">Phone <input type="tel" data-q="phone" placeholder="+1 555-555-5555" required></label>
        <label class="q-field">Date of birth <input type="date" data-q="dob" required></label>
        <label class="q-field">Biological sex
          <select data-q="sex" required>
            <option value="">Select…</option>
            <option value="male">Male</option>
            <option value="female">Female</option>
          </select>
        </label>
      </div>
      <h3>Mailing address (for follow-up materials)</h3>
      <div class="q-grid-2">
        <label class="q-field q-field-wide">Street address <input type="text" data-q="address1" required></label>
        <label class="q-field q-field-wide">Apt / Suite (optional) <input type="text" data-q="address2"></label>
        <label class="q-field">City <input type="text" data-q="city" required></label>
        <label class="q-field">State <select data-q="state" id="q-state" required><option value="">Select state…</option></select></label>
        <label class="q-field">ZIP <input type="text" data-q="zip" required></label>
      </div>
    </section>

    <!-- ── Step 2 — Target Indication ── -->
    <section class="q-step" data-step="2" hidden>
      <h2>What are you trying to address?</h2>
      <p class="q-step-sub">Pick the indication closest to your situation. The care coordinator will match you to the right protocol — peptide stack, RPA, or other regenerative arm.</p>

      <fieldset class="q-radio-group">
        <legend>Primary target indication</legend>
        <label class="q-radio"><input type="radio" name="indication" data-q="indication" value="joint" required> Joint repair / chronic joint pain / post-injury recovery</label>
        <label class="q-radio"><input type="radio" name="indication" data-q="indication" value="cognitive"> Cognitive resilience / mild cognitive concerns / brain healthspan</label>
        <label class="q-radio"><input type="radio" name="indication" data-q="indication" value="diagnosed"> Already diagnosed (MCI, early dementia, Parkinson's, post-stroke)</label>
        <label class="q-radio"><input type="radio" name="indication" data-q="indication" value="post-injury"> Acute post-injury repair (tendon, ligament, soft tissue)</label>
        <label class="q-radio"><input type="radio" name="indication" data-q="indication" value="performance"> Athletic performance / recovery / longevity-driven</label>
        <label class="q-radio"><input type="radio" name="indication" data-q="indication" value="anti-aging"> General anti-aging / healthspan optimization</label>
        <label class="q-radio"><input type="radio" name="indication" data-q="indication" value="other"> Other / multiple</label>
      </fieldset>

      <label class="q-field q-field-block">Briefly describe what you're hoping to accomplish (target outcomes, timeline, what you've already tried)
        <textarea data-q="goalDescription" rows="3" required placeholder="e.g., torn rotator cuff 6 months ago, PT didn't fully resolve, want to avoid surgery — looking for tissue-repair protocol"></textarea>
      </label>

      <label class="q-field q-field-block">If applicable, when was your diagnosis or injury? (optional)
        <input type="text" data-q="diagnosisDate" placeholder="e.g., diagnosed MCI in March 2024, or 'injured 6 months ago'">
      </label>
    </section>

    <!-- ── Step 3 — Regenerative-specific Screening ── -->
    <section class="q-step" data-step="3" hidden>
      <h2>Health background</h2>
      <p class="q-step-sub">Quick screen so the care coordinator can route you correctly and the physician has the context they need.</p>

      <div class="q-grid-2">
        <label class="q-field">Height (feet) <input type="number" min="3" max="8" data-q="heightFt" required></label>
        <label class="q-field">Height (inches) <input type="number" min="0" max="11" data-q="heightIn" required></label>
        <label class="q-field">Current weight (lbs) <input type="number" min="80" max="700" data-q="weightLb" required></label>
      </div>

      <label class="q-field q-field-block">Prior regenerative therapy (peptides, PRP, stem cells, exosomes, RPA, etc.) — what have you tried?
        <textarea data-q="priorRegenerative" rows="2" placeholder="e.g., BPC-157 cycle in 2024, PRP knee injection, or 'none'"></textarea>
      </label>

      <fieldset class="q-radio-group q-warn">
        <legend>Active cancer diagnosis or treatment in the past 5 years?</legend>
        <p class="q-warn-note">⚠ Most growth-factor-stimulating peptides are contraindicated with active or recent malignancy.</p>
        <label class="q-radio"><input type="radio" name="activeCancer" data-q="activeCancer" value="no" required> No</label>
        <label class="q-radio"><input type="radio" name="activeCancer" data-q="activeCancer" value="yes"> Yes</label>
        <label class="q-radio"><input type="radio" name="activeCancer" data-q="activeCancer" value="in-remission"> In remission &gt; 5 years</label>
      </fieldset>

      <fieldset class="q-radio-group">
        <legend>Diagnosed autoimmune condition?</legend>
        <label class="q-radio"><input type="radio" name="autoimmune" data-q="autoimmune" value="no" required> No</label>
        <label class="q-radio"><input type="radio" name="autoimmune" data-q="autoimmune" value="yes"> Yes</label>
        <label class="q-radio"><input type="radio" name="autoimmune" data-q="autoimmune" value="unsure"> Unsure</label>
      </fieldset>
      <label class="q-field q-field-block" id="q-autoimmune-detail" hidden>
        Which autoimmune condition(s)?
        <textarea data-q="autoimmuneDetail" rows="2"></textarea>
      </label>

      <fieldset class="q-radio-group" id="q-pregnancy-block" hidden>
        <legend>Are you pregnant, breastfeeding, or actively trying to become pregnant?</legend>
        <p class="q-warn-note">⚠ Most regenerative protocols require deferral until after pregnancy/breastfeeding.</p>
        <label class="q-radio"><input type="radio" name="pregnancy" data-q="pregnancy" value="no"> No</label>
        <label class="q-radio"><input type="radio" name="pregnancy" data-q="pregnancy" value="yes"> Yes</label>
      </fieldset>

      <label class="q-field q-field-block">Current medications (include dose if known)
        <textarea data-q="currentMeds" rows="2" placeholder="e.g., metformin 1000mg, lisinopril 10mg, or 'none'"></textarea>
      </label>

      <label class="q-field q-field-block">Drug or food allergies
        <textarea data-q="allergies" rows="2" placeholder="e.g., penicillin, sulfa, or 'none'"></textarea>
      </label>

      <label class="q-field q-field-block">Anything else the care coordinator should know? (optional)
        <textarea data-q="other" rows="2"></textarea>
      </label>
    </section>

    <!-- ── Step 4 — Card Capture (Stripe SetupIntent, no price) ── -->
    <section class="q-step" data-step="4" hidden>
      <h2>Save your payment method</h2>
      <div class="q-noscope-box">
        <strong>&#9889; No charge today.</strong>
        Your card is saved securely with Stripe. Regenerative protocols are per-treatment custom pricing — we only charge after the care coordinator provides your written quote and you approve it. No approval, no charge. We ask up front because a physician consult and evaluation have real cost, and a card on file confirms you're a serious candidate.
      </div>

      <div id="stripe-card-element" class="q-stripe-card"></div>
      <p id="stripe-card-error" class="q-stripe-error" role="alert"></p>

      <p class="q-disclaimer">By continuing you authorize My4MLife and the care coordinator to charge this saved payment method for the regenerative protocol you approve after your consult. You can cancel anytime by emailing <a href="mailto:support@my4mlife.com">support@my4mlife.com</a>.</p>
    </section>

    <!-- ── Step 5 — Review & Submit ── -->
    <section class="q-step" data-step="5" hidden>
      <h2>Review and submit</h2>
      <p class="q-step-sub">Confirm everything looks right. After submission, our care coordinator will email you within 24 hours with a personalized quote, protocol recommendation, and scheduling options.</p>

      <div class="q-noscope-box">
        <strong>No charge today — your card is on file.</strong>
        Regenerative protocols are per-treatment custom pricing. The care coordinator will provide a written quote after reviewing your intake; nothing is charged until you approve that quote.
      </div>

      <div id="q-review-summary" class="q-review-summary"></div>

      <label class="q-checkbox-row">
        <input type="checkbox" id="q-attestation" required>
        <span>I attest the information above is accurate to the best of my knowledge. I authorize My4MLife and the care coordinator to contact me by email or phone to discuss protocol options and pricing.</span>
      </label>
      <label class="q-checkbox-row">
        <input type="checkbox" id="q-consent-npp" required>
        <span>I acknowledge I have received and reviewed My4MLife's <a href="/privacy" target="_blank" rel="noopener">Notice of Privacy Practices</a>.</span>
      </label>
      <label class="q-checkbox-row">
        <input type="checkbox" id="q-consent-phi" required>
        <span>I authorize My4MLife and its network physicians to use and disclose my health information to provide, coordinate, and bill for my care, including forwarding my intake to the telemedicine provider, as described in the <a href="/consent" target="_blank" rel="noopener">Patient Authorization &amp; Telehealth Consent</a>.</span>
      </label>
    </section>

    <!-- ── Submission state ── -->
    <section class="q-step" data-step="success" hidden>
      <div class="q-success">
        <div class="q-success-icon">✓</div>
        <h2>Your intake is in.</h2>
        <p>Your card is saved securely — no charge has been made. Our care coordinator will email you within 24 hours with a personalized quote, protocol recommendation, and scheduling options. Nothing is charged until you approve your quote.</p>
        <p class="q-success-fine">Questions? Email <a href="mailto:support@my4mlife.com">support@my4mlife.com</a>.</p>
      </div>
    </section>

    <div class="q-nav" id="q-nav">
      <button type="button" class="q-btn q-btn-secondary" id="q-back" hidden>← Back</button>
      <button type="button" class="q-btn q-btn-primary" id="q-next">Continue →</button>
      <button type="button" class="q-btn q-btn-primary" id="q-submit" hidden>Submit My Intake →</button>
    </div>
  </div>
</section>

<script is:inline src="https://js.stripe.com/v3/"></script>
<script is:inline define:vars={{
  API_BASE: 'https://v9svm8ds74.execute-api.us-east-2.amazonaws.com',
}}>
(function() {
  var totalSteps = 5;
  var currentStep = 1;
  var PH_CAT = 'regenerative-medicine';
  function phCapture(ev, props) { try { if (window.posthog && window.posthog.capture) { props = props || {}; props.category = PH_CAT; window.posthog.capture(ev, props); } } catch (err) {} }
  var payload = {};
  var stripe = null;
  var elements = null;
  var cardElement = null;
  var setupIntentClientSecret = null;
  var paymentMethodId = null;
  var stripeCustomerId = null;

  function $(sel) { return document.querySelector(sel); }
  function $$(sel) { return document.querySelectorAll(sel); }

  var FIELD_LABELS = {
    firstName: 'First name', lastName: 'Last name', email: 'Email', phone: 'Phone',
    dob: 'Date of birth', sex: 'Biological sex',
    address1: 'Street address', city: 'City', state: 'State', zip: 'ZIP',
    heightFt: 'Height (feet)', heightIn: 'Height (inches)', weightLb: 'Current weight',
    indication: 'Target indication', goalDescription: 'Goal description',
    activeCancer: 'Cancer history', autoimmune: 'Autoimmune status',
  };

  function populateStateDropdown() {
    var sel = document.getElementById('q-state');
    if (!sel) return;
    var us = 'Alabama:AL,Alaska:AK,Arizona:AZ,Arkansas:AR,California:CA,Colorado:CO,Connecticut:CT,Delaware:DE,District of Columbia:DC,Florida:FL,Georgia:GA,Hawaii:HI,Idaho:ID,Illinois:IL,Indiana:IN,Iowa:IA,Kansas:KS,Kentucky:KY,Louisiana:LA,Maine:ME,Maryland:MD,Massachusetts:MA,Michigan:MI,Minnesota:MN,Mississippi:MS,Missouri:MO,Montana:MT,Nebraska:NE,Nevada:NV,New Hampshire:NH,New Jersey:NJ,New Mexico:NM,New York:NY,North Carolina:NC,North Dakota:ND,Ohio:OH,Oklahoma:OK,Oregon:OR,Pennsylvania:PA,Rhode Island:RI,South Carolina:SC,South Dakota:SD,Tennessee:TN,Texas:TX,Utah:UT,Vermont:VT,Virginia:VA,Washington:WA,West Virginia:WV,Wisconsin:WI,Wyoming:WY';
    us.split(',').forEach(function(pair) {
      var parts = pair.split(':');
      var opt = document.createElement('option');
      opt.value = parts[1];
      opt.textContent = parts[0];
      sel.appendChild(opt);
    });
  }

  var _phMaxStep = 0;
  function showStep(n) {
    if (n === 'success') { phCapture('rx_submitted', { total_steps: totalSteps }); }
    else if (typeof n === 'number' && n > _phMaxStep) {
      _phMaxStep = n;
      phCapture('rx_step_reached', { step: n, total_steps: totalSteps });
    }
    $$('.q-step').forEach(function(el) { el.hidden = true; });
    var target = document.querySelector('[data-step="' + n + '"]');
    if (target) target.hidden = false;
    window.scrollTo({ top: 0, behavior: 'smooth' });

    var header = document.querySelector('.q-header');
    var nav = document.getElementById('q-nav');

    if (n === 'success') {
      if (header) header.style.display = 'none';
      if (nav) nav.style.display = 'none';
      return;
    }

    if (header) header.style.display = '';
    if (nav) nav.style.display = '';

    var pct = (n / totalSteps) * 100;
    $('#q-progress-bar').style.width = Math.min(pct, 100) + '%';
    $('#q-step-counter').textContent = 'Step ' + n + ' of ' + totalSteps;
    $('#q-back').hidden = (n === 1);
    $('#q-next').hidden = (n === totalSteps);
    $('#q-submit').hidden = (n !== totalSteps);
  }

  function collectStep(n) {
    var step = document.querySelector('[data-step="' + n + '"]');
    if (!step) return true;
    var missing = [];
    var firstMissingEl = null;
    step.querySelectorAll('.q-error').forEach(function(el) { el.classList.remove('q-error'); });

    step.querySelectorAll('[data-q]').forEach(function(field) {
      if (field.type === 'radio') return;
      var name = field.getAttribute('data-q');
      var val = (field.value || '').trim();
      if (field.offsetParent === null && field.tagName !== 'SELECT') return;
      if (val) payload[name] = val;
      if (field.hasAttribute('required') && !val) {
        missing.push(FIELD_LABELS[name] || name);
        field.classList.add('q-error');
        if (!firstMissingEl) firstMissingEl = field;
      }
    });

    var radioGroups = {};
    step.querySelectorAll('input[type=radio]').forEach(function(r) {
      var name = r.name;
      var parentFieldset = r.closest('fieldset');
      if (parentFieldset && parentFieldset.offsetParent === null) return;
      if (!radioGroups[name]) {
        radioGroups[name] = {
          dataQ: r.getAttribute('data-q') || name,
          required: r.hasAttribute('required'),
          any: false,
          firstEl: r,
        };
      }
      if (r.checked) {
        radioGroups[name].any = true;
        payload[radioGroups[name].dataQ] = r.value;
      }
    });
    Object.keys(radioGroups).forEach(function(name) {
      var g = radioGroups[name];
      if (g.required && !g.any) {
        missing.push(FIELD_LABELS[g.dataQ] || g.dataQ);
        if (g.firstEl) {
          var fs = g.firstEl.closest('fieldset');
          if (fs) fs.classList.add('q-error');
          if (!firstMissingEl) firstMissingEl = g.firstEl;
        }
      }
    });

    if (missing.length) {
      alert('Please complete: ' + missing.join(', '));
      if (firstMissingEl && firstMissingEl.scrollIntoView) {
        firstMissingEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        if (firstMissingEl.focus) firstMissingEl.focus();
      }
      return false;
    }
    return true;
  }

  function buildReviewSummary() {
    function row(label, val) {
      if (val === undefined || val === null || val === '') return '';
      var esc = String(val).replace(/[<>&"]/g, function(c){ return {'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c]; });
      return '<div class="q-review-row"><span class="q-review-label">' + label + '</span><span class="q-review-value">' + esc + '</span></div>';
    }
    function section(title, body) {
      if (!body) return '';
      return '<div class="q-review-section"><h3 class="q-review-section-title">' + title + '</h3>' + body + '</div>';
    }

    var demographics = '';
    demographics += row('Name', (payload.firstName || '') + ' ' + (payload.lastName || ''));
    demographics += row('Email', payload.email);
    demographics += row('Phone', payload.phone);
    demographics += row('Date of birth', payload.dob);
    demographics += row('Sex', payload.sex);
    var addrLine1 = [(payload.address1||''), (payload.address2||'')].filter(function(p){return p;}).join(', ');
    var addrLine2 = [(payload.city||''), (payload.state||''), (payload.zip||'')].filter(function(p){return p;}).join(', ').replace(/, (\w{2}), /, ', $1 ');
    demographics += row('Address', [addrLine1, addrLine2].filter(function(p){return p;}).join(' • '));

    var indicationLabels = {
      'joint': 'Joint repair / chronic joint pain / post-injury',
      'cognitive': 'Cognitive resilience / brain healthspan',
      'diagnosed': 'Already diagnosed (MCI / dementia / Parkinson\'s / post-stroke)',
      'post-injury': 'Acute post-injury repair',
      'performance': 'Athletic performance / recovery',
      'anti-aging': 'General anti-aging / healthspan',
      'other': 'Other / multiple',
    };

    var goal = '';
    goal += row('Target indication', indicationLabels[payload.indication] || payload.indication);
    goal += row('Goal description', payload.goalDescription);
    goal += row('When', payload.diagnosisDate);

    var health = '';
    health += row('Height', (payload.heightFt || '') + "' " + (payload.heightIn || '') + '"');
    health += row('Current weight', (payload.weightLb || '') + ' lbs');
    health += row('Prior regenerative therapy', payload.priorRegenerative);
    health += row('Cancer history', payload.activeCancer);
    health += row('Autoimmune', payload.autoimmune);
    health += row('Autoimmune detail', payload.autoimmuneDetail);
    health += row('Pregnancy', payload.pregnancy);
    health += row('Current medications', payload.currentMeds);
    health += row('Allergies', payload.allergies);
    health += row('Other notes', payload.other);

    var payment = '';
    payment += row('Payment method', paymentMethodId ? 'Card saved (Stripe …' + paymentMethodId.slice(-6) + ')' : '— not yet saved');

    var html = '';
    html += section('Demographics', demographics);
    html += section('Goal & Indication', goal);
    html += section('Health Background', health);
    html += section('Payment', payment);

    $('#q-review-summary').innerHTML = html;
  }

  async function initStripeCard() {
    if (cardElement) return;
    if (!window.Stripe) {
      $('#stripe-card-error').textContent = 'Stripe failed to load. Refresh and try again.';
      return;
    }

    // Create SetupIntent (no price, no charge — just saves the card)
    var resp;
    try {
    resp = await fetch(API_BASE + '/api/create-setup-intent', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: payload.email || '', firstName: payload.firstName || '', category: 'regenerative-medicine' }),
    });
    } catch (netErr) {
      $('#stripe-card-error').textContent = 'Network error starting secure card capture. Check your connection and try again.';
      return;
    }
    var json = await resp.json();
    if (!json.clientSecret || !json.publishableKey) {
      $('#stripe-card-error').textContent = 'Unable to start secure card capture. Please try again.';
      return;
    }
    stripe = Stripe(json.publishableKey);
    setupIntentClientSecret = json.clientSecret;
    stripeCustomerId = json.customerId || null;

    elements = stripe.elements();
    cardElement = elements.create('card', {
      style: {
        base: { fontSize: '16px', color: '#1a1a1a', '::placeholder': { color: '#999' } },
        invalid: { color: '#d4351c' },
      },
    });
    cardElement.mount('#stripe-card-element');
    cardElement.addEventListener('change', function(e) {
      $('#stripe-card-error').textContent = (e.error && e.error.message) || '';
    });
  }

  async function confirmStripeCard() {
    // Audit 2026-07-07: a SetupIntent can be confirmed only once. If the card is
    // already saved (user went Back then Next), don't re-confirm — that returns
    // setup_intent_unexpected_state and traps the user before Submit.
    if (paymentMethodId) return true;
    if (!stripe || !cardElement || !setupIntentClientSecret) {
      $('#stripe-card-error').textContent = 'Stripe is not ready yet.';
      return false;
    }
    var result = await stripe.confirmCardSetup(setupIntentClientSecret, {
      payment_method: {
        card: cardElement,
        billing_details: {
          name: (payload.firstName || '') + ' ' + (payload.lastName || ''),
          email: payload.email,
          phone: payload.phone,
        },
      },
    });
    if (result.error) {
      $('#stripe-card-error').textContent = result.error.message || 'Card could not be saved.';
      return false;
    }
    paymentMethodId = result.setupIntent.payment_method;
    phCapture('rx_card_saved');
    return true;
  }

  async function submitIntake() {
    if (!$('#q-attestation').checked) {
      alert('Please confirm the attestation to submit.');
      return;
    }
    if (!$('#q-consent-npp').checked || !$('#q-consent-phi').checked) {
      alert('Please acknowledge the Notice of Privacy Practices and the Patient Authorization to submit.');
      return;
    }
    payload.paymentMethodId = paymentMethodId;
    payload.savedAt = new Date().toISOString();
    var fields = {};
    Object.keys(payload).forEach(function(k){ fields[k] = String(payload[k]); });
    fields.scores = JSON.stringify({});
    var resp = await fetch(API_BASE + '/api/contact-form', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        kind: 'form',
        formId: 'regenerative-questionnaire',
        fields: fields,
      }),
    });
    if (resp.ok) {
      // Best-effort persist to EMR — never blocks success UX
      var _intakeBody = JSON.stringify({
          email: payload.email,
          category: 'regenerative-medicine',
          demographics: {
            firstName: payload.firstName, lastName: payload.lastName,
            phone: payload.phone, state: payload.state,
            dob: payload.dob, sex: payload.sex,
          },
          history: {
            medications: payload.currentMeds ? [payload.currentMeds] : [],
            allergies: payload.allergies ? [payload.allergies] : [],
            conditions: [],
            heightIn: payload.heightFt && payload.heightIn
              ? (parseInt(payload.heightFt, 10) * 12 + parseInt(payload.heightIn, 10))
              : undefined,
            weightLb: payload.weightLb ? Number(payload.weightLb) : undefined,
          },
          screeningAnswers: {
            indication: payload.indication, goalDescription: payload.goalDescription,
            diagnosisDate: payload.diagnosisDate, priorRegenerative: payload.priorRegenerative,
            activeCancer: payload.activeCancer, autoimmune: payload.autoimmune,
            autoimmuneDetail: payload.autoimmuneDetail, pregnancy: payload.pregnancy,
            other: payload.other,
          },
          consents: {
            npp: { agreed: true, version: 'consent-npp-v1', at: new Date().toISOString(), text: "I acknowledge I have received and reviewed My4MLife's Notice of Privacy Practices." },
            phiAuth: { agreed: true, version: 'consent-phi-auth-v1', at: new Date().toISOString(), text: 'I authorize My4MLife and its network physicians to use and disclose my health information to provide, coordinate, and bill for my care, including forwarding my intake to the telemedicine provider.' },
          },
          cardOnFile: { paymentMethodId: paymentMethodId, stripeCustomerId: stripeCustomerId },
        });
      fetch(API_BASE + '/api/patient-record-intake', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: _intakeBody,
      }).then(function(r){
        if (r && !r.ok) { throw new Error('intake ' + r.status); }
      }).catch(function() {
        // one retry — a failed intake after a saved card would orphan the payment
        fetch(API_BASE + '/api/patient-record-intake', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: _intakeBody,
        }).catch(function(){ try { window.posthog && window.posthog.capture('rx_intake_persist_failed', { category: PH_CAT }); } catch(e){} });
      });
      showStep('success');
    } else {
      alert('Submission failed. Please try again or email support@my4mlife.com.');
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    populateStateDropdown();
    showStep(1);

    // Conditional UI: autoimmune detail
    document.querySelectorAll('[name="autoimmune"]').forEach(function(r) {
      r.addEventListener('change', function() {
        $('#q-autoimmune-detail').hidden = (r.value !== 'yes');
      });
    });

    // Conditional UI: pregnancy block only for female
    document.querySelectorAll('[data-q="sex"]').forEach(function(el) {
      el.addEventListener('change', function() {
        $('#q-pregnancy-block').hidden = (el.value !== 'female');
      });
    });

    $('#q-next').addEventListener('click', async function() {
      if (!collectStep(currentStep)) return;
      currentStep++;
      if (currentStep === 4) {
        await initStripeCard();
      }
      if (currentStep === totalSteps) {
        var ok = await confirmStripeCard();
        if (!ok) { currentStep--; return; }
        buildReviewSummary();
      }
      showStep(currentStep);
    });

    $('#q-back').addEventListener('click', function() {
      if (currentStep > 1) { currentStep--; showStep(currentStep); }
    });

    var _submitInFlight = false;
    $('#q-submit').addEventListener('click', async function() {
      if (_submitInFlight) return;
      _submitInFlight = true;
      var btn = $('#q-submit'); if (btn) { btn.disabled = true; }
      try { await submitIntake(); }
      catch (e) { _submitInFlight = false; if (btn) { btn.disabled = false; } }
    });
  });
})();
</script>

</BaseLayout>

