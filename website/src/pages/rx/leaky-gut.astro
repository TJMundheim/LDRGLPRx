---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import TrustBand from '../../components/TrustBand.astro';
import { COORDINATOR_MODE, consultHref } from '../../lib/siteMode';

const LANE = 'leaky-gut';

const title = 'Gut-Brain Rx — My4MLife';
const description = 'Telemedicine consult for Gut-Brain Rx — a proprietary, physician-written gut-lining repair formulation, compounded to your needs.';
const canonical = 'https://www.my4mlife.com/rx/leaky-gut';

const rxSteps = [
  {
    title: 'Complete the health questionnaire',
    body: 'Five minutes, from your phone. No appointment, no waiting room.',
  },
  {
    title: 'A physician reviews',
    body: 'A licensed provider evaluates your history and goals.',
  },
  {
    title: 'Delivered to your door',
    body: 'Your protocol ships directly. Ongoing support included.',
  },
];
---
<BaseLayout title={title} description={description} canonical={canonical}>

<section class="rx-section rx-section--top">
  <div class="container rx-inner">
    <p class="rx-eyebrow">Gut-Brain Rx · Telemedicine Consult</p>
    <h1>Gut-Brain Rx: repair the lining, repair the signal to your mind.</h1>
    <figure class="scene-figure">
      <img src="/images/scenes/gut-powder-stir.jpg" alt="A hand stirring fine powder into a glass of water on a dark stone counter" loading="eager" fetchpriority="high" />
      <figcaption>The gut-brain seal is rebuilt one morning at a time. This is what the protocol looks like.</figcaption>
    </figure>
  </div>
</section>

<TrustBand />

<section class="rx-section rx-section--bottom">
  <div class="container rx-inner">
    <p class="rx-lead">
      Your gut makes roughly <strong>90% of your body's serotonin</strong> and about <strong>half of its dopamine</strong>. The vagus nerve carries most of that signal from gut to brain — not the other direction. When the gut lining is damaged, that inflammation travels up the same highway as fog, low mood, and over the years, decline. Repair the lining, and you repair the supply line to your mind.
    </p>

    <p class="rx-body">
      Bloating after meals. Loose or irregular stools. New food sensitivities. Brain fog 30 minutes after eating. These are not separate problems — they are the gut wall failing at its barrier job, letting bacterial fragments cross into systemic circulation and driving low-grade inflammation everywhere it travels. Off-the-shelf probiotics do not repair a damaged barrier; they require an intact one to colonize. The barrier itself needs targeted repair first.
    </p>

    <p class="rx-body">
      Your telemedicine consult evaluates you for <strong>Gut-Brain Rx</strong> — a proprietary, physician-written gut-lining repair formulation, compounded to your needs. Prescribed via our telemedicine partner; not available over the counter.
    </p>
  </div>
</section>

<HowItWorks steps={rxSteps} />

<section class="rx-section rx-section--bottom">
  <div class="container rx-inner">
    <p class="rx-price-line">
      {COORDINATOR_MODE ? (
        <>No card and no charge to start &mdash; a care coordinator call comes first, and the physician visit (free on most lanes; $249 for testosterone and menopause) is booked only if it fits.</>
      ) : (
        <>
          <strong>Free</strong> — telemedicine consult with a physician in our network. No lab work required.
          <span class="rx-pay-note">Medication is billed separately after the physician writes your script.</span>
        </>
      )}
    </p>

    <a class="rx-cta-btn" href={COORDINATOR_MODE ? consultHref(LANE) : '/rx/leaky-gut/questionnaire'}>
      {COORDINATOR_MODE ? 'Start with a free care coordinator call →' : 'Start Your Free Intake →'}
    </a>

    <p class="rx-disclosure">
      {COORDINATOR_MODE ? (
        <>A care coordinator will call you at the time you choose. Nothing is charged, and no card is requested, until a physician visit is actually booked.</>
      ) : (
        <>Submit the form on the next page and our care coordinator will email you within 24 hours to schedule your telemedicine consult with the appropriate physician in our network.</>
      )}
    </p>
  </div>
</section>

</BaseLayout>

<style>
.rx-section { padding: calc(76px + 3.5rem) 1rem 5rem; min-height: 60vh; }
.rx-section--top { padding-bottom: 1.5rem; min-height: 0; }
.rx-section--bottom { padding-top: 1.5rem; min-height: 0; }
.rx-inner { max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.25rem; }
.rx-eyebrow { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.18em; color: var(--accent); text-transform: uppercase; margin: 0; overflow-wrap: break-word; }
.rx-inner h1 { font-family: 'Playfair Display', serif; font-size: clamp(1.85rem, 4vw, 2.6rem); color: var(--primary); margin: 0; line-height: 1.18; max-width: 640px; }
.rx-lead { font-size: 1.1rem; color: var(--text); line-height: 1.6; margin: 0.5rem 0 0; max-width: 640px; }
.rx-body { font-size: 1rem; color: var(--text); line-height: 1.62; margin: 0; max-width: 640px; }
.rx-body strong { color: var(--primary); }
.rx-price-line { font-size: 1.05rem; color: var(--primary); margin: 0.5rem 0 0; max-width: 640px; line-height: 1.55; }
.rx-price-line strong { color: var(--accent); font-size: 1.35rem; }
.rx-pay-note { display: block; font-size: 0.88rem; color: var(--text-light); font-style: italic; margin-top: 0.35rem; }
.rx-cta-btn { display: inline-block; background: var(--accent); color: #fff; padding: 1rem 2.2rem; border-radius: 999px; font-family: 'Inter', sans-serif; font-size: 1.05rem; font-weight: 700; text-decoration: none; margin-top: 1rem; box-shadow: 0 6px 20px rgba(0,184,148,0.25); transition: opacity .15s; }
.rx-cta-btn:hover { opacity: 0.92; }
.rx-disclosure { font-size: 0.85rem; color: var(--text-light); margin: 0.5rem 0 0; max-width: 560px; line-height: 1.5; }
</style>
