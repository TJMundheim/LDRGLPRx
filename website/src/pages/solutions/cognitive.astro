<style>
.gut-cognitive-bridge {
  margin: 1.5rem 0 1.5rem;
  padding: 1.25rem 1.5rem;
  background: linear-gradient(135deg, rgba(0,184,148,0.06) 0%, rgba(46,127,217,0.06) 100%);
  border-left: 3px solid var(--accent);
  border-radius: 8px;
}
.gut-cognitive-bridge h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.2rem;
  color: var(--primary);
  margin: 0 0 0.5rem;
}
.gut-cognitive-bridge ul { list-style: none; padding: 0; margin: 0.5rem 0; }
.gut-cognitive-bridge li { padding: 0.45rem 0 0.45rem 1.4rem; position: relative; font-size: 0.95rem; line-height: 1.55; color: var(--text); }
.gut-cognitive-bridge li::before { content: "◆"; position: absolute; left: 0; top: 0.45rem; color: var(--accent); font-size: 0.65rem; }
.gut-cognitive-bridge strong { color: var(--primary); }
.gut-cognitive-bridge a { color: var(--primary); font-weight: 600; }
</style>

<style>
.two-paths-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.25rem;
  margin: 1.25rem 0;
}
.path-card {
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.path-card.path-rx {
  border-color: var(--primary);
  border-width: 2px;
}
.path-badge {
  display: inline-block;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--accent);
  background: rgba(0,184,148,0.12);
  border: 1px solid rgba(0,184,148,0.35);
  padding: 0.2rem 0.65rem;
  border-radius: 999px;
  align-self: flex-start;
}
.path-badge.path-badge-rx {
  color: var(--primary);
  background: rgba(26,54,93,0.08);
  border-color: rgba(26,54,93,0.3);
}
.path-card h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.15rem;
  color: var(--primary);
  margin: 0;
}
.path-price {
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--accent);
  margin: 0 !important;
}
.path-card p { font-size: 0.9rem; color: var(--text-light); margin: 0; }
.path-card .btn-sol { align-self: flex-start; margin-top: 0.5rem; }
.when-strip {
  display: flex;
  gap: 1.5rem;
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.25rem 1.5rem;
  margin: 1rem 0 1.5rem;
}
@media (max-width: 560px) {
  .when-strip { flex-direction: column; }
  .when-divider { display: none; }
}
.when-col { flex: 1; }
.when-divider { width: 1px; background: var(--border); }
.when-label {
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--primary);
  margin-bottom: 0.35rem;
}
.when-col p { font-size: 0.88rem; color: var(--text-light); margin: 0; }
.protege-card {
  background: linear-gradient(135deg, rgba(26,54,93,0.06) 0%, rgba(0,184,148,0.06) 100%);
  border: 1px solid var(--border);
  border-left: 4px solid var(--accent);
  border-radius: var(--radius);
  padding: 1.1rem 1.4rem;
  font-size: 0.92rem;
  color: var(--text);
  margin: 0 0 2rem;
}
.protege-card a { color: var(--accent); font-weight: 600; text-decoration: none; }
.protege-card a:hover { text-decoration: underline; }
.read-more-link {
  display: inline-block;
  margin-top: 0.5rem;
  color: var(--accent);
  font-weight: 600;
  font-size: 0.9rem;
  text-decoration: none;
}
.read-more-link:hover { text-decoration: underline; }
.two-paths-section { margin-bottom: 2rem; }
.why-matters-link { margin-top: 1rem; text-align: center; }
.why-matters-link a { font-family: 'Inter', sans-serif; font-size: 0.875rem; font-weight: 600; color: var(--accent); text-decoration: none; }
.why-matters-link a:hover { text-decoration: underline; }
</style>
