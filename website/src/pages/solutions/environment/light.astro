<style>
.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 1.25rem;
  margin: 1rem 0 2.5rem;
}
.product-card {
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.4rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  transition: border-color 0.18s, box-shadow 0.18s, transform 0.18s;
}
.product-card:hover {
  border-color: var(--accent);
  box-shadow: 0 4px 18px rgba(0,184,148,0.14);
  transform: translateY(-2px);
}
.product-card h3 {
  font-size: 1rem;
  font-weight: 700;
  color: var(--primary);
  margin: 0;
}
.product-why {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--accent);
  margin: 0 !important;
}
.product-card p {
  font-size: 0.875rem;
  color: var(--text-light);
  margin: 0;
  flex: 1;
}
.notify-pill {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--accent);
  background: rgba(0,184,148,0.1);
  border: 1px solid rgba(0,184,148,0.35);
  padding: 0.2rem 0.65rem;
  border-radius: 999px;
  align-self: flex-start;
  margin-top: 0.25rem;
}
.btn-cart {
  display: inline-block;
  margin-top: 0.5rem;
  padding: 0.45rem 1.1rem;
  background: var(--accent);
  color: #fff;
  border-radius: 999px;
  font-size: 0.82rem;
  font-weight: 700;
  text-decoration: none;
  align-self: flex-start;
  transition: background 0.15s;
}
.btn-cart:hover { background: var(--accent-dark); }

.blog-deepdive-btn {
  display: inline-block;
  margin: 0.75rem 0 2rem;
  padding: 0.55rem 1.4rem;
  background: var(--bg-soft);
  border: 1px solid var(--accent);
  border-radius: 999px;
  color: var(--accent);
  font-size: 0.875rem;
  font-weight: 600;
  text-decoration: none;
  transition: background 0.15s, color 0.15s;
}
.blog-deepdive-btn:hover {
  background: var(--accent);
  color: #fff;
}

.protege-card {
  background: linear-gradient(135deg, rgba(26,54,93,0.05) 0%, rgba(0,184,148,0.06) 100%);
  border: 1px solid var(--border);
  border-left: 4px solid var(--accent);
  border-radius: var(--radius);
  padding: 1.1rem 1.4rem;
  font-size: 0.92rem;
  color: var(--text);
  margin: 1rem 0 0;
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  align-items: center;
}
.protege-link {
  color: var(--accent);
  font-weight: 700;
  text-decoration: none;
  white-space: nowrap;
}
.protege-link:hover { text-decoration: underline; }
</style>
