<style>
.why-lede {
  font-size: 1.05rem;
  font-style: italic;
  color: var(--text);
  margin: 0 0 1rem;
  line-height: 1.6;
}
.why-list strong { color: var(--primary); }
.why-reveal {
  margin: 1rem 0 0;
  padding: 0.9rem 1.1rem;
  background: linear-gradient(135deg, rgba(0,184,148,0.08) 0%, rgba(46,127,217,0.06) 100%);
  border-left: 3px solid var(--accent);
  border-radius: 8px;
  font-size: 0.97rem;
  line-height: 1.65;
  color: var(--text);
}
.why-reveal em { color: var(--primary); font-weight: 600; font-style: italic; }
</style>

<style>
