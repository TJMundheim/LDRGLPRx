---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUDIT_QUESTIONS } from '../data/audit-questions';
import { SKUS } from '../data/skus';

const title = 'The 4M Audit — My4MLife';
const description = 'Take the 4M Audit. 8 questions, 3 minutes — see your top 3 priorities and the exact starting point.';
const canonical = 'https://www.my4mlife.com/audit';

type SolutionRow = {
  otc: { skuId: string; name: string; tagline: string } | null;
  rx: { name: string; tagline: string; skuId: string } | null;
};

const SOLUTIONS: Record<string, SolutionRow> = {
  gut: {
    otc: { skuId: 'biome-ns-ultra-sub', name: 'Biome NS Ultra', tagline: 'Daily gut-brain seal powder — L-glutamine, DGL, berberine, aloe, curcumin, zinc carnosine. The foundational starting protocol.' },
    rx: { skuId: 'comprehensive-consult', name: 'Biome NS Rx (oral BPC-157)', tagline: 'Single-active compounded oral BPC-157, prescribed via telemedicine consult. Stacks on top of Biome NS Ultra for deeper repair.' },
  },
  sleep: {
    otc: { skuId: 'sleeprestore-sub', name: 'SleepRestore', tagline: 'Magnesium bisglycinate + glycine + apigenin + L-theanine + KSM-66 ashwagandha. Sleep architecture + cortisol + nocturnal CV protection.' },
    rx: { skuId: 'comprehensive-consult', name: 'SleepRestore Rx (oral nattokinase)', tagline: 'Compounded oral nattokinase prescribed via telemedicine consult — nocturnal cardiovascular fibrinolytic for the highest-risk hours.' },
  },
  weight: {
    otc: null,
    rx: { skuId: 'comprehensive-consult', name: 'Weight-loss consult — GLP-1 candidacy', tagline: 'Telemedicine consult to evaluate GLP-1 candidacy (semaglutide/tirzepatide) plus the full metabolic protocol. The first move on weight is the clinical conversation.' },
  },
  nutrition: {
    otc: null,
    rx: { skuId: 'comprehensive-consult', name: 'Nutrition consult', tagline: 'Telemedicine consult to map your nutrition protocol against your hormones, gut, and metabolic markers.' },
  },
  'erectile-dysfunction': {
    otc: { skuId: 'mitovita-sub', name: 'MitoVita', tagline: 'Creatine + L-citrulline + beetroot + electrolytes. Mitochondrial ATP + endothelial nitric oxide — the OTC foundation for ED and stamina.' },
    rx: { skuId: 'comprehensive-consult', name: 'ED consult — PDE5i + hormonal review', tagline: 'ED is a canary. Telemedicine consult to evaluate hormones, vascular health, and PDE5-inhibitor or TRT candidacy.' },
  },
  environment: {
    otc: null,
    rx: null,
  },
  cognitive: {
    otc: { skuId: 'neurobridge-sub', name: 'NeuroBridge', tagline: 'Methylated B-complex (P-5-P, methylcobalamin, 5-MTHF) — homocysteine + methylation foundation for cognitive longevity.' },
    rx: { skuId: 'comprehensive-consult', name: 'Cognitive consult', tagline: 'Telemedicine consult for cognitive baseline, peptide candidacy, and hormone-cognition integration.' },
  },
  hormones: {
    otc: null,
    rx: { skuId: 'comprehensive-consult', name: 'Hormone consult — TRT candidacy', tagline: 'Telemedicine consult to evaluate TRT candidacy and order your full hormone panel.' },
  },
};

// Backfill OTC names/taglines from skus.ts if a SOLUTIONS entry didn't override them
for (const slug of Object.keys(SOLUTIONS)) {
  const otc = SOLUTIONS[slug].otc;
  if (otc) {
    const sku = SKUS[otc.skuId];
    if (sku) {
      if (!otc.tagline) otc.tagline = sku.tagline ?? '';
      if (!otc.name) otc.name = sku.name;
    }
  }
}
---
<BaseLayout title={title} description={description} canonical={canonical}>

<section class="audit-hero">
  <div class="container audit-hero-inner">
    <div class="audit-badge">FREE · 3 MINUTES · NO ACCOUNT REQUIRED</div>
    <h1>The <em>4M Audit</em></h1>
    <p class="audit-sub">Begin with the end in mind. Tell us where you are — we'll show you the 3 most-leveraged places to start.</p>
  </div>
</section>

<section class="audit-shell">
  <div class="container">

    <!-- STEP 1 -->
    <div id="step-1" class="audit-step is-active">
      <div class="audit-card">
        <h2>First, where do we send your results?</h2>
        <p class="audit-card-sub">Three quick fields, then 8 questions.</p>
        <form id="lead-form" class="lead-form" novalidate>
          <label class="field">
            <span class="field-label">First name</span>
            <input type="text" name="firstName" id="firstName" required autocomplete="given-name" />
          </label>
          <label class="field">
            <span class="field-label">Email</span>
            <input type="email" name="email" id="email" required autocomplete="email" />
          </label>
          <label class="field">
            <span class="field-label">Phone <span class="optional">(optional)</span></span>
            <input type="tel" name="phone" id="phone" autocomplete="tel" />
            <span class="carrot">Optional — we'll text & email you a copy of your results.</span>
          </label>
          <div id="lead-error" class="lead-error" hidden></div>
          <button type="submit" class="btn-primary" id="lead-submit">Start the Audit →</button>
        </form>
      </div>
    </div>

    <!-- STEP 2 -->
    <div id="step-2" class="audit-step">
      <div class="audit-progress">
        <span id="progress-label">0 of 8 answered</span>
        <div class="progress-bar"><div class="progress-fill" id="progress-fill"></div></div>
      </div>
      <ol class="question-list">
        {AUDIT_QUESTIONS.map((q) => (
          <li class="question" data-qid={q.solutionSlug}>
            <div class="q-head">
              <span class="q-n">{q.n}</span>
              <h3 class="q-label">{q.label}</h3>
            </div>
            <p class="q-prompt">{q.prompt}</p>
            <div class="likert" role="radiogroup" aria-label={q.label}>
              {[0, 1, 2, 3, 4, 5].map((v) => (
                <label class="likert-opt">
                  <input type="radio" name={`q-${q.solutionSlug}`} value={v} data-slug={q.solutionSlug} />
                  <span>{v}</span>
                </label>
              ))}
            </div>
            <details class="score-guide">
              <summary>Scoring guide</summary>
              <p>{q.scoreGuide}</p>
              <p class="cat-note">{q.categoryNote}</p>
            </details>
          </li>
        ))}
      </ol>
      <button type="button" class="btn-primary" id="survey-submit" disabled>See My Top 3 →</button>
    </div>

    <!-- STEP 3 -->
    <div id="step-3" class="audit-step">
      <div class="results-head">
        <h2>Your ranked priorities</h2>
        <p class="results-sub">Listed in order of where you'll get the biggest leverage right now. Each category has an over-the-counter path and a prescription path — start with whichever fits where you are today.</p>
      </div>
      <ol id="ranked-list" class="ranked-list"></ol>
      <p class="retake-line">
        <button type="button" id="retake-audit" class="link-button">Retake the audit</button>
      </p>
    </div>

  </div>
</section>

<script is:inline define:vars={{
  solutions: SOLUTIONS,
  questions: AUDIT_QUESTIONS,
  LEAD_URL: import.meta.env.PUBLIC_LEAD_CAPTURE_URL || '/api/lead-capture',
  COMPLETE_URL: import.meta.env.PUBLIC_AUDIT_COMPLETE_URL || '/api/audit-complete',
}}>

  function uuid() {
    if (crypto.randomUUID) return crypto.randomUUID();
    return 'local-' + Math.random().toString(36).slice(2) + Date.now().toString(36);
  }

  function showStep(n) {
    document.querySelectorAll('.audit-step').forEach((el) => el.classList.remove('is-active'));
    document.getElementById('step-' + n).classList.add('is-active');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  const leadForm = document.getElementById('lead-form');
  const leadError = document.getElementById('lead-error');
  leadForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    leadError.hidden = true;
    const firstName = document.getElementById('firstName').value.trim();
    const email = document.getElementById('email').value.trim();
    const phone = document.getElementById('phone').value.trim();
    if (!firstName || !email || !/^\S+@\S+\.\S+$/.test(email)) {
      leadError.textContent = 'Please enter your first name and a valid email.';
      leadError.hidden = false;
      return;
    }
    sessionStorage.setItem('audit.firstName', firstName);
    sessionStorage.setItem('audit.email', email);
    if (phone) sessionStorage.setItem('audit.phone', phone);
    let contactId = null;
    try {
      const r = await fetch(LEAD_URL, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ firstName, email, phone: phone || undefined }),
      });
      if (r.ok) {
        const data = await r.json();
        contactId = data.contactId;
      }
    } catch (_) { /* fall through to local */ }
    if (!contactId) contactId = uuid();
    sessionStorage.setItem('audit.contactId', contactId);
    showStep(2);
  });

  const total = questions.length;
  const answers = {};
  const surveySubmit = document.getElementById('survey-submit');
  const progressLabel = document.getElementById('progress-label');
  const progressFill = document.getElementById('progress-fill');

  document.querySelectorAll('input[type=radio][data-slug]').forEach((input) => {
    input.addEventListener('change', (e) => {
      const t = e.target;
      answers[t.dataset.slug] = parseInt(t.value, 10);
      const n = Object.keys(answers).length;
      progressLabel.textContent = `${n} of ${total} answered`;
      progressFill.style.width = `${(n / total) * 100}%`;
      surveySubmit.disabled = n < total;
    });
  });

  // Inline scoring (mirrors ~/lib/survey-scoring.ts)
  const BONUS_MAP = { gut: 2 };
  function rankAll(raw) {
    const entries = Object.entries(raw).map(([id, r]) => ({
      id,
      raw: r,
      bonus: BONUS_MAP[id] || 0,
      total: r + (BONUS_MAP[id] || 0),
    }));
    entries.sort((a, b) => b.total - a.total || b.bonus - a.bonus || a.id.localeCompare(b.id));
    return entries;
  }

  function solutionBlock(kind, sol, contactId) {
    if (!sol) {
      return `<div class="sol sol--placeholder"><span class="sol-kind">${kind}</span><div class="sol-body"><h4>Coming soon</h4><p class="sol-tag">No standalone ${kind === 'OTC' ? 'over-the-counter product' : 'prescription pathway'} for this category yet. We'll notify you when it launches.</p></div></div>`;
    }
    const href = `/cart?sku=${encodeURIComponent(sol.skuId)}&contactId=${encodeURIComponent(contactId)}`;
    const ctaLabel = kind === 'Rx' ? 'Book the consult →' : `Order ${sol.name.split(' — ')[0].split(' (')[0]} →`;
    return `<div class="sol sol--${kind.toLowerCase()}"><span class="sol-kind">${kind}</span><div class="sol-body"><h4>${sol.name}</h4><p class="sol-tag">${sol.tag || sol.tagline}</p><a class="btn-primary btn-primary--sm" href="${href}">${ctaLabel}</a></div></div>`;
  }

  function renderResults(raw, contactId) {
    const ranked = rankAll(raw);
    const top3 = ranked.slice(0, 3).map((r) => r.id);
    const list = document.getElementById('ranked-list');
    list.innerHTML = '';
    ranked.forEach((r, idx) => {
      const q = questions.find((x) => x.solutionSlug === r.id);
      const sol = solutions[r.id] || { otc: null, rx: null };
      const li = document.createElement('li');
      li.className = 'ranked-row';
      li.innerHTML = `
        <div class="rank-head">
          <div class="rank-num">#${idx + 1}</div>
          <div class="rank-title">
            <h3>${q.label}</h3>
            <p class="rank-note">${q.categoryNote}</p>
          </div>
          <div class="rank-score">${r.total}/12</div>
        </div>
        <div class="rank-solutions">
          ${solutionBlock('OTC', sol.otc, contactId)}
          ${solutionBlock('Rx', sol.rx, contactId)}
        </div>
      `;
      list.appendChild(li);
    });
    return top3;
  }

  surveySubmit.addEventListener('click', () => {
    const raw = {};
    for (const q of questions) {
      raw[q.solutionSlug] = (answers[q.solutionSlug] || 0) * 2;
    }
    const contactId = sessionStorage.getItem('audit.contactId');
    const top3 = renderResults(raw, contactId);

    sessionStorage.setItem('audit.answers', JSON.stringify(answers));
    sessionStorage.setItem('audit.scores', JSON.stringify(raw));
    sessionStorage.setItem('audit.top3', JSON.stringify(top3));

    fetch(COMPLETE_URL, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ contactId, scores: raw, top3 }),
    }).catch(() => {});

    showStep(3);
  });

  document.getElementById('retake-audit').addEventListener('click', () => {
    sessionStorage.removeItem('audit.answers');
    sessionStorage.removeItem('audit.scores');
    sessionStorage.removeItem('audit.top3');
    for (const k in answers) delete answers[k];
    document.querySelectorAll('input[type=radio][data-slug]').forEach((i) => { i.checked = false; });
    progressLabel.textContent = `0 of ${total} answered`;
    progressFill.style.width = '0%';
    surveySubmit.disabled = true;
    showStep(2);
  });

  // Resume: if results already stored, jump straight to step 3.
  // Otherwise, if partial answers exist, restore them so the user can continue.
  (function resume() {
    const storedScores = sessionStorage.getItem('audit.scores');
    const storedContactId = sessionStorage.getItem('audit.contactId');
    if (storedScores && storedContactId) {
      try {
        renderResults(JSON.parse(storedScores), storedContactId);
        showStep(3);
        return;
      } catch (_) { /* fall through */ }
    }
    const storedAnswers = sessionStorage.getItem('audit.answers');
    if (storedAnswers) {
      try {
        const a = JSON.parse(storedAnswers);
        for (const slug in a) {
          const input = document.querySelector(`input[type=radio][data-slug="${slug}"][value="${a[slug]}"]`);
          if (input) {
            input.checked = true;
            answers[slug] = a[slug];
          }
        }
        const n = Object.keys(answers).length;
        progressLabel.textContent = `${n} of ${total} answered`;
        progressFill.style.width = `${(n / total) * 100}%`;
        surveySubmit.disabled = n < total;
        if (storedContactId) showStep(2);
      } catch (_) { /* ignore */ }
    }
  })();
</script>

<style>
  .audit-hero {
    background: linear-gradient(180deg, #fff 0%, #f7f5f0 100%);
    padding: 4rem 0 2rem;
    text-align: center;
  }
  .audit-hero-inner { max-width: 760px; margin: 0 auto; }
  .audit-badge {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--accent, #b8722e);
    margin-bottom: 1rem;
    font-weight: 600;
  }
  .audit-hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 5vw, 3.25rem);
    margin: 0 0 1rem;
    font-weight: 500;
  }
  .audit-hero h1 em { color: var(--accent, #b8722e); font-style: italic; }
  .audit-sub {
    font-family: 'Inter', sans-serif;
    font-size: 1.125rem;
    color: #4a4a4a;
    line-height: 1.5;
  }
  .audit-shell { padding: 2rem 0 5rem; font-family: 'Inter', sans-serif; }
  .audit-step { display: none; }
  .audit-step.is-active { display: block; }
  .audit-card {
    background: #fff;
    border: 1px solid #e8e2d6;
    border-radius: 12px;
    padding: 2rem;
    max-width: 560px;
    margin: 0 auto;
    box-shadow: 0 2px 18px rgba(0,0,0,0.04);
  }
  .audit-card h2 {
    font-family: 'Playfair Display', serif;
    margin: 0 0 0.5rem;
    font-size: 1.5rem;
  }
  .audit-card-sub { color: #6b6b6b; margin: 0 0 1.5rem; }
  .lead-form { display: flex; flex-direction: column; gap: 1rem; }
  .field { display: flex; flex-direction: column; gap: 0.35rem; }
  .field-label { font-size: 0.875rem; font-weight: 600; color: #333; }
  .optional { font-weight: 400; color: #999; }
  .field input {
    padding: 0.75rem 0.9rem;
    border: 1px solid #d4cdbf;
    border-radius: 8px;
    font-size: 1rem;
    font-family: inherit;
  }
  .field input:focus { outline: none; border-color: var(--accent, #b8722e); }
  .carrot { font-size: 0.8rem; color: #777; }
  .lead-error { background: #fdecec; color: #a02020; padding: 0.6rem 0.8rem; border-radius: 6px; font-size: 0.9rem; }
  .btn-primary {
    background: var(--accent, #b8722e);
    color: #fff;
    border: none;
    padding: 0.9rem 1.5rem;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    text-align: center;
    font-family: inherit;
    transition: opacity 0.15s;
  }
  .btn-primary:hover { opacity: 0.9; }
  .btn-primary:disabled { opacity: 0.4; cursor: not-allowed; }

  .audit-progress {
    position: sticky;
    top: 0;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(6px);
    padding: 0.75rem 0;
    z-index: 10;
    border-bottom: 1px solid #eee;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: #555;
  }
  .progress-bar { height: 6px; background: #eee; border-radius: 3px; margin-top: 0.4rem; overflow: hidden; }
  .progress-fill { height: 100%; background: var(--accent, #b8722e); width: 0; transition: width 0.25s ease; }

  .question-list { list-style: none; padding: 0; margin: 0; max-width: 720px; margin: 0 auto; }
  .question {
    background: #fff;
    border: 1px solid #e8e2d6;
    border-radius: 10px;
    padding: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .q-head { display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 0.5rem; }
  .q-n { font-family: 'Playfair Display', serif; color: var(--accent, #b8722e); font-size: 1.25rem; }
  .q-label { font-family: 'Playfair Display', serif; margin: 0; font-size: 1.25rem; font-weight: 500; }
  .q-prompt { color: #333; margin: 0 0 1rem; line-height: 1.5; }
  .likert { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
  .likert-opt { flex: 1; min-width: 48px; }
  .likert-opt input { position: absolute; opacity: 0; pointer-events: none; }
  .likert-opt span {
    display: block;
    text-align: center;
    padding: 0.6rem 0;
    border: 1px solid #d4cdbf;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
    color: #555;
    transition: all 0.15s;
  }
  .likert-opt input:checked + span {
    background: var(--accent, #b8722e);
    color: #fff;
    border-color: var(--accent, #b8722e);
  }
  .score-guide { font-size: 0.875rem; color: #666; }
  .score-guide summary { cursor: pointer; color: var(--accent, #b8722e); font-weight: 500; }
  .score-guide p { margin: 0.5rem 0; }
  .cat-note { font-style: italic; }

  #survey-submit { display: block; margin: 2rem auto 0; min-width: 220px; }

  .results-head { text-align: center; max-width: 720px; margin: 0 auto 2.5rem; }
  .results-head h2 { font-family: 'Playfair Display', serif; font-size: 2rem; margin: 0 0 0.5rem; }
  .results-sub { color: #555; }
  .ranked-list { list-style: none; padding: 0; margin: 0 auto; max-width: 960px; display: flex; flex-direction: column; gap: 1.5rem; }
  .ranked-row { background: #fff; border: 1px solid #e8e2d6; border-radius: 14px; padding: 1.5rem; }
  .rank-head { display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: start; padding-bottom: 1rem; border-bottom: 1px solid #f0ebe0; margin-bottom: 1.25rem; }
  .rank-num { font-family: 'Playfair Display', serif; font-size: 1.75rem; color: var(--accent, #b8722e); font-weight: 600; line-height: 1; }
  .rank-title h3 { font-family: 'Playfair Display', serif; margin: 0 0 0.3rem; font-size: 1.35rem; }
  .rank-note { color: #555; font-size: 0.9rem; margin: 0; }
  .rank-score { font-size: 0.85rem; color: #777; font-weight: 600; align-self: center; }
  .rank-solutions { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width: 640px) { .rank-solutions { grid-template-columns: 1fr; } }
  .sol { display: flex; gap: 0.75rem; padding: 1rem; border-radius: 10px; background: #faf7f1; }
  .sol--rx { background: #f3f6f9; }
  .sol--placeholder { background: #f5f5f5; opacity: 0.85; }
  .sol-kind { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; color: var(--accent, #b8722e); flex-shrink: 0; padding-top: 2px; }
  .sol--rx .sol-kind { color: #2a5980; }
  .sol-body { flex: 1; }
  .sol-body h4 { font-family: 'Playfair Display', serif; margin: 0 0 0.4rem; font-size: 1rem; }
  .sol-tag { font-size: 0.85rem; color: #444; margin: 0 0 0.75rem; line-height: 1.45; }
  .btn-primary--sm { padding: 0.5rem 0.9rem; font-size: 0.85rem; }
  .retake-line { text-align: center; margin-top: 2rem; }
  .link-button { background: none; border: none; color: var(--accent, #b8722e); font: inherit; text-decoration: underline; cursor: pointer; padding: 0; }
  .all-list { list-style: none; padding: 0; margin: 1rem 0 0; }
  .all-list li {
    display: flex;
    justify-content: space-between;
    padding: 0.6rem 0;
    border-bottom: 1px solid #eee;
  }
  .al-score { color: #777; font-variant-numeric: tabular-nums; }
</style>

</BaseLayout>
</content>
</invoke>