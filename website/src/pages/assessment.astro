---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUDIT_QUESTIONS } from '../data/audit-questions';
import { SOLUTIONS } from '../data/audit-solutions';

const title = "Free 4M Health Assessment — My4MLife";
const description = "Take the free 4M Assessment. 8 quick questions, about 3 minutes. We'll show you your top 3 mitigating factors so you know exactly where to start.";
const canonical = "https://www.my4mlife.com/assessment";
const keywords = "4M assessment, personalized health assessment, gut health quiz, hormone balance test, cognitive health assessment, My4MLife, free health quiz";
const robots = "index, follow";
---
<BaseLayout title={title} description={description} canonical={canonical} keywords={keywords} robots={robots}>

<!-- ===== HERO ===== -->
<section class="assess-hero">
  <div class="container assess-hero-inner">
    <div class="assess-badge">FREE · 3 MINUTES · NO ACCOUNT REQUIRED</div>
    <h1>Take the Free <em>4M Assessment</em></h1>
    <p class="assess-sub">8 quick questions. About 3 minutes. We'll show you your top 3 mitigating factors so you know where to start.</p>
    <div class="assess-meta">
      <span class="assess-chip">8 questions</span>
      <span class="assess-chip">~3 min</span>
      <span class="assess-chip">Results instantly</span>
      <span class="assess-chip">Private — no data sold</span>
    </div>
  </div>
</section>

<!-- ===== STICKY PROGRESS HEADER ===== -->
<div class="assess-sticky" id="assess-sticky" role="status" aria-live="polite">
  <div class="container assess-sticky-inner">
    <span class="assess-sticky-label" id="progress-label">0 of 8 answered</span>
    <div class="assess-progress-bar" aria-hidden="true">
      <div class="assess-progress-fill" id="progress-fill" style="width:0%"></div>
    </div>
  </div>
</div>

<!-- ===== QUESTIONS ===== -->
<section class="assess-questions" id="questions-section">
  <div class="container assess-questions-inner">
    <div class="assess-instructions">
      Rate each area honestly. <strong>0 = no problem at all &middot; 5 = severe / highly problematic.</strong>
    </div>

    <div class="q-list" id="q-list">
      {AUDIT_QUESTIONS.map((q) => (
        <div class="q-card" id={`card-${q.id}`} data-id={q.id} aria-label={`Question ${q.n}: ${q.prompt}`}>
          <div class="q-header">
            <span class="q-num">{q.n}</span>
            <span class="q-label">{q.label}</span>
          </div>
          <p class="q-prompt">{q.prompt}</p>

          <!-- 0-5 Likert buttons -->
          <div class="likert-row" role="group" aria-label={`Score for ${q.label}`} data-qid={q.id}>
            {[0,1,2,3,4,5].map((val) => (
              <button
                class="likert-btn"
                data-val={val}
                data-qid={q.id}
                aria-pressed="false"
                aria-label={`Score ${val}`}
                type="button"
              >{val}</button>
            ))}
          </div>
          <div class="likert-labels">
            <span>No problem</span>
            <span>Severe</span>
          </div>

          {q.id === 'weight-body-fat' && (
            <div class="bmi-calc" aria-label="BMI calculator (informational, does not affect your score)">
              <div class="bmi-calc-header">Optional: BMI calculator <span class="bmi-calc-note">(informational only — does not change your score)</span></div>
              <div class="bmi-inputs">
                <div class="bmi-field">
                  <label for="bmi-ft">Height (ft)</label>
                  <input type="number" id="bmi-ft" min="3" max="8" step="1" placeholder="5" inputmode="numeric" />
                </div>
                <div class="bmi-field">
                  <label for="bmi-in">Height (in)</label>
                  <input type="number" id="bmi-in" min="0" max="11" step="1" placeholder="10" inputmode="numeric" />
                </div>
                <div class="bmi-field">
                  <label for="bmi-lb">Weight (lbs)</label>
                  <input type="number" id="bmi-lb" min="50" max="700" step="1" placeholder="180" inputmode="numeric" />
                </div>
              </div>
              <div class="bmi-result" id="bmi-result" aria-live="polite">
                <span class="bmi-value" id="bmi-value">—</span>
                <span class="bmi-badge" id="bmi-badge" hidden></span>
              </div>
            </div>
          )}

          <!-- Expandable scoring guide -->
          <button
            class="guide-toggle"
            data-qid={q.id}
            aria-expanded="false"
            type="button"
          >&#9660; How to score this</button>
          <div class="guide-panel" id={`guide-${q.id}`} hidden>
            <p class="guide-text">{q.scoreGuide}</p>
            <p class="guide-note">{q.categoryNote}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="assess-footer">
      <button class="btn btn-primary btn-large" id="continue-btn" disabled type="button">
        See My Results &rarr;
      </button>
      <p class="req-note" id="req-note">Answer all 8 questions to continue</p>
    </div>
  </div>
</section>

<!-- ===== EMAIL CAPTURE FORM ===== -->
<section class="assess-capture" id="capture-section" hidden>
  <div class="container assess-capture-inner">
    <h2>Almost there — where should we send your results?</h2>
    <p class="capture-sub">We'll show your top 3 factors on screen immediately. Your information is never sold.</p>

    <form class="capture-form" id="capture-form" novalidate>
      <div class="form-row">
        <div class="form-field">
          <label for="field-name">First name <span aria-hidden="true">*</span></label>
          <input type="text" id="field-name" name="firstName" autocomplete="given-name" required placeholder="Your first name" />
        </div>
        <div class="form-field">
          <label for="field-email">Email <span aria-hidden="true">*</span></label>
          <input type="email" id="field-email" name="email" autocomplete="email" required placeholder="you@example.com" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="field-phone">Phone <span class="optional">(optional)</span></label>
          <input type="tel" id="field-phone" name="phone" autocomplete="tel" placeholder="(555) 000-0000" />
        </div>
      </div>
      <div class="form-check">
        <label class="check-label">
          <input type="checkbox" id="field-consent" name="aiConsent" required />
          <span>I consent to receive AI-assisted health communications from My4MLife. I understand I may opt out at any time.</span>
        </label>
      </div>
      <p class="form-error" id="form-error" hidden></p>
      <button class="btn btn-primary btn-large" type="submit" id="submit-btn">
        Show My Top 3 Factors &rarr;
      </button>
    </form>
  </div>
</section>

<!-- ===== RESULTS PANEL ===== -->
<section class="assess-results" id="results-section" hidden>
  <div class="container assess-results-inner">
    <div class="results-header">
      <div class="results-badge">YOUR ASSESSMENT RESULTS</div>
      <h2 id="results-greeting">Here are your top 3 mitigating factors.</h2>
      <p class="results-sub">These are the areas where addressing the root cause will create the biggest ripple effect across your health.</p>
    </div>

    <div class="results-cards" id="results-cards">
      <!-- Populated by JS -->
    </div>

    <!-- ===== PROTEGE CTA ===== -->
    <div class="protege-cta-block" id="protege-cta-block">
      <div class="protege-cta-badge">NEXT STEP — FREE</div>
      <h3 class="protege-cta-heading">Ready for the full experience? Become a Prot&eacute;g&eacute;.</h3>
      <ul class="protege-cta-benefits">
        <li>Free access to the My4MLife app with your personalized 4M workbook</li>
        <li>Weekly live Zooms with Dr. TJ and the team</li>
        <li>15% off your first order &mdash; 25% on a 90-day bundle of 2+ products or any subscription</li>
        <li>No purchase required. No commitment. Free forever.</li>
      </ul>
      <a id="protege-cta-link" href="/protege-signup" class="btn btn-primary btn-large">
        Become a Prot&eacute;g&eacute; &mdash; It&apos;s Free &rarr;
      </a>
      <p class="protege-cta-note">Non-members pay full retail. Prot&eacute;g&eacute;s never do.</p>
    </div>

    <!-- ===== PRODUCT TILES (per top-3 category) ===== -->
    <div class="results-products" id="results-products">
      <!-- Populated by JS from SOLUTIONS data -->
    </div>

    <div class="results-ctas">
      <a href="/consult" class="btn btn-outline btn-large">Schedule Your Comprehensive 4M Consult</a>
    </div>

    <p class="results-disclaimer">
      This assessment is for informational purposes only and does not constitute medical advice, diagnosis, or treatment. Always consult a qualified healthcare provider before making changes to your health regimen.
    </p>
  </div>
</section>

<script is:inline define:vars={{ SOLUTIONS_DATA: SOLUTIONS, API_BASE: (import.meta.env.PUBLIC_LEAD_CAPTURE_API_URL ?? 'https://v9svm8ds74.execute-api.us-east-2.amazonaws.com') }}>
(function () {
  'use strict';

  // ── Data mirrored from website/src/data/audit-questions.ts ──
  var QUESTIONS = [
    { id: 'gut-microbiome',       n: '01', label: 'Gut health / leaky gut',           priorityTier: true, solutionSlug: 'gut'                  },
    { id: 'sleep',                n: '02', label: 'Sleep / sleep optimization',       priorityTier: true, solutionSlug: 'sleep'                },
    { id: 'weight-body-fat',      n: '03', label: 'Weight (BMI)',                     priorityTier: true, solutionSlug: 'weight'               },
    { id: 'nutrition',            n: '04', label: 'Diet / nutrition',                 priorityTier: true, solutionSlug: 'nutrition'            },
    { id: 'erectile-dysfunction', n: '05', label: 'Erectile + sexual function',       priorityTier: true, solutionSlug: 'erectile-dysfunction' },
    { id: 'environment',          n: '06', label: 'Environment',                      priorityTier: true, solutionSlug: 'environment'          },
    { id: 'cognitive',            n: '07', label: 'Cognitive / brain fog',            priorityTier: true, solutionSlug: 'cognitive'            },
    { id: 'hormone-balance',      n: '08', label: 'Hormone optimization / TRT',       priorityTier: true, solutionSlug: 'hormones'             },
  ];

  var LS_KEY = 'public-assessment-v1';

  // ── State ──
  var scores = {}; // { [id]: 0-5 }
  var userName = '';
  var userEmail = '';
  var userPhone = '';

  // ── ?reset=1 wipe ──
  (function maybeReset() {
    try {
      var params = new URLSearchParams(window.location.search);
      if (params.get('reset') === '1') {
        localStorage.removeItem(LS_KEY);
      }
      // Pre-fill from query params (passed from assessment results CTA)
      if (params.get('name')) {
        var n = document.getElementById('field-name');
        if (n) n.value = decodeURIComponent(params.get('name'));
      }
      if (params.get('email')) {
        var em = document.getElementById('field-email');
        if (em) em.value = decodeURIComponent(params.get('email'));
      }
      if (params.get('phone')) {
        var ph = document.getElementById('field-phone');
        if (ph) ph.value = decodeURIComponent(params.get('phone'));
      }
    } catch (e) {}
  })();

  // ── Restore from localStorage ──
  (function restore() {
    try {
      var raw = localStorage.getItem(LS_KEY);
      if (!raw) return;
      var saved = JSON.parse(raw);
      if (saved.scores) {
        for (var id in saved.scores) {
          var v = saved.scores[id];
          if (typeof v === 'number' && v >= 0 && v <= 5) scores[id] = v;
        }
      }
      if (saved.name) userName = saved.name;
      if (saved.email) userEmail = saved.email;
      if (saved.phone) userPhone = saved.phone;
    } catch (e) { /* ignore */ }
  })();

  function persist() {
    try {
      localStorage.setItem(LS_KEY, JSON.stringify({
        scores: scores,
        name: userName,
        email: userEmail,
        phone: userPhone,
        savedAt: new Date().toISOString(),
      }));
    } catch (e) { /* ignore */ }
  }

  // ── selectTop3 ──
  function selectTop3(scores, categories) {
    var sorted = categories.slice().sort(function (a, b) {
      var sa = scores[a.id] !== undefined ? scores[a.id] : 0;
      var sb = scores[b.id] !== undefined ? scores[b.id] : 0;
      if (sb !== sa) return sb - sa;
      return (b.priorityTier ? 1 : 0) - (a.priorityTier ? 1 : 0);
    });
    return sorted.slice(0, 3);
  }

  // ── Progress ──
  function answeredCount() {
    var count = 0;
    for (var i = 0; i < QUESTIONS.length; i++) {
      if (scores[QUESTIONS[i].id] !== undefined) count++;
    }
    return count;
  }

  function updateProgress() {
    var count = answeredCount();
    var total = QUESTIONS.length;
    var pct = Math.round((count / total) * 100);
    var label = document.getElementById('progress-label');
    var fill = document.getElementById('progress-fill');
    var btn = document.getElementById('continue-btn');
    var note = document.getElementById('req-note');
    if (label) label.textContent = count + ' of ' + total + ' answered';
    if (fill) fill.style.width = pct + '%';
    if (btn) btn.disabled = count < total;
    if (note) {
      if (count >= total) {
        note.hidden = true;
      } else {
        note.hidden = false;
        var remaining = total - count;
        note.textContent = remaining + ' question' + (remaining !== 1 ? 's' : '') + ' remaining — click 0 if it doesn\'t apply';
      }
    }
  }

  // ── Apply restored scores to DOM ──
  function applyRestoredScores() {
    for (var id in scores) {
      highlightButton(id, scores[id]);
      markCardAnswered(id);
    }
    updateProgress();
  }

  function highlightButton(qid, val) {
    var row = document.querySelector('.likert-row[data-qid="' + qid + '"]');
    if (!row) return;
    var btns = row.querySelectorAll('.likert-btn');
    btns.forEach(function (btn) {
      var bval = parseInt(btn.getAttribute('data-val'), 10);
      if (bval === val) {
        btn.classList.add('likert-selected');
        btn.setAttribute('aria-pressed', 'true');
        btn.style.cssText = getBtnStyle(val);
      } else {
        btn.classList.remove('likert-selected');
        btn.setAttribute('aria-pressed', 'false');
        btn.style.cssText = '';
      }
    });
  }

  function getBtnStyle(val) {
    var color = val <= 1 ? '#1D9E75' : val <= 3 ? '#D4920A' : '#E05C2A';
    return 'background:' + color + ';border-color:' + color + ';color:#fff;';
  }

  function markCardAnswered(id) {
    var card = document.getElementById('card-' + id);
    if (card) card.classList.add('q-answered');
  }

  // ── Event wiring ──
  document.addEventListener('DOMContentLoaded', function () {
    applyRestoredScores();
    initBmiCalc();

    // Likert button clicks
    document.getElementById('q-list').addEventListener('click', function (e) {
      var btn = e.target.closest('.likert-btn');
      if (!btn) return;
      var qid = btn.getAttribute('data-qid');
      var val = parseInt(btn.getAttribute('data-val'), 10);
      scores[qid] = val;
      persist();
      highlightButton(qid, val);
      markCardAnswered(qid);
      updateProgress();
    });

    // Guide toggle clicks
    document.getElementById('q-list').addEventListener('click', function (e) {
      var toggle = e.target.closest('.guide-toggle');
      if (!toggle) return;
      var qid = toggle.getAttribute('data-qid');
      var panel = document.getElementById('guide-' + qid);
      if (!panel) return;
      var isOpen = !panel.hidden;
      panel.hidden = isOpen;
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.innerHTML = (!isOpen ? '&#9650; Hide scoring guide' : '&#9660; How to score this');
    });

    // Continue button
    document.getElementById('continue-btn').addEventListener('click', function () {
      document.getElementById('questions-section').hidden = true;
      document.getElementById('capture-section').hidden = false;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Lead capture form
    document.getElementById('capture-form').addEventListener('submit', function (e) {
      e.preventDefault();
      var nameEl = document.getElementById('field-name');
      var emailEl = document.getElementById('field-email');
      var phoneEl = document.getElementById('field-phone');
      var consentEl = document.getElementById('field-consent');
      var errorEl = document.getElementById('form-error');
      var submitBtn = document.getElementById('submit-btn');

      errorEl.hidden = true;

      if (!nameEl.value.trim()) {
        errorEl.textContent = 'Please enter your first name.';
        errorEl.hidden = false;
        nameEl.focus();
        return;
      }
      if (!emailEl.value.trim() || !emailEl.validity.valid) {
        errorEl.textContent = 'Please enter a valid email address.';
        errorEl.hidden = false;
        emailEl.focus();
        return;
      }
      if (!consentEl.checked) {
        errorEl.textContent = 'Please accept the AI communications consent to continue.';
        errorEl.hidden = false;
        consentEl.focus();
        return;
      }

      userName = nameEl.value.trim();
      userEmail = emailEl.value.trim();
      userPhone = phoneEl.value.trim();
      persist();

      submitBtn.disabled = true;
      submitBtn.textContent = 'Loading…';

      var apiBase = API_BASE;
      fetch(apiBase + '/api/contact-form', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          kind: 'form',
          formId: 'public-assessment',
          fields: {
            firstName: userName,
            email: userEmail,
            phone: userPhone,
            scores: JSON.stringify(scores),
            savedAt: new Date().toISOString(),
          },
        }),
      }).catch(function () { /* silent */ });

      showResults();
    });
  });

  function initBmiCalc() {
    var ft = document.getElementById('bmi-ft');
    var inn = document.getElementById('bmi-in');
    var lb = document.getElementById('bmi-lb');
    var valEl = document.getElementById('bmi-value');
    var badge = document.getElementById('bmi-badge');
    if (!ft || !inn || !lb || !valEl || !badge) return;

    function recompute() {
      var f = parseFloat(ft.value) || 0;
      var i = parseFloat(inn.value) || 0;
      var w = parseFloat(lb.value) || 0;
      var totalInches = (f * 12) + i;
      if (totalInches <= 0 || w <= 0) {
        valEl.textContent = '—';
        badge.hidden = true;
        return;
      }
      // BMI = (lbs / in^2) * 703
      var bmi = (w / (totalInches * totalInches)) * 703;
      valEl.textContent = 'BMI ' + bmi.toFixed(1);
      var label, cls;
      if (bmi < 18.5)      { label = 'Underweight';        cls = 'bmi-low';  }
      else if (bmi < 25)   { label = 'Healthy';            cls = 'bmi-ok';   }
      else if (bmi < 30)   { label = 'Overweight';         cls = 'bmi-warn'; }
      else if (bmi < 35)   { label = 'Obese Class I';      cls = 'bmi-bad';  }
      else if (bmi < 40)   { label = 'Obese Class II';     cls = 'bmi-bad';  }
      else                 { label = 'Obese Class III';    cls = 'bmi-bad';  }
      badge.textContent = label;
      badge.className = 'bmi-badge ' + cls;
      badge.hidden = false;
    }
    ['input','change'].forEach(function(ev){
      ft.addEventListener(ev, recompute);
      inn.addEventListener(ev, recompute);
      lb.addEventListener(ev, recompute);
    });
  }

  function showResults() {
    document.getElementById('capture-section').hidden = true;
    document.getElementById('results-section').hidden = false;
    window.scrollTo({ top: 0, behavior: 'smooth' });

    // Greeting
    var greeting = document.getElementById('results-greeting');
    if (greeting) {
      greeting.textContent = 'Hello ' + userName + '. Here are your top 3 mitigating factors.';
    }

    // Build top 3
    var top3 = selectTop3(scores, QUESTIONS);
    var container = document.getElementById('results-cards');
    container.innerHTML = '';

    top3.forEach(function (q, idx) {
      var rawScore = scores[q.id] !== undefined ? scores[q.id] : 0;
      var displayScore = rawScore * 2; // 0-10

      var scoreClass = displayScore <= 3 ? 'score-low' : displayScore <= 6 ? 'score-mid' : 'score-high';
      var rank = idx + 1;

      var card = document.createElement('div');
      card.className = 'result-card';
      card.innerHTML =
        '<div class="result-rank">#' + rank + '</div>' +
        '<div class="result-body">' +
          '<h3 class="result-label">' + escHtml(q.label) + '</h3>' +
          '<div class="result-score-row">' +
            '<span class="result-score ' + scoreClass + '">' + displayScore + ' / 10</span>' +
            '<div class="result-bar-wrap" aria-hidden="true"><div class="result-bar-fill ' + scoreClass + '" style="width:' + (displayScore * 10) + '%"></div></div>' +
          '</div>' +
          '<a href="/solutions/' + escHtml(q.solutionSlug) + '" class="result-link">See ' + escHtml(q.label) + ' solution &rarr;</a>' +
        '</div>';
      container.appendChild(card);
    });

    // Update Protege CTA link with pre-fill query params
    try {
      var protegeLink = document.getElementById('protege-cta-link');
      if (protegeLink) {
        var qs = '?name=' + encodeURIComponent(userName || '') +
                 '&email=' + encodeURIComponent(userEmail || '') +
                 (userPhone ? '&phone=' + encodeURIComponent(userPhone) : '');
        protegeLink.href = '/protege-signup' + qs;
      }
    } catch (e) { /* no-op */ }

    // Render product tiles for each top-3 category
    try {
      var prodContainer = document.getElementById('results-products');
      if (prodContainer && SOLUTIONS_DATA) {
        prodContainer.innerHTML = '';
        var productsHeading = document.createElement('div');
        productsHeading.className = 'results-products-heading';
        productsHeading.innerHTML = '<h3>Your starting protocols</h3><p class="results-products-sub">Each of your top 3 priorities has an over-the-counter path and a prescription path. Prot&eacute;g&eacute;s get 15&ndash;25% off.</p>';
        prodContainer.appendChild(productsHeading);
        top3.forEach(function (q) {
          var sol = SOLUTIONS_DATA[q.solutionSlug] || { otc: null, rx: null };
          if (!sol.otc && !sol.rx) return;
          var section = document.createElement('div');
          section.className = 'prod-category';
          var catHead = document.createElement('h4');
          catHead.className = 'prod-category-label';
          catHead.textContent = q.label;
          section.appendChild(catHead);
          var tiles = document.createElement('div');
          tiles.className = 'prod-tiles';
          if (sol.otc) {
            var otcTile = document.createElement('div');
            otcTile.className = 'prod-tile prod-tile--otc';
            otcTile.innerHTML =
              '<span class="prod-kind">OTC</span>' +
              '<div class="prod-body">' +
                '<h5>' + escHtml(sol.otc.name) + '</h5>' +
                '<p class="prod-tagline">' + escHtml(sol.otc.tagline) + '</p>' +
                '<a class="prod-cta" href="/cart?sku=' + encodeURIComponent(sol.otc.skuId) + '">Order ' + escHtml(sol.otc.name.split(' —')[0].split(' (')[0]) + ' &rarr;</a>' +
              '</div>';
            tiles.appendChild(otcTile);
          }
          if (sol.rx) {
            var isHormone = sol.rx.skuId === 'consult-hormone';
            var rxTile = document.createElement('div');
            rxTile.className = 'prod-tile prod-tile--rx';
            rxTile.innerHTML =
              '<span class="prod-kind prod-kind--rx">Rx</span>' +
              '<div class="prod-body">' +
                '<h5>' + escHtml(sol.rx.name) + '</h5>' +
                '<p class="prod-tagline">' + escHtml(sol.rx.tagline) + '</p>' +
                '<a class="prod-cta prod-cta--rx" href="/cart?sku=' + encodeURIComponent(sol.rx.skuId) + '">' +
                  (isHormone ? 'Book TRT consult &mdash; $249 &rarr;' : 'Book consult + labs &mdash; $199 &rarr;') +
                '</a>' +
                (sol.rx.basicSkuId ? '<a class="prod-downgrade" href="/cart?sku=' + encodeURIComponent(sol.rx.basicSkuId) + '">I have recent labs &mdash; $99</a>' : '') +
              '</div>';
            tiles.appendChild(rxTile);
          }
          section.appendChild(tiles);
          prodContainer.appendChild(section);
        });
      }
    } catch (e) { /* no-op */ }
  }

  function escHtml(str) {
    return str
      .replace(/&/g, '&amp;')
