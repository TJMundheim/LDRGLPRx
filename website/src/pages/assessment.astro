---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUDIT_QUESTIONS, AUDIT_PILLARS, DIAGNOSED_QUESTION } from '../data/audit-questions';

const title = "Get Your MindSpan Baseline — Free 20-Question 4M Assessment — My4MLife";
const description = "Set your MindSpan baseline with the free 20-question 4M Assessment (about seven minutes). See your top 3 priorities on screen immediately — and we'll email your full results with a free copy of Begin with the End in Mind, the Cohort Workbook, and access to the Protégé app.";
const canonical = "https://www.my4mlife.com/assessment";
const keywords = "4M assessment, personalized health assessment, gut health quiz, hormone balance test, cognitive health assessment, My4MLife, free health quiz";
const robots = "index, follow";
---
<BaseLayout title={title} description={description} canonical={canonical} keywords={keywords} robots={robots}>

<!-- ===== HERO ===== -->
<section class="assess-hero">
  <div class="container assess-hero-inner">
    <div class="assess-badge">FREE · ABOUT 7 MINUTES · NO ACCOUNT REQUIRED</div>
    <h1>Set your <em>MindSpan baseline</em> — the free 20-question 4M Assessment</h1>
    <p class="assess-sub">This is where your MindSpan Score starts. You'll see your top 3 priorities on screen immediately — and we'll email your full results, along with a free copy of <em>Begin with the End in Mind</em>, the <em>Cohort Workbook</em>, and access to the Protégé app.</p>
    <div class="assess-meta">
      <span class="assess-chip">20 questions</span>
      <span class="assess-chip">~7 min</span>
      <span class="assess-chip">Results + book + workbook + app</span>
      <span class="assess-chip">Private — no data sold</span>
    </div>
  </div>
</section>

<!-- ===== STICKY PROGRESS HEADER ===== -->
<div class="assess-sticky" id="assess-sticky" role="status" aria-live="polite">
  <div class="container assess-sticky-inner">
    <span class="assess-sticky-label" id="progress-label">0 of 20 answered</span>
    <div class="assess-progress-bar" aria-hidden="true">
      <div class="assess-progress-fill" id="progress-fill" style="width:0%"></div>
    </div>
  </div>
</div>

<!-- ===== QUESTIONS ===== -->
<section class="assess-questions" id="questions-section">
  <div class="container assess-questions-inner">
    <div class="assess-instructions">
      Rate each area honestly. <strong>0 = no problem at all &middot; 5 = severe / highly problematic.</strong>
    </div>

    <div class="q-list" id="q-list">
      {AUDIT_PILLARS.map((pillar) => (
        <>
          <div class="pillar-header" aria-hidden="false">
            <span class="pillar-name">{pillar.name}</span>
            <span class="pillar-tag">{pillar.tag}</span>
          </div>
          {AUDIT_QUESTIONS.filter((q) => q.pillar === pillar.id).map((q) => (
        <div class="q-card" id={`card-${q.id}`} data-id={q.id} aria-label={`Question ${q.n}: ${q.prompt}`}>
          <div class="q-header">
            <span class="q-num">{q.n}</span>
            <span class="q-label">{q.label}</span>
          </div>
          <p class="q-prompt">{q.prompt}</p>

          <!-- 0-5 Likert buttons -->
          <div class="likert-row" role="group" aria-label={`Score for ${q.label}`} data-qid={q.id}>
            {[0,1,2,3,4,5].map((val) => (
              <button
                class="likert-btn"
                data-val={val}
                data-qid={q.id}
                aria-pressed="false"
                aria-label={`Score ${val}`}
                type="button"
              >{val}</button>
            ))}
          </div>
          <div class="likert-labels">
            <span>No problem</span>
            <span>Severe</span>
          </div>

          <!-- Expandable scoring guide -->
          <button
            class="guide-toggle"
            data-qid={q.id}
            aria-expanded="false"
            type="button"
          >&#9660; How to score this</button>
          <div class="guide-panel" id={`guide-${q.id}`} hidden>
            <p class="guide-text">{q.scoreGuide}</p>
            <p class="guide-note">{q.categoryNote}</p>
          </div>
        </div>
          ))}
        </>
      ))}

      <!-- Separate Yes/No flag — outside the scored audit -->
      <div class="q-card diag-card" id="card-already-diagnosed" data-id="already-diagnosed">
        <div class="q-header">
          <span class="q-num">+</span>
          <span class="q-label">One more — outside the audit</span>
        </div>
        <p class="q-prompt">{DIAGNOSED_QUESTION.prompt}</p>
        <div class="diag-row" role="group" aria-label="Already diagnosed — yes or no">
          <button class="diag-btn" id="diag-no" data-diag="no" aria-pressed="false" type="button">No</button>
          <button class="diag-btn" id="diag-yes" data-diag="yes" aria-pressed="false" type="button">Yes</button>
        </div>
        <p class="guide-note diag-note">{DIAGNOSED_QUESTION.categoryNote} This doesn't count toward your score — it helps us point you to the right path.</p>
      </div>
    </div>

    <div class="assess-footer">
      <button class="btn btn-primary btn-large" id="continue-btn" disabled type="button">
        See My Results &rarr;
      </button>
      <p class="req-note" id="req-note">Answer all 20 questions to continue</p>
    </div>
  </div>
</section>

<!-- ===== EMAIL CAPTURE FORM ===== -->
<section class="assess-capture" id="capture-section" hidden>
  <div class="container assess-capture-inner">
    <h2>Almost there — where should we send your MindSpan baseline?</h2>
    <p class="capture-sub">We'll show your top 3 factors on screen immediately. Your information is never sold.</p>

    <form class="capture-form" id="capture-form" novalidate>
      <div class="form-row">
        <div class="form-field">
          <label for="field-name">First name <span aria-hidden="true">*</span></label>
          <input type="text" id="field-name" name="firstName" autocomplete="given-name" required placeholder="Your first name" />
        </div>
        <div class="form-field">
          <label for="field-email">Email <span aria-hidden="true">*</span></label>
          <input type="email" id="field-email" name="email" autocomplete="email" required placeholder="you@example.com" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="field-phone">Phone <span aria-hidden="true">*</span></label>
          <input type="tel" id="field-phone" name="phone" autocomplete="tel" required placeholder="(555) 000-0000" />
        </div>
      </div>
      <div class="form-check">
        <label class="check-label">
          <input type="checkbox" id="field-protege-consent" name="protegeConsent" required />
          <span>I agree to the Prot&eacute;g&eacute; terms (free account; no purchase required).</span>
        </label>
      </div>
      <div class="form-check">
        <label class="check-label">
          <input type="checkbox" id="field-consent" name="aiConsent" required />
          <span>I consent to receive AI-assisted health communications from My4MLife. I understand I may opt out at any time.</span>
        </label>
      </div>
      <p class="form-error" id="form-error" hidden></p>
      <button class="btn btn-primary btn-large" type="submit" id="submit-btn">
        Show My MindSpan Baseline &rarr;
      </button>
    </form>
  </div>
</section>

<!-- ===== RESULTS PANEL ===== -->
<section class="assess-results" id="results-section" hidden>
  <div class="container assess-results-inner">
    <div class="results-header">
      <div class="results-badge">YOUR RESULTS</div>
      <h2 id="results-greeting">Thank you. Here is your MindSpan baseline.</h2>
      <p class="results-sub">Your full results are also on the way to your inbox in a single email.</p>
    </div>

    <!-- On-screen results: score + band + top 3 (rendered by script) -->
    <div class="results-score-block">
      <div class="results-score-ring">
        <span class="results-score-num" id="results-score-num">—</span>
        <span class="results-score-max">/ 100</span>
      </div>
      <div class="results-band">
        <span class="results-band-label" id="results-band-label"></span>
        <span class="results-band-line" id="results-band-line"></span>
      </div>
      <p class="results-score-note">Lower is better — this is your risk load, the number your MindSpan work brings down.</p>
    </div>

    <div class="results-top3-block">
      <h3>Your top 3 priorities</h3>
      <p class="results-top3-sub">The areas where addressing the root cause creates the biggest ripple effect. Start at #1.</p>
      <ol class="results-top3-list" id="results-top3-list"></ol>
    </div>

    <div class="results-diag-banner" id="results-diag-banner" hidden>
      <h3>Because of your diagnosis, one path matters most</h3>
      <p>You told us you've already received a neurocognitive diagnosis. That makes regenerative medicine time-sensitive — it's the first conversation to have.</p>
      <a href="/regenerative-medicine" class="btn btn-primary">Explore the regenerative-medicine path &rarr;</a>
    </div>

    <!-- ConnectedMind mental-health module (conditional; hidden until the
         consumer URL is configured — see CONNECTEDMIND_URL in the script) -->
    <div class="results-cm-block" id="results-cm-block" hidden>
      <h3>Worth a closer look: your mental health</h3>
      <p>Mental health — especially depression and anxiety — is one of the most under-recognized contributors to cognitive decline. If that's on your mind, <strong>ConnectedMind</strong> is a clinical-grade screening you can complete in minutes and take to your own doctor. It's the best tool we've found for this.</p>
      <a id="results-cm-link" href="#" target="_blank" rel="noopener" class="btn btn-primary">Open the ConnectedMind screening &rarr;</a>
      <p class="results-cm-external">Opens in a new tab — you'll be leaving My4MLife.</p>
      <p class="results-cm-boundary">This is a screening resource to share with your physician. My4MLife does not diagnose or treat mental-health conditions.</p>
    </div>

    <div class="results-email-block">
      <h3>What&rsquo;s in your email</h3>
      <ul class="results-email-list">
        <li><strong>Your MindSpan baseline and top 3 mitigating factors</strong> &mdash; the areas where addressing the root cause will create the biggest ripple effect across your health.</li>
        <li><strong>Your free copy of <em>Begin with the End in Mind</em></strong> &mdash; the field guide that walks you through the 4M framework.</li>
        <li><strong>Your free <em>Cohort Workbook</em></strong> &mdash; the printable companion you&rsquo;ll use day-to-day inside the program.</li>
        <li><strong>Access to the Prot&eacute;g&eacute; app</strong> &mdash; daily check-ins, weekly Zooms with Dr. TJ, and your cohort.</li>
      </ul>
      <p class="results-email-help">Don&rsquo;t see it within a few minutes? Check spam, then email <a href="mailto:support@my4mlife.com">support@my4mlife.com</a> and we&rsquo;ll resend.</p>
    </div>

    <div class="results-coordinator-block">
      <h3>Want to talk to a person?</h3>
      <p>Schedule a call with one of our care coordinators. They&rsquo;ll listen to your situation and connect you with the appropriate medical provider in our network for your chief complaint.</p>
      <a href="/consult" class="btn btn-primary btn-large">Schedule with a Care Coordinator &rarr;</a>
    </div>

    <p class="results-cm-quiet" id="results-cm-quiet" hidden>
      Optional: <a id="results-cm-quiet-link" href="#" target="_blank" rel="noopener">take the ConnectedMind mental-health screening</a> — a clinical-grade screen to share with your own doctor. (Opens in a new tab; My4MLife does not diagnose or treat mental-health conditions.)
    </p>

    <p class="results-disclaimer">
      This assessment is for informational purposes only and does not constitute medical advice, diagnosis, or treatment. Always consult a qualified healthcare provider before making changes to your health regimen.
    </p>
  </div>
</section>

<script is:inline define:vars={{ API_BASE: (import.meta.env.PUBLIC_LEAD_CAPTURE_API_URL ?? 'https://v9svm8ds74.execute-api.us-east-2.amazonaws.com') }}>
(function () {
  function phCapture(ev, props) { try { if (window.posthog && window.posthog.capture) { window.posthog.capture(ev, props || {}); } } catch (err) {} }
  var phPrev = null;
  'use strict';

  // ── Data mirrored from website/src/data/audit-questions.ts (20-question set, 2026-07-13) ──
  var QUESTIONS = [
    { id: 'cognitive',              n: '01', pillar: 'mind',     label: 'Cognitive / brain fog',     solutionSlug: 'cognitive'            },
    { id: 'sleep',                  n: '02', pillar: 'mind',     label: 'Sleep',                     solutionSlug: 'sleep'                },
    { id: 'hearing-vision-dental',  n: '03', pillar: 'mind',     label: 'Hearing, vision & dental',  solutionSlug: 'cognitive'            },
    { id: 'mood',                   n: '04', pillar: 'mind',     label: 'Mood',                      solutionSlug: 'stress'               },
    { id: 'social-connection',      n: '05', pillar: 'mind',     label: 'Social connection',         solutionSlug: 'purpose-goals'        },
    { id: 'mental-challenge',       n: '06', pillar: 'mind',     label: 'Mental challenge',          solutionSlug: 'cognitive'            },
    { id: 'movement-strength',      n: '07', pillar: 'muscle',   label: 'Movement & strength',       solutionSlug: 'muscle'               },
    { id: 'weight-body-fat',        n: '08', pillar: 'muscle',   label: 'Weight',                    solutionSlug: 'weight'               },
    { id: 'nutrition',              n: '09', pillar: 'muscle',   label: 'Nutrition',                 solutionSlug: 'nutrition'            },
    { id: 'pain-injury',            n: '10', pillar: 'muscle',   label: 'Pain / injury',             solutionSlug: 'pain-chronic'         },
    { id: 'blood-pressure',         n: '11', pillar: 'mitigate', label: 'Blood pressure',            solutionSlug: 'chronic-conditions'   },
    { id: 'blood-sugar',            n: '12', pillar: 'mitigate', label: 'Blood sugar',               solutionSlug: 'chronic-conditions'   },
    { id: 'ldl-cholesterol',        n: '13', pillar: 'mitigate', label: 'LDL cholesterol',           solutionSlug: 'chronic-conditions'   },
    { id: 'smoking-nicotine',       n: '14', pillar: 'mitigate', label: 'Smoking / nicotine',        solutionSlug: 'substance-use'        },
    { id: 'alcohol',                n: '15', pillar: 'mitigate', label: 'Alcohol',                   solutionSlug: 'alcohol'              },
    { id: 'gut-microbiome',         n: '16', pillar: 'mitigate', label: 'Gut health',                solutionSlug: 'gut'                  },
    { id: 'hormone-balance',        n: '17', pillar: 'mitigate', label: 'Hormones',                  solutionSlug: 'hormones'             },
    { id: 'erectile-dysfunction',   n: '18', pillar: 'mitigate', label: 'Sexual function',           solutionSlug: 'erectile-dysfunction' },
    { id: 'environment',            n: '19', pillar: 'mitigate', label: 'Environment',               solutionSlug: 'environment'          },
    { id: 'purpose-accountability', n: '20', pillar: 'motivate', label: 'Purpose & accountability',  solutionSlug: 'purpose-goals'        },
  ];

  // Result bands over the 0-100 total.
  var BANDS = [
    { max: 15,  label: 'Sharp',           line: 'Protect it.' },
    { max: 35,  label: 'Early drift',     line: 'Worth getting ahead of.' },
    { max: 60,  label: 'Time for a plan', line: '' },
    { max: 100, label: 'Act now',         line: 'While the choice is still yours.' },
  ];

  // ConnectedMind consumer screening URL. Leave empty until the custom
  // consumer-facing link arrives — the module stays hidden (no dead buttons).
  var CONNECTEDMIND_URL = '';

  // Scoring rules (TJ 2026-07-13):
  //   - already-diagnosed is a Yes/No FLAG — never ranked, never scored
  //   - gut-microbiome +3, weight-body-fat +2 (forfeited when raw score is 0)
  //   - ties break by question order (pillar order embedded)
  var BONUS_BY_ID = {
    'gut-microbiome': 3,
    'weight-body-fat': 2,
  };

  var LS_KEY = 'public-assessment-v2';

  // ── State ──
  var scores = {}; // { [id]: 0-5 } — the 20 scored items only
  var diagnosed = null; // null = unanswered, true/false once answered
  var userName = '';
  var userEmail = '';
  var userPhone = '';

  // ── ?reset=1 wipe ──
  (function maybeReset() {
    try {
      var params = new URLSearchParams(window.location.search);
      if (params.get('reset') === '1') {
        localStorage.removeItem(LS_KEY);
      }
      // Pre-fill from query params (passed from assessment results CTA)
      if (params.get('name')) {
        var n = document.getElementById('field-name');
        if (n) n.value = decodeURIComponent(params.get('name'));
      }
      if (params.get('email')) {
        var em = document.getElementById('field-email');
        if (em) em.value = decodeURIComponent(params.get('email'));
      }
      if (params.get('phone')) {
        var ph = document.getElementById('field-phone');
        if (ph) ph.value = decodeURIComponent(params.get('phone'));
      }
    } catch (e) {}
  })();

  // ── Restore from localStorage ──
  (function restore() {
    try {
      var raw = localStorage.getItem(LS_KEY);
      if (!raw) return;
      var saved = JSON.parse(raw);
      if (saved.scores) {
        for (var id in saved.scores) {
          var v = saved.scores[id];
          if (typeof v === 'number' && v >= 0 && v <= 5) scores[id] = v;
        }
      }
      if (typeof saved.diagnosed === 'boolean') diagnosed = saved.diagnosed;
      if (saved.name) userName = saved.name;
      if (saved.email) userEmail = saved.email;
      if (saved.phone) userPhone = saved.phone;
    } catch (e) { /* ignore */ }
  })();

  function persist() {
    try {
      localStorage.setItem(LS_KEY, JSON.stringify({
        scores: scores,
        diagnosed: diagnosed,
        name: userName,
        email: userEmail,
        phone: userPhone,
        savedAt: new Date().toISOString(),
      }));
    } catch (e) { /* ignore */ }
  }

  function toE164(input) {
    if (!input) return null;
    var raw = String(input).trim();
    if (!raw) return null;
    var hasPlus = raw.charAt(0) === '+';
    var digits = raw.replace(/[^0-9]/g, '');
    if (hasPlus) {
      if (digits.length >= 8 && digits.length <= 15) return '+' + digits;
      return null;
    }
    if (digits.length === 10) return '+1' + digits;
    if (digits.length === 11 && digits.charAt(0) === '1') return '+' + digits;
    return null;
  }

  // ── selectTop3 (TJ 2026-07-13) ──
  //   - the diagnosed flag is never in the ranking (it routes separately)
  //   - raw + bonus (bonus forfeited at raw 0 — a zero stays a zero)
  //   - ties break by question order (pillar order Mind→Muscle→Mitigate→Motivate embedded)
  function selectTop3(scores, categories) {
    function adj(id) {
      var raw = scores[id] !== undefined ? scores[id] : 0;
      return raw > 0 ? raw + (BONUS_BY_ID[id] || 0) : raw;
    }
    return categories
      .map(function (c, i) { return { cat: c, i: i, total: adj(c.id) }; })
      .sort(function (a, b) {
        if (b.total !== a.total) return b.total - a.total;
        return a.i - b.i;
      })
      .slice(0, 3)
      .map(function (e) { return e.cat; });
  }

  function totalScore() {
    var t = 0;
    for (var i = 0; i < QUESTIONS.length; i++) t += scores[QUESTIONS[i].id] || 0;
    return t;
  }

  function bandFor(total) {
    for (var i = 0; i < BANDS.length; i++) {
      if (total <= BANDS[i].max) return BANDS[i];
    }
    return BANDS[BANDS.length - 1];
  }

  // ── Progress ──
  function answeredCount() {
    var count = 0;
    for (var i = 0; i < QUESTIONS.length; i++) {
      if (scores[QUESTIONS[i].id] !== undefined) count++;
    }
    return count;
  }

  function updateProgress() {
    var count = answeredCount();
    var total = QUESTIONS.length;
    if (phPrev === null) { phPrev = count; }
    else if (count > phPrev) {
      if (phPrev === 0) phCapture('assessment_started');
      if (count === total) phCapture('assessment_questions_completed');
      phPrev = count;
    }
    var pct = Math.round((count / total) * 100);
    var allDone = count >= total && diagnosed !== null;
    var label = document.getElementById('progress-label');
    var fill = document.getElementById('progress-fill');
    var btn = document.getElementById('continue-btn');
    var note = document.getElementById('req-note');
    if (label) label.textContent = count + ' of ' + total + ' answered';
    if (fill) fill.style.width = pct + '%';
    if (btn) btn.disabled = !allDone;
    if (note) {
      if (allDone) {
        note.hidden = true;
      } else if (count >= total) {
        note.hidden = false;
        note.textContent = 'One more — answer the yes/no question above to continue';
      } else {
        note.hidden = false;
        var remaining = total - count;
        note.textContent = remaining + ' question' + (remaining !== 1 ? 's' : '') + ' remaining — click 0 if it doesn\'t apply';
      }
    }
  }

  function highlightDiag() {
    var yes = document.getElementById('diag-yes');
    var no = document.getElementById('diag-no');
    if (!yes || !no) return;
    yes.classList.toggle('diag-selected', diagnosed === true);
    yes.setAttribute('aria-pressed', String(diagnosed === true));
    no.classList.toggle('diag-selected', diagnosed === false);
    no.setAttribute('aria-pressed', String(diagnosed === false));
    var card = document.getElementById('card-already-diagnosed');
    if (card && diagnosed !== null) card.classList.add('q-answered');
  }

  // ── Apply restored scores to DOM ──
  function applyRestoredScores() {
    for (var id in scores) {
      highlightButton(id, scores[id]);
      markCardAnswered(id);
    }
    updateProgress();
  }

  function highlightButton(qid, val) {
    var row = document.querySelector('.likert-row[data-qid="' + qid + '"]');
    if (!row) return;
    var btns = row.querySelectorAll('.likert-btn');
    btns.forEach(function (btn) {
      var bval = parseInt(btn.getAttribute('data-val'), 10);
      if (bval === val) {
        btn.classList.add('likert-selected');
        btn.setAttribute('aria-pressed', 'true');
        btn.style.cssText = getBtnStyle(val);
      } else {
        btn.classList.remove('likert-selected');
        btn.setAttribute('aria-pressed', 'false');
        btn.style.cssText = '';
      }
    });
  }

  function getBtnStyle(val) {
    var color = val <= 1 ? '#1D9E75' : val <= 3 ? '#D4920A' : '#E05C2A';
    return 'background:' + color + ';border-color:' + color + ';color:#fff;';
  }

  function markCardAnswered(id) {
    var card = document.getElementById('card-' + id);
    if (card) card.classList.add('q-answered');
  }

  // ── Event wiring ──
  document.addEventListener('DOMContentLoaded', function () {
    applyRestoredScores();
    highlightDiag();

    // Likert button clicks
    document.getElementById('q-list').addEventListener('click', function (e) {
      var btn = e.target.closest('.likert-btn');
      if (!btn) return;
      var qid = btn.getAttribute('data-qid');
      var val = parseInt(btn.getAttribute('data-val'), 10);
      scores[qid] = val;
      persist();
      highlightButton(qid, val);
      markCardAnswered(qid);
      updateProgress();
    });

    // Diagnosed Yes/No clicks
    document.getElementById('q-list').addEventListener('click', function (e) {
      var btn = e.target.closest('.diag-btn');
      if (!btn) return;
      diagnosed = btn.getAttribute('data-diag') === 'yes';
      persist();
      highlightDiag();
      updateProgress();
    });

    // Guide toggle clicks
    document.getElementById('q-list').addEventListener('click', function (e) {
      var toggle = e.target.closest('.guide-toggle');
      if (!toggle) return;
      var qid = toggle.getAttribute('data-qid');
      var panel = document.getElementById('guide-' + qid);
      if (!panel) return;
      var isOpen = !panel.hidden;
      panel.hidden = isOpen;
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.innerHTML = (!isOpen ? '&#9650; Hide scoring guide' : '&#9660; How to score this');
    });

    // Continue button
    var _phContactFired = false;
    document.getElementById('continue-btn').addEventListener('click', function () {
      if (!_phContactFired) { _phContactFired = true; phCapture('assessment_contact_reached'); }
      document.getElementById('questions-section').hidden = true;
      document.getElementById('capture-section').hidden = false;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Lead capture form
    document.getElementById('capture-form').addEventListener('submit', function (e) {
      e.preventDefault();
      var nameEl = document.getElementById('field-name');
      var emailEl = document.getElementById('field-email');
      var phoneEl = document.getElementById('field-phone');
      var consentEl = document.getElementById('field-consent');
      var protegeConsentEl = document.getElementById('field-protege-consent');
      var errorEl = document.getElementById('form-error');
      var submitBtn = document.getElementById('submit-btn');

      errorEl.hidden = true;

      if (!nameEl.value.trim()) {
        errorEl.textContent = 'Please enter your first name.';
        errorEl.hidden = false;
        nameEl.focus();
        return;
      }
      if (!emailEl.value.trim() || !emailEl.validity.valid) {
        errorEl.textContent = 'Please enter a valid email address.';
        errorEl.hidden = false;
        emailEl.focus();
        return;
      }
      var rawPhone = phoneEl.value.trim();
      var phoneE164 = rawPhone ? toE164(rawPhone) : null;
      if (!rawPhone || !phoneE164) {
        errorEl.textContent = 'Please enter a valid phone number (US 10-digit or international +country format).';
        errorEl.hidden = false;
        phoneEl.focus();
        return;
      }
      if (!protegeConsentEl.checked) {
        errorEl.textContent = 'Please agree to the Protégé terms to continue.';
        errorEl.hidden = false;
        protegeConsentEl.focus();
        return;
      }
      if (!consentEl.checked) {
        errorEl.textContent = 'Please accept the AI communications consent to continue.';
        errorEl.hidden = false;
        consentEl.focus();
        return;
      }

      userName = nameEl.value.trim();
      userEmail = emailEl.value.trim();
      userPhone = phoneE164;
      persist();

      submitBtn.disabled = true;
      submitBtn.textContent = 'Loading…';

      var apiBase = API_BASE;
      fetch(apiBase + '/api/contact-form', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          kind: 'form',
          formId: 'public-assessment',
          fields: {
            firstName: userName,
            email: userEmail,
            phone: userPhone,
            scores: JSON.stringify(scores),
            savedAt: new Date().toISOString(),
          },
        }),
      }).catch(function () { /* silent */ });

      // Capture the consent agreements (exact text + version + timestamp) so we
      // have a durable, retrievable record of what each person agreed to.
      var consentPayload = {
        consentedAt: new Date().toISOString(),
        protegeTerms: {
          agreed: !!protegeConsentEl.checked,
          version: 'consent-protege-v1',
          text: 'I agree to the Protégé terms (free account; no purchase required).',
        },
        aiComms: {
          agreed: !!consentEl.checked,
          version: 'consent-ai-comms-v1',
          text: 'I consent to receive AI-assisted health communications from My4MLife. I understand I may opt out at any time.',
        },
      };

      // Also notify audit-complete (writes auditTop3 + consent + sends results email).
      var top3Payload = selectTop3(scores, QUESTIONS).map(function (q) {
        return { id: q.id, label: q.label, slug: q.solutionSlug, score: scores[q.id] || 0 };
      });
      // scores payload: 20 items + the diagnosed flag encoded as 0|5 for
      // downstream compatibility (lambda rx-rec + app factor map).
      var scoresPayload = {};
      for (var qi = 0; qi < QUESTIONS.length; qi++) {
        scoresPayload[QUESTIONS[qi].id] = scores[QUESTIONS[qi].id] || 0;
      }
      scoresPayload['already-diagnosed'] = diagnosed === true ? 5 : 0;
      // Full per-question breakdown for the results email (pillar-grouped table).
      var breakdownPayload = QUESTIONS.map(function (q) {
        return { id: q.id, label: q.label, pillar: q.pillar, score: scores[q.id] || 0 };
      });
      var totalPayload = totalScore();
      var bandPayload = bandFor(totalPayload);
      // Fire assessment_submitted only when the backend actually accepted the
      // signup — otherwise the funnel over-counts submissions (audit #21).
      fetch(apiBase + '/api/audit-complete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: userEmail,
          firstName: userName,
          phone: userPhone,
          scores: scoresPayload,
          top3: top3Payload,
          breakdown: breakdownPayload,
          totalScore: totalPayload,
          band: bandPayload.label,
          diagnosed: diagnosed === true,
          consent: consentPayload,
        }),
      }).then(function (r) {
        phCapture(r && r.ok ? 'assessment_submitted' : 'assessment_submit_failed');
      }).catch(function () { phCapture('assessment_submit_failed'); });

      showResults(top3Payload, totalPayload, bandPayload);
    });
  });

  function showResults(top3, total, band) {
    document.getElementById('capture-section').hidden = true;
    document.getElementById('results-section').hidden = false;
    window.scrollTo({ top: 0, behavior: 'smooth' });

    var greeting = document.getElementById('results-greeting');
    if (greeting && userName) {
      greeting.textContent = 'Thank you, ' + userName + '. Here is your MindSpan baseline.';
    }

    // Score + band
    var numEl = document.getElementById('results-score-num');
    var bandLabelEl = document.getElementById('results-band-label');
    var bandLineEl = document.getElementById('results-band-line');
    if (numEl) numEl.textContent = String(total);
    if (bandLabelEl) bandLabelEl.textContent = band.label;
    if (bandLineEl) bandLineEl.textContent = band.line || '';

    // Top 3 with solution links
    var listEl = document.getElementById('results-top3-list');
    if (listEl) {
      listEl.innerHTML = top3.map(function (t) {
        return '<li><a href="/solutions/' + encodeURIComponent(t.slug) + '">' +
          '<span class="top3-label">' + escHtml(t.label) + '</span>' +
          '<span class="top3-score">' + t.score + ' / 5</span>' +
          '<span class="top3-go">See the solution path &rarr;</span></a></li>';
      }).join('');
    }

    // Diagnosed → regenerative-medicine banner
    if (diagnosed === true) {
      var diagBanner = document.getElementById('results-diag-banner');
      if (diagBanner) diagBanner.hidden = false;
    }

    // ConnectedMind module — only when the consumer URL is configured.
    if (CONNECTEDMIND_URL) {
      var prominent = (scores['mood'] || 0) >= 3 || diagnosed === true;
      if (prominent) {
        var cm = document.getElementById('results-cm-block');
        var cmLink = document.getElementById('results-cm-link');
        if (cm && cmLink) { cmLink.href = CONNECTEDMIND_URL; cm.hidden = false; }
      } else {
        var cmQuiet = document.getElementById('results-cm-quiet');
        var cmQuietLink = document.getElementById('results-cm-quiet-link');
        if (cmQuiet && cmQuietLink) { cmQuietLink.href = CONNECTEDMIND_URL; cmQuiet.hidden = false; }
      }
    }
  }

  function escHtml(str) {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }
})();
</script>

