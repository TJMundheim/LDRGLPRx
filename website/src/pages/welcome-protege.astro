---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "You're in — Welcome, Protégé | My4MLife";
const description = "Your free My4MLife Protégé account is ready. Open the app to begin.";
const canonical = "https://www.my4mlife.com/welcome-protege";
const robots = "noindex, nofollow";
---
<BaseLayout title={title} description={description} canonical={canonical} robots={robots}>

<section class="wp-section">
  <div class="container wp-inner">
    <div class="wp-icon" aria-hidden="true">&#10003;</div>
    <h1>You&apos;re in. Welcome, Prot&eacute;g&eacute;.</h1>
    <p class="wp-sub">Your free account is ready. Check your email for your sign-in code.</p>

    <a href="https://app.my4mlife.com" id="open-app-link" class="btn btn-primary btn-large" rel="noopener">
      Open the My4MLife App &rarr;
    </a>
    <script is:inline>
      // Carry the user's email from sessionStorage (set by protege-signup form) to the app
      // so the sign-in screen pre-fills it and hides the firstName field.
      (function () {
        try {
          var em = sessionStorage.getItem('my4m-signup-email') || '';
          var link = document.getElementById('open-app-link');
          if (em && link) {
            link.href = 'https://app.my4mlife.com/?new=1&email=' + encodeURIComponent(em);
          } else if (link) {
            link.href = 'https://app.my4mlife.com/?new=1';
          }
        } catch (e) { /* no-op */ }
      })();
    </script>

    <div class="wp-benefits">
      <h2>What your Prot&eacute;g&eacute; account unlocks</h2>
      <ul>
        <li>Free access to the My4MLife app</li>
        <li>Free <em>Begin with the End in Mind</em> book (digital)</li>
        <li>Free Cohort Workbook (digital)</li>
        <li>Weekly support Zooms with Dr. TJ</li>
        <li>Cohort community</li>
        <li>Personalized assessment results and care-coordinator pathway</li>
      </ul>
    </div>

    <p style="text-align:center;margin-top:1.25rem;font-size:0.98rem"><a href="/equipment" style="color:var(--wp-accent,#00b894);font-weight:700;text-decoration:none">Order your starter equipment before Week 1 &rarr;</a></p>

    <p class="wp-note">
      Didn&apos;t get the email? Check spam, or email
      <a href="mailto:support@my4mlife.com">support@my4mlife.com</a>.
    </p>
  </div>
</section>

<style>
:root {
  --wp-accent: #00b894;
  --wp-accent-dark: #00a381;
  --wp-muted: #718096;
  --wp-parchment: #faf8f4;
  --wp-dark: #0a1628;
}
.wp-section {
  background: var(--wp-parchment);
  min-height: calc(100vh - 200px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80px 0;
}
.wp-inner {
  max-width: 560px;
  margin: 0 auto;
  padding: 0 2rem;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22px;
}
.wp-icon {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  background: var(--wp-accent);
  color: #fff;
  font-size: 2.2rem;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}
.wp-inner h1 {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  margin: 0;
  color: var(--wp-dark);
  line-height: 1.2;
}
.wp-sub {
  font-size: 1.05rem;
  color: var(--wp-muted);
  margin: 0;
  max-width: 440px;
  line-height: 1.55;
}
.wp-note {
  font-size: 0.85rem;
  color: var(--wp-muted);
  margin: 0;
}
.wp-note a { color: var(--wp-accent-dark); }
.btn { display: inline-block; border-radius: 8px; font-weight: 700; text-align: center; cursor: pointer; transition: background 0.15s, color 0.15s, border-color 0.15s; font-family: inherit; text-decoration: none; border: 2px solid transparent; }
.btn-primary { background: var(--wp-accent); color: #fff; border-color: var(--wp-accent); }
.btn-primary:hover { background: var(--wp-accent-dark); border-color: var(--wp-accent-dark); }
.btn-large { padding: 14px 32px; font-size: 1rem; min-width: 260px; }
.wp-benefits {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  padding: 22px 28px;
  text-align: left;
  max-width: 480px;
  width: 100%;
}
.wp-benefits h2 {
  font-size: 1rem;
  color: var(--wp-dark);
  margin: 0 0 12px;
  text-align: center;
}
.wp-benefits ul {
  list-style: disc;
  margin: 0;
  padding-left: 20px;
  color: var(--wp-dark);
  font-size: 0.92rem;
  line-height: 1.65;
}
</style>
</BaseLayout>
