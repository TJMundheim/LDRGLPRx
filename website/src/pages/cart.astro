---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SKUS } from '../data/skus';

const title = 'Your Cart — My4MLife';
const description = 'Review your selection and continue to checkout.';
const canonical = 'https://www.my4mlife.com/cart';

// We don't read the URL on the server (Astro is statically built).
// The client-side script reads ?sku= and renders the SKU card.
const skuList = Object.values(SKUS);
---

<BaseLayout title={title} description={description} canonical={canonical} robots="noindex, nofollow">

<section class="cart-section">
  <div class="container cart-container">
    <h1 class="cart-h1">Your Cart</h1>

    <div class="cart-empty" id="cart-empty" hidden>
      <p>Your cart is empty.</p>
      <a href="/" class="btn-cart-primary">Browse the 8 categories &rarr;</a>
    </div>

    <div class="cart-item" id="cart-item" hidden>
      <div class="cart-item-body">
        <span class="cart-tag" id="cart-tag">Product</span>
        <h2 class="cart-name" id="cart-name">—</h2>
        <p class="cart-tagline" id="cart-tagline">—</p>
        <p class="cart-availability" id="cart-availability" hidden>—</p>
      </div>
      <div class="cart-item-aside">
        <div class="cart-price-row">
          <div class="cart-price-stack">
            <span class="cart-price-label">Member price</span>
            <span class="cart-price" id="cart-member-price">—</span>
          </div>
          <div class="cart-price-stack cart-price-retail">
            <span class="cart-price-label">Retail</span>
            <span class="cart-price" id="cart-retail-price">—</span>
          </div>
        </div>
        <button class="btn-cart-primary" id="cart-checkout-btn" disabled>
          Continue to Checkout &rarr;
        </button>
        <p class="cart-checkout-note" id="cart-checkout-note">Checkout opens when Stripe is wired (coming soon)</p>
      </div>
    </div>

    <p class="cart-unlock-note">
      <strong>Every My4MLife purchase activates your Protégé tier and unlocks the full 4M App.</strong> Your purchase is the start of your protocol, not the end.
    </p>
  </div>
</section>

<script is:inline define:vars={{ skuList }}>
(function() {
  // Read ?sku=X from URL
  var params = new URLSearchParams(window.location.search);
  var skuId = params.get('sku');

  var emptyEl = document.getElementById('cart-empty');
  var itemEl = document.getElementById('cart-item');

  if (!skuId) {
    emptyEl.hidden = false;
    return;
  }

  // Find the SKU
  var sku = skuList.find(function(s) { return s.id === skuId; });
  if (!sku) {
    emptyEl.hidden = false;
    return;
  }

  itemEl.hidden = false;
  document.getElementById('cart-tag').textContent = sku.cadence === 'monthly' ? 'Monthly subscription' : sku.cadence === 'annual' ? 'Annual subscription' : 'One-time';
  document.getElementById('cart-name').textContent = sku.name;
  document.getElementById('cart-tagline').textContent = sku.tagline;

  var availEl = document.getElementById('cart-availability');
  if (!sku.available && sku.availableNote) {
    availEl.textContent = sku.availableNote;
    availEl.hidden = false;
  }

  // Pricing display — locked 2026-05-18:
  // - 90-day bundle first purchase: 20% off retail
  // - Anything else first purchase OR active subscriber: 15% off retail
  // For now (pre-Stripe) we show both the retail and the most-aggressive discount available
  var retail = sku.retailPriceUSD;
  var memberEl = document.getElementById('cart-member-price');
  var retailEl = document.getElementById('cart-retail-price');
  if (retail) {
    var discountPct = sku.variant === 'ninety-day-bundle' ? 20 : 15;
    var discounted = (retail * (100 - discountPct) / 100).toFixed(2);
    memberEl.textContent = '$' + discounted;
    retailEl.textContent = '$' + retail.toFixed(2);
    // Update the "Member price" label to indicate the discount tier
    var memberLabel = document.querySelector('.cart-price-stack:not(.cart-price-retail) .cart-price-label');
    if (memberLabel) memberLabel.textContent = (discountPct === 20 ? '20% off (first-purchase bundle)' : '15% off (first purchase or subscriber)');
  } else {
    memberEl.textContent = 'TBD';
    retailEl.textContent = 'TBD';
  }

  // Checkout button — only enabled if product is available AND Stripe price ID is set
  var btn = document.getElementById('cart-checkout-btn');
  var note = document.getElementById('cart-checkout-note');
  if (sku.available && sku.stripePriceId) {
    btn.disabled = false;
    note.hidden = true;
    btn.addEventListener('click', function() {
      var apiBase = 'https://v9svm8ds74.execute-api.us-east-2.amazonaws.com';
      btn.disabled = true;
      btn.textContent = 'Opening secure checkout…';
      fetch(apiBase + '/api/create-checkout-session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          skuId: sku.id,
          priceId: sku.stripePriceId,
          contactId: params.get('contactId') || '',
          email: params.get('email') || '',
          firstName: params.get('firstName') || '',
          phone: params.get('phone') || '',
        }),
      })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data && data.url) window.location.href = data.url;
          else {
            btn.disabled = false;
            btn.textContent = 'Continue to Checkout →';
            alert('Checkout error: ' + (data && data.error ? data.error : 'unknown'));
          }
        })
        .catch(function(e) {
          btn.disabled = false;
          btn.textContent = 'Continue to Checkout →';
          alert('Checkout error — please try again.');
        });
    });
  }
})();
</script>

</BaseLayout>

<style>
.cart-section { background: var(--bg-soft); padding: 4rem 0 6rem; min-height: 60vh; }
.cart-container { max-width: 760px; }
.cart-h1 { font-family: 'Playfair Display', serif; font-size: 2.2rem; color: var(--primary); margin-bottom: 1.4rem; }

.cart-empty { text-align: center; padding: 3rem 1rem; }
.cart-empty p { font-size: 1.1rem; color: var(--text-light); margin-bottom: 1.5rem; }

.cart-item {
  background: white;
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 1.8rem 2rem;
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 2rem;
}
.cart-tag {
  display: inline-block;
  font-family: 'Inter', sans-serif;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--accent);
  background: rgba(0,184,148,0.1);
  padding: 0.25rem 0.7rem;
  border-radius: 999px;
  margin-bottom: 0.7rem;
}
.cart-name { font-family: 'Playfair Display', serif; font-size: 1.6rem; color: var(--primary); margin: 0 0 0.5rem; }
.cart-tagline { font-size: 0.95rem; color: var(--text); line-height: 1.55; margin: 0 0 0.8rem; }
.cart-availability {
  font-size: 0.85rem;
  font-style: italic;
  color: var(--text-light);
  padding: 0.6rem 0.9rem;
  background: var(--bg-soft);
  border-radius: 8px;
  border-left: 3px solid var(--accent);
}

.cart-item-aside { display: flex; flex-direction: column; gap: 0.8rem; align-items: flex-end; }
.cart-price-row { display: flex; gap: 1.4rem; align-items: flex-end; }
.cart-price-stack { display: flex; flex-direction: column; align-items: flex-end; }
.cart-price-retail .cart-price { color: var(--text-light); text-decoration: line-through; font-size: 1rem; }
.cart-price-label { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-light); }
.cart-price { font-family: 'Playfair Display', serif; font-size: 1.6rem; color: var(--primary); font-weight: 600; }

.btn-cart-primary {
  padding: 0.85rem 1.6rem;
  background: var(--accent);
  color: white;
  border: none;
  border-radius: 8px;
  font-family: 'Inter', sans-serif;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
  text-decoration: none;
  display: inline-block;
}
.btn-cart-primary:disabled { background: var(--text-light); cursor: not-allowed; opacity: 0.7; }
.btn-cart-primary:not(:disabled):hover { background: #00d4a4; }

.cart-checkout-note { font-size: 0.78rem; font-style: italic; color: var(--text-light); margin: 0; text-align: right; }

.cart-unlock-note {
  margin-top: 2rem;
  padding: 1rem 1.3rem;
  background: rgba(0,184,148,0.08);
  border-left: 3px solid var(--accent);
  border-radius: 8px;
  font-size: 0.92rem;
  color: var(--text);
  line-height: 1.55;
}

@media (max-width: 640px) {
  .cart-item { grid-template-columns: 1fr; }
  .cart-item-aside { align-items: stretch; }
  .cart-price-row { justify-content: space-between; }
}
</style>
