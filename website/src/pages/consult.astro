---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Schedule a Consult | My4MLife";
const description = "Schedule a consult with a My4MLife care coordinator. They'll connect you with a physician in our network for intake, lab review, candidacy assessment, and a personalized protocol.";
const canonical = "https://www.my4mlife.com/consult";
---
<BaseLayout title={title} description={description} canonical={canonical}>

<section class="consult-section">
  <div class="container consult-inner">

    <p class="consult-eyebrow">Care Coordinator Intake</p>
    <h1>Schedule a Consult</h1>
    <p class="consult-sub">
      Tell us what you're working on. A My4MLife care coordinator will reach out within
      one business day to confirm next steps and connect you with a physician in our network.
    </p>

    <figure class="scene-figure">
      <img src="/images/scenes/couple-rooftop.jpg" alt="Couple in their 50s on a rooftop terrace at dusk, she is laughing and looking at him" loading="eager" fetchpriority="high" />
      <figcaption>Five minutes to fill out. One call back. The rest compounds for decades.</figcaption>
    </figure>

    <form id="consult-form" class="consult-form" novalidate>
      <div class="form-row">
        <label for="name">Full name</label>
        <input id="name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="form-row form-row-2">
        <div>
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div>
          <label for="phone">Phone</label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="(555) 555-5555" required />
        </div>
      </div>
      <div class="form-row">
        <label for="category">What would you like to consult about?</label>
        <input id="category" name="category" type="text" required />
      </div>
      <div class="form-row">
        <label for="bestTime">Best time to reach you</label>
        <input id="bestTime" name="bestTime" type="text" placeholder="e.g. weekday mornings, ET" required />
      </div>
      <div class="form-row">
        <label for="note">Anything else we should know? <span class="opt">(optional)</span></label>
        <textarea id="note" name="note" rows="4" placeholder="Brief context — recent labs, symptoms, prior treatments, questions…"></textarea>
      </div>
      <button id="consult-submit" type="submit" class="consult-submit">Submit Request →</button>
      <p id="consult-error" class="consult-error" hidden></p>
    </form>

    <div id="consult-success" class="consult-success" hidden>
      <h2>Got it — request received.</h2>
      <p>
        A care coordinator will reach out within one business day at the email
        and phone number you provided. If your situation is time-sensitive,
        you can also email <a href="mailto:care@my4mlife.com">care@my4mlife.com</a> directly.
      </p>
      <p class="consult-success-em">
        <em>Medical emergency? Call 911. This intake form is not for emergencies and is not monitored 24/7.</em>
      </p>
    </div>

  </div>
</section>

</BaseLayout>

<script is:inline define:vars={{ API_BASE: (import.meta.env.PUBLIC_LEAD_CAPTURE_API_URL ?? 'https://v9svm8ds74.execute-api.us-east-2.amazonaws.com') }}>
(function () {
  // Prefill category from ?category= query param if present
  try {
    var params = new URLSearchParams(window.location.search);
    var cat = params.get('category');
    if (cat) {
      var catEl = document.getElementById('category');
      if (catEl) catEl.value = cat;
    }
  } catch (_) { /* no-op */ }

  function toE164(input) {
    var raw = String(input || '').trim();
    if (!raw) return null;
    var hasPlus = raw.charAt(0) === '+';
    var digits = raw.replace(/[^0-9]/g, '');
    if (hasPlus) {
      if (digits.length >= 8 && digits.length <= 15) return '+' + digits;
      return null;
    }
    if (digits.length === 10) return '+1' + digits;
    if (digits.length === 11 && digits.charAt(0) === '1') return '+' + digits;
    return null;
  }

  var form = document.getElementById('consult-form');
  if (!form) return;
  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    var btn = document.getElementById('consult-submit');
    var err = document.getElementById('consult-error');
    if (err) { err.hidden = true; err.textContent = ''; }

    var name = document.getElementById('name').value.trim();
    var email = document.getElementById('email').value.trim();
    var rawPhone = document.getElementById('phone').value;
    var phone = toE164(rawPhone) || '';
    var category = document.getElementById('category').value.trim();
    var bestTime = document.getElementById('bestTime').value.trim();
    var note = document.getElementById('note').value.trim();

    if (!name || !email || !phone || !category || !bestTime) {
      if (err) {
        err.hidden = false;
        err.textContent = phone ? 'Please complete all required fields.' : 'Please provide a valid US phone number.';
      }
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Submitting…';

    try {
      var res = await fetch(API_BASE + '/api/contact-form', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          kind: 'form',
          formId: 'consult-intake',
          fields: { name: name, email: email, phone: phone, subject: 'Consult intake — ' + category, message: 'Best time: ' + bestTime + '\n\n' + (note || '(no additional notes)') }
        }),
      });
      if (!res.ok) throw new Error('submit failed (' + res.status + ')');
      // Best-effort persist to EMR — never blocks success UX
      fetch(API_BASE + '/api/patient-record-intake', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          email: email,
          category: category,
          demographics: { firstName: name, phone: phone },
          screeningAnswers: { bestTime: bestTime, note: note },
        }),
      }).catch(function() { /* best-effort — ignore errors */ });
      form.style.display = 'none';
      var success = document.getElementById('consult-success');
      if (success) success.hidden = false;
    } catch (e2) {
      btn.disabled = false;
      btn.textContent = 'Submit Request →';
      if (err) {
        err.hidden = false;
        err.textContent = 'Something went wrong submitting your request. Please try again or email care@my4mlife.com directly.';
      }
    }
  });
})();
</script>

<style>
.consult-section { padding: 5rem 1.25rem 6rem; background: var(--bg-soft, #f7fafc); min-height: 60vh; }
.consult-inner { max-width: 640px; margin: 0 auto; background: #fff; padding: 2.5rem 2.25rem; border-radius: var(--radius, 12px); box-shadow: 0 4px 24px rgba(0,0,0,0.06); }
.consult-eyebrow { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent, #00b894); margin: 0 0 0.5rem; }
.consult-inner h1 { font-family: 'Playfair Display', serif; font-size: 2rem; color: var(--primary, #1a365d); margin: 0 0 0.75rem; line-height: 1.2; }
.consult-sub { font-size: 1rem; color: var(--text); line-height: 1.6; margin: 0 0 2rem; }
.consult-form { display: flex; flex-direction: column; gap: 1rem; }
.form-row { display: flex; flex-direction: column; gap: 0.35rem; }
.form-row-2 { display: grid; grid-template-columns: 1fr; gap: 1rem; }
@media (min-width: 560px) { .form-row-2 { grid-template-columns: 1fr 1fr; } }
.form-row-2 > div { display: flex; flex-direction: column; gap: 0.35rem; }
.consult-form label { font-size: 0.82rem; font-weight: 600; color: var(--primary, #1a365d); }
.consult-form .opt { font-weight: 400; color: var(--text-light); }
.consult-form input, .consult-form textarea {
  font-family: inherit; font-size: 0.95rem; color: var(--text);
  background: #fff; border: 1px solid var(--border, #e2e8f0); border-radius: 8px;
  padding: 0.7rem 0.85rem; transition: border-color 0.15s, box-shadow 0.15s;
}
.consult-form input:focus, .consult-form textarea:focus { outline: none; border-color: var(--accent, #00b894); box-shadow: 0 0 0 3px rgba(0,184,148,0.15); }
.consult-submit { align-self: flex-start; margin-top: 0.5rem; padding: 0.85rem 1.6rem; background: var(--accent, #00b894); color: #fff; border: none; border-radius: 999px; font-size: 0.95rem; font-weight: 700; cursor: pointer; transition: background 0.15s, transform 0.15s; }
.consult-submit:hover:not(:disabled) { background: var(--accent-dark, #00a381); transform: translateY(-1px); }
.consult-submit:disabled { opacity: 0.6; cursor: not-allowed; }
.consult-error { color: #c0392b; font-size: 0.88rem; margin: 0.4rem 0 0; }
.consult-success { padding: 0.5rem 0; }
.consult-success h2 { font-family: 'Playfair Display', serif; font-size: 1.5rem; color: var(--primary, #1a365d); margin: 0 0 0.75rem; }
.consult-success p { font-size: 0.98rem; line-height: 1.6; color: var(--text); margin: 0 0 0.85rem; }
.consult-success a { color: var(--accent, #00b894); font-weight: 600; }
.consult-success-em { font-size: 0.85rem; color: var(--text-light); margin-top: 1rem !important; }
</style>
