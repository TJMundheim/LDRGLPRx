---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailCapture from '../components/EmailCapture.astro';

const title = "Membership Tiers — Protégé to Graduate | My4MLife";
const description = "Five membership tiers — free Protégé onboarding through Insider, Insider Plus, Insider Concierge, and earned Graduate status — built around the 4M framework for men. Compare features, member pricing, and the path to permanent Graduate benefits.";
const canonical = "https://www.my4mlife.com/membership";
const keywords = "My4MLife membership, brain health membership, Protégé, Insider, Insider Plus, Insider Concierge, Graduate status, member pricing, Dr. TJ Mundheim, longevity membership, men's health membership, gut-brain protocol, 4M framework";
const ogImage = "https://www.my4mlife.com/og-image.svg";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.my4mlife.com/membership",
      "name": "Membership Tiers — Protégé to Graduate | My4MLife",
      "description": "Five membership tiers — free Protégé to earned Graduate — built around the 4M framework for men.",
      "url": "https://www.my4mlife.com/membership"
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.my4mlife.com/membership#faq",
      "mainEntity": [
        { "@type": "Question", "name": "Is the free Protégé tier really free?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. No card, no trial, no expiration. The full base app is yours forever. Insider and above are paid upgrades." } },
        { "@type": "Question", "name": "What's included in Insider that's not in Protégé?",
          "acceptedAnswer": { "@type": "Answer", "text": "Live group sessions with Dr. TJ, deeper education content, member-only pricing on Rx, supplements, and lab work, and group coaching." } },
        { "@type": "Question", "name": "How do I become a Graduate?",
          "acceptedAnswer": { "@type": "Answer", "text": "12+ months of continuous Insider participation plus completion of specific 4M program milestones. Graduates earn permanent member benefits including future sharing-program access." } },
        { "@type": "Question", "name": "When does Insider open?",
          "acceptedAnswer": { "@type": "Answer", "text": "Insider pricing is finalizing. Subscribe above and we will honor the early-member rate when we launch." } },
        { "@type": "Question", "name": "Can I cancel a paid tier?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, for any paid tier at any time. Protégé does not require a subscription — the app is simply yours." } },
        { "@type": "Question", "name": "Can I downgrade from Concierge to Insider?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, anytime. Downgrading adjusts your access at the next billing cycle." } },
        { "@type": "Question", "name": "What if I miss a live session?",
          "acceptedAnswer": { "@type": "Answer", "text": "Recordings are available to all active Insider-tier members." } },
        { "@type": "Question", "name": "Does the member pricing apply to environmental products?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Member pricing covers Rx, supplements, and environmental products — same tier-based discount applies across the board." } },
        { "@type": "Question", "name": "How does Graduate status differ from Concierge?",
          "acceptedAnswer": { "@type": "Answer", "text": "Concierge is a paid tier you subscribe to. Graduate is a status you earn through 12+ months of continuous Insider participation and program milestones. It is permanent and cannot be purchased." } },
        { "@type": "Question", "name": "What is the My4MLife sharing program?",
          "acceptedAnswer": { "@type": "Answer", "text": "A future Phase 2 vehicle for Graduates: a wellness-focused mutual-aid sharing program covering what insurance won't — peptides, longevity protocols, environmental products. Sequestered now; Graduates access it first." } }
      ]
    }
  ]
};
---
<BaseLayout title={title} description={description} canonical={canonical} keywords={keywords} ogImage={ogImage} schema={schema}>

<!-- ===== HERO ===== -->
<section class="mem-hero">
  <div class="container">
    <div class="mem-hero-content">
      <span class="section-tag">Membership</span>
      <h1>Membership That Earns<br/><em>Its Place</em></h1>
      <p class="mem-hero-sub">From free Protégé onboarding to permanent Graduate status — five tiers, one progression.</p>
      <p class="mem-hero-brand">"My4MLife is a lifestyle company giving you the best chance of having the best mind possible until your last day of life. Membership is how you stay on the path."</p>
      <div class="mem-hero-buttons">
        <a href="https://app.my4mlife.com" class="btn btn-primary btn-large">Become a Protégé — Free <i class="fas fa-arrow-right"></i></a>
        <a href="#tiers" class="btn btn-white btn-large">See All Tiers <i class="fas fa-chevron-down"></i></a>
      </div>
    </div>
  </div>
</section>

<!-- ===== JOURNEY FLOW ===== -->
<section class="section journey-section">
  <div class="container">
    <div class="section-header fade-in">
      <span class="section-tag">The Path</span>
      <h2>One progression. Five levels of commitment.</h2>
      <p>Every member starts free. The path forward is earned.</p>
    </div>
    <div class="journey-flow fade-in">
      <div class="journey-node journey-free">
        <div class="journey-badge">FREE</div>
        <div class="journey-name">Protégé</div>
        <div class="journey-desc">Start here</div>
      </div>
      <div class="journey-arrow"><i class="fas fa-arrow-right"></i></div>
      <div class="journey-node journey-paid">
        <div class="journey-badge">PAID</div>
        <div class="journey-name">Insider</div>
        <div class="journey-desc">Live sessions</div>
      </div>
      <div class="journey-arrow"><i class="fas fa-arrow-right"></i></div>
      <div class="journey-node journey-paid">
        <div class="journey-badge">PAID</div>
        <div class="journey-name">Insider Plus</div>
        <div class="journey-desc">Small-group cohort</div>
      </div>
      <div class="journey-arrow"><i class="fas fa-arrow-right"></i></div>
      <div class="journey-node journey-paid journey-top">
        <div class="journey-badge">PAID</div>
        <div class="journey-name">Insider Concierge</div>
        <div class="journey-desc">1:1 with Dr. TJ</div>
      </div>
      <div class="journey-arrow"><i class="fas fa-arrow-right"></i></div>
      <div class="journey-node journey-earned">
        <div class="journey-badge">EARNED</div>
        <div class="journey-name">Graduate</div>
        <div class="journey-desc">Permanent · Mind as destination</div>
      </div>
    </div>
    <p class="journey-note fade-in">Graduate status is earned — not purchased. It is the destination.</p>
  </div>
</section>

<!-- ===== TIER CARDS ===== -->
<section class="section" id="tiers" style="background:var(--bg-soft);">
  <div class="container">
    <div class="section-header fade-in">
      <span class="section-tag">Membership Tiers</span>
      <h2>Five tiers. One framework. One direction.</h2>
    </div>
    <div class="mem-tiers-grid fade-in">

      <!-- Protégé -->
      <div class="mem-card mem-card-free">
        <div class="mem-card-badge-top mem-badge-free">FREE · FOREVER</div>
        <div class="mem-card-label">Tier 0</div>
        <h3 class="mem-card-title">Protégé</h3>
        <div class="mem-card-positioning">The complete 4M foundation — no card, no expiration, no catch.</div>
        <div class="mem-card-price">Free</div>
        <ul class="mem-card-list">
          <li>Full My4MLife App — your daily protocol hub, available from day one</li>
          <li>20-Factor Self-Assessment — the root-cause map of what's depleting you right now</li>
          <li>4M Cohort App protocol — Mind, Muscle, Mitigate, Motivate, structured for Month 1</li>
          <li>Weekly onboarding sessions (Month 1) — live group orientation with the program team</li>
          <li>Gut-brain repair module — BiomeAxisForge protocol framework built in</li>
          <li>Morning routine tracker — daily execution, not daily aspiration</li>
        </ul>
        <a href="https://app.my4mlife.com" class="btn btn-primary mem-cta">Get the App — Free <i class="fas fa-arrow-right"></i></a>
