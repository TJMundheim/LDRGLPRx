---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "The 4M Cohort — Brain & Body Optimization for Men 35–60 | Essential Manage";
const description = "A physician-supervised brain optimization program for men 35–60. Address the root cause — not just symptoms — with clinical labs, proprietary Rx formulas, and the 4M System.";
const canonical = "https://my4mlife.com/4m-cohort";
const keywords = "4M cohort, brain optimization men, testosterone decline, gut brain axis, physician supervised program, TJ Mundheim";
const ogImage = "https://my4mlife.com/images/og-image.jpg";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalBusiness",
      "@id": "https://my4mlife.com/#organization",
      "name": "Essential Manage",
      "url": "https://my4mlife.com/",
      "description": "Physician-supervised brain and body optimization program for men 35–60.",
      "medicalSpecialty": "Anti-aging and regenerative medicine",
      "areaServed": "US"
    },
    {
      "@type": "FAQPage",
      "@id": "https://my4mlife.com/4m-cohort#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is this safe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "All prescriptions are issued by licensed MDs, DOs, NPs, and PAs in Dr. Mundheim's telemedicine network. Every formula is clinically dosed and physician-reviewed."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to be local?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The 4M program is 100% virtual. Labs are ordered remotely and shipped to your door."
          }
        },
        {
          "@type": "Question",
          "name": "I'm on medications — is that okay?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Your telemedicine provider reviews all current medications before prescribing anything. Safety and compatibility are checked at every step."
          }
        },
        {
          "@type": "Question",
          "name": "Can I start Tier 1 and upgrade later?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — you can upgrade to a higher tier at any time, including after the cohort begins."
          }
        },
        {
          "@type": "Question",
          "name": "What if I don't see results?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We have never had a Month 1 where someone followed the protocol and saw nothing. We're happy to discuss specifics on your free intro call."
          }
        }
      ]
    }
  ]
};
---
<BaseLayout title={title} description={description} canonical={canonical} keywords={keywords} ogImage={ogImage} schema={schema}>

