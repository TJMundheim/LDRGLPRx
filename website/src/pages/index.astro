---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "My4MLife — Begin with the end in mind.";
const description = "The 4M system for optimal cognitive aging. Mind, Muscle, Mitigate, Motivate — a recursive protocol designed by Dr. TJ Mundheim, DC. Start free with the Cohort App.";
const canonical = "https://my4mlife.com/";
const keywords = "4M system, cognitive aging, brain health, gut health, hormone balance, Dr. TJ Mundheim, My4MLife, cohort program, health protocol";
const ogImage = "https://my4mlife.com/logos/concept-13/lockup-color.svg";
const robots = "index, follow";
---
<BaseLayout title={title} description={description} canonical={canonical} keywords={keywords} ogImage={ogImage} robots={robots}>

<!-- ===== HERO ===== -->
<section class="hp-hero">
  <div class="container hp-hero-inner">
    <img src="/logos/concept-13/lockup-color.svg" alt="My4MLife" class="hp-hero-lockup" />
    <p class="hp-tagline"><em>Begin with the end in mind.</em></p>
    <p class="hp-value-prop">
      The 4M system is the simplest path to optimal cognitive aging. Start with <strong>Mind</strong> as your destination, work the <strong>Muscle</strong>, <strong>Mitigate</strong> the harm, <strong>Motivate</strong> the change — and return to a sharper Mind.
    </p>
    <div class="hp-hero-ctas">
      <a href="https://app.my4mlife.com" class="btn btn-primary btn-large" target="_blank" rel="noopener">Download the Cohort App — Free</a>
      <a href="/consult" class="btn btn-outline btn-large">Schedule a 4M Consult</a>
    </div>
  </div>
</section>

<!-- ===== 4M CYCLE ===== -->
<section class="hp-section hp-cycle-section">
  <div class="container">
    <div class="hp-cycle-grid">

      <!-- Mind (emphasized) -->
      <div class="cycle-card cycle-card--mind">
        <div class="cycle-letter">M</div>
        <h3>Mind</h3>
        <p>The destination. Sharper cognition, clearer focus, longer healthspan.</p>
        <a href="/solutions/cognitive" class="cycle-link">Explore &rarr;</a>
      </div>

      <div class="cycle-arrow" aria-hidden="true">&rarr;</div>

      <!-- Muscle -->
      <div class="cycle-card">
        <div class="cycle-letter">M</div>
        <h3>Muscle</h3>
        <p>Strength and body composition as the physical engine of brain health.</p>
        <a href="/solutions/weight" class="cycle-link">Explore &rarr;</a>
      </div>

      <div class="cycle-arrow" aria-hidden="true">&rarr;</div>

      <!-- Mitigate -->
      <div class="cycle-card">
        <div class="cycle-letter">M</div>
        <h3>Mitigate</h3>
        <p>Remove the gut-brain obstacles — inflammation, toxins, hormonal drift.</p>
        <a href="/solutions/gut" class="cycle-link">Explore &rarr;</a>
      </div>

      <div class="cycle-arrow" aria-hidden="true">&rarr;</div>

      <!-- Motivate -->
      <div class="cycle-card">
        <div class="cycle-letter">M</div>
        <h3>Motivate</h3>
        <p>Purpose, goals, and identity change that make the system stick.</p>
        <a href="/solutions/purpose-goals" class="cycle-link">Explore &rarr;</a>
      </div>

    </div>
    <p class="cycle-loop-note">&#8635; The cycle is recursive — Motivate feeds back into a sharper Mind.</p>
  </div>
</section>

<!-- ===== TOP PRIORITIES GRID ===== -->
<section class="hp-section hp-priorities-section">
  <div class="container">
    <div class="hp-section-header">
      <h2>What's holding you back?</h2>
    </div>
    <div class="hp-priorities-grid">
      <a href="/solutions/gut" class="priority-card">
        <span class="priority-badge">Gut &amp; Digestion</span>
        <p>Leaky gut, bloating, and microbiome dysfunction are upstream of almost everything.</p>
        <span class="priority-cta">Explore &rarr;</span>
      </a>
      <a href="/solutions/hormones" class="priority-card">
        <span class="priority-badge">Hormone Balance</span>
        <p>Testosterone, cortisol, and thyroid dysregulation quietly steal your edge.</p>
        <span class="priority-cta">Explore &rarr;</span>
      </a>
      <a href="/solutions/weight" class="priority-card">
        <span class="priority-badge">Weight &amp; Body Fat</span>
        <p>Visceral adiposity is a direct neurotoxin — body composition is brain health.</p>
        <span class="priority-cta">Explore &rarr;</span>
      </a>
      <a href="/solutions/sleep" class="priority-card">
        <span class="priority-badge">Sleep Quality</span>
        <p>Poor sleep is the single fastest way to accelerate cognitive decline.</p>
        <span class="priority-cta">Explore &rarr;</span>
      </a>
      <a href="/solutions/cognitive" class="priority-card">
        <span class="priority-badge">Cognitive Function</span>
        <p>Brain fog, memory gaps, and processing speed loss are not inevitable.</p>
        <span class="priority-cta">Explore &rarr;</span>
      </a>
      <a href="/solutions/stress" class="priority-card">
        <span class="priority-badge">Stress &amp; Resilience</span>
        <p>Chronic cortisol elevation literally shrinks the hippocampus. This is fixable.</p>
        <span class="priority-cta">Explore &rarr;</span>
      </a>
    </div>
  </div>
</section>

<!-- ===== COHORT TIERS ===== -->
<section class="hp-section hp-tiers-section">
  <div class="container">
    <div class="hp-section-header">
      <h2>The 4M Cohort Program</h2>
      <p class="hp-section-sub">Start free. Stay forever.</p>
    </div>
    <div class="hp-tiers-grid">

      <div class="tier-card tier-card--free">
        <div class="tier-badge">Free — Month 1</div>
        <h3>Cohort App</h3>
        <p>The complete 4M Cohort Workbook App. Daily protocols, weekly onboarding guides, full Discovery audit, gut-brain protocol, morning routine tracker. Yours forever — no card required.</p>
        <a href="https://app.my4mlife.com" class="btn btn-primary" target="_blank" rel="noopener">Get the App — Free</a>
      </div>

      <div class="tier-card tier-card--plus">
        <div class="tier-badge tier-badge--gold">Cohort Plus — Month 2+</div>
        <h3>Continue the Journey</h3>
        <p>Continue beyond the 4-week onboarding. Member discounts on supplements and labs. Monthly group Q&amp;A with Dr. TJ. Pricing TBD — early-bird member rate incoming.</p>
        <a href="mailto:hello@my4mlife.com" class="btn btn-outline">Notify Me</a>
      </div>

      <div class="tier-card tier-card--concierge">
        <div class="tier-badge tier-badge--dark">1:1 Concierge</div>
        <h3>Founder Circle</h3>
        <p>Personal protocol design with Dr. TJ. Direct messaging, priority consult booking, full lab panel review. Pricing TBD — limited Founder-circle slots available.</p>
        <a href="mailto:drtj@my4mlife.com" class="btn btn-outline">Apply for Founder Circle</a>
      </div>

    </div>
  </div>
</section>

<!-- ===== FOUNDER SECTION ===== -->
<section class="hp-section hp-founder-section">
  <div class="container hp-founder-inner">
    <div class="founder-avatar" aria-label="Dr. TJ Mundheim">TJ</div>
    <div class="founder-content">
      <h2>Dr. TJ Mundheim, DC</h2>
      <p class="founder-creds">NBCE-certified since 1994 &middot; 30+ years of clinical experience &middot; Founder of My4MLife</p>
      <blockquote class="founder-quote">
        "I built this because I'm living it. Every protocol you see in this program is one I run myself. The 4M framework is what I wish someone had handed me at 50."
      </blockquote>
      <a href="/about" class="btn btn-outline">Full Bio &rarr;</a>
    </div>
  </div>
</section>

<!-- ===== EMAIL CAPTURE BAND ===== -->
<section class="hp-email-band">
  <div class="container hp-email-inner">
    <p class="email-band-tagline"><em>Begin with the end in mind.</em></p>
    <p class="email-band-sub">Get the weekly 4M protocol update — no spam, one email, unsubscribe anytime.</p>
    <div class="email-band-form">
      <input type="email" placeholder="your@email.com" class="email-band-input" aria-label="Email address" />
      <a href="mailto:hello@my4mlife.com" class="btn btn-primary">Stay Informed</a>
    </div>
  </div>
</section>

</BaseLayout>

<style>
/* ===== SHARED HELPERS ===== */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.7rem 1.6rem;
  border-radius: 50px;
  font-family: 'Inter', sans-serif;
  font-size: 0.9rem;
  font-weight: 600;
  text-decoration: none;
  border: none;
  cursor: pointer;
  transition: all 0.25s;
}
.btn-primary { background: var(--accent); color: white; }
.btn-primary:hover { background: var(--accent-dark); transform: translateY(-1px); box-shadow: 0 4px 15px rgba(0,184,148,0.4); }
.btn-outline { background: transparent; color: var(--primary); border: 2px solid var(--primary); }
.btn-outline:hover { background: var(--primary); color: white; }
.btn-large { padding: 1rem 2.2rem; font-size: 1rem; }

/* ===== HERO ===== */
.hp-hero {
  padding: 9rem 0 6rem;
  background: linear-gradient(160deg, #0a1628 0%, #0f4c75 60%, #1b6fa8 100%);
  text-align: center;
  position: relative;
  overflow: hidden;
}
.hp-hero::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -15%;
  width: 700px;
  height: 700px;
  background: radial-gradient(circle, rgba(0,184,148,0.12) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}
.hp-hero-inner { position: relative; z-index: 1; }
.hp-hero-lockup {
  width: 100%;
  max-width: 460px;
  height: auto;
  margin: 0 auto 2rem;
  display: block;
  filter: drop-shadow(0 4px 24px rgba(0,0,0,0.3));
}
.hp-tagline {
  font-family: 'Playfair Display', serif;
  font-size: 1.6rem;
  color: rgba(255,255,255,0.85);
  margin-bottom: 1.4rem;
  font-style: italic;
}
.hp-value-prop {
  font-size: 1.1rem;
  color: rgba(255,255,255,0.75);
  max-width: 640px;
  margin: 0 auto 2.5rem;
  line-height: 1.8;
}
.hp-value-prop strong { color: var(--accent); }
.hp-hero-ctas {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}
.hp-hero-ctas .btn-outline { border-color: rgba(255,255,255,0.5); color: white; }
.hp-hero-ctas .btn-outline:hover { background: rgba(255,255,255,0.15); border-color: white; }

/* ===== SECTIONS ===== */
.hp-section { padding: 5.5rem 0; }
.hp-section-header { text-align: center; margin-bottom: 3rem; }
.hp-section-header h2 { font-size: 2.4rem; margin-bottom: 0.5rem; }
.hp-section-sub { color: var(--text-light); font-size: 1.05rem; }

/* ===== 4M CYCLE ===== */
.hp-cycle-section { background: var(--bg-soft); }
.hp-cycle-grid {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  justify-content: center;
  flex-wrap: wrap;
}
.cycle-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 2rem 1.5rem;
  text-align: center;
  flex: 1;
  min-width: 180px;
  max-width: 220px;
  transition: transform 0.25s, box-shadow 0.25s;
}
.cycle-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
.cycle-card--mind {
  border-color: #c8a84b;
  box-shadow: 0 0 0 2px rgba(200,168,75,0.25);
  min-width: 200px;
  max-width: 240px;
  transform: scale(1.04);
}
.cycle-card--mind:hover { transform: scale(1.04) translateY(-4px); }
.cycle-letter {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: var(--bg-accent);
  color: var(--accent);
  font-family: 'Playfair Display', serif;
  font-size: 1.6rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 1rem;
}
.cycle-card--mind .cycle-letter {
  background: #fdf6e3;
  color: #c8a84b;
}
.cycle-card h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.2rem;
  margin-bottom: 0.5rem;
}
.cycle-card--mind h3 { color: #b8962e; }
.cycle-card p { font-size: 0.85rem; color: var(--text-light); margin-bottom: 1rem; }
.cycle-link { font-size: 0.82rem; font-weight: 600; color: var(--accent); text-decoration: none; }
.cycle-link:hover { text-decoration: underline; }
.cycle-arrow {
  font-size: 1.5rem;
  color: var(--border);
  flex-shrink: 0;
}
.cycle-loop-note {
  text-align: center;
  margin-top: 1.5rem;
  font-size: 0.85rem;
  color: var(--text-light);
  font-style: italic;
}

/* ===== PRIORITIES GRID ===== */
.hp-priorities-section { background: white; }
.hp-priorities-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}
.priority-card {
  display: block;
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 1.6rem;
  text-decoration: none;
  transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
}
.priority-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: var(--accent); }
.priority-badge {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--accent);
  margin-bottom: 0.6rem;
}
.priority-card p { font-size: 0.9rem; color: var(--text); line-height: 1.6; margin-bottom: 0.8rem; }
.priority-cta { font-size: 0.82rem; font-weight: 600; color: var(--primary); }

/* ===== COHORT TIERS ===== */
.hp-tiers-section { background: linear-gradient(135deg, #0a1628 0%, #0f4c75 100%); }
.hp-tiers-section .hp-section-header h2 { color: white; }
.hp-tiers-section .hp-section-sub { color: rgba(255,255,255,0.65); }
.hp-tiers-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}
.tier-card {
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-lg);
  padding: 2.2rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.tier-badge {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--accent);
  background: rgba(0,184,148,0.12);
  padding: 0.3rem 0.8rem;
  border-radius: 20px;
  width: fit-content;
}
.tier-badge--gold { color: #e2b84a; background: rgba(226,184,74,0.12); }
.tier-badge--dark { color: rgba(255,255,255,0.8); background: rgba(255,255,255,0.08); }
.tier-card h3 { font-family: 'Playfair Display', serif; font-size: 1.4rem; color: white; }
.tier-card p { font-size: 0.9rem; color: rgba(255,255,255,0.65); line-height: 1.7; flex: 1; }
.tier-card .btn-outline { border-color: rgba(255,255,255,0.35); color: white; }
.tier-card .btn-outline:hover { background: rgba(255,255,255,0.12); border-color: white; }

/* ===== FOUNDER ===== */
.hp-founder-section { background: var(--bg-soft); }
.hp-founder-inner {
  display: flex;
  gap: 3rem;
  align-items: flex-start;
}
.founder-avatar {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  background: var(--bg-accent);
  border: 3px solid var(--accent);
  color: var(--accent);
  font-family: 'Playfair Display', serif;
  font-size: 2rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.founder-content { flex: 1; }
.founder-content h2 { font-size: 2rem; margin-bottom: 0.4rem; }
.founder-creds { font-size: 0.85rem; color: var(--text-light); margin-bottom: 1.2rem; }
.founder-quote {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-size: 1.1rem;
  color: var(--text);
  border-left: 3px solid var(--accent);
  padding-left: 1.2rem;
  margin-bottom: 1.5rem;
  line-height: 1.7;
}

/* ===== EMAIL BAND ===== */
.hp-email-band {
  background: var(--dark);
  padding: 5rem 0;
  text-align: center;
}
.hp-email-inner { max-width: 560px; margin: 0 auto; }
.email-band-tagline {
  font-family: 'Playfair Display', serif;
  font-size: 2rem;
  color: white;
  margin-bottom: 0.8rem;
}
.email-band-sub {
  font-size: 0.95rem;
  color: rgba(255,255,255,0.6);
  margin-bottom: 2rem;
}
.email-band-form {
  display: flex;
  gap: 0.75rem;
  justify-content: center;
  flex-wrap: wrap;
}
.email-band-input {
  flex: 1;
  min-width: 220px;
  padding: 0.85rem 1.2rem;
  border-radius: 50px;
  border: 1px solid rgba(255,255,255,0.2);
  background: rgba(255,255,255,0.08);
  color: white;
  font-family: 'Inter', sans-serif;
  font-size: 0.9rem;
  outline: none;
}
.email-band-input::placeholder { color: rgba(255,255,255,0.35); }
.email-band-input:focus { border-color: var(--accent); }

/* ===== RESPONSIVE ===== */
@media (max-width: 900px) {
  .hp-priorities-grid { grid-template-columns: repeat(2, 1fr); }
  .hp-tiers-grid { grid-template-columns: 1fr; max-width: 440px; margin: 0 auto; }
  .hp-cycle-grid { flex-direction: column; align-items: center; }
  .cycle-arrow { transform: rotate(90deg); }
  .cycle-card, .cycle-card--mind { min-width: unset; max-width: 340px; width: 100%; transform: none; }
  .cycle-card--mind { transform: none; box-shadow: 0 0 0 2px rgba(200,168,75,0.35); }
  .cycle-card--mind:hover { transform: translateY(-4px); }
}
@media (max-width: 600px) {
  .hp-hero { padding: 7rem 0 4rem; }
  .hp-hero-lockup { max-width: 280px; }
  .hp-tagline { font-size: 1.3rem; }
  .hp-value-prop { font-size: 0.97rem; }
  .hp-priorities-grid { grid-template-columns: 1fr; }
  .hp-founder-inner { flex-direction: column; align-items: center; text-align: center; }
  .founder-quote { text-align: left; }
  .hp-section-header h2 { font-size: 1.9rem; }
  .email-band-tagline { font-size: 1.5rem; }
}
</style>
