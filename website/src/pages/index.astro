---
import BaseLayout from '../layouts/BaseLayout.astro';
import HowItWorks from '../components/HowItWorks.astro';
import '../styles/door.css';
import TrustBand from '../components/TrustBand.astro';
import { COORDINATOR_MODE, SHOW_BEASLEY_PARTNER, SHOW_COACHING, consultHref } from '../lib/siteMode';

const title = COORDINATOR_MODE
  ? "My4MLife — Protect your mind. The right treatment, chosen with you."
  : "My4MLife — Protect your mind. Physician-prescribed treatment you can start today.";
const description = "Physician-prescribed telemedicine built around brain healthspan: GLP-1 weight loss, gut-brain repair, growth-hormone peptides, testosterone, and menopause HRT. Answer a few questions from your phone — most visits are free. Founded by Dr. TJ.";
const canonical = "https://www.my4mlife.com/";
const keywords = "GLP-1 weight loss, semaglutide, tirzepatide, gut brain axis, gut lining repair, growth hormone peptide, testosterone therapy, menopause HRT, telemedicine, cognitive longevity, brain health, My4MLife, Dr. TJ Mundheim";
const ogImage = "https://www.my4mlife.com/images/hero/main.jpg";
const robots = "index, follow";

const treatments = [
  {
    slug: 'gut-brain',
    eyebrow: 'Free visit',
    free: true,
    tag: null,
    name: 'Gut-Brain Rx',
    benefit: 'A proprietary, physician-written gut-lining repair formulation. Your gut makes about 90% of your serotonin — repair the supply line to your mind.',
    href: '/rx/leaky-gut',
  },
  {
    slug: 'weight-loss',
    eyebrow: 'Free visit',
    free: true,
    tag: null,
    name: 'GLP-1 Weight Loss',
    benefit: 'Semaglutide or tirzepatide, prescribed correctly the first time.',
    href: '/rx/weight-loss',
  },
  {
    slug: 'peptides',
    eyebrow: 'Free visit',
    free: true,
    tag: null,
    name: 'Peptides',
    benefit: 'Growth-hormone and repair peptides, matched to your goals — including tesamorelin for belly fat with muscle preserved.',
    href: '/rx/peptides',
  },
  {
    slug: 'testosterone',
    eyebrow: '$249 live visit',
    free: false,
    tag: 'For men',
    name: 'Testosterone',
    benefit: 'Low T and ED evaluated together, with the hormone panel that makes prescribing safe.',
    href: '/rx/testosterone-ed',
  },
  {
    slug: 'menopause',
    eyebrow: '$249 live visit',
    free: false,
    tag: 'For women',
    name: 'Menopause & HRT',
    benefit: 'Brain fog, sleep, weight, and hormones — one visit, a plan for the whole system.',
    href: '/rx/menopause-hrt',
  },
];
---
<BaseLayout title={title} description={description} canonical={canonical} keywords={keywords} ogImage={ogImage} robots={robots}>

<!-- ===== HERO — direct-buy ===== -->
<section class="hp-hero" id="hp-hero">
  <div class="container hp-hero-inner">
    <h1 class="hp-hero-headline">{COORDINATOR_MODE ? 'Protect your mind — and the body that carries it — with the right treatment, chosen with you.' : 'Protect your mind — and the body that carries it — with physician-prescribed treatment you can start today.'}</h1>

    <p class="hp-hero-sub hp-hero-spine">Alzheimer's is a disease that shows up when you're older. It starts in midlife.</p>

    <p class="hp-hero-sub">{COORDINATOR_MODE ? 'No card. No decisions to make. Take the intake, then Dr. TJ calls you.' : 'Pick your treatment. Answer a few questions from your phone. A licensed physician reviews — most visits are free.'}</p>

    {COORDINATOR_MODE ? (
      <div class="hp-hero-doors">
        <a href={consultHref()} class="btn-primary-xl" onclick="window.posthog && posthog.capture('hp_coordinator_cta')">Free care coordinator call &mdash; find out exactly what you need &rarr;</a>
        <a href="/assessment" class="btn-secondary-xl" onclick="window.posthog && posthog.capture('hp_hero_assessment_cta')">Take the MindSpan assessment now &rarr;</a>
      </div>
      <div class="hp-audience">
        <p class="hp-audience-label">Who are you?</p>
        <div class="hp-audience-row">
          <a href="/women" class="hp-audience-btn" onclick="window.posthog && posthog.capture('hp_door_women')">For women</a>
          <a href="/men" class="hp-audience-btn" onclick="window.posthog && posthog.capture('hp_door_men')">For men</a>
        </div>
      </div>
      <p class="hp-hero-reassure">Nothing to pay today. After your call you'll get a written plan, and nothing is booked or charged unless it fits.</p>
    ) : (
      <a href="#treatments" class="btn-primary-xl" onclick="window.posthog && posthog.capture('hp_hero_choose_treatment')">Choose your treatment &darr;</a>
    )}

    <p class="hp-hero-brandnote"><em>Begin with the end in mind.</em></p>
    <p class="hp-hero-brandnote">Don't lose your identity and your dignity while you still have a choice.</p>
  </div>
</section>

{!COORDINATOR_MODE && (
<section id="treatments" class="hp-treatments">
  <div class="container">
    <div class="tx-grid">
      {treatments.map((t) => (
        <a
          href={t.href}
          class="tx-card"
          onclick={`window.posthog && posthog.capture('hp_treatment_${t.slug}')`}
        >
          <div class="tx-card-top">
            <span class={t.free ? 'tx-eyebrow tx-eyebrow--free' : 'tx-eyebrow tx-eyebrow--paid'}>{t.eyebrow}</span>
            {t.tag && <span class="tx-tag">{t.tag}</span>}
          </div>
          <h2 class="tx-name">{t.name}</h2>
          <p class="tx-benefit">{t.benefit}</p>
          <span class="tx-start">Start &rarr;</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ===== BILLING REASSURANCE STRIP ===== -->
<section class="hp-reassure">
  <div class="container">
    <p>Medication is billed separately after a physician writes your script. If you're not approved, you're never charged.</p>
  </div>
</section>
)}

<TrustBand />

<HowItWorks />

<!-- ===== SECONDARY — free path ===== -->
<section class="hp-free">
  <div class="container hp-free-inner">
    <h2 class="hp-free-heading">Not ready to buy? Start free.</h2>
    <p class="hp-free-copy">Take the free MindSpan assessment and you get the book <em>Begin with the End in Mind</em>, the <em>Logbook</em>, and the Prot&eacute;g&eacute; app.</p>
    <a href="/assessment" class="btn-secondary" onclick="window.posthog && posthog.capture('hp_free_assessment')">Take the free assessment &rarr;</a>

    <div class="hp-free-book">
      <img src="/images/book/cover-front.png" alt="Begin with the End in Mind book cover" class="hp-free-book-cover" loading="lazy" />
      <div class="hp-free-book-text">
        <p class="hp-free-book-title"><em>Begin with the End in Mind</em></p>
        <p class="hp-free-book-tagline">Don't lose your identity and your dignity while you still have a choice.</p>
        <p class="hp-free-book-copy">Dr. TJ's field guide. Free when you complete the assessment, or own it now:</p>
        <p class="hp-free-book-links">
          <a href="https://www.amazon.com/dp/B0H7FJRHXC" target="_blank" rel="noopener" onclick="window.posthog && posthog.capture('hp_book_amazon_click', {format:'kindle'})">Kindle</a>
          <span class="hp-free-book-sep">&middot;</span>
          <a href="https://www.amazon.com/dp/B0H7742SDD" target="_blank" rel="noopener" onclick="window.posthog && posthog.capture('hp_book_amazon_click', {format:'paperback'})">Paperback</a>
          <span class="hp-free-book-sep">&middot;</span>
          <a href="https://www.amazon.com/dp/B0H75TYF1G" target="_blank" rel="noopener" onclick="window.posthog && posthog.capture('hp_book_amazon_click', {format:'hardcover'})">Hardcover</a>
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ===== PARTNER · RANDALL BEASLEY (live 2026-10-17) ===== -->
{SHOW_BEASLEY_PARTNER && (
<section class="hp-partner" aria-labelledby="hp-partner-heading">
  <div class="container hp-partner-inner">
    <div class="hp-partner-lead">
      <p class="hp-eyebrow">Partner &middot; Randall Beasley</p>
      <h2 class="hp-partner-heading" id="hp-partner-heading">Running From Excuses</h2>
      <span class="hp-partner-rule" aria-hidden="true"></span>
    </div>
    <div class="hp-partner-body">
      <p>My work starts with the body and the brain: what you eat, how you sleep, what you are exposed to, and what medicine can do. My best friend of thirty years, Randall Beasley, works on what has to come first: the decision to stop making excuses. His book is part memoir and part roadmap. He lost his business and his health, and he rebuilt both with a simple framework, one honest decision at a time.</p>
      <p>In the 4Ms, that is Motivate. We send people back and forth, each to the one best equipped to help. If the thing holding you back is the decision itself, start with Randall.</p>
      <div class="hp-partner-actions">
        <a href="https://www.amazon.com/dp/B0HH9Q67QD" target="_blank" rel="noopener" class="hp-btn hp-btn--solid" onclick="window.posthog && posthog.capture('hp_beasley_book_click')">Get the book</a>
        <a href="https://randallbeasley.com/#coaching" target="_blank" rel="noopener" class="hp-btn hp-btn--ghost" onclick="window.posthog && posthog.capture('hp_beasley_coaching_click')">Coaching with Randall</a>
      </div>
      <p class="hp-fine">Randall's coaching is not medical care. Medical care through My4MLife is provided by our network's licensed physicians.</p>
    </div>
  </div>
</section>
)}

<!-- ===== ONE-ON-ONE WITH DR. TJ · THE CAPTAIN'S TABLE (live 2026-10-17) ===== -->
{SHOW_COACHING && (
<section class="hp-seats" aria-labelledby="hp-seats-heading">
  <div class="container hp-seats-inner">
    <div class="hp-seats-dots" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <p class="hp-eyebrow hp-eyebrow--gold">One-on-one with Dr. TJ &middot; The Captain&rsquo;s Table</p>
    <h2 class="hp-seats-heading" id="hp-seats-heading">Four seats. Your home. Your whole life.</h2>
    <p class="hp-seats-copy">I take on no more than four people at a time, and I come to you twice in your first month. First, four days in your home, Sunday through Wednesday: we test, we clear the pantry, set up your home, and build your workout and your morning routine. Then a call every day. At the end of the month I come back for three days to see what thirty days of change has done, and to deliver your regenerative therapy in person.</p>
    <p class="hp-seats-price"><span class="hp-seats-amt">$50,000</span> for the first month. Travel included.</p>
    <p class="hp-seats-cap">Two new seats open each month. Never more than four people at a time.</p>
    <a href="/coaching" class="hp-btn hp-btn--accent" onclick="window.posthog && posthog.capture('hp_coaching_apply_click')">Apply for a seat</a>
    <p class="hp-seats-note">By application only.</p>
  </div>
</section>
)}

<!-- ===== FOUNDER QUOTE ===== -->
<section class="hp-quote">
  <div class="container hp-quote-inner">
    <blockquote class="hp-quote-text">
      &ldquo;The people I want on these treatments aren't trying to look 30 again. They want to be present and sharp at their granddaughter's wedding &mdash; to recognize her face, remember her husband's name, and finish the toast they planned. That's the whole thesis in one sentence, and it's the only outcome I care about delivering.&rdquo;
    </blockquote>
    <p class="hp-quote-attr">&mdash; Dr. TJ &middot; Founder, My4MLife</p>
  </div>
</section>

</BaseLayout>

<style>
/* ===== HERO ===== */
.hp-hero {
  background:
    radial-gradient(ellipse at 50% 0%, rgba(0, 184, 148, 0.18) 0%, rgba(10, 22, 40, 0) 62%),
    linear-gradient(160deg, #102842 0%, #0a1628 55%, #050b16 100%);
  padding: 5.5rem 0 4rem;
}
.hp-hero-inner {
  max-width: 820px;
  text-align: center;
}
.hp-hero-headline {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.9rem, 5.2vw, 3.1rem);
  font-weight: 700;
  line-height: 1.2;
  color: #fff;
  margin: 0 auto 1.2rem;
  text-wrap: balance;
}
.hp-hero-sub {
  font-family: 'Inter', sans-serif;
  font-size: clamp(1rem, 2.2vw, 1.15rem);
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.86);
  margin: 0 auto 2rem;
  max-width: 620px;
}
.hp-hero-spine {
  font-weight: 600;
  color: rgba(255, 255, 255, 0.94);
  margin-bottom: 0.9rem;
}
.hp-hero-brandnote {
  font-family: 'Playfair Display', serif;
  font-size: 1rem;
  color: rgba(212, 175, 90, 0.85);
  margin: 1.6rem 0 0;
}
.hp-hero-brandnote em { font-style: italic; }

/* ===== PRIMARY BUTTON (kept from prior page) ===== */
.btn-primary-xl {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  padding: 1rem 1.9rem;
  border-radius: 40px;
  background: var(--accent);
  color: #fff;
  font-family: 'Inter', sans-serif;
  font-size: 1.08rem;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
  text-decoration: none;
  border: 2px solid var(--accent);
  box-shadow: 0 10px 32px rgba(0, 184, 148, 0.4), 0 2px 8px rgba(0, 0, 0, 0.25);
  transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  cursor: pointer;
  max-width: 100%;
}
.btn-primary-xl:hover {
  background: var(--accent-dark);
  border-color: var(--accent-dark);
  transform: translateY(-2px);
  box-shadow: 0 14px 40px rgba(0, 184, 148, 0.5), 0 4px 12px rgba(0, 0, 0, 0.3);
}
@media (min-width: 640px) {
  .btn-primary-xl { padding: 1.25rem 2.6rem; font-size: 1.3rem; border-radius: 56px; }
}

/* ===== HERO — two-door coordinator layout ===== */
.hp-hero-doors {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
}
.btn-secondary-xl {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  padding: 0.85rem 1.7rem;
  border-radius: 40px;
  background: transparent;
  color: #fff;
  font-family: 'Inter', sans-serif;
  font-size: 1rem;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
  text-decoration: none;
  border: 2px solid rgba(255, 255, 255, 0.55);
  transition: border-color 0.18s ease, background 0.18s ease;
  max-width: 100%;
}
.btn-secondary-xl:hover {
  border-color: #fff;
  background: rgba(255, 255, 255, 0.08);
}

/* ===== HERO REASSURANCE (coordinator mode) ===== */
.hp-hero-reassure {
  font-family: 'Inter', sans-serif;
  font-size: 0.9rem;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
  margin: 0.9rem auto 0;
  max-width: 34rem;
}

/* ===== TREATMENT CARDS ===== */
.hp-treatments {
  background: var(--bg-soft);
  padding: 3rem 0 3.25rem;
}
.hp-treatments-heading {
  font-family: 'Playfair Display', serif;
  font-size: 1.6rem;
  font-weight: 700;
  color: var(--dark);
  text-align: center;
  margin: 0 0 1.75rem;
}
.tx-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
}
.tx-card {
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
  background: #fff;
  border: 1px solid var(--border);
  border-top: 3px solid var(--accent);
  border-radius: 14px;
  padding: 1.35rem 1.4rem 1.5rem;
  text-decoration: none;
  color: var(--text);
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}
.tx-card:hover,
.tx-card:focus-visible {
  transform: translateY(-3px);
  box-shadow: var(--shadow-md);
  border-color: var(--accent);
}
.tx-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.6rem;
  flex-wrap: wrap;
}
.tx-eyebrow {
  font-family: 'Inter', sans-serif;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.tx-eyebrow--free { color: var(--accent-dark); }
.tx-eyebrow--paid { color: var(--primary); }
.tx-tag {
  font-family: 'Inter', sans-serif;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--primary);
  background: rgba(15, 76, 117, 0.09);
  border-radius: 20px;
  padding: 0.22rem 0.65rem;
  white-space: nowrap;
}
.tx-name {
  font-family: 'Playfair Display', serif;
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--dark);
  margin: 0;
  line-height: 1.25;
}
.tx-benefit {
  font-family: 'Inter', sans-serif;
  font-size: 0.92rem;
  line-height: 1.6;
  color: var(--text-light);
  margin: 0;
  flex: 1;
}
.tx-start {
  font-family: 'Inter', sans-serif;
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--accent-dark);
  margin-top: 0.35rem;
}
.tx-card:hover .tx-start { color: var(--primary); }

@media (min-width: 640px) {
  .tx-grid { grid-template-columns: repeat(2, 1fr); gap: 1.15rem; }
}
@media (min-width: 1024px) {
  /* 6-col track so 5 cards render as 3 + 2 centered */
  .tx-grid { grid-template-columns: repeat(6, 1fr); gap: 1.25rem; }
  .tx-card { grid-column: span 2; }
  .tx-card:nth-child(4) { grid-column: 2 / span 2; }
}

/* ===== REASSURANCE STRIP ===== */
.hp-reassure {
  background: var(--primary);
  padding: 1.1rem 0;
}
.hp-reassure p {
  font-family: 'Inter', sans-serif;
  font-size: 0.92rem;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.94);
  text-align: center;
  margin: 0;
}

/* ===== SECONDARY FREE BAND ===== */
.hp-free {
  background: #fff;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  padding: 2.75rem 0;
}
.hp-free-inner {
  max-width: 640px;
  text-align: center;
}
.hp-free-heading {
  font-family: 'Playfair Display', serif;
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--dark);
  margin: 0 0 0.6rem;
}
.hp-free-copy {
  font-family: 'Inter', sans-serif;
  font-size: 0.95rem;
  line-height: 1.65;
  color: var(--text-light);
  margin: 0 0 1.35rem;
}
.hp-free-copy em { font-style: italic; color: var(--text); }
.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.75rem 1.6rem;
  border-radius: 40px;
  background: transparent;
  color: var(--primary);
  border: 2px solid var(--primary);
  font-family: 'Inter', sans-serif;
  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: none;
  transition: background 0.18s ease, color 0.18s ease;
}
.btn-secondary:hover {
  background: var(--primary);
  color: #fff;
}

/* ===== SECONDARY FREE BAND — book row ===== */
.hp-free-book {
  display: flex;
  align-items: center;
  gap: 1.1rem;
  max-width: 480px;
  margin: 2rem auto 0;
  padding-top: 1.75rem;
  border-top: 1px solid var(--border);
  text-align: left;
}
.hp-free-book-cover {
  width: 100%;
  max-width: 110px;
  height: auto;
  flex-shrink: 0;
  border-radius: 3px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
}
.hp-free-book-text {
  min-width: 0;
}
.hp-free-book-title {
  font-family: 'Playfair Display', serif;
  font-size: 1rem;
  font-weight: 700;
  color: var(--dark);
  margin: 0 0 0.3rem;
}
.hp-free-book-title em { font-style: italic; }
.hp-free-book-tagline {
  font-family: 'Inter', sans-serif;
  font-size: 0.8rem;
  font-style: italic;
  color: var(--text-light);
  margin: 0 0 0.5rem;
}
.hp-free-book-copy {
  font-family: 'Inter', sans-serif;
  font-size: 0.85rem;
  line-height: 1.5;
  color: var(--text-light);
  margin: 0 0 0.45rem;
}
.hp-free-book-links {
  font-family: 'Inter', sans-serif;
  font-size: 0.85rem;
  font-weight: 600;
  margin: 0;
}
.hp-free-book-links a {
  color: var(--primary);
  text-decoration: none;
}
.hp-free-book-links a:hover { text-decoration: underline; }
.hp-free-book-sep {
  color: var(--text-light);
  margin: 0 0.35rem;
}
@media (max-width: 639px) {
  .hp-free-book {
    flex-direction: column;
    text-align: center;
  }
  .hp-free-book-cover { max-width: 90px; }
}

/* ===== FOUNDER QUOTE ===== */
.hp-quote {
  background: var(--bg-soft);
  padding: 3.25rem 0;
}
.hp-quote-inner {
  max-width: 720px;
  text-align: center;
}
.hp-quote-text {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.08rem, 2.4vw, 1.35rem);
  line-height: 1.6;
  color: var(--dark);
  margin: 0 0 1.1rem;
  font-style: italic;
}
.hp-quote-attr {
  font-family: 'Inter', sans-serif;
  font-size: 0.88rem;
  color: var(--text-light);
  margin: 0;
}

@media (min-width: 768px) {
  .hp-hero { padding: 6.5rem 0 5rem; }
  .hp-treatments { padding: 4rem 0; }
  .hp-free { padding: 3.5rem 0; }
  .hp-quote { padding: 4.5rem 0; }
  .hp-free-heading { font-size: 1.65rem; }
}

/* ===== DRAFT BANDS — shared ===== */
.hp-eyebrow {
  font-family: 'Inter', sans-serif;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--accent-dark);
  margin: 0 0 0.9rem;
}
.hp-eyebrow--gold { color: rgba(212, 175, 90, 0.95); }
.hp-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.85rem 1.7rem;
  border-radius: 40px;
  font-family: 'Inter', sans-serif;
  font-size: 0.95rem;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
  text-decoration: none;
  border: 2px solid transparent;
  transition: transform 0.18s ease, background 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
}
.hp-btn--solid { background: var(--primary); border-color: var(--primary); color: #fff; }
