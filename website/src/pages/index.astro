---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailCapture from '../components/EmailCapture.astro';

const title = "My4MLife — Live longer. Think sharper. Begin with the end in mind.";
const description = "Brain-health-first lifestyle and telemedicine. Schedule a comprehensive consult, get the free Protégé app, or take the 5-minute audit. Founded by Dr. TJ Mundheim, DC.";
const canonical = "https://www.my4mlife.com/";
const keywords = "4M system, cognitive aging, brain health, hormone optimization, GLP-1 weight loss, Dr. TJ Mundheim, My4MLife, membership program, health protocol, men cognitive longevity";
const ogImage = "https://www.my4mlife.com/images/hero/main.jpg";
const robots = "index, follow";
---
<BaseLayout title={title} description={description} canonical={canonical} keywords={keywords} ogImage={ogImage} robots={robots}>

<!-- ===== HERO — Full-bleed Hims-pattern ===== -->
<section class="hp-hero">
  <div class="hp-hero-bg" aria-hidden="true">
    <img
      src="/images/hero/main.jpg"
      alt=""
      class="hp-hero-img"
      loading="eager"
      fetchpriority="high"
      width="1920"
      height="1280"
    />
    <div class="hp-hero-overlay"></div>
  </div>

  <div class="container hp-hero-content">
    <h1 class="hp-hero-headline">
      Live longer. Think sharper.<br />
      <em>Begin with the end in mind.</em>
    </h1>

    <div class="hp-hero-ctas">
      <a href="/consult" class="btn hp-btn-ghost">Schedule a Consult</a>
      <a href="https://app.my4mlife.com" class="btn hp-btn-filled" target="_blank" rel="noopener">Get the App — Free</a>
      <a href="/assessment" class="btn hp-btn-ghost">Take the Free Audit</a>
    </div>

    <p class="hp-hero-sub">Brain-health-first. Pick the path that fits — all three keep you engaged.</p>
  </div>
</section>

<!-- ===== SECTION 1: 4M FRAMEWORK ===== -->
<section class="hp-section hp-4m-section">
  <div class="container">
    <div class="hp-section-header">
      <h2 class="hp-4m-header">The 4M System</h2>
      <p class="hp-4m-explainer">
        The 4M system is the path: <strong>Mind</strong> is the destination — work the <strong>Muscle</strong>, <strong>Mitigate</strong> the harm, <strong>Motivate</strong> the change, return to a sharper Mind. Recursive, by design.
      </p>
    </div>

    <div class="hp-4m-grid">

      <a href="/pillars/mind" class="m-card m-card--mind">
        <div class="m-letter">M</div>
        <h3>Mind</h3>
        <p>The destination. Sharper cognition, clearer focus, longer healthspan.</p>
        <span class="m-link">Explore &rarr;</span>
      </a>

      <div class="m-arrow" aria-hidden="true">&rarr;</div>

      <a href="/pillars/muscle" class="m-card">
        <div class="m-letter">M</div>
        <h3>Muscle</h3>
        <p>Strength and body composition as the physical engine of brain health.</p>
        <span class="m-link">Explore &rarr;</span>
      </a>

      <div class="m-arrow" aria-hidden="true">&rarr;</div>

      <a href="/pillars/mitigate" class="m-card">
        <div class="m-letter">M</div>
        <h3>Mitigate</h3>
        <p>Remove the gut-brain obstacles — inflammation, toxins, hormonal drift.</p>
        <span class="m-link">Explore &rarr;</span>
      </a>

      <div class="m-arrow" aria-hidden="true">&rarr;</div>

      <a href="/pillars/motivate" class="m-card">
        <div class="m-letter">M</div>
        <h3>Motivate</h3>
        <p>Purpose, goals, and identity change that make the system stick.</p>
        <span class="m-link">Explore &rarr;</span>
      </a>

    </div>
  </div>
</section>

<!-- ===== SECTION 2: FEATURED PROTOCOLS ===== -->
<section class="hp-section hp-protocols-section">
  <div class="container">
    <div class="hp-section-header">
      <h2>Where most men should start</h2>
      <p class="hp-section-sub">Three action steps. Pick one — or take all three in any order.</p>
    </div>

    <div class="hp-protocols-grid">

      <a href="https://app.my4mlife.com" class="proto-card">
        <div class="proto-body proto-body-tall">
          <span class="proto-step">Step 1 — Free</span>
          <h3>Become a Protégé</h3>
          <p>The free workbook app. The 4M framework — Mind, Muscle, Mitigate, Motivate — built into a daily habit anchor. Start today, no card, no consult required.</p>
          <span class="proto-link">Open the app &rarr;</span>
        </div>
      </a>

      <a href="/assessment" class="proto-card">
        <div class="proto-body proto-body-tall">
          <span class="proto-step">Step 2 — 5 minutes</span>
          <h3>Take the Assessment</h3>
          <p>You can't <em>begin with the end in mind</em> until you know where you're starting. A 20-question audit identifies your top-three priorities in five minutes — and shows you the path from where you are to where you want to be.</p>
          <span class="proto-link">Start the audit &rarr;</span>
        </div>
      </a>

      <a href="/consult" class="proto-card">
        <div class="proto-body proto-body-tall">
          <span class="proto-step">Step 3 — Know your numbers</span>
          <h3>Schedule the Consult</h3>
          <p>Where labs and testing actually pinpoint your starting line. Hormones, metabolic markers, cognitive baseline — the fastest path from "I think" to "I know," with a licensed telemedicine provider who builds your protocol around the data.</p>
          <span class="proto-link">Book the consult &rarr;</span>
        </div>
      </a>

    </div>
  </div>
</section>

<!-- ===== SECTION 2.4: ED — THE EARLY WARNING ===== -->
<section class="hp-section hp-canary-section">
  <div class="container">
    <div class="hp-section-header">
      <h2>The early warning your body is sending</h2>
      <p class="hp-section-sub">One signal most men ignore for a decade. We don't.</p>
    </div>

    <a href="/solutions/erectile-dysfunction" class="proto-card canary-card">
      <div class="proto-body proto-body-tall canary-body">
        <span class="proto-step canary-badge">Canary in the mine</span>
        <h3 class="canary-title">Erectile Dysfunction</h3>
        <p class="canary-copy">ED is rarely just an erection problem. It's the earliest visible signal that hormones, cardiovascular health, and cognitive trajectory are all drifting in the wrong direction. Most men ignore the signal for a decade. We don't.</p>
        <span class="proto-link">Learn what ED is actually telling you &rarr;</span>
      </div>
    </a>
  </div>
</section>

<!-- ===== SECTION 2.5: ANTICIPATED OUTCOMES — HONEST FORWARD-FRAMING ===== -->
<section class="hp-section hp-anticipated-section">
  <div class="container">
    <div class="hp-section-header">
      <h2>What we're building toward</h2>
      <p class="hp-anticipated-subhead">
        We won't fabricate testimonials. Our first cohort is just starting. Here's the honest forward-framing — what 30+ years of clinical pattern recognition tells us to expect, and what we're holding ourselves accountable to deliver.
      </p>
    </div>

    <div class="hp-anticipated-grid">

      <article class="anticipated-card">
        <span class="anticipated-badge anticipated-badge--founder">Founder perspective</span>
        <p class="anticipated-quote">"In thirty years of practice with men, the pattern is almost always the same: the cognitive slide starts a decade before anyone names it. Word-finding gets slower, sleep gets shallower, the workout that used to feel good now feels like a chore. Most men accept it. The whole point of 4M is that you don't have to."</p>
        <p class="anticipated-attribution">Dr. TJ &middot; Founder</p>
      </article>

      <article class="anticipated-card">
        <span class="anticipated-badge anticipated-badge--composite">Composite pattern &middot; not an individual</span>
        <p class="anticipated-quote">The 52-year-old executive who walks in convinced the brain fog is just stress and not enough coffee. Labs tell a different story — inflammation, hormone drift, gut dysbiosis stacking on top of each other. Six months in, the fog is the first thing that lifts. He notices it on a Tuesday afternoon when a name he'd been hunting for three weeks lands without effort.</p>
        <p class="anticipated-attribution">Composite based on common patterns &middot; not a single member</p>
      </article>

      <article class="anticipated-card">
        <span class="anticipated-badge anticipated-badge--goal">90-day goal</span>
        <p class="anticipated-quote">Our goal for every Protégé in 90 days: measurably sharper morning cognition, a sleep score they can point to, and one cognitive task — a name, a word, a workflow — that comes back faster than it did in week one. Not weight loss. Not a vanity metric. Cognitive function you can feel before noon.</p>
        <p class="anticipated-attribution">What we're holding ourselves to &middot; not a guarantee</p>
      </article>

      <article class="anticipated-card">
        <span class="anticipated-badge anticipated-badge--coming">Coming Q3 2026</span>
        <p class="anticipated-quote">Real member stories land here as our first cohort graduates. We won't fake it, we won't pay for it, and we won't pull the quote out of context. If the protocol works the way 30 years of clinical experience says it should, the stories will tell themselves.</p>
        <p class="anticipated-attribution">First-cohort outcomes &middot; published when earned</p>
      </article>

      <article class="anticipated-card anticipated-card--wide">
        <span class="anticipated-badge anticipated-badge--founder">Founder perspective</span>
        <p class="anticipated-quote">"The men I want in this program aren't trying to look 30 again. They're trying to be present and sharp at their granddaughter's wedding. They want to recognize her face, remember her husband's name, and finish the toast they planned. That's the brain-health thesis in one sentence — and it's the only outcome I care about delivering."</p>
        <p class="anticipated-attribution">Dr. TJ &middot; Founder</p>
      </article>

    </div>
  </div>
</section>

<!-- ===== SECTION 3: MEMBERSHIP COMPARISON ===== -->
<section class="hp-section hp-tiers-section">
  <div class="container">
    <div class="hp-section-header">
      <h2 class="hp-tiers-heading">Free Protégé. Earned Graduate. Everything in between.</h2>
    </div>

    <div class="hp-tiers-grid">

      <div class="tier-card tier-card--free">
        <div class="tier-badge tier-badge--free">Free</div>
        <h3>Protégé</h3>
        <p>The complete 4M digital workbook. Daily protocols, full Discovery audit, gut-brain protocol, morning routine tracker. Yours forever — no card required.</p>
        <a href="https://app.my4mlife.com" class="btn btn-accent" target="_blank" rel="noopener">Get the App — Free</a>
      </div>

      <div class="tier-card">
        <div class="tier-badge tier-badge--gold">Paid</div>
        <h3>Insider</h3>
        <p>Continue beyond the 4-week onboarding. Member discounts on supplements and labs. Monthly group Q&amp;A with Dr. TJ.</p>
        <a href="/membership" class="btn btn-outline-white">Learn More</a>
      </div>

      <div class="tier-card">
        <div class="tier-badge tier-badge--dark">Paid</div>
        <h3>Insider Concierge</h3>
        <p>Personal protocol design with Dr. TJ. Direct messaging, priority consult booking, full lab panel review. Limited slots.</p>
        <a href="/membership" class="btn btn-outline-white">Learn More</a>
      </div>

      <div class="tier-card tier-card--graduate">
        <div class="tier-badge tier-badge--earned">Earned</div>
        <h3>Graduate</h3>
        <p>Completion of the full 4M program with verified outcomes. Alumni community, advanced protocols, ongoing access.</p>
        <a href="/membership" class="btn btn-outline-white">Learn More</a>
      </div>

    </div>

    <div class="hp-tiers-footer">
      <a href="/membership" class="hp-tiers-compare-link">See full comparison &rarr;</a>
    </div>
  </div>
</section>

<!-- ===== SECTION 4: FOUNDER + MISSION ===== -->
<section class="hp-section hp-founder-section">
  <div class="container hp-founder-inner">

    <div class="founder-avatar-col">
      <div class="founder-avatar" aria-label="Dr. TJ Mundheim, DC">TJ</div>
    </div>

    <div class="founder-content">
      <h2>Dr. TJ Mundheim, DC</h2>
      <p class="founder-creds">NBCE-certified since 1994 &middot; 30+ years of clinical experience &middot; Founder, My4MLife</p>

      <p>I built My4MLife because I'm living it. Every protocol in this program is one I run myself. The 4M framework is what I wish someone had handed me at 50 — a clear system for protecting the thing that matters most: your mind.</p>

      <p>The cognitive longevity thesis is simple: the brain doesn't degrade in isolation. It degrades because of what we feed it, how we move, what we ignore, and what we believe is inevitable. Almost none of it is inevitable with the right approach.</p>

      <p>My4MLife exists to give men a lifestyle company's worth of tools and a clinician's framework — without the pharmaceutical-first bias. You deserve both the strategy and the support to execute it.</p>

      <a href="/about" class="btn btn-outline-dark">Read more about Dr. TJ &rarr;</a>
    </div>

  </div>
</section>

<!-- ===== EMAIL CAPTURE BAND ===== -->
<section class="hp-email-band">
  <div class="container hp-email-inner">
    <p class="email-band-tagline"><em>Begin with the end in mind.</em></p>
    <p class="email-band-sub">Get the weekly 4M protocol update — no spam, one email, unsubscribe anytime.</p>
    <div class="email-band-form">
      <EmailCapture source="homepage" dark={true} buttonLabel="Stay Informed" />
    </div>
  </div>
</section>

<!-- ===== PHOTO ATTRIBUTION ===== -->
<!--
  Hero photo: Unsplash — https://images.unsplash.com/photo-1476480862126-209bfaa8edc8
  Protocol photos: Unsplash — photo-1547592180-85f173990554, photo-1571019614242-c5c5dee9f50b, photo-1499750310107-5fef28a66643
  All images used under the Unsplash License (free for commercial use, no attribution required by license).
-->

</BaseLayout>

<style>
/* ===== SHARED BUTTONS ===== */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.8rem 1.8rem;
  border-radius: 50px;
  font-family: 'Inter', sans-serif;
  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: none;
  border: 2px solid transparent;
  cursor: pointer;
  transition: all 0.22s;
  white-space: nowrap;
}

/* Hero ghost — white outlined */
.hp-btn-ghost {
  background: transparent;
  color: white;
  border-color: rgba(255,255,255,0.65);
}
.hp-btn-ghost:hover {
  background: rgba(255,255,255,0.14);
  border-color: white;
}

/* Hero filled — accent green (middle CTA, emphasized) */
.hp-btn-filled {
  background: var(--accent);
  color: white;
  border-color: var(--accent);
  box-shadow: 0 4px 20px rgba(0,184,148,0.35);
}
.hp-btn-filled:hover {
  background: var(--accent-dark);
  border-color: var(--accent-dark);
  transform: translateY(-1px);
  box-shadow: 0 6px 28px rgba(0,184,148,0.45);
}

/* Accent — used in tier cards */
.btn-accent {
  background: var(--accent);
  color: white;
  border-color: var(--accent);
}
.btn-accent:hover {
  background: var(--accent-dark);
  border-color: var(--accent-dark);
  transform: translateY(-1px);
}

/* White outlined — dark sections */
.btn-outline-white {
  background: transparent;
  color: white;
  border-color: rgba(255,255,255,0.35);
}
.btn-outline-white:hover {
  background: rgba(255,255,255,0.1);
  border-color: rgba(255,255,255,0.7);
}

/* Dark outlined — light sections */
.btn-outline-dark {
  background: transparent;
  color: var(--primary);
  border-color: var(--primary);
}
.btn-outline-dark:hover {
  background: var(--primary);
  color: white;
}

/* ===== SHARED SECTION HELPERS ===== */
.hp-section { padding: 5.5rem 0; }
.hp-section-header { text-align: center; margin-bottom: 3rem; }
.hp-section-header h2 { font-size: 2.2rem; margin-bottom: 0.5rem; }

/* ===== HERO ===== */
.hp-hero {
  position: relative;
  min-height: 70vh;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.hp-hero-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.hp-hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  display: block;
}

.hp-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(10, 22, 40, 0.55) 0%,
    rgba(10, 22, 40, 0.72) 60%,
    rgba(10, 22, 40, 0.85) 100%
  );
}

.hp-hero-content {
  position: relative;
  z-index: 1;
  text-align: center;
  padding-top: 7rem;
  padding-bottom: 5rem;
}

.hp-hero-headline {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2.2rem, 5vw, 3.8rem);
  font-weight: 700;
  color: white;
  line-height: 1.22;
  margin-bottom: 2.5rem;
  max-width: 820px;
  margin-left: auto;
  margin-right: auto;
  text-shadow: 0 2px 12px rgba(0,0,0,0.4);
}
.hp-hero-headline em {
  font-style: italic;
  color: rgba(255,255,255,0.88);
}

.hp-hero-ctas {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 1.5rem;
}

.hp-hero-sub {
  font-size: 0.9rem;
  color: rgba(255,255,255,0.6);
  margin: 0;
}

/* ===== 4M SECTION ===== */
.hp-4m-section { background: var(--dark); }
.hp-4m-header {
  color: white;
  font-size: 2.2rem;
}
.hp-4m-explainer {
  color: rgba(255,255,255,0.7);
  font-size: 1rem;
  max-width: 700px;
  margin: 0 auto;
  line-height: 1.75;
}
.hp-4m-explainer strong { color: var(--accent); }

.hp-4m-grid {
  display: flex;
  align-items: stretch;
  gap: 0.5rem;
  justify-content: center;
  flex-wrap: wrap;
}

.m-card {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: var(--radius-lg);
  padding: 2rem 1.5rem;
  text-align: center;
  flex: 1;
  min-width: 180px;
  max-width: 220px;
  text-decoration: none;
  color: white;
  transition: transform 0.22s, background 0.22s, border-color 0.22s;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.m-card:hover {
  transform: translateY(-4px);
  background: rgba(255,255,255,0.09);
  border-color: var(--accent);
}
.m-card--mind {
  border-color: #c8a84b;
  background: rgba(200,168,75,0.08);
  min-width: 200px;
  max-width: 240px;
  transform: scale(1.04);
}
.m-card--mind:hover { transform: scale(1.04) translateY(-4px); border-color: #e2b84a; }

.m-letter {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: rgba(0,184,148,0.15);
  color: var(--accent);
  font-family: 'Playfair Display', serif;
  font-size: 1.6rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 1rem;
}
.m-card--mind .m-letter {
  background: rgba(200,168,75,0.15);
  color: #e2b84a;
}
.m-card h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.2rem;
  margin-bottom: 0.5rem;
  color: white;
}
.m-card--mind h3 { color: #e2b84a; }
.m-card p { font-size: 0.85rem; color: rgba(255,255,255,0.6); margin-bottom: 1rem; flex: 1; }
.m-link {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--accent);
}
.m-arrow {
  font-size: 1.5rem;
  color: rgba(255,255,255,0.2);
  flex-shrink: 0;
  align-self: center;
}

/* ===== PROTOCOLS SECTION ===== */
.hp-protocols-section { background: var(--bg-soft); }
.hp-protocols-section .hp-section-header h2 { color: var(--dark); }

.hp-protocols-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}

.proto-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  text-decoration: none;
  color: var(--text);
  transition: transform 0.22s, box-shadow 0.22s, border-color 0.22s;
  display: flex;
  flex-direction: column;
}
.proto-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
  border-color: var(--accent);
}

.proto-img-wrap {
  width: 100%;
  aspect-ratio: 3/2;
  overflow: hidden;
}
.proto-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s;
}
.proto-card:hover .proto-img-wrap img { transform: scale(1.04); }

.proto-body {
  padding: 1.4rem 1.5rem 1.6rem;
  display: flex;
  flex-direction: column;
  flex: 1;
}
.proto-body h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.15rem;
  margin-bottom: 0.5rem;
  color: var(--dark);
}
.proto-body p {
  font-size: 0.88rem;
  color: var(--text-light);
  line-height: 1.65;
  flex: 1;
  margin-bottom: 1rem;
}
.proto-link {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--accent);
}
.proto-body-tall { padding: 2.2rem 1.8rem 2rem; min-height: 320px; }

/* ── Canary / ED card — single prominent feature card ── */
.hp-canary-section { background: var(--bg-soft, #f5f0e8); }
.canary-card {
  display: block;
  max-width: 760px;
  margin: 0 auto;
  border-left: 4px solid var(--accent);
  background: var(--bg, #fff);
}
.canary-body { min-height: 0; padding: 2.5rem 2.25rem 2.25rem; }
.canary-badge { color: #b85c2c; }
.canary-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.85rem;
  margin: 0.25rem 0 0.85rem;
  color: var(--dark, #1a1a1a);
}
.canary-copy {
  font-size: 1.02rem;
  line-height: 1.6;
  color: var(--text);
  margin-bottom: 1.1rem;
}

.proto-step {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 0.8rem;
}
.proto-body-tall h3 { font-size: 1.4rem; margin-bottom: 0.7rem; }
.proto-body-tall p { font-size: 0.95rem; }
.proto-body-tall em { color: var(--primary); font-style: italic; }
.hp-section-sub {
  text-align: center;
  color: var(--text-light);
  font-size: 0.95rem;
  margin-top: 0.4rem;
}

/* ===== TIERS SECTION ===== */
.hp-tiers-section { background: linear-gradient(135deg, #0a1628 0%, #0f4c75 100%); }
.hp-tiers-heading { color: white; }

.hp-tiers-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
}

.tier-card {
  background: rgba(255,255,255,0.06);
