---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailCapture from '../components/EmailCapture.astro';

const title = "My4MLife — Live longer. Think sharper. Begin with the end in mind.";
const description = "Brain-health-first lifestyle and telemedicine. Schedule a comprehensive consult, take the free 3-minute personalized assessment, or pick your starting protocol. Founded by Dr. TJ Mundheim, DC.";
const canonical = "https://www.my4mlife.com/";
const keywords = "4M system, cognitive aging, brain health, hormone optimization, GLP-1 weight loss, Dr. TJ Mundheim, My4MLife, membership program, health protocol, men cognitive longevity";
const ogImage = "https://www.my4mlife.com/images/hero/main.jpg";
const robots = "index, follow";
---
<BaseLayout title={title} description={description} canonical={canonical} keywords={keywords} ogImage={ogImage} robots={robots}>

<!-- ===== HERO — Survey-first funnel (above all other content) ===== -->
<section class="hp-hero hp-hero--survey" id="hp-hero-survey">
  <div class="hp-hero-bg" aria-hidden="true">
    <div class="hp-hero-gradient"></div>
    <svg class="hp-hero-neural" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <radialGradient id="neuronGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#5fb8d6" stop-opacity="0.95" />
          <stop offset="60%" stop-color="#3a86a8" stop-opacity="0.45" />
          <stop offset="100%" stop-color="#1a4a6a" stop-opacity="0" />
        </radialGradient>
        <filter id="brainBlur" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="1.2" />
        </filter>
      </defs>

      {/* Two cerebral hemispheres — abstract brain silhouette, very subtle */}
      <g class="hp-hero-brain" opacity="0.18" filter="url(#brainBlur)">
        <path d="M 600 180 C 460 180 360 270 360 400 C 360 510 430 580 530 600 C 560 620 580 640 600 640 C 620 640 640 620 670 600 C 770 580 840 510 840 400 C 840 270 740 180 600 180 Z" fill="none" stroke="#7ec8e0" stroke-width="2.5" />
        <path d="M 600 200 C 600 400 600 600 600 640" fill="none" stroke="#7ec8e0" stroke-width="1.2" stroke-dasharray="4,6" />
      </g>

      {/* Connections — drawn first so neurons sit on top */}
      <g class="hp-hero-edges" stroke="#5fb8d6" stroke-width="1" stroke-opacity="0.35" fill="none">
        <line x1="420" y1="280" x2="500" y2="320" class="edge e1" />
        <line x1="500" y1="320" x2="540" y2="420" class="edge e2" />
        <line x1="540" y1="420" x2="450" y2="480" class="edge e3" />
        <line x1="450" y1="480" x2="380" y2="380" class="edge e4" />
        <line x1="380" y1="380" x2="420" y2="280" class="edge e5" />
        <line x1="500" y1="320" x2="600" y2="260" class="edge e6" />
        <line x1="600" y1="260" x2="700" y2="320" class="edge e7" />
        <line x1="700" y1="320" x2="780" y2="280" class="edge e8" />
        <line x1="700" y1="320" x2="660" y2="420" class="edge e9" />
        <line x1="660" y1="420" x2="540" y2="420" class="edge e10" />
        <line x1="660" y1="420" x2="750" y2="480" class="edge e11" />
        <line x1="750" y1="480" x2="820" y2="380" class="edge e12" />
        <line x1="820" y1="380" x2="780" y2="280" class="edge e13" />
        <line x1="540" y1="420" x2="500" y2="540" class="edge e14" />
        <line x1="500" y1="540" x2="600" y2="580" class="edge e15" />
        <line x1="600" y1="580" x2="700" y2="540" class="edge e16" />
        <line x1="700" y1="540" x2="660" y2="420" class="edge e17" />
        <line x1="450" y1="480" x2="500" y2="540" class="edge e18" />
        <line x1="750" y1="480" x2="700" y2="540" class="edge e19" />
        <line x1="600" y1="260" x2="540" y2="420" class="edge e20" />
        <line x1="600" y1="260" x2="660" y2="420" class="edge e21" />
      </g>

      {/* Neurons */}
      <g class="hp-hero-nodes">
        {[
          [420, 280], [500, 320], [540, 420], [450, 480], [380, 380],
          [600, 260], [700, 320], [780, 280], [660, 420], [750, 480],
          [820, 380], [500, 540], [600, 580], [700, 540],
        ].map(([cx, cy], i) => (
          <g class={`node n${i}`}>
            <circle cx={cx} cy={cy} r="22" fill="url(#neuronGlow)" class="node-glow" />
            <circle cx={cx} cy={cy} r="4" fill="#cfe9f4" class="node-core" />
          </g>
        ))}
      </g>
    </svg>
    <div class="hp-hero-overlay"></div>
  </div>

  <div class="container hp-hero-content">
    <p class="hp-hero-subhead-top">Begin with the end in mind. The next twenty years of your mind are decided by what you do now.</p>

    <a href="/assessment" class="btn-primary-xl">Take the Personalized Assessment &rarr;</a>

    <p class="hp-hero-subhead-bottom">Four minutes. Eight questions. Your top three priorities — ranked, ordered, and ready to act on.</p>

    <p class="hp-hero-scroll-hint">Want to learn more first? Scroll down &darr;</p>
  </div>
</section>

<!-- Sticky mobile audit CTA (hidden until hero scrolls off) -->
<a href="/assessment" class="hp-sticky-audit" id="hp-sticky-audit" aria-label="Take the Personalized Assessment">Take the Personalized Assessment &rarr;</a>
<script is:inline>
  (function () {
    var hero = document.getElementById('hp-hero-survey');
    var sticky = document.getElementById('hp-sticky-audit');
    if (!hero || !sticky || !('IntersectionObserver' in window)) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) sticky.classList.remove('is-visible');
        else sticky.classList.add('is-visible');
      });
    }, { rootMargin: '0px 0px -80% 0px' });
    io.observe(hero);
    window.addEventListener('scroll', function () {
      var nearBottom = (window.innerHeight + window.scrollY) >= (document.body.offsetHeight - 120);
      sticky.classList.toggle('at-bottom', nearBottom);
    }, { passive: true });
  })();
</script>

