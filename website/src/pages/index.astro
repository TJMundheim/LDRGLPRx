  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.8rem 1.8rem;
  border-radius: 50px;
  font-family: 'Inter', sans-serif;
  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: none;
  border: 2px solid transparent;
  cursor: pointer;
  transition: all 0.22s;
  white-space: nowrap;
}

/* Hero ghost — white outlined */
.hp-btn-ghost {
  background: transparent;
  color: white;
  border-color: rgba(255,255,255,0.65);
}
.hp-btn-ghost:hover {
  background: rgba(255,255,255,0.14);
  border-color: white;
}

/* Hero filled — accent green (middle CTA, emphasized) */
.hp-btn-filled {
  background: var(--accent);
  color: white;
  border-color: var(--accent);
  box-shadow: 0 4px 20px rgba(0,184,148,0.35);
}
.hp-btn-filled:hover {
  background: var(--accent-dark);
  border-color: var(--accent-dark);
  transform: translateY(-1px);
  box-shadow: 0 6px 28px rgba(0,184,148,0.45);
}

/* Accent — used in tier cards */
.btn-accent {
  background: var(--accent);
  color: white;
  border-color: var(--accent);
}
.btn-accent:hover {
  background: var(--accent-dark);
  border-color: var(--accent-dark);
  transform: translateY(-1px);
}

/* White outlined — dark sections */
.btn-outline-white {
  background: transparent;
  color: white;
  border-color: rgba(255,255,255,0.35);
}
.btn-outline-white:hover {
  background: rgba(255,255,255,0.1);
  border-color: rgba(255,255,255,0.7);
}

/* Dark outlined — light sections */
.btn-outline-dark {
  background: transparent;
  color: var(--primary);
  border-color: var(--primary);
}
.btn-outline-dark:hover {
  background: var(--primary);
  color: white;
}

/* ===== QUICK-BUY CATEGORY BAND ===== */
.quick-buy-band {
  background: var(--dark);
  padding: 2.2rem 0 2.4rem;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}
.quick-buy-kicker {
  text-align: center;
  font-family: 'Inter', sans-serif;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--accent);
  margin: 0 0 0.7rem;
}
.quick-buy-headline {
  text-align: center;
  font-family: 'Playfair Display', serif;
  font-size: 1.55rem;
  line-height: 1.35;
  color: white;
  max-width: 880px;
  margin: 0 auto 0.8rem;
}
.quick-buy-subhead {
  text-align: center;
  font-family: 'Inter', sans-serif;
  font-size: 0.92rem;
  line-height: 1.55;
  color: rgba(255,255,255,0.75);
  max-width: 800px;
  margin: 0 auto 1.6rem;
}
.quick-buy-hook {
  font-family: 'Inter', sans-serif;
  font-size: 0.75rem;
  font-style: italic;
  color: rgba(255,255,255,0.85);
  line-height: 1.4;
  margin-top: 0.5rem;
  padding-top: 0.55rem;
  border-top: 1px solid rgba(255,255,255,0.12);
  flex: 1;
}
.quick-buy-cta {
  display: inline-block;
  margin-top: 0.85rem;
  padding: 0.55rem 0.9rem;
  background: var(--accent);
  color: white;
  font-family: 'Inter', sans-serif;
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-align: center;
  border-radius: 6px;
  transition: background 0.15s, transform 0.15s;
}
.quick-buy-tile:hover .quick-buy-cta {
  background: #00d4a4;
  transform: translateX(2px);
}

/* ===== LAYER C — Wake-up paragraph section ===== */
.hp-wakeup { background: var(--bg-soft); padding: 4rem 0; border-bottom: 1px solid var(--border); }
.hp-wakeup-inner { max-width: 760px; margin: 0 auto; text-align: center; }
.hp-wakeup-inner p {
  font-size: 1.05rem;
  line-height: 1.7;
  color: var(--text);
  margin: 0 0 1rem;
}
.hp-wakeup-lead {
  font-family: 'Playfair Display', serif !important;
  font-size: 1.7rem !important;
  font-weight: 600;
  color: var(--primary) !important;
  margin-bottom: 1.4rem !important;
}
.hp-wakeup-tag {
  font-family: 'Playfair Display', serif !important;
  font-size: 1.25rem !important;
  color: var(--primary) !important;
  margin-top: 1.4rem !important;
}
.quick-buy-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 0.8rem;
}
.quick-buy-tile {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  padding: 1.1rem 0.9rem;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 10px;
  text-decoration: none;
  text-align: center;
  transition: background 0.15s, border-color 0.15s, transform 0.15s;
}
.quick-buy-tile:hover {
  background: rgba(0,184,148,0.12);
  border-color: var(--accent);
  transform: translateY(-2px);
}
.quick-buy-label {
  font-family: 'Playfair Display', serif;
  font-size: 1.15rem;
  font-weight: 600;
  color: white;
  letter-spacing: 0.01em;
}
.quick-buy-sub {
  font-family: 'Inter', sans-serif;
  font-size: 0.72rem;
  color: rgba(255,255,255,0.65);
  line-height: 1.35;
}
@media (max-width: 1100px) {
  .quick-buy-grid { grid-template-columns: repeat(4, 1fr); }
}
@media (max-width: 600px) {
  .quick-buy-grid { grid-template-columns: repeat(2, 1fr); }
  .quick-buy-tile { padding: 0.9rem 0.6rem; }
  .quick-buy-label { font-size: 1rem; }
  .quick-buy-sub { font-size: 0.68rem; }
}

/* ===== SHARED SECTION HELPERS ===== */
.hp-section { padding: 5.5rem 0; }
.hp-gap-section { background: var(--bg-soft); padding: 4.5rem 0; }
.hp-gap-inner { text-align: center; max-width: 760px; margin: 0 auto; }
.hp-gap-stat { font-family: 'Playfair Display', serif; font-size: 1.7rem; line-height: 1.35; color: var(--dark); margin: 0.3rem 0; }
.hp-gap-stat--punch { color: var(--primary); }
.hp-gap-pct { font-size: 2.8rem; font-weight: 700; color: var(--accent); margin-right: 0.35rem; }
.hp-gap-footnote { margin-top: 1.4rem; font-size: 0.85rem; color: var(--text-light); font-style: italic; }
.hp-gap-footnote a { color: var(--primary); text-decoration: underline; }
.hp-section-header { text-align: center; margin-bottom: 3rem; }
.hp-section-header h2 { font-size: 2.2rem; margin-bottom: 0.5rem; }

/* ===== HERO ===== */
.hp-hero {
  position: relative;
  min-height: 70vh;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.hp-hero-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.hp-hero-gradient {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 50% 40%, #102842 0%, #0a1628 55%, #050b16 100%);
}

.hp-hero-neural {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.hp-hero-neural .node-core { transform-origin: center; transform-box: fill-box; }
.hp-hero-neural .node-glow { transform-origin: center; transform-box: fill-box; }

@keyframes hp-pulse {
  0%, 100% { opacity: 0.55; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.4); }
}
@keyframes hp-pulse-core {
  0%, 100% { opacity: 0.85; }
  50% { opacity: 1; }
}
@keyframes hp-edge {
  0%, 100% { stroke-opacity: 0.2; }
  50% { stroke-opacity: 0.7; }
}
@keyframes hp-brain-drift {
  0%, 100% { opacity: 0.14; }
  50% { opacity: 0.24; }
}

.hp-hero-neural .node-glow { animation: hp-pulse 4.2s ease-in-out infinite; }
.hp-hero-neural .node-core { animation: hp-pulse-core 4.2s ease-in-out infinite; }
.hp-hero-neural .n1 .node-glow, .hp-hero-neural .n1 .node-core { animation-delay: -0.4s; }
.hp-hero-neural .n2 .node-glow, .hp-hero-neural .n2 .node-core { animation-delay: -0.8s; }
.hp-hero-neural .n3 .node-glow, .hp-hero-neural .n3 .node-core { animation-delay: -1.2s; }
.hp-hero-neural .n4 .node-glow, .hp-hero-neural .n4 .node-core { animation-delay: -1.6s; }
.hp-hero-neural .n5 .node-glow, .hp-hero-neural .n5 .node-core { animation-delay: -2.0s; }
.hp-hero-neural .n6 .node-glow, .hp-hero-neural .n6 .node-core { animation-delay: -2.4s; }
.hp-hero-neural .n7 .node-glow, .hp-hero-neural .n7 .node-core { animation-delay: -2.8s; }
.hp-hero-neural .n8 .node-glow, .hp-hero-neural .n8 .node-core { animation-delay: -3.2s; }
.hp-hero-neural .n9 .node-glow, .hp-hero-neural .n9 .node-core { animation-delay: -0.2s; }
.hp-hero-neural .n10 .node-glow, .hp-hero-neural .n10 .node-core { animation-delay: -0.6s; }
.hp-hero-neural .n11 .node-glow, .hp-hero-neural .n11 .node-core { animation-delay: -1.0s; }
.hp-hero-neural .n12 .node-glow, .hp-hero-neural .n12 .node-core { animation-delay: -1.4s; }
.hp-hero-neural .n13 .node-glow, .hp-hero-neural .n13 .node-core { animation-delay: -1.8s; }

.hp-hero-neural .edge { animation: hp-edge 3.5s ease-in-out infinite; }
.hp-hero-neural .e1 { animation-delay: -0.3s; }
.hp-hero-neural .e2 { animation-delay: -0.6s; }
.hp-hero-neural .e3 { animation-delay: -0.9s; }
.hp-hero-neural .e4 { animation-delay: -1.2s; }
.hp-hero-neural .e5 { animation-delay: -1.5s; }
.hp-hero-neural .e6 { animation-delay: -1.8s; }
.hp-hero-neural .e7 { animation-delay: -2.1s; }
.hp-hero-neural .e8 { animation-delay: -2.4s; }
.hp-hero-neural .e9 { animation-delay: -2.7s; }
.hp-hero-neural .e10 { animation-delay: -3.0s; }
.hp-hero-neural .e11 { animation-delay: -0.15s; }
.hp-hero-neural .e12 { animation-delay: -0.45s; }
.hp-hero-neural .e13 { animation-delay: -0.75s; }
.hp-hero-neural .e14 { animation-delay: -1.05s; }
.hp-hero-neural .e15 { animation-delay: -1.35s; }
.hp-hero-neural .e16 { animation-delay: -1.65s; }
.hp-hero-neural .e17 { animation-delay: -1.95s; }
.hp-hero-neural .e18 { animation-delay: -2.25s; }
.hp-hero-neural .e19 { animation-delay: -2.55s; }
.hp-hero-neural .e20 { animation-delay: -2.85s; }
.hp-hero-neural .e21 { animation-delay: -3.15s; }

.hp-hero-brain { animation: hp-brain-drift 7s ease-in-out infinite; }

@media (prefers-reduced-motion: reduce) {
  .hp-hero-neural .node-glow,
  .hp-hero-neural .node-core,
  .hp-hero-neural .edge,
  .hp-hero-brain { animation: none; }
}

.hp-hero-overlay {
  position: absolute;
  inset: 0;
  background: radial-gradient(
    ellipse at 50% 50%,
    rgba(10, 22, 40, 0.2) 0%,
    rgba(10, 22, 40, 0.55) 60%,
    rgba(10, 22, 40, 0.82) 100%
  );
}

.hp-hero-content {
  position: relative;
  z-index: 1;
  text-align: center;
  padding-top: 7rem;
  padding-bottom: 5rem;
}

.hp-hero-headline {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2.2rem, 5vw, 3.8rem);
  font-weight: 700;
  color: white;
  line-height: 1.22;
  margin-bottom: 2.5rem;
  max-width: 820px;
  margin-left: auto;
  margin-right: auto;
  text-shadow: 0 2px 12px rgba(0,0,0,0.4);
}
.hp-hero-headline em {
  font-style: italic;
  color: rgba(255,255,255,0.88);
}

.hp-hero-ctas {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 1.5rem;
}

.hp-hero-sub {
  font-size: 0.9rem;
  color: rgba(255,255,255,0.6);
  margin: 0;
}

/* ===== 4M SECTION ===== */
.hp-4m-section { background: var(--dark); }
.hp-4m-header {
  color: white;
  font-size: 2.2rem;
}
.hp-4m-explainer {
  color: rgba(255,255,255,0.7);
  font-size: 1rem;
  max-width: 700px;
  margin: 0 auto;
  line-height: 1.75;
}
.hp-4m-explainer strong { color: var(--accent); }

.hp-4m-grid {
  display: flex;
  align-items: stretch;
  gap: 0.5rem;
  justify-content: center;
  flex-wrap: wrap;
}

.m-card {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: var(--radius-lg);
  padding: 2rem 1.5rem;
  text-align: center;
  flex: 1;
  min-width: 180px;
  max-width: 220px;
  text-decoration: none;
  color: white;
  transition: transform 0.22s, background 0.22s, border-color 0.22s;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.m-card:hover {
  transform: translateY(-4px);
  background: rgba(255,255,255,0.09);
  border-color: var(--accent);
}
.m-card--mind {
  border-color: #c8a84b;
  background: rgba(200,168,75,0.08);
  min-width: 200px;
  max-width: 240px;
  transform: scale(1.04);
}
.m-card--mind:hover { transform: scale(1.04) translateY(-4px); border-color: #e2b84a; }

.m-letter {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: rgba(0,184,148,0.15);
  color: var(--accent);
  font-family: 'Playfair Display', serif;
  font-size: 1.6rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 1rem;
}
.m-card--mind .m-letter {
  background: rgba(200,168,75,0.15);
  color: #e2b84a;
}
.m-card h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.2rem;
  margin-bottom: 0.5rem;
  color: white;
}
.m-card--mind h3 { color: #e2b84a; }
.m-card p { font-size: 0.85rem; color: rgba(255,255,255,0.6); margin-bottom: 1rem; flex: 1; }
.m-link {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--accent);
}
.m-arrow {
  font-size: 1.5rem;
  color: rgba(255,255,255,0.2);
  flex-shrink: 0;
  align-self: center;
}

/* ===== PROTOCOLS SECTION ===== */
.hp-protocols-section { background: var(--bg-soft); }
.hp-protocols-section .hp-section-header h2 { color: var(--dark); }

.hp-protocols-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}

.proto-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  text-decoration: none;
  color: var(--text);
  transition: transform 0.22s, box-shadow 0.22s, border-color 0.22s;
  display: flex;
  flex-direction: column;
}
.proto-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
  border-color: var(--accent);
}

.proto-img-wrap {
  width: 100%;
  aspect-ratio: 3/2;
  overflow: hidden;
}
.proto-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s;
}
.proto-card:hover .proto-img-wrap img { transform: scale(1.04); }

.proto-body {
  padding: 1.4rem 1.5rem 1.6rem;
  display: flex;
  flex-direction: column;
  flex: 1;
}
.proto-body h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.15rem;
  margin-bottom: 0.5rem;
  color: var(--dark);
}
.proto-body p {
  font-size: 0.88rem;
  color: var(--text-light);
  line-height: 1.65;
  flex: 1;
  margin-bottom: 1rem;
}
.proto-link {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--accent);
}
.proto-body-tall { padding: 2.2rem 1.8rem 2rem; min-height: 320px; }

/* ── Canary / ED card — single prominent feature card ── */
.hp-canary-section { background: var(--bg-soft, #f5f0e8); }
.canary-card {
  display: block;
  max-width: 760px;
  margin: 0 auto;
  border-left: 4px solid var(--accent);
  background: var(--bg, #fff);
}
.canary-body { min-height: 0; padding: 2.5rem 2.25rem 2.25rem; }
.canary-badge { color: #b85c2c; }
.canary-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.85rem;
  margin: 0.25rem 0 0.85rem;
  color: var(--dark, #1a1a1a);
}
.canary-copy {
  font-size: 1.02rem;
  line-height: 1.6;
  color: var(--text);
  margin-bottom: 1.1rem;
}

.proto-step {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 0.8rem;
}
.proto-body-tall h3 { font-size: 1.4rem; margin-bottom: 0.7rem; }
.proto-body-tall p { font-size: 0.95rem; }
.proto-body-tall em { color: var(--primary); font-style: italic; }
.hp-section-sub {
  text-align: center;
  color: var(--text-light);
  font-size: 0.95rem;
  margin-top: 0.4rem;
}

/* ===== TIERS SECTION ===== */
.hp-tiers-section { background: linear-gradient(135deg, #0a1628 0%, #0f4c75 100%); }
.hp-tiers-heading { color: white; }

.hp-tiers-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
}

.tier-card {
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-lg);
  padding: 2rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
}
.tier-card--free {
  border-color: rgba(0,184,148,0.4);
  background: rgba(0,184,148,0.07);
}
.tier-card--graduate {
  border-color: rgba(226,184,74,0.35);
  background: rgba(226,184,74,0.06);
}

.tier-badge {
  display: inline-block;
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  padding: 0.25rem 0.75rem;
  border-radius: 20px;
  width: fit-content;
}
.tier-badge--free { color: var(--accent); background: rgba(0,184,148,0.15); }
.tier-badge--gold { color: #e2b84a; background: rgba(226,184,74,0.12); }
.tier-badge--dark { color: rgba(255,255,255,0.75); background: rgba(255,255,255,0.08); }
.tier-badge--earned { color: #e2b84a; background: rgba(226,184,74,0.12); }

.tier-card h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.25rem;
  color: white;
  margin: 0;
}
.tier-card p {
  font-size: 0.87rem;
  color: rgba(255,255,255,0.62);
  line-height: 1.65;
  flex: 1;
  margin: 0;
}

.hp-tiers-footer {
  text-align: center;
  margin-top: 2rem;
}
.hp-tiers-compare-link {
  color: rgba(255,255,255,0.55);
  font-size: 0.88rem;
  text-decoration: none;
  transition: color 0.2s;
}
.hp-tiers-compare-link:hover { color: var(--accent); }

/* ===== FOUNDER ===== */
.hp-founder-section { background: var(--bg-soft); }
.hp-founder-inner {
  display: flex;
  gap: 3.5rem;
  align-items: flex-start;
}
.founder-avatar-col { flex-shrink: 0; }
.founder-avatar {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  overflow: hidden;
  border: 3px solid var(--accent);
  box-shadow: 0 6px 18px rgba(0,0,0,0.15);
  background: var(--bg-soft);
}
.founder-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.founder-content { flex: 1; }
.founder-content h2 {
  font-size: 2rem;
  margin-bottom: 0.35rem;
  color: var(--dark);
}
.founder-creds {
  font-size: 0.83rem;
  color: var(--text-light);
  margin-bottom: 1.4rem;
}
.founder-content p {
  font-size: 0.97rem;
  color: var(--text);
  line-height: 1.75;
  margin-bottom: 1rem;
}

/* ===== EMAIL BAND ===== */
.hp-email-band {
  background: var(--dark);
  padding: 5rem 0;
  text-align: center;
}
.hp-email-inner { max-width: 560px; margin: 0 auto; }
.email-band-tagline {
  font-family: 'Playfair Display', serif;
  font-size: 2rem;
  color: white;
  margin-bottom: 0.8rem;
}
.email-band-sub {
  font-size: 0.95rem;
  color: rgba(255,255,255,0.6);
  margin-bottom: 2rem;
}
.email-band-form {
  display: flex;
  gap: 0.75rem;
  justify-content: center;
  flex-wrap: wrap;
