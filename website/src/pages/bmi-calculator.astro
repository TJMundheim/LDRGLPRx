const ogImage = "https://www.my4mlife.com/og-image.svg";
const robots = "index, follow";
---
<BaseLayout title={title} description={description} canonical={canonical} keywords={keywords} ogImage={ogImage} robots={robots}>
<script type="application/ld+json" is:inline set:html={`{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://www.my4mlife.com/#organization","name":"My4MLife","url":"https://www.my4mlife.com/","logo":"https://www.my4mlife.com/og-image.svg"},{"@type":"WebApplication","@id":"https://www.my4mlife.com/bmi-calculator.html#app","name":"Free BMI + Body Composition Check — Brain-Health Baseline","description":"Free BMI calculator that frames excess visceral fat as a cognitive longevity threat. Computes BMI, provides WHO category context, and explains what each range means for brain health. First step toward the free 4M Audit.","url":"https://www.my4mlife.com/bmi-calculator.html","applicationCategory":"HealthApplication","operatingSystem":"All","browserRequirements":"Requires JavaScript","featureList":["Calculate Body Mass Index (BMI) from height and weight","Imperial and metric units","WHO BMI category classification","Brain-health cognitive longevity framing for each BMI category","Links to free 4M Audit, comprehensive 4M consult, and My4MLife app"],"offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"provider":{"@id":"https://www.my4mlife.com/#organization"}},{"@type":"MedicalWebPage","@id":"https://www.my4mlife.com/bmi-calculator.html#webpage","url":"https://www.my4mlife.com/bmi-calculator.html","name":"Free BMI + Body Composition Check — Your Brain-Health Baseline","description":"Excess visceral fat produces inflammatory cytokines that cross the blood-brain barrier and accelerate cognitive aging. BMI is a starting metric — use this calculator, then take the 4M Audit for your full metabolic risk profile.","isPartOf":{"@id":"https://www.my4mlife.com/#website"},"about":[{"@type":"MedicalCondition","name":"Obesity"},{"@type":"MedicalCondition","name":"Neuroinflammation"}],"medicalAudience":["Patient"],"inLanguage":"en-US","lastReviewed":"2026-04-28"},{"@type":"HowTo","@id":"https://www.my4mlife.com/bmi-calculator.html#howto","name":"How to check your BMI as a brain-health baseline","description":"Use BMI as a first-pass metabolic metric, then take the 4M Audit for a comprehensive cognitive longevity risk profile.","totalTime":"PT2M","step":[{"@type":"HowToStep","position":1,"name":"Enter your height","text":"Enter your height in feet and inches, or in centimeters."},{"@type":"HowToStep","position":2,"name":"Enter your weight","text":"Enter your current weight in pounds or kilograms."},{"@type":"HowToStep","position":3,"name":"Review your BMI and brain-health context","text":"The calculator shows your BMI, WHO category, and what that category means for cognitive longevity and visceral fat risk."},{"@type":"HowToStep","position":4,"name":"Take the 4M Audit","text":"For a complete metabolic and cognitive risk profile, take the free 5-minute 4M Audit at my4mlife.com/assessment."},{"@type":"HowToStep","position":5,"name":"Book a 4M Consult","text":"Book a comprehensive 4M Consult for clinical evaluation, protocol design, and — if appropriate — GLP-1 prescription through a contracted licensed telemedicine provider."}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.my4mlife.com/"},{"@type":"ListItem","position":2,"name":"BMI Calculator","item":"https://www.my4mlife.com/bmi-calculator.html"}]},{"@type":"FAQPage","@id":"https://www.my4mlife.com/bmi-calculator.html#faq","mainEntity":[{"@type":"Question","name":"Why does body fat matter for brain health?","acceptedAnswer":{"@type":"Answer","text":"Excess visceral fat is metabolically active tissue that produces pro-inflammatory cytokines — including IL-6, TNF-alpha, and C-reactive protein — that circulate systemically and cross the blood-brain barrier. Once inside, they drive neuroinflammation, disrupt hippocampal neurogenesis, and accelerate the same pathological cascades associated with cognitive decline and dementia. Reducing visceral fat is a primary lever for cognitive longevity."}},{"@type":"Question","name":"How is BMI calculated?","acceptedAnswer":{"@type":"Answer","text":"BMI is calculated by dividing your weight in kilograms by the square of your height in meters (kg/m²). In imperial units, multiply your weight in pounds by 703, then divide by the square of your height in inches."}},{"@type":"Question","name":"What are the limitations of BMI?","acceptedAnswer":{"@type":"Answer","text":"BMI does not distinguish between visceral fat and lean muscle mass. A highly muscular person may have an elevated BMI without excess body fat, while someone with a normal BMI may still carry significant visceral fat. BMI is a useful screening metric, but a comprehensive assessment — like the 4M Audit — gives a more complete metabolic and cognitive risk picture."}},{"@type":"Question","name":"What are the BMI categories?","acceptedAnswer":{"@type":"Answer","text":"The WHO BMI categories for adults are: underweight (below 18.5), normal weight (18.5 to 24.9), overweight (25.0 to 29.9), and obese (30.0 or higher). Obesity is subdivided into class I (30.0 to 34.9), class II (35.0 to 39.9), and class III (40 or higher). Each category carries specific implications for visceral fat burden and cognitive longevity risk."}},{"@type":"Question","name":"When does GLP-1 medication become part of the protocol?","acceptedAnswer":{"@type":"Answer","text":"GLP-1 medication is clinically indicated for adults with a BMI of 30 or higher, or 27 and above with a weight-related comorbidity. It is one clinical lever within the 4M framework — not the entire protocol. A comprehensive 4M consult determines whether it is appropriate and which agent fits your health profile."}}]}]}`} slot="head" />


<!-- ===== NAVBAR ===== -->


<!-- ===== HERO ===== -->
<section class="hero">
  <div class="container">
    <h1>Where do you stand? Your BMI is a starting metric for <em>cognitive longevity</em>.</h1>
    <p>Excess body fat — particularly visceral fat — is brain-toxic. It produces inflammatory cytokines that cross the blood-brain barrier and accelerate cognitive aging. BMI is a crude metric, but it is a starting point. Use this calculator, then take the free 4M Audit to see your full metabolic risk profile.</p>
    <div class="hero-badges">
      <div class="hero-badge"><i class="fas fa-clock"></i> Takes 30 seconds</div>
      <div class="hero-badge"><i class="fas fa-lock"></i> 100% private</div>
      <div class="hero-badge"><i class="fas fa-brain"></i> Brain-health framed</div>
    </div>
  </div>
</section>

<!-- ===== BMI CALCULATOR ===== -->
<section class="calc-section">
  <div class="container">
    <div class="calc-wrapper">
      <div class="calc-header">
        <h2>Free BMI + Body Composition Check</h2>
        <p>Enter your height and weight to calculate your BMI and see what it means for your cognitive longevity and metabolic health.</p>
      </div>

      <!-- Unit toggle -->
      <div class="unit-toggle">
        <button class="active" id="btn-imperial" onclick="switchUnit('imperial')">Imperial (lb/ft)</button>
        <button id="btn-metric" onclick="switchUnit('metric')">Metric (kg/cm)</button>
      </div>

      <form class="calc-form" id="bmi-form" onsubmit="calculateBMI(event)">
        <!-- Imperial inputs -->
        <div id="imperial-inputs">
          <div class="input-group">
            <label>Height</label>
            <div class="input-row">
              <div class="input-field">
                <input type="number" id="feet" min="1" max="8" placeholder="5" required />
                <span class="unit-label">ft</span>
              </div>
              <div class="input-field">
                <input type="number" id="inches" min="0" max="11" placeholder="7" required />
                <span class="unit-label">in</span>
              </div>
            </div>
          </div>
          <div class="input-group">
            <label>Weight</label>
            <div class="input-field">
              <input type="number" id="weight-lbs" min="50" max="800" placeholder="185" required />
              <span class="unit-label">lbs</span>
            </div>
          </div>
        </div>

        <!-- Metric inputs -->
        <div id="metric-inputs" style="display:none;">
          <div class="input-group">
            <label>Height</label>
            <div class="input-field">
              <input type="number" id="height-cm" min="50" max="280" placeholder="170" />
              <span class="unit-label">cm</span>
            </div>
          </div>
          <div class="input-group">
            <label>Weight</label>
            <div class="input-field">
              <input type="number" id="weight-kg" min="20" max="400" placeholder="84" />
              <span class="unit-label">kg</span>
            </div>
          </div>
        </div>

        <button type="submit" class="calc-btn">Calculate My BMI <i class="fas fa-arrow-right"></i></button>
      </form>

      <!-- ===== RESULT ===== -->
      <div class="result-area" id="result-area">
        <div class="bmi-result-card">
          <div class="bmi-number" id="bmi-number">--</div>
          <div class="bmi-label" id="bmi-label">Your BMI</div>

          <div class="bmi-gauge">
            <div class="gauge-marker" id="gauge-marker" style="left: 0%;"></div>
          </div>
          <div class="gauge-labels">
            <span>Underweight</span>
            <span>Normal</span>
            <span>Overweight</span>
            <span>Obese</span>
          </div>
        </div>

        <div id="eligibility-result"></div>

        <div class="result-cta" style="display:flex; gap:0.75rem; flex-wrap:wrap; justify-content:center;">
          <a href="/assessment" class="btn btn-primary btn-large">Take the Free 4M Audit (5 min) <i class="fas fa-arrow-right"></i></a>
          <a href="/consult" class="btn btn-outline btn-large">Schedule a 4M Consult <i class="fas fa-arrow-right"></i></a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== EDUCATION SECTION ===== -->
<section class="education-section">
  <div class="container">
    <div class="section-header">
      <h2>BMI, Visceral Fat, and Your Brain</h2>
      <p>BMI is a starting point. Here is what it actually tells you — and what it does not — about your cognitive longevity risk.</p>
    </div>

    <div class="edu-grid">
      <div class="edu-card">
        <div class="edu-card-icon">
          <i class="fas fa-brain"></i>
        </div>
        <h3>Why Visceral Fat Is Brain-Toxic</h3>
        <p>Visceral fat — the abdominal fat that surrounds your organs — is not inert storage. It is metabolically active tissue that produces chronic systemic inflammation.</p>
        <ul>
          <li>Secretes IL-6, TNF-alpha, and C-reactive protein</li>
          <li>These cytokines cross the blood-brain barrier</li>
          <li>Drives neuroinflammation and disrupts hippocampal neurogenesis</li>
          <li>Accelerates the same pathways linked to cognitive decline</li>
        </ul>
      </div>

      <div class="edu-card">
        <div class="edu-card-icon">
          <i class="fas fa-scale-balanced"></i>
        </div>
        <h3>What BMI Actually Tells You</h3>
        <p>BMI is a screening proxy — useful as a first filter, limited as a complete picture. It correlates with visceral fat burden at the population level, but individual variation is significant.</p>
        <ul>
          <li>Does not directly measure visceral vs. subcutaneous fat</li>
          <li>May overestimate risk in highly muscular men</li>
          <li>May underestimate risk in men with "normal" weight but central adiposity</li>
          <li>Best paired with waist circumference and metabolic markers</li>
        </ul>
      </div>

      <div class="edu-card">
        <div class="edu-card-icon">
          <i class="fas fa-clipboard-list"></i>
        </div>
        <h3>What the 4M Audit Adds</h3>
        <p>The free 4M Audit goes beyond BMI to assess your full metabolic and cognitive risk profile — in 5 minutes.</p>
        <ul>
          <li>Sleep quality and cortisol dysregulation</li>
          <li>Hormonal health indicators (testosterone, thyroid)</li>
          <li>Gut health and systemic inflammation signals</li>
          <li>Cognitive function baseline and lifestyle risk factors</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ===== BMI CATEGORIES + COGNITIVE CONTEXT ===== -->
<section style="padding:5rem 0; background:white;">
  <div class="container" style="max-width:820px;">
    <div style="text-align:center; margin-bottom:2.5rem;">
      <h2 style="font-family:'Playfair Display',serif; font-size:2.2rem; color:var(--dark); margin-bottom:0.8rem;">What Your BMI Category Means for Cognitive Longevity</h2>
      <p style="color:var(--text-light);">Each BMI range carries different implications for neuroinflammatory risk and metabolic health.</p>
    </div>
    <div style="display:flex; flex-direction:column; gap:1rem;">
      <div style="background:var(--bg-soft); border:1px solid var(--border); border-left:4px solid #22c55e; border-radius:var(--radius); padding:1.5rem;">
        <h3 style="font-family:'Playfair Display',serif; font-size:1.1rem; color:var(--dark); margin-bottom:0.5rem;">Normal Weight (BMI 18.5–24.9)</h3>
        <p style="font-size:0.93rem; color:var(--text);">BMI is within a healthy range, but this does not automatically mean low visceral fat. Men with normal BMI can still carry significant central adiposity — particularly if lean mass is low. The 4M Audit provides a more complete picture. Focus on maintaining lean mass through resistance training and supporting metabolic health proactively.</p>
      </div>
      <div style="background:var(--bg-soft); border:1px solid var(--border); border-left:4px solid #eab308; border-radius:var(--radius); padding:1.5rem;">
        <h3 style="font-family:'Playfair Display',serif; font-size:1.1rem; color:var(--dark); margin-bottom:0.5rem;">Overweight (BMI 25.0–29.9)</h3>
        <p style="font-size:0.93rem; color:var(--text);">Visceral fat accumulation is likely beginning to drive low-grade systemic inflammation. For men 35–60, this is the range where the neuroinflammatory burden starts to compound year over year. It is also the range where proactive intervention — protocol-level lifestyle change and, in some cases, clinical support — produces the best long-term cognitive return. Take the 4M Audit to assess your full risk profile.</p>
      </div>
      <div style="background:var(--bg-soft); border:1px solid var(--border); border-left:4px solid #f97316; border-radius:var(--radius); padding:1.5rem;">
        <h3 style="font-family:'Playfair Display',serif; font-size:1.1rem; color:var(--dark); margin-bottom:0.5rem;">Obese Class I (BMI 30.0–34.9)</h3>
        <p style="font-size:0.93rem; color:var(--text);">At this BMI range, visceral fat burden is clinically significant. Systemic inflammation is likely elevated. Insulin resistance, hormonal suppression (particularly testosterone via aromatization), and sleep architecture disruption are common. The neuroinflammatory load is real and measurable. This is also the primary threshold for GLP-1 medication eligibility. A comprehensive 4M consult is the appropriate next step.</p>
      </div>
      <div style="background:var(--bg-soft); border:1px solid var(--border); border-left:4px solid #ef4444; border-radius:var(--radius); padding:1.5rem;">
        <h3 style="font-family:'Playfair Display',serif; font-size:1.1rem; color:var(--dark); margin-bottom:0.5rem;">Obese Class II–III (BMI 35.0+)</h3>
        <p style="font-size:0.93rem; color:var(--text);">Visceral fat at this level produces persistent, high-load neuroinflammation. Metabolic syndrome, insulin resistance, cardiovascular risk, sleep apnea, and hormonal disruption are common. The good news: this is also where GLP-1 medications produce the most dramatic metabolic and inflammatory reduction — particularly when combined with the 4M protocol. Do not wait. Book a comprehensive 4M consult.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== GLP-1 SECTION ===== -->
<section style="padding:4rem 0; background:var(--bg-soft);">
  <div class="container" style="max-width:820px;">
    <div style="background:white; border:1px solid var(--border); border-radius:var(--radius-lg); padding:2.5rem;">
      <h2 style="font-family:'Playfair Display',serif; font-size:1.6rem; color:var(--dark); margin-bottom:1rem;">If GLP-1 Medication Is Part of Your Protocol</h2>
      <p style="color:var(--text); font-size:0.95rem; margin-bottom:1rem;">GLP-1 medications — semaglutide and tirzepatide — are powerful clinical tools for reducing visceral fat and restoring metabolic function. They are not a standalone fix; they are one lever within the 4M framework. If your BMI is 30 or higher (or 27 or higher with a weight-related comorbidity), GLP-1 therapy may be clinically appropriate for your protocol.</p>
      <p style="color:var(--text); font-size:0.95rem; margin-bottom:1.5rem;">Final eligibility is confirmed through a comprehensive 4M consult with a contracted licensed telemedicine provider — not a BMI calculator. The consult reviews your full health history, metabolic markers, and whether GLP-1 therapy is appropriate and which agent fits your profile.</p>
      <a href="/solutions/weight" class="btn btn-outline" style="font-size:0.9rem;">Learn More About GLP-1 in the 4M Protocol <i class="fas fa-arrow-right"></i></a>
    </div>
  </div>
</section>

<!-- ===== THREE BOTTOM CTAs ===== -->
<section style="padding:4rem 0; background:linear-gradient(135deg,#0a1628 0%,#0f4c75 50%,#1b6fa8 100%);">
  <div class="container" style="max-width:820px; text-align:center;">
    <h2 style="font-family:'Playfair Display',serif; font-size:2rem; color:white; margin-bottom:0.75rem;">Ready to see your full picture?</h2>
    <p style="color:rgba(255,255,255,0.75); font-size:1rem; margin-bottom:2.5rem;">BMI is where you start. The 4M framework is where the real work happens.</p>
    <div style="display:flex; flex-direction:column; gap:1rem; align-items:center;">
      <a href="/assessment" class="btn btn-primary btn-large" style="width:100%; max-width:420px; justify-content:center;">Take the Free 4M Audit (5 min) <i class="fas fa-arrow-right"></i></a>
      <a href="/consult" class="btn btn-outline btn-large" style="width:100%; max-width:420px; justify-content:center; color:white; border-color:white;">Schedule a Comprehensive 4M Consult <i class="fas fa-arrow-right"></i></a>
      <a href="https://app.my4mlife.com" target="_blank" rel="noopener" class="btn btn-large" style="width:100%; max-width:420px; justify-content:center; background:rgba(255,255,255,0.12); color:white; border:1px solid rgba(255,255,255,0.3);">Get the My4MLife App — Free <i class="fas fa-arrow-right"></i></a>
    </div>
  </div>
</section>

<!-- ===== EMAIL CAPTURE ===== -->
<section class="email-section">
  <div class="container">
