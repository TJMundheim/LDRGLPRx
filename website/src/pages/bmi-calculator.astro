<!-- ===== FAQ ===== -->
<section id="faq" style="padding:5rem 0; background:var(--bg-soft);">
  <div class="container" style="max-width:820px;">
    <div style="text-align:center; margin-bottom:2.5rem;">
      <h2 style="font-family:'Playfair Display',serif; font-size:2.2rem; color:var(--dark); margin-bottom:0.8rem;">BMI &amp; GLP-1 Eligibility FAQ</h2>
      <p style="color:var(--text-light);">Answers to common questions about BMI and GLP-1 medication eligibility.</p>
    </div>
    <details style="background:white; border:1px solid var(--border); border-radius:var(--radius); padding:1.2rem 1.5rem; margin-bottom:0.8rem;">
      <summary style="font-weight:600; color:var(--dark); cursor:pointer; font-size:1.02rem;">What BMI do I need to qualify for GLP-1 weight loss medication?</summary>
      <p style="margin-top:0.8rem; color:var(--text); font-size:0.95rem;">A BMI of 30 or higher generally qualifies adults for GLP-1 weight loss medication. A BMI of 27 to 29.9 may qualify with at least one weight-related health condition such as type 2 diabetes, high blood pressure, high cholesterol, or obstructive sleep apnea. Final eligibility is determined by a licensed physician during consultation.</p>
    </details>
    <details style="background:white; border:1px solid var(--border); border-radius:var(--radius); padding:1.2rem 1.5rem; margin-bottom:0.8rem;">
      <summary style="font-weight:600; color:var(--dark); cursor:pointer; font-size:1.02rem;">How is BMI calculated?</summary>
      <p style="margin-top:0.8rem; color:var(--text); font-size:0.95rem;">BMI is calculated by dividing your weight in kilograms by the square of your height in meters (kg/m²). In imperial units, multiply your weight in pounds by 703, then divide by the square of your height in inches.</p>
    </details>
    <details style="background:white; border:1px solid var(--border); border-radius:var(--radius); padding:1.2rem 1.5rem; margin-bottom:0.8rem;">
      <summary style="font-weight:600; color:var(--dark); cursor:pointer; font-size:1.02rem;">Is BMI the only factor for GLP-1 eligibility?</summary>
      <p style="margin-top:0.8rem; color:var(--text); font-size:0.95rem;">No. BMI is the primary screening criterion, but your physician will also review your medical history, current medications, existing health conditions, contraindications, and overall goals before prescribing GLP-1 medication. BMI is a first-pass indicator, not a final determination.</p>
    </details>
    <details style="background:white; border:1px solid var(--border); border-radius:var(--radius); padding:1.2rem 1.5rem; margin-bottom:0.8rem;">
      <summary style="font-weight:600; color:var(--dark); cursor:pointer; font-size:1.02rem;">What are the BMI categories?</summary>
      <p style="margin-top:0.8rem; color:var(--text); font-size:0.95rem;">The WHO categories for adults are: underweight (below 18.5), normal (18.5–24.9), overweight (25.0–29.9), and obese (30.0+). Obesity is further divided into class I (30.0–34.9), class II (35.0–39.9), and class III (40+).</p>
    </details>
    <details style="background:white; border:1px solid var(--border); border-radius:var(--radius); padding:1.2rem 1.5rem; margin-bottom:0.8rem;">
      <summary style="font-weight:600; color:var(--dark); cursor:pointer; font-size:1.02rem;">Does BMI have any limitations?</summary>
      <p style="margin-top:0.8rem; color:var(--text); font-size:0.95rem;">Yes. BMI does not distinguish between muscle and fat mass, so highly muscular individuals may have a high BMI without excess body fat. BMI also does not account for fat distribution or body composition. Your physician may consider additional measures like waist circumference alongside BMI.</p>
    </details>
    <details style="background:white; border:1px solid var(--border); border-radius:var(--radius); padding:1.2rem 1.5rem;">
      <summary style="font-weight:600; color:var(--dark); cursor:pointer; font-size:1.02rem;">What if my BMI is below 27?</summary>
      <p style="margin-top:0.8rem; color:var(--text); font-size:0.95rem;">GLP-1 weight loss medications are generally not prescribed for adults with a BMI below 27. If your BMI is in the normal or mildly overweight range, nutrition counseling, exercise, and behavioral support may be more appropriate. A physician can help you choose the safest and most effective path for your goals.</p>
    </details>
  </div>
</section>

<!-- ===== FOOTER ===== -->



<script is:inline>
  // Navbar scroll effect
  window.addEventListener('scroll', function() {
    document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 20);
  });

  // Mobile menu toggle
  function toggleMenu() {
    document.getElementById('nav-links').classList.toggle('open');
  }

  // Close mobile menu on link click
  document.querySelectorAll('.nav-links a').forEach(function(link) {
    link.addEventListener('click', function() {
      document.getElementById('nav-links').classList.remove('open');
    });
  });

  // Current unit system
  var currentUnit = 'imperial';

  function switchUnit(unit) {
    currentUnit = unit;
    document.getElementById('btn-imperial').classList.toggle('active', unit === 'imperial');
    document.getElementById('btn-metric').classList.toggle('active', unit === 'metric');
    document.getElementById('imperial-inputs').style.display = unit === 'imperial' ? 'block' : 'none';
    document.getElementById('metric-inputs').style.display = unit === 'metric' ? 'block' : 'none';

    // Update required attributes
    var impFields = document.querySelectorAll('#imperial-inputs input');
    var metFields = document.querySelectorAll('#metric-inputs input');
    impFields.forEach(function(f) { f.required = (unit === 'imperial'); });
    metFields.forEach(function(f) { f.required = (unit === 'metric'); });
  }

  function calculateBMI(e) {
    e.preventDefault();

    var bmi;

    if (currentUnit === 'imperial') {
      var feet = parseFloat(document.getElementById('feet').value);
      var inches = parseFloat(document.getElementById('inches').value) || 0;
      var weightLbs = parseFloat(document.getElementById('weight-lbs').value);

      if (!feet || !weightLbs) return;

      var totalInches = (feet * 12) + inches;
      bmi = (weightLbs / (totalInches * totalInches)) * 703;
    } else {
      var heightCm = parseFloat(document.getElementById('height-cm').value);
      var weightKg = parseFloat(document.getElementById('weight-kg').value);

      if (!heightCm || !weightKg) return;

      var heightM = heightCm / 100;
      bmi = weightKg / (heightM * heightM);
    }

    bmi = Math.round(bmi * 10) / 10;
    displayResult(bmi);
  }

  function displayResult(bmi) {
    var resultArea = document.getElementById('result-area');
    resultArea.classList.add('visible');

    // BMI number
    var bmiNumEl = document.getElementById('bmi-number');
    bmiNumEl.textContent = bmi;

    // Category and color
    var category, color;
    if (bmi < 18.5) {
      category = 'Underweight';
      color = '#3b82f6';
    } else if (bmi < 25) {
      category = 'Normal Weight';
      color = '#22c55e';
    } else if (bmi < 30) {
      category = 'Overweight';
      color = '#eab308';
    } else if (bmi < 35) {
      category = 'Obese (Class I)';
      color = '#f97316';
    } else if (bmi < 40) {
      category = 'Obese (Class II)';
      color = '#ef4444';
    } else {
      category = 'Obese (Class III)';
      color = '#dc2626';
    }

    bmiNumEl.style.color = color;
    document.getElementById('bmi-label').textContent = category;
    document.getElementById('bmi-label').style.color = color;

    // Gauge position (map BMI 15-45 to 0-100%)
    var gaugePos = Math.max(0, Math.min(100, ((bmi - 15) / 30) * 100));
    document.getElementById('gauge-marker').style.left = gaugePos + '%';

    // Eligibility result
    var eligDiv = document.getElementById('eligibility-result');
    if (bmi >= 30) {
      eligDiv.innerHTML =
        '<div class="eligibility-card eligible">' +
          '<div class="eligibility-icon"><i class="fas fa-circle-check"></i></div>' +
          '<h3>Elevated Visceral Fat Risk — Action Warranted</h3>' +
          '<p>A BMI of ' + bmi + ' indicates clinically significant visceral fat burden. This is the range where neuroinflammatory load is measurable and the cognitive longevity risk is real. It is also the primary threshold for GLP-1 medication eligibility — a powerful tool for reducing visceral fat within the 4M protocol.</p>' +
          '<p>Your next step is the free 4M Audit for a complete metabolic and cognitive risk profile, followed by a comprehensive 4M consult to design your protocol.</p>' +
          '<div class="next-steps">' +
            '<h4>Recommended Next Steps</h4>' +
            '<ul>' +
              '<li>Take the free 4M Audit at /assessment — 5 minutes</li>' +
              '<li>Book a comprehensive 4M consult for protocol design and clinical evaluation</li>' +
              '<li>If GLP-1 medication is appropriate, your contracted telemedicine provider handles the prescription</li>' +
            '</ul>' +
          '</div>' +
        '</div>';
    } else if (bmi >= 27) {
      eligDiv.innerHTML =
        '<div class="eligibility-card conditional">' +
          '<div class="eligibility-icon"><i class="fas fa-info-circle"></i></div>' +
          '<h3>Moderate Risk — This Is the Inflection Point</h3>' +
          '<p>A BMI of ' + bmi + ' puts you in the overweight range — the zone where visceral fat accumulation begins to drive low-grade systemic inflammation and neuroinflammatory risk starts to compound. This is also where proactive protocol-level intervention produces the best long-term cognitive return.</p>' +
          '<p>GLP-1 medication may be appropriate at this BMI if you carry a weight-related comorbidity (type 2 diabetes, hypertension, dyslipidemia, or sleep apnea). Your 4M consult determines this.</p>' +
          '<div class="next-steps">' +
            '<h4>Recommended Next Steps</h4>' +
            '<ul>' +
              '<li>Take the free 4M Audit for your complete metabolic risk profile</li>' +
              '<li>Book a 4M consult to evaluate your full health picture</li>' +
              '<li>The 4M protocol addresses visceral fat at every BMI level — medication is one tool among several</li>' +
            '</ul>' +
          '</div>' +
        '</div>';
    } else {
      eligDiv.innerHTML =
        '<div class="eligibility-card not-eligible">' +
          '<div class="eligibility-icon"><i class="fas fa-shield-halved"></i></div>' +
          '<h3>BMI in a Lower-Risk Range — Maintain and Optimize</h3>' +
          '<p>A BMI of ' + bmi + ' is below the threshold where visceral fat typically drives significant neuroinflammatory load. GLP-1 medications are generally not indicated at this level. However, BMI alone does not tell the whole story — men with normal BMI can still carry central adiposity, hormonal imbalance, poor sleep architecture, or gut dysbiosis that drives cognitive aging.</p>' +
          '<p>The 4M framework addresses cognitive longevity at every metabolic level — not just for men with high BMI. The 4M Audit gives you the complete picture.</p>' +
          '<div class="next-steps">' +
            '<h4>Recommended Next Steps</h4>' +
            '<ul>' +
              '<li>Take the free 4M Audit to assess sleep, hormones, gut, and cognitive baseline</li>' +
              '<li>Focus on preserving lean mass through resistance training (the Muscle pillar)</li>' +
              '<li>Proactive protocol work now protects cognitive function for decades ahead</li>' +
            '</ul>' +
          '</div>' +
        '</div>';
    }

    // Scroll to result
    resultArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // Email form handler (placeholder)
  function submitEmail(e) {
    e.preventDefault();
    var emailInput = document.getElementById('email-input');
    if (emailInput.value) {
      document.getElementById('email-form').style.display = 'none';
      document.getElementById('email-confirmation').classList.add('visible');
    }
  }
</script>


</BaseLayout>

<style is:global>

    :root {
