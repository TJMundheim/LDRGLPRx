---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Claim Your Free Copy — Begin with the End in Mind | My4MLife";
const description = "Get Dr. TJ Mundheim's 270-page brain-healthspan field guide free as your Protégé welcome gift. Name, email, phone — download arrives in your inbox.";
const canonical = "https://www.my4mlife.com/get-the-book";
---
<BaseLayout title={title} description={description} canonical={canonical}>

<section class="gtb-section">
  <div class="container gtb-inner">
    <div class="gtb-grid">

      <div class="gtb-cover-col">
        <img src="/images/book/cover.png" alt="Begin with the End in Mind — Dr. TJ Mundheim" class="gtb-cover" />
        <p class="gtb-eyebrow">Free for Protégés · Limited launch</p>
        <h2 class="gtb-cover-title">Begin with the End in Mind</h2>
        <p class="gtb-cover-tagline">Don't lose your identity. You still have a choice.</p>
        <ul class="gtb-list">
          <li>~270 pages, organized around the 4M framework</li>
          <li>17 chapters: Mind / Mitigate / Muscle / Motivate</li>
          <li>Action Guide (Part V) + daily adherence scorecard</li>
          <li>Genesis RPA + Muse cells regenerative chapter</li>
          <li>For the men already diagnosed — and the men preventing it</li>
        </ul>
      </div>

      <div class="gtb-form-col">
        <p class="gtb-form-eyebrow">Your Welcome Gift</p>
        <h1 class="gtb-form-headline">Claim your free copy</h1>
        <p class="gtb-form-sub">Name, email, phone. Become a Protégé (free), and we'll email you the book download link right now.</p>

        <form id="gtb-form" class="gtb-form" novalidate>
          <label for="field-name">First name</label>
          <input id="field-name" type="text" autocomplete="given-name" placeholder="e.g. TJ" required />

          <label for="field-email">Email</label>
          <input id="field-email" type="email" autocomplete="email" placeholder="you@example.com" required />

          <label for="field-phone">Phone</label>
          <input id="field-phone" type="tel" autocomplete="tel" placeholder="(555) 555-1234" required />

          <div class="gtb-consents">
            <label class="gtb-consent">
              <input id="field-protege-consent" type="checkbox" />
              <span>I agree to the Protégé terms — free signup, no purchase required, optional product offerings at the Protégé discount.</span>
            </label>
            <label class="gtb-consent">
              <input id="field-ai-consent" type="checkbox" />
              <span>I consent to receive communications from My4MLife (including AI-assisted educational messages and offers).</span>
            </label>
          </div>

          <p id="gtb-error" class="gtb-error" hidden></p>

          <button id="gtb-submit" type="submit" class="gtb-submit">Send My Free Book →</button>

          <p class="gtb-fine">By signing up you also get the My4MLife app, weekly Zooms with Dr. TJ, and 25%/25%/15% Protégé pricing on the product stack. No purchase required, ever.</p>
        </form>

        <div id="gtb-success" class="gtb-success" hidden>
          <div class="gtb-success-icon">✓</div>
          <h2>You're a Protégé.</h2>
          <p>Your book is on its way to your inbox now. Check there in the next minute or two (and the spam folder, just in case).</p>
          <p class="gtb-success-next">
            <strong>Next step:</strong> Take the free 5-minute 4M assessment to see your personalized top-3 priorities and unlock the dashboard.
          </p>
          <a href="/assessment" class="gtb-success-cta">Take the 5-min Assessment →</a>
        </div>
      </div>
    </div>
  </div>
</section>

</BaseLayout>

<script is:inline define:vars={{ API: (import.meta.env.PUBLIC_LEAD_CAPTURE_API_URL ?? 'https://v9svm8ds74.execute-api.us-east-2.amazonaws.com') }}>
(function () {
  function toE164(input) {
    var raw = String(input).trim();
    if (!raw) return null;
    var hasPlus = raw.charAt(0) === '+';
    var digits = raw.replace(/[^0-9]/g, '');
    if (hasPlus) {
      if (digits.length >= 8 && digits.length <= 15) return '+' + digits;
      return null;
    }
    if (digits.length === 10) return '+1' + digits;
    if (digits.length === 11 && digits.charAt(0) === '1') return '+' + digits;
    return null;
  }

  var form = document.getElementById('gtb-form');
  if (!form) return;

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    var nameEl = document.getElementById('field-name');
    var emailEl = document.getElementById('field-email');
    var phoneEl = document.getElementById('field-phone');
    var protegeEl = document.getElementById('field-protege-consent');
    var aiEl = document.getElementById('field-ai-consent');
    var errEl = document.getElementById('gtb-error');
    var btn = document.getElementById('gtb-submit');

    function showErr(msg) { errEl.textContent = msg; errEl.hidden = false; }
    errEl.hidden = true;

    var name = nameEl.value.trim();
    if (!name) { showErr('Please enter your first name.'); nameEl.focus(); return; }

    var email = emailEl.value.trim().toLowerCase();
    if (!email || !emailEl.validity.valid) { showErr('Please enter a valid email.'); emailEl.focus(); return; }

    var rawPhone = phoneEl.value.trim();
    var phoneE164 = rawPhone ? toE164(rawPhone) : null;
    if (!phoneE164) { showErr('Please enter a valid phone number.'); phoneEl.focus(); return; }

    if (!protegeEl.checked) { showErr('Please agree to the Protégé terms.'); protegeEl.focus(); return; }
    if (!aiEl.checked) { showErr('Please consent to communications.'); aiEl.focus(); return; }

    btn.disabled = true;
    btn.textContent = 'Sending your book…';

    try {
      var res = await fetch(API + '/api/protege-signup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          firstName: name,
          email: email,
          phone: phoneE164,
          consent: { ai: true, protege: true },
        }),
      });
      var data = await res.json().catch(function () { return {}; });
      if (!res.ok) throw new Error(data.error || ('Signup failed (' + res.status + ')'));

      // Success — swap form for success state
      form.hidden = true;
      document.getElementById('gtb-success').hidden = false;
      try { sessionStorage.setItem('my4m-signup-email', email); } catch (e) { /* no-op */ }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch (err) {
      btn.disabled = false;
      btn.textContent = 'Send My Free Book →';
      showErr(err && err.message ? err.message : 'Something went wrong. Please try again.');
    }
  });
})();
</script>

<style>
.gtb-section { padding: 3rem 1rem 5rem; }
.gtb-inner { max-width: 1080px; margin: 0 auto; }
.gtb-grid {
  display: grid;
  grid-template-columns: 0.85fr 1fr;
  gap: 3rem;
  align-items: start;
}
@media (max-width: 860px) {
  .gtb-grid { grid-template-columns: 1fr; gap: 2rem; }
}

.gtb-cover-col { text-align: center; }
.gtb-cover {
  width: 100%;
  max-width: 320px;
  height: auto;
  border-radius: 8px;
  box-shadow: 0 12px 40px rgba(0,0,0,0.25);
  margin: 0 auto 1.2rem;
}
.gtb-eyebrow {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--accent);
  margin: 0 0 0.4rem;
}
.gtb-cover-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.5rem;
  color: var(--primary);
  margin: 0 0 0.3rem;
}
.gtb-cover-tagline {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  color: var(--accent);
  margin: 0 0 1.2rem;
}
.gtb-list {
  list-style: none;
  padding: 0;
  margin: 0;
  text-align: left;
  max-width: 320px;
  margin: 0 auto;
}
.gtb-list li {
  font-size: 0.92rem;
  color: var(--text);
  padding: 0.4rem 0;
  border-bottom: 1px solid var(--border);
  display: flex;
  gap: 0.5rem;
}
.gtb-list li:last-child { border-bottom: none; }
.gtb-list li::before { content: '✓'; color: var(--accent); font-weight: 700; }

.gtb-form-col {
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 2rem 2rem 1.8rem;
}
.gtb-form-eyebrow {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--accent);
  margin: 0 0 0.4rem;
}
.gtb-form-headline {
  font-family: 'Playfair Display', serif;
  font-size: 2rem;
  color: var(--primary);
  margin: 0 0 0.5rem;
  line-height: 1.15;
}
.gtb-form-sub {
  font-size: 0.98rem;
  color: var(--text);
  margin: 0 0 1.5rem;
  line-height: 1.55;
}

.gtb-form label {
  display: block;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--primary);
  margin: 1rem 0 0.4rem;
}
.gtb-form input[type="text"],
.gtb-form input[type="email"],
.gtb-form input[type="tel"] {
  width: 100%;
  box-sizing: border-box;
  padding: 0.65rem 0.85rem;
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 1rem;
  font-family: inherit;
}
.gtb-form input:focus {
  outline: none;
  border-color: var(--accent);
}

.gtb-consents {
  margin: 1.25rem 0 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
}
.gtb-consent {
  display: flex;
  gap: 0.55rem;
  font-weight: 400;
  font-size: 0.85rem;
  color: var(--text);
  line-height: 1.45;
  cursor: pointer;
  margin: 0;
}
.gtb-consent input { margin-top: 3px; flex-shrink: 0; }

.gtb-error {
  background: rgba(192, 57, 43, 0.08);
  border: 1px solid rgba(192, 57, 43, 0.4);
  border-radius: 6px;
  padding: 0.55rem 0.8rem;
  color: #c0392b;
  font-size: 0.88rem;
  margin: 0.5rem 0 0.75rem;
}

.gtb-submit {
  width: 100%;
  padding: 0.95rem 1.5rem;
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: 999px;
  font-family: 'Inter', sans-serif;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
  letter-spacing: 0.01em;
}
.gtb-submit:hover:not(:disabled) { opacity: 0.92; }
.gtb-submit:disabled { opacity: 0.6; cursor: not-allowed; }

.gtb-fine {
  font-size: 0.78rem;
  color: var(--text-light);
  margin: 0.9rem 0 0;
  line-height: 1.5;
}

.gtb-success {
  text-align: center;
  padding: 1rem 0;
}
.gtb-success-icon {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  font-size: 1.8rem;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 0.8rem;
}
.gtb-success h2 {
  font-family: 'Playfair Display', serif;
  font-size: 1.5rem;
  color: var(--primary);
  margin: 0 0 0.6rem;
}
.gtb-success p {
  font-size: 0.95rem;
  color: var(--text);
  margin: 0 0 0.8rem;
  line-height: 1.55;
}
.gtb-success-next {
  background: rgba(0,184,148,0.06);
  border-left: 3px solid var(--accent);
  border-radius: 6px;
  padding: 0.7rem 0.9rem;
  text-align: left;
  margin: 1rem 0;
  font-size: 0.92rem;
}
.gtb-success-cta {
  display: inline-block;
  margin-top: 0.5rem;
  padding: 0.7rem 1.5rem;
  background: var(--accent);
  color: #fff;
  border-radius: 999px;
  font-family: 'Inter', sans-serif;
  font-weight: 600;
  text-decoration: none;
  font-size: 0.95rem;
}
.gtb-success-cta:hover { opacity: 0.92; }
</style>
