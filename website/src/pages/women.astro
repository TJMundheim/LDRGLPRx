---
// /women — audience door (TJ 2026-09-22, plan §2).
// Thin landing page: hero → canary → lane cards (her order) → the same two
// action doors as the homepage, carrying ?sex=female through to the
// assessment and the coordinator intake.
//
// PHOTO: Wave 3 w3-02 (placed 2026-09-22). Group shot w3-08 sits above the action doors.
// (woman at the head of the conference table). Swap the one <img src> below
// when the file lands. Never a male photo on this page.
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/door.css';
import TrustBand from '../components/TrustBand.astro';
import { consultHref } from '../lib/siteMode';

const SEX = 'female' as const;

const title = 'For Women — Protect Your Mind | My4MLife';
const description = "Perimenopause is the first signal, not the whole story. Menopause & HRT, GLP-1 weight loss, gut-brain repair, and peptides — chosen with you, starting with a free care coordinator call.";
const canonical = 'https://www.my4mlife.com/women';

const lanes = [
  {
    slug: 'menopause',
    eyebrow: 'Live visit · $249',
    name: 'Menopause & HRT',
    benefit: 'Hot flashes, broken sleep, brain fog, weight that moved to your middle. One visit, one hormone panel, and a plan for the whole system instead of one symptom at a time.',
    href: '/rx/menopause-hrt',
  },
  {
    slug: 'weight-loss',
    eyebrow: 'Free visit',
    name: 'GLP-1 Weight Loss',
    benefit: 'Semaglutide or tirzepatide, prescribed correctly the first time — with the muscle and protein plan that keeps the weight you lose from being the wrong weight.',
    href: '/rx/weight-loss',
  },
  {
    slug: 'gut-brain',
    eyebrow: 'Free visit',
    name: 'Gut-Brain Rx',
    benefit: 'A proprietary, physician-written gut-lining repair formulation. Your gut makes about 90% of your serotonin — repair the supply line to your mind.',
    href: '/rx/leaky-gut',
  },
  {
    slug: 'peptides',
    eyebrow: 'Free visit',
    name: 'Peptides',
    benefit: 'Growth-hormone and repair peptides matched to your goals — including tesamorelin for belly fat with muscle preserved.',
    href: '/rx/peptides',
  },
];
---
<BaseLayout title={title} description={description} canonical={canonical}>

<section class="door-hero">
  <div class="container door-hero-inner">
    <p class="door-eyebrow">For Women</p>
    <h1 class="door-headline">The signals showing up now are about your brain, and you can still set the clock.</h1>
    <p class="door-sub">Alzheimer's is a disease that shows up when you're older. It starts in midlife.</p>
    <figure class="door-figure">
      <img src="/images/wave3/w3-02.jpg" alt="A woman in her mid-40s leading a conversation in a warm brick-walled office" loading="eager" fetchpriority="high" />
    </figure>
  </div>
</section>

<TrustBand />

<section class="door-canary">
  <div class="container door-inner">
    <h2 class="door-h2">Perimenopause is the first signal, not the whole story.</h2>
    <p class="door-body">Sleep that stopped holding, a mood you don't recognize, fog in the middle of work you used to do without thinking, and weight that moved to your middle — those are not four separate problems, and they are not something to wait out. They are the earliest readable sign that estrogen, progesterone, sleep architecture, and metabolism are moving together, and that movement is a cognitive event, not only a comfort one.</p>
  </div>
</section>

<section class="door-lanes">
  <div class="container">
    <h2 class="door-h2 door-h2--center">Where you start</h2>
    <div class="door-grid">
      {lanes.map((t) => (
        <a href={t.href} class="door-card" onclick={`window.posthog && posthog.capture('women_lane_${t.slug}')`}>
          <span class="door-card-eyebrow">{t.eyebrow}</span>
          <h3 class="door-card-name">{t.name}</h3>
          <p class="door-card-benefit">{t.benefit}</p>
          <span class="door-card-start">Read more &rarr;</span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="door-cta">
  <div class="container door-inner door-inner--center">
    <figure class="door-figure door-figure--group">
      <img src="/images/wave3/w3-08.jpg" alt="Five women, thirties to sixties, talking around a table in a bright cafe" loading="lazy" />
    </figure>
    <h2 class="door-h2 door-h2--center">What do you want to do?</h2>
    <div class="door-doors">
      <a href={consultHref(undefined, SEX)} class="btn-primary-xl" onclick="window.posthog && posthog.capture('women_coordinator_cta')">Free care coordinator call &mdash; find out exactly what you need &rarr;</a>
      <a href={`/assessment?sex=${SEX}`} class="btn-secondary-xl" onclick="window.posthog && posthog.capture('women_assessment_cta')">Take the MindSpan assessment now &rarr;</a>
    </div>
    <p class="door-reassure">Nothing to pay today. After your call you'll get a written plan, and nothing is booked or charged unless it fits.</p>
    <p class="door-brandnote"><em>Begin with the end in mind.</em></p>
    <p class="door-brandnote">Don't lose your identity and your dignity while you still have a choice.</p>
  </div>
</section>

</BaseLayout>
