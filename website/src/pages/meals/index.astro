---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AFFILIATE_DISCLOSURE } from '../../lib/affiliates';
import { WEEKS, FIRST_MEALS, FIRST_MEAL_RULE, FASTING_DEFAULT } from '../../data/meals';

const title = 'Month 1 Meals | My4MLife';
const description =
  'Twelve high-protein, low-carb dinners — three a week, each serving four so dinner becomes the next two lunches. Plus the first meal that breaks your fast every day.';
const canonical = 'https://www.my4mlife.com/meals';

const RULES = [
  {
    h: 'Protein first',
    p: 'Thirty-five to fifty grams at dinner. Lunch is last night’s dinner, already cooked, already in the fridge.',
  },
  {
    h: 'No seed oils, no sugar, no flour',
    p: 'Your fats are butter, ghee, tallow, olive oil, avocado oil and coconut oil. Nothing else gets in the pan.',
  },
  {
    h: 'Vegetables are the carbs',
    p: 'No grains, no potatoes, no sweeteners. As few carbs as the dish allows, and the ones you get come off a plant.',
  },
  {
    h: 'Twenty to thirty minutes, hands-on',
    p: 'If it cannot be cooked in the time we claim, it does not belong on this page.',
  },
  {
    h: 'No weak links',
    p: 'Every packaged thing you buy — broth, marinara, spice blend — passes a full-ingredient read. One bad ingredient disqualifies the jar.',
  },
  {
    h: 'Nothing to drink but tea and water',
    p: 'Iced tea or green tea on the table. Water through the day. No alcohol in a recipe and none beside it.',
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <main class="mlx-page">
    <header class="mlx-hero">
      <p class="mlx-kicker">Month 1</p>
      <h1>Your meals for the month</h1>
      <p class="mlx-sub">
        Twelve dinners. Three a week, each one serving four, so tonight&rsquo;s dinner becomes the
        next two lunches. High-protein, low-carb, and the same twelve every month until you can cook
        them without reading.
      </p>
      <p class="mlx-plan">
        You will not be cooking lunch this month. That is the whole design.
      </p>
    </header>

    <section class="mlx-rules">
      <h2>The rule every one of these passes</h2>
      <div class="mlx-rule-grid">
        {RULES.map((r) => (
          <div class="mlx-rule-card">
            <h3>{r.h}</h3>
            <p>{r.p}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mlx-first">
      <h2>Break the fast</h2>
      <p class="mlx-rule-line">{FIRST_MEAL_RULE}</p>
      <div class="mlx-first-grid">
        {FIRST_MEALS.map((m) => (
          <div class="mlx-first-card">
            <p class="mlx-first-letter">{m.letter}</p>
            <h3>{m.name}</h3>
            <p class="mlx-first-body">{m.body}</p>
            <p class="mlx-first-protein">{m.protein}</p>
          </div>
        ))}
      </div>
      <p class="mlx-fasting"><strong>Your eating window.</strong> {FASTING_DEFAULT}</p>
    </section>

    <section class="mlx-weeks">
      <h2>The four weeks</h2>
      {WEEKS.map((w) => (
        <a class="mlx-week" href={`/meals/week-${w.n}`}>
          <p class="mlx-week-n">Week {w.n}</p>
          <h3>{w.theme}</h3>
          <p class="mlx-week-intro">{w.intro}</p>
          <ul class="mlx-week-list">
            {w.recipes.map((r) => <li>{r.title}</li>)}
          </ul>
          <span class="mlx-week-cta">Open Week {w.n} &rarr;</span>
        </a>
      ))}
    </section>

    <section class="mlx-cross">
      <p>
        Your supplements live on a page of their own. <a href="/stack">Your Stack &rarr;</a>
      </p>
    </section>

    <footer class="mlx-foot">
      <p class="mlx-disclosure">
        As an Amazon Associate, My4MLife earns from qualifying purchases. {AFFILIATE_DISCLOSURE}
      </p>
      <p class="mlx-tagline">
        <em>Don&rsquo;t lose your identity and your dignity while you still have a choice.</em>
      </p>
    </footer>
  </main>
</BaseLayout>

<style>
  .mlx-page { max-width: 900px; margin: 0 auto; padding: 3rem 1rem 4rem; }
  .mlx-hero { text-align: center; margin-bottom: 2.5rem; }
  .mlx-kicker { text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.78rem; color: #b8912f; font-weight: 700; margin-bottom: 0.5rem; }
  .mlx-hero h1 { font-size: clamp(2rem, 5vw, 2.8rem); color: #0a1f44; margin: 0 0 0.6rem; }
  .mlx-sub { max-width: 640px; margin: 0 auto 0.9rem; color: #33415c; font-size: 1.05rem; line-height: 1.6; }
  .mlx-plan { max-width: 640px; margin: 0 auto; color: #4a5568; font-size: 0.92rem; line-height: 1.6; }

  .mlx-rules { margin: 0 0 3rem; }
  .mlx-rules h2, .mlx-first h2, .mlx-weeks h2 { color: #0a1f44; font-size: 1.5rem; margin: 0 0 1rem; }
  .mlx-rule-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; }
  .mlx-rule-card { border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.1rem; background: #fff; min-width: 0; }
  .mlx-rule-card h3 { font-size: 1rem; color: #0a1f44; margin: 0 0 0.4rem; line-height: 1.35; }
  .mlx-rule-card p { font-size: 0.9rem; color: #4a5568; line-height: 1.55; margin: 0; }

  .mlx-first { background: #f3f6fb; border: 1px solid #dbe3f0; border-radius: 16px; padding: 1.75rem 1.25rem; margin: 0 0 3rem; }
  .mlx-first h2 { margin-bottom: 0.6rem; }
  .mlx-rule-line { color: #33415c; line-height: 1.65; margin: 0 0 1.25rem; }
  .mlx-first-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
  .mlx-first-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.1rem; min-width: 0; }
  .mlx-first-letter { font-size: 0.75rem; font-weight: 800; letter-spacing: 0.1em; color: #b8912f; margin: 0 0 0.25rem; }
  .mlx-first-card h3 { font-size: 1rem; color: #0a1f44; margin: 0 0 0.4rem; line-height: 1.35; }
  .mlx-first-body { font-size: 0.9rem; color: #4a5568; line-height: 1.55; margin: 0 0 0.6rem; }
  .mlx-first-protein { font-size: 0.82rem; font-weight: 700; color: #0a7c4d; margin: 0; }
  .mlx-fasting { margin: 1.25rem 0 0; font-size: 0.92rem; color: #33415c; line-height: 1.65; }

  .mlx-weeks { margin: 0 0 2.5rem; }
  .mlx-week { display: block; border: 1px solid #e2e8f0; border-radius: 16px; background: #fff; padding: 1.4rem 1.25rem; margin-bottom: 1.1rem; text-decoration: none; min-width: 0; }
  .mlx-week:hover { border-color: #b8912f; }
  .mlx-week-n { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.09em; color: #b8912f; font-weight: 800; margin: 0 0 0.25rem; }
  .mlx-week h3 { font-size: 1.22rem; color: #0a1f44; margin: 0 0 0.45rem; line-height: 1.3; }
  .mlx-week-intro { font-size: 0.93rem; color: #4a5568; line-height: 1.6; margin: 0 0 0.8rem; }
  .mlx-week-list { margin: 0 0 0.9rem; padding-left: 1.1rem; }
  .mlx-week-list li { font-size: 0.9rem; color: #33415c; line-height: 1.5; margin-bottom: 0.3rem; }
  .mlx-week-cta { font-size: 0.88rem; font-weight: 700; color: #0a7c4d; }

  .mlx-cross { border-top: 1px solid #e2e8f0; padding-top: 1.5rem; }
  .mlx-cross p { margin: 0; font-size: 0.95rem; color: #33415c; }
  .mlx-cross a { color: #0a7c4d; font-weight: 700; text-decoration: none; }
  .mlx-cross a:hover { text-decoration: underline; }

  .mlx-foot { border-top: 1px solid #e2e8f0; padding-top: 1.75rem; margin-top: 2.5rem; text-align: center; }
  .mlx-disclosure { font-size: 0.78rem; color: #8b96a8; line-height: 1.6; max-width: 620px; margin: 0 auto 1rem; }
  .mlx-tagline { font-size: 0.92rem; color: #33415c; margin: 0; }

  @media (max-width: 600px) {
    .mlx-page { padding: 2rem 1rem 3rem; }
    .mlx-rule-grid, .mlx-first-grid { grid-template-columns: 1fr; }
  }
</style>
