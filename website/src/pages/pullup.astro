---
// Peptide Pull-Up Challenge landing page (route /pullup). Discoverable: normal chrome, indexable.
// Rules written 2026-11-15 per TJ (replaces the old Push Patch contest; no divisions, no scoring, no prize).
// Posts to /api/pullup-challenge-entry (consentVersion pullup-v2). Entering is not marketing consent.
// Plan: docs/plan/peptide-pullup-challenge-2026-11-15.md
import BaseLayout from '../layouts/BaseLayout.astro';
import { SHOW_PULLUP } from '../lib/siteMode';
if (!SHOW_PULLUP) return Astro.redirect('/rx/peptides');
const title = 'Peptide Pull-Up Challenge | My4MLife';
const description = 'Everyone can do this. Film your starting point, post it, and get 50% off a peptide order. Come back in January with your after video and get a second 50% code.';
const canonical = 'https://www.my4mlife.com/pullup';
const coordHref = '/consult?lane=peptides&src=pullup';
---
<BaseLayout title={title} description={description} canonical={canonical}>

<main class="pu">
  <section class="pu-hero">
    <h1>Peptide Pull-Up Challenge</h1>
    <p class="pu-due">Day-one videos due December 15.</p>
    <p class="pu-lead">Everyone can do this. You're not competing against anyone but yourself. Film your starting point, post it, and get 50% off a peptide order. Come back in January with your after video and get a second 50% code.</p>
    <h2 class="pu-short-h">THE SHORT VERSION</h2>
    <ul class="pu-short">
      <li>Post your day-one video by December 15, 2026 and enter it below. You get a code for 50% off one peptide order (Push Patch included).</li>
      <li>Not sure what you need? A free care coordinator call and a free telemedicine visit come with it, and the provider decides what's right for you.</li>
      <li>Train through the holidays.</li>
      <li>Post your after video January 1 to 7, 2027 and enter it. You get a second 50% code.</li>
      <li>Optional: invite @drtjmundheim as a collaborator so your video shows on my page too.</li>
    </ul>
    <h3>THE REP</h3>
    <p>Start from a dead hang, pull until your nose is above the bar, and lower under control. Can't do one yet? Use a band, jump up off the ground, step off a box, or get a spotter. Any help is fine, and the help can change between your videos. Band-assisted on day one and one unassisted rep in January is exactly the kind of progress I want to see. Improvement can be more reps, less help, or both. Film the whole set from the side or the front, with the bar visible.</p>
    <h3>WHAT YOU GET</h3>
    <p>Each accepted video earns one code: 50% off one peptide order, single use, good for 90 days. Use it at <a href="/go/push-patch">Push Patch checkout</a> (tap "Add promotion code"), or tell your care coordinator on your free call (<a href="/consult?lane=peptides&amp;src=pullup">book it here</a>). Your code shows on screen right after you enter, and we email it to you too.</p>
    <p>Day-one videos: now through December 15, 2026 at 11:59 PM CT. After videos: January 1 through January 7, 2027 at 11:59 PM CT.</p>
  </section>

  <section class="pu-formwrap" id="enter" aria-labelledby="pu-enter-h">
    <h2 id="pu-enter-h">Enter the challenge</h2>
    <form id="pu-form" novalidate>
      <div class="pu-hp" aria-hidden="true"><label for="pu-hp">Leave this empty</label><input id="pu-hp" name="hp" type="text" tabindex="-1" autocomplete="off" /></div>

      <label for="pu-name">Name</label>
      <input id="pu-name" name="name" type="text" autocomplete="name" maxlength="120" required />

      <label for="pu-email">Email</label>
      <input id="pu-email" name="email" type="email" inputmode="email" autocomplete="email" maxlength="200" required />

      <label for="pu-phone">Phone</label>
      <input id="pu-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="30" required />

      <label for="pu-ig">Link to your public Instagram post</label>
      <input id="pu-ig" name="instagramUrl" type="url" inputmode="url" placeholder="https://www.instagram.com/..." maxlength="500" required />

      <fieldset class="pu-round">
        <legend>Which video is this?</legend>
        <label class="pu-opt"><input type="radio" name="round" value="start" required /> My day-one video</label>
        <label class="pu-opt"><input type="radio" name="round" value="final" required /> My January after video</label>
      </fieldset>

      <label class="pu-opt pu-check"><input type="checkbox" name="adult" required /> I am 18 or older</label>
      <label class="pu-opt pu-check"><input type="checkbox" name="rulesAccepted" required /> I live in the United States and I have read and agree to the rules.</label>

      <div class="pu-consent">
        <label class="pu-opt pu-check"><input type="checkbox" name="smsOptIn" /> Text me updates and offers from My4MLife</label>
        <p class="pu-fine">By checking this box, you agree to receive recurring automated marketing text messages from My4MLife at the number provided. Consent is not a condition of entry or purchase. Msg &amp; data rates may apply. Msg frequency varies. Reply STOP to cancel, HELP for help. <a href="/privacy">Privacy Policy</a>.</p>
        <label class="pu-opt pu-check"><input type="checkbox" name="emailOptIn" /> Email me updates and offers from My4MLife</label>
        <p class="pu-fine">By checking this box, you agree to receive marketing emails from My4MLife. Consent is not a condition of entry. Unsubscribe anytime. <a href="/privacy">Privacy Policy</a>.</p>
      </div>

      <p class="pu-error" id="pu-error" role="alert" hidden></p>
      <button type="submit">Submit my entry</button>
      <p class="pu-fine pu-center">Entering is not consent to marketing.</p>
    </form>
    <div class="pu-done" id="pu-done" role="status" hidden>
      <p id="pu-done-msg"></p>
      <div id="pu-code-wrap" hidden>
        <p>Your 50% off code:</p>
        <div class="pu-code-box">
          <div id="pu-code"></div>
          <button type="button" id="pu-copy">Copy code</button>
        </div>
        <p>Check your email too. We sent it there.</p>
        <p>Use it at Push Patch checkout, or tell your care coordinator on your free call.</p>
        <a class="pu-cta" href={coordHref}>Book my free care coordinator call</a>
      </div>
    </div>
  </section>

  <section class="pu-rules" aria-labelledby="pu-rules-h">
    <h2 id="pu-rules-h">Full rules</h2>
  <h3>HOW TO ENTER</h3>
  <ol>
    <li>Film your day-one video following the video notes below.</li>
    <li>Post it on your own Instagram page. The post must be public, tag @drtjmundheim, and include the hashtag #PeptidePullUpChallenge in the caption. Step-by-step posting instructions are next.</li>
    <li>Enter on this page: your name, email, phone number, and the link to your public Instagram post. Day-one videos are accepted through 11:59 PM CT on December 15, 2026.</li>
    <li>Train through the holidays.</li>
    <li>Film your after video, post it publicly the same way, and enter the post link on this page between January 1 and 11:59 PM CT on January 7, 2027.</li>
  </ol>
  <p>Posting publicly is the point: your post is how the challenge spreads, and the link you send is how your entry is checked. You never need to like or follow any page, or share anyone else's post.</p>
  <h3>POSTING, STEP BY STEP</h3>
  <p>Never posted a video before? Here is exactly how. If your account or the post is private, we cannot see it, so the public setting matters.</p>
  <ul>
    <li>Instagram: open the app, tap the + to make a new post, and pick your video. In the caption, type @drtjmundheim and tap the account when it pops up, then type #PeptidePullUpChallenge. If your Instagram account is set to private, your post cannot be checked. Tap Share.</li>
    <li>Optional, but it helps the challenge spread: invite me as a collaborator. On the share screen, tap Tag people, then Invite collaborator, and search drtjmundheim. When I accept, your video shows on my page too, and both of our followers see it. Your entry counts either way.</li>
    <li>Get the link to your Instagram post: open your post, tap the share or three-dots menu, and tap Copy Link.</li>
    <li>Then come back to this page, fill in the form, and paste the link. That is a complete entry.</li>
  </ul>
  <p>Stuck on any step? DM the My4MLife page and we will walk you through it.</p>
  <h3>VIDEO NOTES</h3>
  <ul>
    <li>Start from a dead hang, pull until your nose is above the bar, lower under control.</li>
    <li>Film the whole set, side or front view, with the bar visible.</li>
    <li>Help is fine (band, jump, box, spotter) and can change between videos.</li>
    <li>Keep the same bar if you can, so your progress is easy to see.</li>
  </ul>
  <h3>THE FINE PRINT</h3>
  <ul>
    <li>Sponsor: My4MLIFE LLC, operating as My4MLife, 1205 Hall Johnson Rd, Colleyville, TX 76034.</li>
    <li>Open to people 18 or older who live in the United States. One entry per video round per person. Void where prohibited by law.</li>
    <li>Each accepted video earns one code for 50% off one peptide order. Codes are single use, have no cash value, are good for 90 days, allow one code per order, and cannot be combined with other codes.</li>
    <li>Prescription products require a provider's review, and the provider decides what is right for you. The discount applies only to what is prescribed.</li>
    <li>We may remove entries whose video does not show a real attempt.</li>
    <li>Check with your doctor before starting any exercise program. You participate at your own risk. Stop if you feel pain. The sponsor is not responsible for injuries.</li>
    <li>By entering, you agree that your videos may be reposted and used to promote this challenge.</li>
    <li>Entering is not marketing consent. The text and email opt-ins are optional and unchecked.</li>
    <li>The sponsor may cancel, change, or end the challenge if something outside its control affects it, with notice on this page.</li>
    <li>This challenge is in no way sponsored, endorsed or administered by, or associated with, Meta Platforms, Inc., Facebook or Instagram. By entering, each entrant fully releases Meta Platforms, Inc., Facebook and Instagram from any and all liability in connection with this challenge. Questions about the challenge go to My4MLife, not to Meta.</li>
  </ul>
    <p class="pu-tag">Don't lose your identity and your dignity while you still have a choice.</p>
    <p class="pu-fine"><a href="/privacy">Privacy Policy</a></p>
  </section>
</main>

</BaseLayout>

<script>
  const renderedAt = Date.now();

  const API_BASE: string =
    (import.meta as any).env?.PUBLIC_LEAD_CAPTURE_API_URL ??
    'https://v9svm8ds74.execute-api.us-east-2.amazonaws.com';

  const form = document.getElementById('pu-form') as HTMLFormElement | null;
  const errEl = document.getElementById('pu-error') as HTMLElement;
  const ph = (e: string, p?: Record<string, unknown>) => (window as any).posthog?.capture(e, p);
  const setErr = (m: string | null) => { errEl.textContent = m ?? ''; errEl.hidden = !m; };
  const val = (n: string) => (form!.elements.namedItem(n) as HTMLInputElement).value.trim();
  const checked = (n: string) => (form!.elements.namedItem(n) as HTMLInputElement).checked;

  const copyBtn = document.getElementById('pu-copy') as HTMLButtonElement | null;
  copyBtn?.addEventListener('click', async () => {
    const codeEl = document.getElementById('pu-code') as HTMLElement;
    try {
      await navigator.clipboard.writeText(codeEl.textContent ?? '');
      copyBtn.textContent = 'Copied';
    } catch (_) {
      const r = document.createRange();
      r.selectNodeContents(codeEl);
      const s = window.getSelection();
      s?.removeAllRanges();
      s?.addRange(r);
      copyBtn.textContent = 'Press and hold to copy';
    }
  });

  if (form) {
    let started = false;
    form.addEventListener('input', () => { if (!started) { started = true; ph('pullup_form_started'); } }, { once: false });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = val('name'), email = val('email'), phone = val('phone');
      // The Lambda requires an https instagram.com URL; accept a pasted link without the scheme.
      const instagramUrl = val('instagramUrl').replace(/^http:\/\//i, 'https://').replace(/^(?!https:\/\/)/i, 'https://');
      const roundEl = form.querySelector<HTMLInputElement>('input[name="round"]:checked');
      if (!name) return setErr('Please enter your name.');
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return setErr('Please enter a valid email address.');
      const digits = phone.replace(/\D/g, '');
      if (!(digits.length === 10 || (digits.length === 11 && digits[0] === '1'))) return setErr('Please enter a 10-digit US phone number.');
      if (!instagramUrl.toLowerCase().includes('instagram.com')) return setErr('Please paste the link to your Instagram post (it should contain instagram.com).');
      if (!roundEl) return setErr('Please choose your day-one video or your January after video.');
      if (!checked('adult')) return setErr('Please confirm you are 18 or older.');
      if (!checked('rulesAccepted')) return setErr('Please confirm you live in the United States and agree to the rules.');
      const round = roundEl.value === 'final' ? 'final' : 'start';
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      button.disabled = true;
      setErr(null);
      let ok = false;
      let serverMsg: string | null = null;
      let code: string | null = null;
      try {
        const res = await fetch(`${API_BASE}/api/pullup-challenge-entry`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name, email, phone, instagramUrl, round,
            adult: true,
            rulesAccepted: true,
            smsOptIn: checked('smsOptIn'),
            emailOptIn: checked('emailOptIn'),
            consentVersion: 'pullup-v2',
            hp: val('hp'),
            t: Date.now() - renderedAt,
          }),
        });
        ok = res.ok;
        // 400 (validation) and 409 (already entered this round) carry a plain-language { error }.
        const j = await res.json().catch(() => null);
        if (ok) code = typeof j?.code === 'string' && j.code ? j.code : null;
        else serverMsg = typeof j?.error === 'string' ? j.error : null;
      } catch (_) { ok = false; }
      button.disabled = false;
      if (!ok) { setErr(serverMsg ?? "That didn't go through. Please try again."); ph('pullup_entry_failed', { round }); return; }
      ph('pullup_entry_submitted', { round });
      const msg = document.getElementById('pu-done-msg')!;
      if (code) {
        msg.textContent = round === 'start'
          ? "You're in. Train hard, and post your after video January 1 to 7, 2027."
          : "You're in. Thank you for showing your progress.";
        document.getElementById('pu-code')!.textContent = code;
        (document.getElementById('pu-code-wrap') as HTMLElement).hidden = false;
      } else {
        msg.textContent = "You're in. Your code is on its way by email.";
      }
      form.hidden = true;
      (document.getElementById('pu-done') as HTMLElement).hidden = false;
    });
  }
</script>

<style>
.pu { font-family: 'Inter', system-ui, sans-serif; color: #1f2d3d; max-width: 720px; margin: 0 auto; padding: calc(73px + 1.5rem) 1rem 3rem; /* clear the fixed 73px navbar */ line-height: 1.6; font-size: 1.05rem; }
.pu h1 { font-size: clamp(2rem, 7vw, 2.8rem); line-height: 1.15; margin: 0.5rem 0 0.25rem; }
.pu-due { font-weight: 800; font-size: 1.2rem; margin: 0 0 1rem; }
.pu-short { padding-left: 1.2rem; }
.pu-short li { margin-bottom: 0.7rem; }
.pu h2 { font-size: 1.6rem; margin: 2rem 0 0.75rem; }
.pu h3 { font-size: 1.1rem; letter-spacing: 0.04em; margin: 1.8rem 0 0.5rem; }
.pu-formwrap { background: #f6f3ea; border: 2px solid #1f2d3d; border-radius: 10px; padding: 1rem 1rem 1.25rem; margin-top: 1.5rem; }
.pu-formwrap h2 { margin-top: 0.25rem; }
#pu-form { display: flex; flex-direction: column; gap: 0.5rem; }
#pu-form > label:not(.pu-opt) { font-weight: 700; margin-top: 0.5rem; }
#pu-form input[type="text"], #pu-form input[type="email"], #pu-form input[type="tel"], #pu-form input[type="url"] { font-size: 1.1rem; padding: 0.9rem; min-height: 52px; border: 2px solid #1f2d3d; border-radius: 6px; width: 100%; box-sizing: border-box; background: #fff; }
.pu-round { border: 0; padding: 0; margin: 0.75rem 0 0; display: flex; flex-direction: column; gap: 0.4rem; }
.pu-round legend { font-weight: 700; margin-bottom: 0.3rem; padding: 0; }
.pu-opt { display: flex; gap: 0.75rem; align-items: flex-start; min-height: 48px; padding: 0.4rem 0; cursor: pointer; }
.pu-opt input { width: 1.6rem; height: 1.6rem; flex: none; margin: 0.1rem 0 0; }
.pu-check { font-weight: 600; }
.pu-consent { margin-top: 0.75rem; border-top: 1px solid #d8d2c0; padding-top: 0.5rem; }
.pu-fine { font-size: 0.85rem; line-height: 1.5; margin: 0 0 0.75rem 2.4rem; opacity: 0.9; }
.pu-center { text-align: center; margin-left: 0; }
.pu-fine a { color: inherit; }
.pu-error { color: #a01818; font-weight: 700; margin: 0.5rem 0; }
#pu-form button[type="submit"] { background: #1f2d3d; color: #fff; font-weight: 700; font-size: 1.15rem; padding: 1.1rem; min-height: 56px; border: 0; border-radius: 8px; cursor: pointer; margin-top: 0.75rem; }
#pu-form button:disabled { opacity: 0.6; }
.pu-done { font-weight: 700; font-size: 1.15rem; }
.pu-rules p, .pu-rules li { margin: 0 0 0.6rem; }
.pu-rules ul, .pu-rules ol { padding-left: 1.4rem; }
.pu-code-box { display: flex; flex-direction: column; gap: 0.6rem; align-items: stretch; margin: 0.75rem 0; }
#pu-code { font-family: ui-monospace, Menlo, monospace; font-size: 1.5rem; font-weight: 800; letter-spacing: 0.04em; background: #fff; border: 2px dashed #1f2d3d; border-radius: 8px; padding: 0.9rem; text-align: center; word-break: break-all; user-select: all; }
#pu-copy { background: #1f2d3d; color: #fff; font-weight: 700; font-size: 1.1rem; min-height: 52px; border: 0; border-radius: 8px; cursor: pointer; }
.pu-cta { display: inline-block; background: #c98a00; color: #1f2d3d; font-weight: 700; padding: 0.9rem 1.2rem; border-radius: 8px; text-decoration: none; min-height: 48px; box-sizing: border-box; }
.pu-tag { font-weight: 700; font-style: italic; margin-top: 2rem; }
.pu-hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
</style>
