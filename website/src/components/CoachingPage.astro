---
// /coaching page body (DRAFT — rendered only when SHOW_DRAFTS; see pages/coaching.astro).
// Copy source: docs/plan/beasley-reciprocal-and-coaching-2026-10-17.md
const steps = [
  { t: 'Apply', d: '5 minutes. This is by application only.' },
  { t: 'A private call with Dr. TJ', d: 'To see if it is a fit, for both of us.' },
  { t: 'Visit one: four days in your home', d: 'Sunday through Wednesday.' },
  { t: 'A call every day', d: 'For the rest of the month.' },
  { t: 'Visit two: three days in your home', d: 'Sunday through Tuesday, at the end of your first 30 days.' },
];
const visitOne = [
  'Genetic testing for how your body handles medications (PGx) and nutrients (NGx), plus a comprehensive lab panel',
  'Kitchen and pantry reset: out with the insulting foods, in with a stocked week',
  'Home environment set-up: light, sleep, air, water',
  'A workout program built for your body and your schedule',
  'Your morning routine, practiced until it sticks',
  "Cooking the week's meals together",
  'The book and the Logbook applied to your actual life',
];
const criteria = [
  'You are ready to change how you live, not just what you take.',
  'You will do the daily calls and the work between them.',
  'You and your household are open to me spending time in your home.',
  'You can commit the first month in full.',
];
const radioGroups = {
  household: { name: 'household', id: 'cc-household', legend: 'Who lives in your home?', opts: ['Just me', 'Spouse or partner', 'Spouse or partner and kids', 'Other'] },
  partner: { name: 'partnerOnBoard', id: 'cc-partner', legend: 'Is your spouse or partner on board with this?', opts: ['Yes', 'Not yet', 'Not applicable'] },
  calls: { name: 'dailyCalls', id: 'cc-calls', legend: 'Will you do a call with Dr. TJ every day for the first month?', opts: ['Yes', 'No'] },
  commit: { name: 'commit', id: 'cc-commit', legend: 'The first month is $50,000. Are you prepared to commit?', opts: ['Yes', "I'd like to discuss"] },
};
const spaces = ['Home gym', 'Sauna', 'Cold plunge', 'Swimming pool', 'Walking trails or outdoor space', 'Garden', 'Red-light therapy', 'Standing desk or home office', 'None of these yet'];
const goalOpts = ['Energy', 'Weight', 'Sleep', 'Focus and memory', 'Strength', 'Hormones', 'Gut', 'Daily habits'];
---
<section class="cc-hero">
  <div class="container cc-hero-inner">
    <h1>The Captain's Table</h1>
    <p class="cc-headline">Four seats. Your home. Your whole life.</p>
    <p class="cc-tagline">Don't lose your identity and your dignity while you still have a choice.</p>
    <a href="#apply" class="cc-btn cc-btn--accent">Apply for a seat</a>
  </div>
</section>

<section class="cc-section">
  <div class="container cc-narrow">
    <h2>What happens</h2>
    <ol class="cc-steps">
      {steps.map((s) => (
        <li>
          <span class="cc-step-title">{s.t}</span>
          <span class="cc-step-desc">{s.d}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="cc-section cc-section--soft">
  <div class="container cc-two">
    <div>
      <h2>Visit one: four days (Sunday&ndash;Wednesday)</h2>
      <ul class="cc-list">
        {visitOne.map((d) => <li>{d}</li>)}
      </ul>
    </div>
    <div>
      <h2>Between visits</h2>
      <p class="cc-after">A call every day; the My4MLife app, Logbook and weekly Zooms.</p>
    </div>
  </div>
</section>

<section class="cc-section">
  <div class="container cc-narrow">
    <h2>Visit two: three days (Sunday&ndash;Tuesday, end of month one)</h2>
    <p class="cc-after">We review your results and your labs together and work on whatever is still in the way at home; then your full-dose regenerative therapy (Genesis RPA), delivered by nasal atomizer, with Dr. TJ there to walk you through it. Approved by one of our network's licensed physicians, like every treatment we offer.</p>
  </div>
</section>

<section class="cc-section">
  <div class="container cc-narrow">
    <h2>Who this is for</h2>
    <ul class="cc-list">
      {criteria.map((d) => <li>{d}</li>)}
    </ul>
    <p class="cc-pull">Being able to pay is not enough. I choose people who are ready.</p>
  </div>
</section>

<section class="cc-price">
  <div class="container cc-narrow cc-price-inner">
    <h2>Price</h2>
    <p class="cc-amount"><span>$50,000</span> for the first month. Travel included.</p>
    <p class="cc-seats-note cc-capacity">Two new seats open each month. Never more than four people at a time.</p>
    <p class="cc-includes">Includes both visits, all testing and labs, daily calls, and your regenerative therapy.</p>
    <p class="cc-seats-note">Seats are limited to four at a time. If the table is full, you'll be first in line for the next opening.</p>
  </div>
</section>

<section class="cc-section cc-section--soft" id="reserving">
  <div class="container cc-narrow">
    <h2>Reserving your seat</h2>
    <p class="cc-after cc-reserve-lead">Your seat is reserved when you choose a start date and pay in full.</p>
    <ul class="cc-list">
      <li>More than 30 days before your start date: 90% refund.</li>
      <li>15 to 30 days before: 85% refund.</li>
      <li>14 days or fewer: 80% refund.</li>
      <li>After your start date: no refund, with one exception. If you decide after the first four days not to continue, you receive $15,000 back.</li>
      <li>If Dr. TJ has to cancel, you receive a full refund for anything not yet delivered.</li>
    </ul>
  </div>
</section>

<section class="cc-section" id="apply">
  <div class="container cc-form-wrap">
    <h2>Apply for a seat</h2>
    <p class="cc-form-intro">About 5 minutes. <span class="cc-req" aria-hidden="true">*</span> marks a required question. We do not ask any health questions here.</p>
    <form id="coaching-form" novalidate>
      <fieldset class="cc-group">
        <legend class="cc-group-title">About you</legend>
        <div class="cc-row">
          <div class="cc-field" data-field="cc-first">
            <label for="cc-first">First name <span class="cc-req" aria-hidden="true">*</span></label>
            <input type="text" id="cc-first" name="firstName" autocomplete="given-name" aria-required="true" />
            <span class="cc-err" data-for="cc-first" role="alert"></span>
          </div>
          <div class="cc-field" data-field="cc-last">
            <label for="cc-last">Last name <span class="cc-req" aria-hidden="true">*</span></label>
            <input type="text" id="cc-last" name="lastName" autocomplete="family-name" aria-required="true" />
            <span class="cc-err" data-for="cc-last" role="alert"></span>
          </div>
        </div>
        <div class="cc-row">
          <div class="cc-field" data-field="cc-email">
            <label for="cc-email">Email <span class="cc-req" aria-hidden="true">*</span></label>
            <input type="email" id="cc-email" name="email" autocomplete="email" aria-required="true" />
            <span class="cc-err" data-for="cc-email" role="alert"></span>
          </div>
          <div class="cc-field" data-field="cc-phone">
            <label for="cc-phone">Mobile phone <span class="cc-req" aria-hidden="true">*</span></label>
            <input type="tel" id="cc-phone" name="phone" autocomplete="tel" inputmode="tel" aria-required="true" />
            <span class="cc-err" data-for="cc-phone" role="alert"></span>
          </div>
        </div>
        <div class="cc-field" data-field="cc-city">
          <label for="cc-city">City and state <span class="cc-req" aria-hidden="true">*</span></label>
          <input type="text" id="cc-city" name="location" autocomplete="address-level2" aria-required="true" />
          <span class="cc-err" data-for="cc-city" role="alert"></span>
        </div>
        {[radioGroups.household, radioGroups.partner].map((g) => (
          <fieldset class="cc-field cc-radios" id={g.id} data-field={g.id} data-radio={g.name}>
            <legend>{g.legend} <span class="cc-req" aria-hidden="true">*</span></legend>
            <div class="cc-opts">
              {g.opts.map((o) => (
                <label class="cc-opt"><input type="radio" name={g.name} value={o} /> <span>{o}</span></label>
              ))}
            </div>
            <span class="cc-err" data-for={g.id} role="alert"></span>
          </fieldset>
        ))}
      </fieldset>

      <fieldset class="cc-group">
        <legend class="cc-group-title">Your home</legend>
        <fieldset class="cc-field cc-radios" id="cc-spaces" data-field="cc-spaces">
          <legend>Which of these do you have at home?</legend>
          <div class="cc-opts cc-opts--grid">
            {spaces.map((o) => (
              <label class="cc-opt"><input type="checkbox" name="homeSpaces" value={o} /> <span>{o}</span></label>
            ))}
          </div>
        </fieldset>
        <div class="cc-field" data-field="cc-other">
          <label for="cc-other">Anything else at home that could help?</label>
          <input type="text" id="cc-other" name="homeOther" autocomplete="off" />
        </div>
      </fieldset>

      <fieldset class="cc-group">
        <legend class="cc-group-title">Your why</legend>
        <div class="cc-field" data-field="cc-whofor">
          <label for="cc-whofor">Who are you doing this for? <span class="cc-req" aria-hidden="true">*</span></label>
          <p class="cc-help" id="cc-whofor-help">Name the person and your relationship to them.</p>
          <input type="text" id="cc-whofor" name="whoFor" maxlength="80" autocomplete="off" aria-required="true" aria-describedby="cc-whofor-help" />
          <span class="cc-err" data-for="cc-whofor" role="alert"></span>
        </div>
        <fieldset class="cc-field cc-radios" id="cc-goals" data-field="cc-goals">
          <legend>What do you most want to change? <span class="cc-req" aria-hidden="true">*</span></legend>
          <p class="cc-help cc-pickup" id="cc-goals-note">Pick up to 3. <span id="cc-goals-count">0 of 3 selected.</span></p>
          <div class="cc-opts cc-opts--grid">
            {goalOpts.map((o) => (
              <label class="cc-opt"><input type="checkbox" name="goals" value={o} /> <span>{o}</span></label>
            ))}
          </div>
          <span class="cc-err" data-for="cc-goals" role="alert"></span>
        </fieldset>
        <div class="cc-field" data-field="cc-why">
          <label for="cc-why">Why now? <span class="cc-req" aria-hidden="true">*</span></label>
          <textarea id="cc-why" name="whyNow" rows="4" aria-required="true"></textarea>
          <span class="cc-err" data-for="cc-why" role="alert"></span>
        </div>
      </fieldset>

      <fieldset class="cc-group">
        <legend class="cc-group-title">Your commitment</legend>
        <fieldset class="cc-field cc-radios" id={radioGroups.calls.id} data-field={radioGroups.calls.id} data-radio={radioGroups.calls.name}>
          <legend>{radioGroups.calls.legend} <span class="cc-req" aria-hidden="true">*</span></legend>
          <div class="cc-opts">
            {radioGroups.calls.opts.map((o) => (
              <label class="cc-opt"><input type="radio" name={radioGroups.calls.name} value={o} /> <span>{o}</span></label>
            ))}
          </div>
          <span class="cc-err" data-for={radioGroups.calls.id} role="alert"></span>
        </fieldset>
        <div class="cc-field" data-field="cc-start">
          <label for="cc-start">When would you like to start? <span class="cc-req" aria-hidden="true">*</span></label>
          <select id="cc-start" name="start" aria-required="true">
            <option value="">Select one</option>
            <option>Next month</option>
            <option>Within 3 months</option>
            <option>Just exploring</option>
          </select>
          <span class="cc-err" data-for="cc-start" role="alert"></span>
        </div>
        <fieldset class="cc-field cc-radios" id={radioGroups.commit.id} data-field={radioGroups.commit.id} data-radio={radioGroups.commit.name}>
          <legend>{radioGroups.commit.legend} <span class="cc-req" aria-hidden="true">*</span></legend>
          <div class="cc-opts">
            {radioGroups.commit.opts.map((o) => (
              <label class="cc-opt"><input type="radio" name={radioGroups.commit.name} value={o} /> <span>{o}</span></label>
            ))}
          </div>
          <span class="cc-err" data-for={radioGroups.commit.id} role="alert"></span>
        </fieldset>
        <div class="cc-field" data-field="cc-heard">
          <label for="cc-heard">How did you hear about The Captain's Table?</label>
          <input type="text" id="cc-heard" name="heardFrom" autocomplete="off" />
        </div>
      </fieldset>

      <p class="cc-missing" id="cc-missing" role="alert"></p>
      <button type="submit" class="cc-btn cc-btn--accent cc-submit" id="cc-submit">Send my application</button>
      <p class="cc-form-error" id="cc-form-error" role="alert" hidden></p>
    </form>
    <div class="cc-success" id="cc-success" role="status" hidden>
      <h3>Thank you for applying. I read every application myself and will reach out personally within two business days. A confirmation is on its way to your inbox. &mdash; Dr. TJ</h3>
    </div>
  </div>
</section>

<section class="cc-fine">
  <div class="container cc-narrow">
    <p>Coaching is lifestyle and education. Testing, labs and any prescription or regenerative therapy are ordered and approved by our network's licensed physicians.</p>
  </div>
</section>

<script>
  import { submitLead, LEAD_CAPTURE_ERROR } from '../scripts/lead-capture';

  const API_BASE: string =
    (import.meta as any).env?.PUBLIC_LEAD_CAPTURE_API_URL ??
    'https://v9svm8ds74.execute-api.us-east-2.amazonaws.com';

  function toE164(input: string): string | null {
    const raw = (input || '').trim();
    if (!raw) return null;
    const digits = raw.replace(/[^0-9]/g, '');
    if (raw.charAt(0) === '+') return digits.length >= 8 && digits.length <= 15 ? '+' + digits : null;
    if (digits.length === 10) return '+1' + digits;
    if (digits.length === 11 && digits.charAt(0) === '1') return '+' + digits;
    return null;
  }

  const form = document.getElementById('coaching-form') as HTMLFormElement | null;
  if (form) {
    const submit = document.getElementById('cc-submit') as HTMLButtonElement;
    const formError = document.getElementById('cc-form-error') as HTMLElement;
    const missing = document.getElementById('cc-missing') as HTMLElement;
    const success = document.getElementById('cc-success') as HTMLElement;
    const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();
    const radioVal = (name: string) => form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? '';
    const checkedVals = (name: string) =>
      Array.from(form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)).map((i) => i.value);

    // "Pick up to 3": once three are chosen, the rest are disabled until one is unchecked.
    const goalBoxes = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="goals"]'));
    const goalCount = document.getElementById('cc-goals-count') as HTMLElement;
    const syncGoals = () => {
      const n = goalBoxes.filter((b) => b.checked).length;
      goalBoxes.forEach((b) => {
        b.disabled = n >= 3 && !b.checked;
        b.closest('.cc-opt')?.classList.toggle('cc-opt--off', b.disabled);
      });
      goalCount.textContent = `${n} of 3 selected.`;
    };
    goalBoxes.forEach((b) => b.addEventListener('change', syncGoals));
    syncGoals();

    const setErr = (id: string, msg: string) => {
      const el = form.querySelector<HTMLElement>(`.cc-err[data-for="${id}"]`);
      if (el) el.textContent = msg;
      const box = form.querySelector<HTMLElement>(`[data-field="${id}"]`);
      box?.classList.toggle('cc-bad', !!msg);
      document.getElementById(id)?.setAttribute('aria-invalid', msg ? 'true' : 'false');
    };
    const clearAll = () => {
      form.querySelectorAll<HTMLElement>('[data-field]').forEach((f) => setErr(f.dataset.field as string, ''));
      missing.textContent = '';
    };
    // Editing any answer clears the "still missing" message.
    form.addEventListener('input', () => { missing.textContent = ''; });
    form.addEventListener('change', () => { missing.textContent = ''; });

    const reduceMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
    const goTo = (id: string) => {
      const box = form.querySelector<HTMLElement>(`[data-field="${id}"]`) ?? document.getElementById(id);
      const focusEl = document.getElementById(id)?.matches('input,select,textarea')
        ? (document.getElementById(id) as HTMLElement)
        : box?.querySelector<HTMLElement>('input:not(:disabled)');
      box?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
      try { focusEl?.focus({ preventScroll: true }); } catch (_) { focusEl?.focus(); }
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      formError.hidden = true;
      clearAll();

      const email = val('cc-email');
      const phone = toE164(val('cc-phone'));
      const goals = checkedVals('goals');
      // Listed in page order so the first failure is the first one on screen.
      const checks: Array<[string, string]> = [
        ['cc-first', val('cc-first') ? '' : 'Please enter your first name.'],
        ['cc-last', val('cc-last') ? '' : 'Please enter your last name.'],
        ['cc-email', /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email) ? '' : 'Please enter a valid email address.'],
        ['cc-phone', phone ? '' : 'Please enter a valid mobile phone number.'],
        ['cc-city', val('cc-city') ? '' : 'Please enter your city and state.'],
        ['cc-household', radioVal('household') ? '' : 'Please choose who lives in your home.'],
        ['cc-partner', radioVal('partnerOnBoard') ? '' : 'Please choose one.'],
        ['cc-whofor', val('cc-whofor') ? '' : 'Please name the person you are doing this for.'],
        ['cc-goals', goals.length >= 1 && goals.length <= 3 ? '' : 'Please choose between 1 and 3.'],
        ['cc-why', val('cc-why') ? '' : 'Please tell us why now.'],
        ['cc-calls', radioVal('dailyCalls') ? '' : 'Please choose one.'],
        ['cc-start', val('cc-start') ? '' : 'Please choose when you would like to start.'],
        ['cc-commit', radioVal('commit') ? '' : 'Please choose one.'],
      ];
      let firstBad: string | null = null;
      for (const [id, msg] of checks) {
        setErr(id, msg);
        if (msg && !firstBad) firstBad = id;
      }
      if (firstBad) {
        missing.textContent = "A few answers are still missing. We've taken you to the first one.";
        goTo(firstBad);
        return;
      }

      const fields = {
        firstName: val('cc-first'),
        lastName: val('cc-last'),
        email,
        phone: phone as string,
        location: val('cc-city'),
        household: radioVal('household'),
        partnerOnBoard: radioVal('partnerOnBoard'),
        homeSpaces: checkedVals('homeSpaces'),
        homeOther: val('cc-other'),
        whoFor: val('cc-whofor'),
        goals,
        whyNow: val('cc-why'),
        dailyCalls: radioVal('dailyCalls'),
        start: val('cc-start'),
        commit: radioVal('commit'),
        heardFrom: val('cc-heard'),
      };

      submit.disabled = true;
      const relay = (async () => {
        try {
          const res = await fetch(API_BASE + '/api/contact-form', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ kind: 'form', formId: 'coaching-application', fields }),
          });
          return res.ok;
        } catch (_) {
          return false;
        }
      })();
      const [relayOk] = await Promise.all([relay, submitLead(email, 'coaching-application')]);
      submit.disabled = false;

      if (!relayOk) {
        formError.textContent = LEAD_CAPTURE_ERROR;
        formError.hidden = false;
        return; // keep what they typed
      }
      form.hidden = true;
      success.hidden = false;
      success.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
      (window as any).posthog?.capture?.('coaching_application_submitted');
    });
  }
</script>

<style>
.cc-hero {
  background:
    radial-gradient(ellipse at 50% 0%, rgba(212, 175, 90, 0.16) 0%, rgba(10, 22, 40, 0) 62%),
    linear-gradient(160deg, #102842 0%, #0a1628 55%, #050b16 100%);
  padding: 8rem 0 4.5rem;
  text-align: center;
}
.cc-hero-inner { max-width: 800px; }
.cc-hero h1 {
  font-family: 'Inter', sans-serif;
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  line-height: 1.4;
  color: rgba(212, 175, 90, 0.95);
  margin: 0 0 1rem;
}
.cc-headline {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem, 6vw, 3.4rem);
  font-weight: 700;
  line-height: 1.15;
  color: #fff;
  margin: 0 auto 1.25rem;
  text-wrap: balance;
}
.cc-tagline {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-size: clamp(1.05rem, 2.6vw, 1.3rem);
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.85);
  margin: 0 auto 2rem;
  max-width: 34rem;
}
.cc-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 1rem 2.2rem;
  border-radius: 40px;
  font-family: 'Inter', sans-serif;
  font-size: 1.05rem;
  font-weight: 700;
  text-decoration: none;
  border: 2px solid transparent;
  cursor: pointer;
  transition: transform 0.18s ease, background 0.18s ease;
}
.cc-btn--accent {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
  box-shadow: 0 10px 32px rgba(0, 184, 148, 0.35);
}
.cc-btn--accent:hover { background: var(--accent-dark); border-color: var(--accent-dark); transform: translateY(-2px); }
.cc-btn:disabled { opacity: 0.6; cursor: wait; transform: none; }

.cc-section { padding: 3.5rem 0; background: #fff; }
.cc-section--soft { background: var(--bg-soft); }
.cc-narrow { max-width: 720px; }
.cc-section h2, .cc-price h2 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.5rem, 4vw, 2rem);
  color: var(--dark);
  margin: 0 0 1.4rem;
}

.cc-steps { list-style: none; counter-reset: step; margin: 0; padding: 0; display: grid; gap: 1rem; }
.cc-steps li {
  counter-increment: step;
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 0.2rem 0 0.2rem 3.4rem;
  min-height: 2.6rem;
}
.cc-steps li::before {
  content: counter(step);
  position: absolute;
  left: 0;
  top: 0;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
  border: 2px solid #d4af5a;
  font-family: 'Playfair Display', serif;
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--dark);
  display: flex;
  align-items: center;
  justify-content: center;
}
.cc-step-title { font-weight: 700; color: var(--dark); font-size: 1.05rem; }
.cc-step-desc { color: var(--text-light); font-size: 0.95rem; }

.cc-two { display: grid; grid-template-columns: 1fr; gap: 2.5rem; max-width: 960px; }
.cc-reserve-lead { font-weight: 600; margin-bottom: 1rem; }
.cc-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
.cc-list li { position: relative; padding-left: 1.5rem; line-height: 1.6; color: var(--text); }
.cc-list li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0.62em;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent);
