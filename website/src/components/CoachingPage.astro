---
// /coaching page body (DRAFT — rendered only when SHOW_DRAFTS; see pages/coaching.astro).
// Copy source: docs/plan/beasley-reciprocal-and-coaching-2026-10-17.md
const steps = [
  { t: 'Apply', d: '5 minutes. This is by application only.' },
  { t: 'A private call with Dr. TJ', d: 'To see if it is a fit, for both of us.' },
  { t: 'Visit one: four days in your home', d: 'Sunday through Wednesday.' },
  { t: 'A call every day', d: 'For the rest of the month.' },
  { t: 'Visit two: three days in your home', d: 'Sunday through Tuesday, at the end of your first 30 days.' },
];
const visitOne = [
  'Genetic testing for how your body handles medications (PGx) and nutrients (NGx), plus a comprehensive lab panel',
  'Kitchen and pantry reset: out with the insulting foods, in with a stocked week',
  'Home environment set-up: light, sleep, air, water',
  'A workout program built for your body and your schedule',
  'Your morning routine, practiced until it sticks',
  "Cooking the week's meals together",
  'The book and the Logbook applied to your actual life',
];
const criteria = [
  'You are ready to change how you live, not just what you take.',
  'You will do the daily calls and the work between them.',
  'You and your household are open to me being in your home, ideally staying in your guest room.',
  'You can commit the first month in full.',
];
---
<section class="cc-hero">
  <div class="container cc-hero-inner">
    <h1>The Captain's Table</h1>
    <p class="cc-headline">Four seats. Your home. Your whole life.</p>
    <p class="cc-tagline">Don't lose your identity and your dignity while you still have a choice.</p>
    <a href="#apply" class="cc-btn cc-btn--accent">Apply for a seat</a>
  </div>
</section>

<section class="cc-section">
  <div class="container cc-narrow">
    <h2>What happens</h2>
    <ol class="cc-steps">
      {steps.map((s) => (
        <li>
          <span class="cc-step-title">{s.t}</span>
          <span class="cc-step-desc">{s.d}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="cc-section cc-section--soft">
  <div class="container cc-two">
    <div>
      <h2>Visit one: four days (Sunday&ndash;Wednesday)</h2>
      <ul class="cc-list">
        {visitOne.map((d) => <li>{d}</li>)}
      </ul>
    </div>
    <div>
      <h2>Between visits</h2>
      <p class="cc-after">A call every day; the My4MLife app, Logbook and weekly Zooms.</p>
    </div>
  </div>
</section>

<section class="cc-section">
  <div class="container cc-narrow">
    <h2>Visit two: three days (Sunday&ndash;Tuesday, end of month one)</h2>
    <p class="cc-after">We review your results and your labs together and work on whatever is still in the way at home; then your full-dose regenerative therapy (Genesis RPA), delivered by nasal atomizer, with Dr. TJ there to walk you through it. Approved by one of our network's licensed physicians, like every treatment we offer.</p>
  </div>
</section>

<section class="cc-section cc-section--soft">
  <div class="container cc-narrow">
    <h2>Why I stay in your home</h2>
    <p class="cc-after">The fastest way to change a life is to see it as it is lived. When I can, I stay in your guest room during visits, so I see the real morning, the real kitchen, the real evening. If that is not comfortable at first, we start without it; many people are ready by the second visit.</p>
  </div>
</section>

<section class="cc-section">
  <div class="container cc-narrow">
    <h2>Who this is for</h2>
    <ul class="cc-list">
      {criteria.map((d) => <li>{d}</li>)}
    </ul>
    <p class="cc-pull">Being able to pay is not enough. I choose people who are ready.</p>
  </div>
</section>

<section class="cc-price">
  <div class="container cc-narrow cc-price-inner">
    <h2>Price</h2>
    <p class="cc-amount"><span>$35,000</span> for the first month. Travel included.</p>
    <p class="cc-includes">Includes both visits, all testing and labs, daily calls, and your regenerative therapy.</p>
    <p class="cc-seats-note">Seats are limited to four at a time. If the table is full, you'll be first in line for the next opening.</p>
  </div>
</section>

<section class="cc-section" id="apply">
  <div class="container cc-form-wrap">
    <h2>Apply for a seat</h2>
    <form id="coaching-form" novalidate>
      <div class="cc-row">
        <div class="cc-field">
          <label for="cc-first">First name</label>
          <input type="text" id="cc-first" name="firstName" autocomplete="given-name" required />
          <span class="cc-err" data-for="cc-first" role="alert"></span>
        </div>
        <div class="cc-field">
          <label for="cc-last">Last name</label>
          <input type="text" id="cc-last" name="lastName" autocomplete="family-name" required />
          <span class="cc-err" data-for="cc-last" role="alert"></span>
        </div>
      </div>
      <div class="cc-row">
        <div class="cc-field">
          <label for="cc-email">Email</label>
          <input type="email" id="cc-email" name="email" autocomplete="email" required />
          <span class="cc-err" data-for="cc-email" role="alert"></span>
        </div>
        <div class="cc-field">
          <label for="cc-phone">Mobile phone</label>
          <input type="tel" id="cc-phone" name="phone" autocomplete="tel" inputmode="tel" required />
          <span class="cc-err" data-for="cc-phone" role="alert"></span>
        </div>
      </div>
      <div class="cc-field">
        <label for="cc-city">City and state</label>
        <input type="text" id="cc-city" name="location" autocomplete="address-level2" required />
        <span class="cc-err" data-for="cc-city" role="alert"></span>
      </div>
      <div class="cc-field">
        <label for="cc-change">What do you most want to change?</label>
        <textarea id="cc-change" name="change" rows="4" required></textarea>
        <span class="cc-err" data-for="cc-change" role="alert"></span>
      </div>
      <div class="cc-field">
        <label for="cc-start">When would you like to start?</label>
        <select id="cc-start" name="start" required>
          <option value="">Select one</option>
          <option>Next month</option>
          <option>Within 3 months</option>
          <option>Just exploring</option>
        </select>
        <span class="cc-err" data-for="cc-start" role="alert"></span>
      </div>
      <fieldset class="cc-field cc-radios" id="cc-guest" aria-describedby="cc-guest-err">
        <legend>Would your household be comfortable with Dr. TJ staying in your guest room during visits?</legend>
        <label class="cc-radio"><input type="radio" name="guestRoom" value="Yes" required /> <span>Yes</span></label>
        <label class="cc-radio"><input type="radio" name="guestRoom" value="After the first visit" /> <span>After the first visit</span></label>
        <label class="cc-radio"><input type="radio" name="guestRoom" value="No, I prefer he stays nearby" /> <span>No &mdash; prefer he stays nearby</span></label>
        <span class="cc-err" id="cc-guest-err" data-for="cc-guest" role="alert"></span>
      </fieldset>
      <div class="cc-field">
        <label for="cc-why">Why now?</label>
        <textarea id="cc-why" name="whyNow" rows="4" required></textarea>
        <span class="cc-err" data-for="cc-why" role="alert"></span>
      </div>
      <button type="submit" class="cc-btn cc-btn--accent cc-submit" id="cc-submit">Send my application</button>
      <p class="cc-form-error" id="cc-form-error" role="alert" hidden></p>
    </form>
    <div class="cc-success" id="cc-success" role="status" hidden>
      <h3>Thank you for applying. I read every application myself and will reach out personally within two business days. &mdash; Dr. TJ</h3>
    </div>
  </div>
</section>

<section class="cc-fine">
  <div class="container cc-narrow">
    <p>Coaching is lifestyle and education. Testing, labs and any prescription or regenerative therapy are ordered and approved by our network's licensed physicians.</p>
  </div>
</section>

<script>
  import { submitLead, LEAD_CAPTURE_ERROR } from '../scripts/lead-capture';

  const API_BASE: string =
    (import.meta as any).env?.PUBLIC_LEAD_CAPTURE_API_URL ??
    'https://v9svm8ds74.execute-api.us-east-2.amazonaws.com';

  function toE164(input: string): string | null {
    const raw = (input || '').trim();
    if (!raw) return null;
    const digits = raw.replace(/[^0-9]/g, '');
    if (raw.charAt(0) === '+') return digits.length >= 8 && digits.length <= 15 ? '+' + digits : null;
    if (digits.length === 10) return '+1' + digits;
    if (digits.length === 11 && digits.charAt(0) === '1') return '+' + digits;
    return null;
  }

  const form = document.getElementById('coaching-form') as HTMLFormElement | null;
  if (form) {
    const submit = document.getElementById('cc-submit') as HTMLButtonElement;
    const formError = document.getElementById('cc-form-error') as HTMLElement;
    const success = document.getElementById('cc-success') as HTMLElement;
    const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();
    const guestVal = () => (form.querySelector<HTMLInputElement>('input[name="guestRoom"]:checked')?.value ?? '');

    const setErr = (id: string, msg: string) => {
      const el = form.querySelector<HTMLElement>(`.cc-err[data-for="${id}"]`);
      if (el) el.textContent = msg;
      const target = document.getElementById(id);
      target?.setAttribute('aria-invalid', msg ? 'true' : 'false');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      formError.hidden = true;

      const email = val('cc-email');
      const phone = toE164(val('cc-phone'));
      const checks: Array<[string, string]> = [
        ['cc-first', val('cc-first') ? '' : 'Please enter your first name.'],
        ['cc-last', val('cc-last') ? '' : 'Please enter your last name.'],
        ['cc-email', /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email) ? '' : 'Please enter a valid email address.'],
        ['cc-phone', phone ? '' : 'Please enter a valid mobile phone number.'],
        ['cc-city', val('cc-city') ? '' : 'Please enter your city and state.'],
        ['cc-change', val('cc-change') ? '' : 'Please tell us what you most want to change.'],
        ['cc-start', val('cc-start') ? '' : 'Please choose when you would like to start.'],
        ['cc-guest', guestVal() ? '' : 'Please choose one.'],
        ['cc-why', val('cc-why') ? '' : 'Please tell us why now.'],
      ];
      let firstBad: string | null = null;
      for (const [id, msg] of checks) {
        setErr(id, msg);
        if (msg && !firstBad) firstBad = id;
      }
      if (firstBad) {
        if (firstBad === 'cc-guest') form.querySelector<HTMLInputElement>('input[name="guestRoom"]')?.focus();
        else document.getElementById(firstBad)?.focus();
        return;
      }

      const fields = {
        firstName: val('cc-first'),
        lastName: val('cc-last'),
        name: `${val('cc-first')} ${val('cc-last')}`,
        email,
        phone: phone as string,
        location: val('cc-city'),
        change: val('cc-change'),
        start: val('cc-start'),
        guestRoom: guestVal(),
        whyNow: val('cc-why'),
      };

      submit.disabled = true;
      const relay = (async () => {
        try {
          const res = await fetch(API_BASE + '/api/contact-form', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ kind: 'form', formId: 'coaching-application', fields }),
          });
          return res.ok;
        } catch (_) {
          return false;
        }
      })();
      const [relayOk] = await Promise.all([relay, submitLead(email, 'coaching-application')]);
      submit.disabled = false;

      if (!relayOk) {
        formError.textContent = LEAD_CAPTURE_ERROR;
        formError.hidden = false;
        return; // keep what they typed
      }
      form.hidden = true;
      success.hidden = false;
      success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      (window as any).posthog?.capture?.('coaching_application_submitted');
    });
  }
</script>

<style>
.cc-hero {
  background:
    radial-gradient(ellipse at 50% 0%, rgba(212, 175, 90, 0.16) 0%, rgba(10, 22, 40, 0) 62%),
    linear-gradient(160deg, #102842 0%, #0a1628 55%, #050b16 100%);
  padding: 8rem 0 4.5rem;
  text-align: center;
}
.cc-hero-inner { max-width: 800px; }
.cc-hero h1 {
  font-family: 'Inter', sans-serif;
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  line-height: 1.4;
  color: rgba(212, 175, 90, 0.95);
  margin: 0 0 1rem;
}
.cc-headline {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem, 6vw, 3.4rem);
  font-weight: 700;
  line-height: 1.15;
  color: #fff;
  margin: 0 auto 1.25rem;
  text-wrap: balance;
}
.cc-tagline {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-size: clamp(1.05rem, 2.6vw, 1.3rem);
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.85);
  margin: 0 auto 2rem;
  max-width: 34rem;
}
.cc-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 1rem 2.2rem;
  border-radius: 40px;
  font-family: 'Inter', sans-serif;
  font-size: 1.05rem;
  font-weight: 700;
  text-decoration: none;
  border: 2px solid transparent;
  cursor: pointer;
  transition: transform 0.18s ease, background 0.18s ease;
}
.cc-btn--accent {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
  box-shadow: 0 10px 32px rgba(0, 184, 148, 0.35);
}
.cc-btn--accent:hover { background: var(--accent-dark); border-color: var(--accent-dark); transform: translateY(-2px); }
.cc-btn:disabled { opacity: 0.6; cursor: wait; transform: none; }

.cc-section { padding: 3.5rem 0; background: #fff; }
.cc-section--soft { background: var(--bg-soft); }
.cc-narrow { max-width: 720px; }
.cc-section h2, .cc-price h2 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.5rem, 4vw, 2rem);
  color: var(--dark);
  margin: 0 0 1.4rem;
}

.cc-steps { list-style: none; counter-reset: step; margin: 0; padding: 0; display: grid; gap: 1rem; }
.cc-steps li {
  counter-increment: step;
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 0.2rem 0 0.2rem 3.4rem;
  min-height: 2.6rem;
}
.cc-steps li::before {
  content: counter(step);
  position: absolute;
  left: 0;
  top: 0;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
  border: 2px solid #d4af5a;
  font-family: 'Playfair Display', serif;
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--dark);
  display: flex;
  align-items: center;
  justify-content: center;
}
.cc-step-title { font-weight: 700; color: var(--dark); font-size: 1.05rem; }
.cc-step-desc { color: var(--text-light); font-size: 0.95rem; }

.cc-two { display: grid; grid-template-columns: 1fr; gap: 2.5rem; max-width: 960px; }
.cc-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
.cc-list li { position: relative; padding-left: 1.5rem; line-height: 1.6; color: var(--text); }
.cc-list li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0.62em;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent);
}
.cc-after { line-height: 1.7; color: var(--text); margin: 0; }
.cc-pull { font-family: 'Playfair Display', serif; font-style: italic; font-size: 1.2rem; line-height: 1.5; color: var(--dark); margin: 1.75rem 0 0; }

.cc-price {
  background: linear-gradient(160deg, #102842 0%, #0a1628 100%);
  padding: 3.5rem 0;
  text-align: center;
}
.cc-price h2 { color: rgba(212, 175, 90, 0.95); font-family: 'Inter', sans-serif; font-size: 0.78rem; letter-spacing: 0.18em; text-transform: uppercase; margin-bottom: 0.8rem; }
.cc-amount { font-family: 'Inter', sans-serif; color: rgba(255, 255, 255, 0.82); margin: 0 0 1.2rem; font-size: 1.05rem; }
.cc-amount span {
  display: block;
  font-family: 'Playfair Display', serif;
  font-size: clamp(2.6rem, 9vw, 3.8rem);
  font-weight: 700;
  line-height: 1.1;
  color: rgba(212, 175, 90, 0.98);
}
.cc-includes { color: rgba(255, 255, 255, 0.82); line-height: 1.7; max-width: 32rem; margin: 0 auto 1rem; }
.cc-seats-note { color: rgba(255, 255, 255, 0.78); line-height: 1.7; max-width: 32rem; margin: 0 auto; }

.cc-form-wrap { max-width: 680px; }
#coaching-form { display: block; }
.cc-row { display: grid; grid-template-columns: 1fr; gap: 0; }
.cc-field { margin-bottom: 1.1rem; }
.cc-field label { display: block; font-size: 0.85rem; font-weight: 600; color: var(--dark); margin-bottom: 0.4rem; }
.cc-field input, .cc-field select, .cc-field textarea {
  width: 100%;
  padding: 0.8rem 1rem;
  border: 1px solid var(--border);
  border-radius: 8px;
  font-family: 'Inter', sans-serif;
  font-size: 1rem;
  background: var(--bg-soft);
  color: var(--text);
  outline: none;
}
.cc-field input:focus, .cc-field select:focus, .cc-field textarea:focus { border-color: var(--accent); background: #fff; }
.cc-field [aria-invalid="true"] { border-color: #e74c3c; }
.cc-radios { border: 0; padding: 0; min-width: 0; }
.cc-radios legend { display: block; padding: 0; font-size: 0.85rem; font-weight: 600; color: var(--dark); margin-bottom: 0.6rem; line-height: 1.5; }
.cc-radios .cc-radio { display: flex; align-items: center; gap: 0.7rem; font-size: 1rem; font-weight: 400; color: var(--text); margin: 0 0 0.5rem; padding: 0.7rem 1rem; border: 1px solid var(--border); border-radius: 8px; background: var(--bg-soft); cursor: pointer; }
.cc-radios .cc-radio input { width: 1.15rem; height: 1.15rem; padding: 0; margin: 0; flex: 0 0 auto; accent-color: var(--accent); }
.cc-field textarea { resize: vertical; min-height: 120px; }
.cc-err { display: block; min-height: 0; color: #c0392b; font-size: 0.82rem; margin-top: 0.3rem; }
.cc-err:empty { display: none; }
.cc-submit { width: 100%; margin-top: 0.5rem; }
.cc-form-error { color: #c0392b; font-size: 0.95rem; margin: 0.9rem 0 0; text-align: center; }
.cc-success { text-align: center; padding: 2.5rem 1rem; border: 1px solid var(--border); border-top: 3px solid var(--accent); border-radius: 14px; background: var(--bg-accent); }
.cc-success h3 { font-family: 'Playfair Display', serif; font-size: 1.4rem; line-height: 1.4; color: var(--dark); margin: 0; }
.cc-fine { background: var(--bg-soft); border-top: 1px solid var(--border); padding: 1.75rem 0; }
.cc-fine p { font-size: 0.8rem; color: var(--text-light); line-height: 1.7; margin: 0; }

@media (min-width: 640px) {
  .cc-row { grid-template-columns: 1fr 1fr; gap: 1rem; }
  .cc-steps { grid-template-columns: 1fr 1fr; gap: 1.5rem 2rem; }
}
@media (min-width: 900px) {
  .cc-hero { padding: 10rem 0 5.5rem; }
  .cc-section { padding: 5rem 0; }
  .cc-two { grid-template-columns: 3fr 2fr; gap: 4rem; }
}
</style>
