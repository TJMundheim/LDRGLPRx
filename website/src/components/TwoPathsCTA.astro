---
interface Props {
  otcProductName: string;
  otcPrice?: string;
  otcDescription: string;
  otcCtaLabel?: string;
  otcCtaHref?: string;
  rxDescription: string;
  rxCtaHref?: string;
  whenOtc: string;
  whenRx: string;
  protegeFooter?: string;
}

const {
  otcProductName,
  otcPrice = 'Pricing finalizing',
  otcDescription,
  otcCtaLabel = 'Order →',
  otcCtaHref = '#',
  rxDescription,
  rxCtaHref = '/consult',
  whenOtc,
  whenRx,
  protegeFooter,
} = Astro.props;
---

<section id="solution" class="two-paths-section two-paths">
  <h2 class="two-paths-heading">Two paths to act — choose yours today</h2>

  <div class="two-paths-grid">
    <!-- OTC card -->
    <div class="path-card path-otc">
      <div class="path-badge">OTC · Start Today</div>
      <h3 class="path-product">{otcProductName}</h3>
      <p class="path-price">{otcPrice}</p>
      <p class="path-desc">{otcDescription}</p>
      <a href={otcCtaHref} class="path-btn otc-btn">{otcCtaLabel}</a>
    </div>

    <!-- Rx card -->
    <div class="path-card path-rx">
      <div class="path-badge rx-badge">Rx Protocol · Full Protocol</div>
      <h3 class="path-product">Comprehensive 4M Consult</h3>
      <p class="path-price">Telemedicine · Covered by consult fee</p>
      <p class="path-desc">{rxDescription}</p>
      <a href={rxCtaHref} class="path-btn rx-btn">Schedule Comprehensive 4M Consult →</a>
    </div>
  </div>

  <!-- When to choose which -->
  <div class="when-grid">
    <div class="when-col">
      <span class="when-label">Choose OTC if&hellip;</span>
      <p class="when-text">{whenOtc}</p>
    </div>
    <div class="when-divider" aria-hidden="true"></div>
    <div class="when-col">
      <span class="when-label">Choose Rx if&hellip;</span>
      <p class="when-text">{whenRx}</p>
    </div>
  </div>

  <!-- Protégé footer -->
  {protegeFooter && (
    <div class="protege-footer">
      <p>
        <a href="/assessment" class="protege-link">
          {protegeFooter}
        </a>
      </p>
    </div>
  )}

  <p class="why-matters-link">
    <a href="#why-matters">Read about why this matters &darr;</a>
  </p>
</section>

<style>
.two-paths {
  margin: 2.5rem 0;
}

.two-paths-heading {
  font-family: 'Playfair Display', serif;
  font-size: 1.5rem;
  color: var(--primary);
  margin-bottom: 1.5rem;
}

/* Two-card grid */
.two-paths-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
  margin-bottom: 1rem;
}

@media (max-width: 640px) {
  .two-paths-grid { grid-template-columns: 1fr; }
}

.path-card {
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 1.75rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  box-shadow: var(--shadow-sm);
}

.path-card.path-rx {
  border-color: var(--primary);
  border-width: 2px;
}

.path-badge {
  display: inline-block;
  font-family: 'Inter', sans-serif;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--accent);
  background: rgba(0,184,148,0.15);
  border: 1px solid rgba(0,184,148,0.4);
  padding: 0.2rem 0.65rem;
  border-radius: 999px;
  align-self: flex-start;
}

.rx-badge {
  color: #a78bfa;
  background: rgba(167,139,250,0.15);
  border-color: rgba(167,139,250,0.4);
}

.path-product {
  font-family: 'Playfair Display', serif;
  font-size: 1.15rem;
  color: var(--primary);
  margin: 0;
}

.path-price {
  font-family: 'Inter', sans-serif;
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--accent);
  margin: 0;
}

.path-desc {
  font-size: 0.9rem;
  color: var(--text-light);
  margin: 0.25rem 0 0.5rem;
  flex-grow: 1;
}

.path-btn {
  display: inline-block;
  padding: 0.65rem 1.4rem;
  border-radius: 999px;
  font-family: 'Inter', sans-serif;
  font-size: 0.875rem;
  font-weight: 600;
  text-decoration: none;
  text-align: center;
  margin-top: auto;
  transition: opacity 0.15s ease;
}
.path-btn:hover { opacity: 0.88; }

.otc-btn {
  background: var(--accent);
  color: #fff;
}

.rx-btn {
  background: #7c3aed;
  color: #fff;
}

/* When to choose which */
.when-grid {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 1rem;
  align-items: start;
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.25rem 1.5rem;
  margin-top: 1rem;
}

@media (max-width: 640px) {
  .when-grid {
    grid-template-columns: 1fr;
  }
  .when-divider { display: none; }
}

.when-col { display: flex; flex-direction: column; gap: 0.35rem; }

.when-label {
  font-family: 'Inter', sans-serif;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--accent);
}

.when-text {
  font-size: 0.88rem;
  color: var(--text);
  margin: 0;
  line-height: 1.5;
}

.when-divider {
  width: 1px;
  background: var(--border);
  align-self: stretch;
}

/* Protégé footer */
.protege-footer {
  margin-top: 1rem;
  background: rgba(0,184,148,0.07);
  border: 1px solid rgba(0,184,148,0.3);
  border-radius: var(--radius);
  padding: 0.85rem 1.25rem;
  text-align: center;
}

.protege-link {
  font-family: 'Inter', sans-serif;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--accent);
  text-decoration: none;
}
.protege-link:hover { text-decoration: underline; }

.why-matters-link {
  margin-top: 1.25rem;
  text-align: center;
}
.why-matters-link a {
  font-family: 'Inter', sans-serif;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--accent);
  text-decoration: none;
}
.why-matters-link a:hover { text-decoration: underline; }
</style>
