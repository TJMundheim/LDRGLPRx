---
// /partners body. Copy rules: buyer-facing name "Push Patch"; physicians never named; no emoji; no guaranteed results.
const steps = [
  { t: 'Apply', d: 'Tell us about your business. It takes about 3 minutes.' },
  { t: 'We set up your link and code', d: 'You choose the offer: your clients get $100 off and you earn $100 (most partners choose this; it sells more), or they get $50 off and you earn $150.' },
  { t: 'Your clients order through your link', d: 'A licensed physician in our network reviews every order, and the kit ships direct to them.' },
  { t: 'You earn $100 or $150 on every approved, paid order', d: 'Paid monthly.' },
];
const who = ['IV bars', 'Med spas', 'Facial and cosmetic spas', 'Salons', 'Gyms'];
const why = [
  'No needles.',
  'Slow delivery over 12 to 14 hours.',
  "Manufacturer's data: 276% more NAD+ exposure than daily 50 mg injections, and 163% more than a 500 mg weekly IV.*",
];
const faqs = [
  { q: 'Do I need a medical provider?', a: "No. Our network's licensed physicians review every order." },
  { q: 'Do I handle product?', a: 'No. Kits ship direct to your client. There is no inventory and nothing to store.' },
  { q: 'When do I get paid?', a: 'Monthly, by ACH. We need a W-9 from you before the first payout.' },
  { q: "What if an order isn't approved?", a: 'The client is refunded and no commission applies.' },
  { q: 'Can I make medical claims?', a: 'Please use our approved materials only. We send them with your link.' },
];
const types = ['IV bar', 'Med spa', 'Facial or cosmetic spa', 'Salon', 'Gym', 'Other'];
---
<section class="pn-hero">
  <div class="container pn-hero-inner">
    <h1>Earn up to $150 per order. No inventory. No provider needed.</h1>
    <p class="pn-sub">Offer your clients the Push Patch &mdash; needle-free peptides and NAD+, physician-reviewed, shipped to their door. You share your link; we handle the rest.</p>
    <a href="#apply" class="pn-btn">Apply to partner</a>
  </div>
</section>

<section class="pn-section">
  <div class="container pn-narrow">
    <h2>How it works</h2>
    <ol class="pn-steps">
      {steps.map((s) => (<li><span class="pn-step-title">{s.t}</span><span class="pn-step-desc">{s.d}</span></li>))}
    </ol>
  </div>
</section>

<section class="pn-section pn-soft">
  <div class="container pn-two">
    <div>
      <h2>Who it&rsquo;s for</h2>
      <ul class="pn-list">{who.map((w) => <li>{w}</li>)}</ul>
    </div>
    <div>
      <h2>Why clients like it</h2>
      <ul class="pn-list">{why.map((w) => <li>{w}</li>)}</ul>
      <p class="pn-fine">*Manufacturer&rsquo;s data. Results vary.</p>
    </div>
  </div>
</section>

<section class="pn-band">
  <div class="container pn-narrow"><p>Keep the drip. The patch is for the days in between.</p></div>
</section>

<section class="pn-section">
  <div class="container pn-narrow">
    <h2>Questions</h2>
    <dl class="pn-faq">
      {faqs.map((f) => (<div><dt>{f.q}</dt><dd>{f.a}</dd></div>))}
    </dl>
  </div>
</section>

<section class="pn-section pn-soft" id="apply">
  <div class="container pn-form-wrap">
    <h2>Apply to partner</h2>
    <p class="pn-intro">About 3 minutes. <span class="pn-req" aria-hidden="true">*</span> marks a required question. Dr. TJ reviews every application personally.</p>
    <form id="partner-form" novalidate>
      <fieldset class="pn-field pn-radios" data-field="pn-discount" data-radio="discount">
        <legend>Choose your offer. Give clients $100 off and earn $100, or give $50 off and earn $150. <span class="pn-req" aria-hidden="true">*</span></legend>
        <div class="pn-opts">
          <label class="pn-opt"><input type="radio" name="discount" value="$100" checked /> <span>$100 off for my clients (I earn $100)</span></label>
          <label class="pn-opt"><input type="radio" name="discount" value="$50" /> <span>$50 off for my clients (I earn $150)</span></label>
        </div>
        <span class="pn-err" data-for="pn-discount" role="alert"></span>
      </fieldset>
      <div class="pn-row">
        <div class="pn-field" data-field="pn-biz"><label for="pn-biz">Business name <span class="pn-req" aria-hidden="true">*</span></label><input type="text" id="pn-biz" name="businessName" autocomplete="organization" /><span class="pn-err" data-for="pn-biz" role="alert"></span></div>
        <div class="pn-field" data-field="pn-type"><label for="pn-type">Business type <span class="pn-req" aria-hidden="true">*</span></label>
          <select id="pn-type" name="businessType"><option value="">Select one</option>{types.map((t) => <option>{t}</option>)}</select><span class="pn-err" data-for="pn-type" role="alert"></span></div>
      </div>
      <div class="pn-row">
        <div class="pn-field" data-field="pn-city"><label for="pn-city">City <span class="pn-req" aria-hidden="true">*</span></label><input type="text" id="pn-city" name="city" autocomplete="address-level2" /><span class="pn-err" data-for="pn-city" role="alert"></span></div>
        <div class="pn-field" data-field="pn-state"><label for="pn-state">State <span class="pn-req" aria-hidden="true">*</span></label><input type="text" id="pn-state" name="state" autocomplete="address-level1" /><span class="pn-err" data-for="pn-state" role="alert"></span></div>
      </div>
      <div class="pn-field" data-field="pn-name"><label for="pn-name">Contact name <span class="pn-req" aria-hidden="true">*</span></label><input type="text" id="pn-name" name="name" autocomplete="name" /><span class="pn-err" data-for="pn-name" role="alert"></span></div>
      <div class="pn-row">
        <div class="pn-field" data-field="pn-email"><label for="pn-email">Email <span class="pn-req" aria-hidden="true">*</span></label><input type="email" id="pn-email" name="email" autocomplete="email" /><span class="pn-err" data-for="pn-email" role="alert"></span></div>
        <div class="pn-field" data-field="pn-phone"><label for="pn-phone">Phone <span class="pn-req" aria-hidden="true">*</span></label><input type="tel" id="pn-phone" name="phone" autocomplete="tel" inputmode="tel" /><span class="pn-err" data-for="pn-phone" role="alert"></span></div>
      </div>
      <div class="pn-row">
        <div class="pn-field" data-field="pn-web"><label for="pn-web">Website</label><input type="text" id="pn-web" name="website" autocomplete="url" /></div>
        <div class="pn-field" data-field="pn-clients"><label for="pn-clients">Approximate clients per month</label><input type="text" id="pn-clients" name="clientsPerMonth" inputmode="numeric" /></div>
      </div>
      <fieldset class="pn-field pn-radios" data-field="pn-offers" data-radio="offers">
        <legend>Do you offer peptides or NAD+ today? <span class="pn-req" aria-hidden="true">*</span></legend>
        <div class="pn-opts">
          <label class="pn-opt"><input type="radio" name="offers" value="Yes" /> <span>Yes</span></label>
          <label class="pn-opt"><input type="radio" name="offers" value="No" /> <span>No</span></label>
        </div>
        <span class="pn-err" data-for="pn-offers" role="alert"></span>
      </fieldset>
      <div class="pn-field"><label for="pn-notes">Anything else we should know?</label><textarea id="pn-notes" name="notes" rows="3"></textarea></div>
      <p class="pn-missing" id="pn-missing" role="alert"></p>
      <button type="submit" class="pn-btn pn-submit" id="pn-submit">Send my application</button>
      <p class="pn-form-error" id="pn-form-error" role="alert" hidden></p>
    </form>
    <div class="pn-success" id="pn-success" role="status" hidden>
      <h3>Thank you for applying. I review every partner personally. Within two business days you will get your link, your code, a counter card and a one-page guide. A confirmation is on its way to your inbox. &mdash; Dr. TJ</h3>
    </div>
  </div>
</section>

<section class="pn-fine-band">
  <div class="container pn-narrow">
    <p>My4MLife is not a medical provider. Every Push Patch order is reviewed by one of our network&rsquo;s licensed physicians, and orders that are not approved are refunded. Partners use approved materials only and make no medical claims. Results vary.</p>
  </div>
</section>

<script>
  import { attachHoneypot, botFields, LEAD_CAPTURE_ERROR } from '../scripts/lead-capture';

  const API_BASE: string =
    (import.meta as any).env?.PUBLIC_LEAD_CAPTURE_API_URL ??
    'https://v9svm8ds74.execute-api.us-east-2.amazonaws.com';

  function toE164(input: string): string | null {
    const raw = (input || '').trim();
    const digits = raw.replace(/[^0-9]/g, '');
    if (raw.charAt(0) === '+') return digits.length >= 8 && digits.length <= 15 ? '+' + digits : null;
    if (digits.length === 10) return '+1' + digits;
    if (digits.length === 11 && digits.charAt(0) === '1') return '+' + digits;
    return null;
  }

  const form = document.getElementById('partner-form') as HTMLFormElement | null;
  if (form) {
    attachHoneypot(form);
    const submit = document.getElementById('pn-submit') as HTMLButtonElement;
    const formError = document.getElementById('pn-form-error') as HTMLElement;
    const missing = document.getElementById('pn-missing') as HTMLElement;
    const success = document.getElementById('pn-success') as HTMLElement;
    const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();
    const radioVal = (name: string) => form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? '';

    const setErr = (id: string, msg: string) => {
      const el = form.querySelector<HTMLElement>(`.pn-err[data-for="${id}"]`);
      if (el) el.textContent = msg;
      form.querySelector<HTMLElement>(`[data-field="${id}"]`)?.classList.toggle('pn-bad', !!msg);
    };
    form.addEventListener('input', () => { missing.textContent = ''; });
    form.addEventListener('change', () => { missing.textContent = ''; });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      formError.hidden = true;
      const email = val('pn-email');
      const phone = toE164(val('pn-phone'));
      const checks: Array<[string, string]> = [
        ['pn-discount', radioVal('discount') ? '' : 'Please choose $50 or $100 off for your clients.'],
        ['pn-biz', val('pn-biz') ? '' : 'Please enter your business name.'],
        ['pn-type', val('pn-type') ? '' : 'Please choose your business type.'],
        ['pn-city', val('pn-city') ? '' : 'Please enter your city.'],
        ['pn-state', val('pn-state') ? '' : 'Please enter your state.'],
        ['pn-name', val('pn-name') ? '' : 'Please enter a contact name.'],
        ['pn-email', /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email) ? '' : 'Please enter a valid email address.'],
        ['pn-phone', phone ? '' : 'Please enter a valid phone number.'],
        ['pn-offers', radioVal('offers') ? '' : 'Please choose one.'],
      ];
      let firstBad: string | null = null;
      for (const [id, msg] of checks) { setErr(id, msg); if (msg && !firstBad) firstBad = id; }
      if (firstBad) {
        missing.textContent = "A few answers are still missing. We've taken you to the first one.";
        const box = form.querySelector<HTMLElement>(`[data-field="${firstBad}"]`);
        box?.scrollIntoView({ block: 'center' });
        box?.querySelector<HTMLElement>('input,select')?.focus({ preventScroll: true });
        return;
      }

      const { hp, t } = botFields(form);
      const fields = {
        discount: radioVal('discount'),
        businessName: val('pn-biz'),
        businessType: val('pn-type'),
        city: val('pn-city'),
        state: val('pn-state'),
        name: val('pn-name'),
        email,
        phone: phone as string,
        website: val('pn-web'),
        clientsPerMonth: val('pn-clients'),
        offersPeptidesOrNad: radioVal('offers'),
        notes: val('pn-notes'),
        hp,
        t,
      };

      submit.disabled = true;
      let ok = false;
      try {
        const res = await fetch(API_BASE + '/api/contact-form', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ kind: 'form', formId: 'partner-application', fields }),
        });
        ok = res.ok;
      } catch (_) { ok = false; }
      submit.disabled = false;

      if (!ok) {
        formError.textContent = LEAD_CAPTURE_ERROR;
        formError.hidden = false;
        return; // keep what they typed
      }
      form.hidden = true;
      success.hidden = false;
      success.scrollIntoView({ block: 'center' });
      (window as any).posthog?.capture?.('partner_application_submitted');
    });
  }
</script>

<style>
.pn-hero { background: linear-gradient(160deg, #102842 0%, #0a1628 55%, #050b16 100%); padding: 8rem 0 4.5rem; text-align: center; }
.pn-hero-inner { max-width: 820px; }
.pn-hero h1 { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 6vw, 3.3rem); font-weight: 700; line-height: 1.15; color: #fff; margin: 0 auto 1.25rem; text-wrap: balance; }
.pn-sub { font-size: clamp(1rem, 2.4vw, 1.2rem); line-height: 1.6; color: rgba(255, 255, 255, 0.85); margin: 0 auto 2rem; max-width: 38rem; }
.pn-btn { display: inline-flex; align-items: center; justify-content: center; padding: 1rem 2.2rem; border-radius: 40px; font-family: 'Inter', sans-serif; font-size: 1.05rem; font-weight: 700; text-decoration: none; border: 2px solid var(--accent); background: var(--accent); color: #fff; cursor: pointer; box-shadow: 0 10px 32px rgba(0, 184, 148, 0.35); transition: transform 0.18s ease, background 0.18s ease; }
.pn-btn:hover { background: var(--accent-dark); border-color: var(--accent-dark); transform: translateY(-2px); }
.pn-btn:disabled { opacity: 0.6; cursor: wait; transform: none; }
.pn-section { padding: 3.5rem 0; background: #fff; }
.pn-soft { background: var(--bg-soft); }
.pn-narrow { max-width: 720px; }
.pn-section h2 { font-family: 'Playfair Display', serif; font-size: clamp(1.5rem, 4vw, 2rem); color: var(--dark); margin: 0 0 1.4rem; }
.pn-steps { list-style: none; counter-reset: step; margin: 0; padding: 0; display: grid; gap: 1.2rem; }
.pn-steps li { counter-increment: step; position: relative; display: flex; flex-direction: column; padding: 0.2rem 0 0.2rem 3.4rem; min-height: 2.6rem; }
.pn-steps li::before { content: counter(step); position: absolute; left: 0; top: 0; width: 2.5rem; height: 2.5rem; border-radius: 50%; border: 2px solid var(--accent); font-family: 'Playfair Display', serif; font-size: 1.15rem; font-weight: 700; color: var(--dark); display: flex; align-items: center; justify-content: center; }
.pn-step-title { font-weight: 700; color: var(--dark); font-size: 1.05rem; }
.pn-step-desc { color: var(--text-light); font-size: 0.95rem; }
.pn-two { display: grid; grid-template-columns: 1fr; gap: 2.5rem; max-width: 960px; }
.pn-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
.pn-list li { position: relative; padding-left: 1.5rem; line-height: 1.6; color: var(--text); }
.pn-list li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
.pn-fine { font-size: 0.8rem; color: var(--text-light); margin: 1rem 0 0; }
.pn-band { background: linear-gradient(160deg, #102842 0%, #0a1628 100%); padding: 3rem 0; text-align: center; }
.pn-band p { font-family: 'Playfair Display', serif; font-style: italic; font-size: clamp(1.3rem, 4vw, 1.9rem); color: #fff; margin: 0; }
.pn-faq { margin: 0; display: grid; gap: 1.4rem; }
.pn-faq dt { font-weight: 700; color: var(--dark); margin-bottom: 0.3rem; }
.pn-faq dd { margin: 0; line-height: 1.7; color: var(--text); }
.pn-form-wrap { max-width: 680px; }
.pn-intro { color: var(--text-light); font-size: 0.95rem; line-height: 1.6; margin: -0.6rem 0 1.75rem; }
.pn-row { display: grid; grid-template-columns: 1fr; gap: 0; }
.pn-field { margin-bottom: 1.1rem; }
.pn-field label { display: block; font-size: 0.85rem; font-weight: 600; color: var(--dark); margin-bottom: 0.4rem; }
.pn-field input[type="text"], .pn-field input[type="email"], .pn-field input[type="tel"], .pn-field select, .pn-field textarea { width: 100%; min-height: 44px; padding: 0.8rem 1rem; border: 1px solid var(--border); border-radius: 8px; font-family: 'Inter', sans-serif; font-size: 1rem; background: #fff; color: var(--text); outline: none; }
.pn-field input:focus, .pn-field select:focus, .pn-field textarea:focus { border-color: var(--accent); }
.pn-field textarea { resize: vertical; min-height: 90px; }
.pn-radios { border: 0; padding: 0; min-width: 0; }
.pn-radios legend { display: block; padding: 0; font-size: 0.85rem; font-weight: 600; color: var(--dark); margin-bottom: 0.6rem; line-height: 1.5; }
.pn-opts { display: grid; grid-template-columns: 1fr; gap: 0.5rem; }
.pn-radios .pn-opt { display: flex; align-items: center; gap: 0.7rem; min-height: 44px; font-size: 1rem; font-weight: 400; margin: 0; padding: 0.6rem 1rem; border: 1px solid var(--border); border-radius: 8px; background: #fff; cursor: pointer; }
.pn-radios .pn-opt input { width: 1.15rem; height: 1.15rem; margin: 0; accent-color: var(--accent); }
.pn-req { color: #c0392b; font-weight: 700; }
.pn-err { display: block; color: #c0392b; font-size: 0.82rem; margin-top: 0.3rem; }
.pn-err:empty { display: none; }
.pn-bad input, .pn-bad select, .pn-bad .pn-opt { border-color: #e74c3c; }
.pn-missing { margin: 0 0 0.9rem; padding: 0.7rem 0.9rem; font-weight: 700; color: #c0392b; text-align: center; background: rgba(231, 76, 60, 0.08); border: 1px solid #e74c3c; border-radius: 8px; }
.pn-missing:empty { display: none; }
.pn-submit { width: 100%; margin-top: 0.5rem; }
.pn-form-error { color: #c0392b; font-size: 0.95rem; margin: 0.9rem 0 0; text-align: center; }
.pn-success { text-align: center; padding: 2.5rem 1rem; border: 1px solid var(--border); border-top: 3px solid var(--accent); border-radius: 14px; background: #fff; }
.pn-success h3 { font-family: 'Playfair Display', serif; font-size: 1.3rem; line-height: 1.5; color: var(--dark); margin: 0; }
.pn-fine-band { background: var(--bg-soft); border-top: 1px solid var(--border); padding: 1.75rem 0; }
.pn-fine-band p { font-size: 0.8rem; color: var(--text-light); line-height: 1.7; margin: 0; }
@media (min-width: 640px) {
  .pn-row { grid-template-columns: 1fr 1fr; gap: 1rem; }
  .pn-steps { grid-template-columns: 1fr 1fr; gap: 1.5rem 2rem; }
}
@media (min-width: 900px) {
  .pn-hero { padding: 10rem 0 5.5rem; }
  .pn-section { padding: 5rem 0; }
  .pn-two { grid-template-columns: 1fr 1fr; gap: 4rem; }
}
</style>
