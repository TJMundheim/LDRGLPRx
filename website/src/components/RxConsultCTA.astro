---
// Rx-pathway consult CTA — for categories where the only legitimate path is
// a prescriber-supervised protocol (GLP-1, Testosterone, ED, Peptides,
// Regenerative). Single CTA: schedule a consult.

interface Props {
  category: string;       // e.g. "Testosterone Therapy"
  whyConsult: string;     // one-sentence reason this is consult-only
}

const { category, whyConsult } = Astro.props as Props;
const consultUrl = `/consult?category=${encodeURIComponent(category)}`;
---

<aside class="rx-consult-cta">
  <p class="rx-consult-eyebrow">Rx Pathway</p>
  <h3 class="rx-consult-title">{category} requires a physician.</h3>
  <p class="rx-consult-body">
    {whyConsult} Schedule a consult with one of our care coordinators
    and they'll connect you with a physician in our network for full intake,
    lab review, candidacy assessment, and protocol design.
  </p>
  <a href={consultUrl} class="rx-consult-primary">Schedule a Consult →</a>
</aside>

<style>
.rx-consult-cta {
  background: linear-gradient(135deg, rgba(26,54,93,0.06) 0%, rgba(0,184,148,0.07) 100%);
  border: 1px solid var(--border, #e5e7eb);
  border-left: 4px solid var(--primary, #1a365d);
  border-radius: var(--radius, 12px);
  padding: 1.5rem 1.6rem;
  margin: 1.75rem 0 2rem;
}
.rx-consult-eyebrow {
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--primary, #1a365d);
  margin: 0 0 0.4rem;
}
.rx-consult-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.3rem;
  color: var(--primary, #1a365d);
  margin: 0 0 0.6rem;
  line-height: 1.25;
}
.rx-consult-body {
  font-size: 0.95rem;
  color: var(--text);
  line-height: 1.6;
  margin: 0 0 1rem;
}
.rx-consult-primary {
  display: inline-block;
  padding: 0.7rem 1.4rem;
  background: var(--accent, #00b894);
  color: #fff;
  border-radius: 999px;
  font-size: 0.92rem;
  font-weight: 700;
  text-decoration: none;
  transition: background 0.15s, transform 0.15s;
}
.rx-consult-primary:hover {
  background: var(--accent-dark, #00a381);
  transform: translateY(-1px);
}
</style>
