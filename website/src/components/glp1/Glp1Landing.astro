---
// LANDING PAGE — GLP-1 direct buy (/go/glp-1). Copy of the Push Patch flow: Buy → safety check → health form
// + typed signature → POST /api/push-patch-pre-intake {lane:'glp1'} → Stripe Checkout. No partner refs, no promo codes.
// Data: src/data/glp1.ts, src/data/screening.ts. Private $2 test link (?t=<token>) handled below.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GLP1_PRODUCTS, GLP1_PRICE_USD, GLP1_CONDITIONS, GLP1_SAFETY_HISTORY, GLP1_INTERACTING_MEDS } from '../../data/glp1';
import { SCREENING } from '../../data/screening';

const title = 'Lose weight with a GLP-1 — My4MLife';
const description = 'Semaglutide, tirzepatide or GLP-3 (Reta), prescribed after review by our network’s licensed physicians. $375 for one month, any dose.';
const canonical = 'https://www.my4mlife.com/go/glp-1';
const API_BASE = import.meta.env.PUBLIC_LEAD_CAPTURE_API_URL ?? 'https://v9svm8ds74.execute-api.us-east-2.amazonaws.com';
const SCREEN = SCREENING['glp1'];
const BENEFITS: Record<string, string> = {
  'glp1-sema': 'The most widely used GLP-1. Weekly injection that helps quiet appetite and slow the urge to snack.',
  'glp1-tirzep': 'A dual-action GLP-1 and GIP medicine, taken weekly, studied for larger average weight loss.',
  'glp1-reta': 'A triple-action medicine, taken weekly, that physicians are watching closely for weight loss.',
};
---
<BaseLayout title={title} description={description} canonical={canonical} robots="noindex,follow" hideChrome={true}>

<Fragment slot="head">
  {/* Private $2 test link (?t=<token>): kept in memory + sessionStorage, scrubbed from the address bar, sent only in the checkout POST body. */}
  <script is:inline>
  (function () {
    try {
      var u = new URL(location.href), t = u.searchParams.get('t');
      if (t) {
        window.__ppT = t;
        try { sessionStorage.setItem('pp_t', t); } catch (e) {}
        u.searchParams.delete('t');
        history.replaceState(null, '', u.pathname + u.search + u.hash);
      } else {
        try { window.__ppT = sessionStorage.getItem('pp_t') || undefined; } catch (e) {}
      }
    } catch (e) {}
  })();
  </script>
</Fragment>

<div class="g1" id="g1-root" data-api={API_BASE}>
  <header class="g1-top"><a class="g1-mark" href="/">My<b>4M</b>Life</a></header>

  <section class="g1-hero">
    <div class="g1-wrap">
      <h1>Lose the weight with a GLP-1. <span>Prescribed by our network&rsquo;s licensed physicians.</span></h1>
      <p class="g1-sub">Choose your medicine, answer a short health form, and one of our network&rsquo;s licensed physicians reviews it. If you are approved, your medicine is prepared for you. If not, you are refunded.</p>
      <ul class="g1-chips"><li>${GLP1_PRICE_USD} a month at any dose</li><li>Physician-reviewed</li><li>No visit to a clinic</li></ul>
    </div>
  </section>

  <section class="g1-sec" id="products">
    <div class="g1-wrap">
      <h2>Choose your GLP-1</h2>
      <p class="g1-lead">${GLP1_PRICE_USD} for one month, any dose. Your physician picks the dose that fits you.</p>
      <div class="g1-auto">
        <label class="g1-check"><input type="checkbox" id="g1-autoship" /> <span>Auto-ship every 4 weeks. Skip or cancel any time.</span></label>
      </div>
      <div class="g1-cards" id="g1-grid">
        {GLP1_PRODUCTS.map((p) => (
          <article class="g1-card">
            <div class="g1-card-top"><h3>{p.name}</h3><span class="g1-price">${GLP1_PRICE_USD}</span></div>
            <p class="g1-benefit">{BENEFITS[p.skuId]}</p>
            <p class="g1-term">1 month, any dose</p>
            <button type="button" class="g1-cta g1-buy" data-sku={p.skuId} data-label={p.name}>Buy {p.short}</button>
          </article>
        ))}
      </div>
      <p class="g1-fine">Prescription medicine is provided only if one of our network&rsquo;s licensed physicians decides it is right for you. If you are not cleared before anything ships, your payment is refunded in full.</p>
    </div>
  </section>

  <footer class="g1-foot">
    <div class="g1-wrap">
      <p class="g1-legal"><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href="/">my4mlife.com</a> · We use cookies for site analytics.</p>
    </div>
  </footer>

  <dialog class="g1-modal" id="g1-dlg" aria-labelledby="g1-screen-title">
    <div class="g1-box">
      <button type="button" class="g1-x" id="g1-x" aria-label="Close">&times;</button>

      <form id="g1-screen" class="g1-form" novalidate>
        <div class="g1-scroll">
          <h2 id="g1-screen-title">Quick safety check</h2>
          <p class="g1-intro">Answer all {SCREEN.knockouts.length} questions. It takes about 30 seconds.</p>
          {SCREEN.siteNote && <p class="g1-note">{SCREEN.siteNote}</p>}
          {SCREEN.knockouts.map((q, i) => (
            <fieldset class="g1-q" data-id={q.id}>
              <legend><span class="g1-qn">{i + 1}.</span> {q.question}</legend>
              <div class="g1-opts">
                <label><input type="radio" name={`g1-${q.id}`} value="yes" /> Yes</label>
                <label><input type="radio" name={`g1-${q.id}`} value="no" /> No</label>
              </div>
            </fieldset>
          ))}
        </div>
        <div class="g1-foot-bar">
          <p class="g1-err" id="g1-screen-err" role="alert"></p>
          <p class="g1-confirm">By continuing, I confirm my answers are accurate.</p>
          <button type="submit" class="g1-cta g1-go">Continue</button>
        </div>
      </form>

      <form id="g1-health" class="g1-form" novalidate hidden>
        <div class="g1-scroll">
          <h2 id="g1-health-title" tabindex="-1">Your health questions</h2>
          <p class="g1-intro">About 3 minutes. After you pay, one of our network&rsquo;s licensed physicians reviews your answers during business hours, 9 a.m. to 5 p.m. Central. If you are not cleared, your payment is refunded.</p>
          <p class="g1-help">Your answers go only to the reviewing physician and your care record. They are never sent by text message or shown on a receipt.</p>

          <div class="g1-row">
            <div class="g1-f"><label for="g1-first">First name</label><input id="g1-first" type="text" autocomplete="given-name" /><p class="g1-fe" data-e="first"></p></div>
            <div class="g1-f"><label for="g1-last">Last name</label><input id="g1-last" type="text" autocomplete="family-name" /><p class="g1-fe" data-e="last"></p></div>
          </div>
          <div class="g1-f"><label for="g1-email">Email</label><input id="g1-email" type="email" autocomplete="email" inputmode="email" /><p class="g1-help">Your receipt and the physician&rsquo;s decision are sent here.</p><p class="g1-fe" data-e="email"></p></div>
          <div class="g1-f"><label for="g1-phone">Mobile phone</label><input id="g1-phone" type="tel" autocomplete="tel" inputmode="tel" /><p class="g1-help">Used only if the physician needs to reach you. We never text health information.</p><p class="g1-fe" data-e="phone"></p></div>

          <div class="g1-row">
            <div class="g1-f"><label for="g1-dob">Date of birth</label><input id="g1-dob" type="date" autocomplete="bday" /><p class="g1-fe" data-e="dob"></p></div>
            <div class="g1-f"><label for="g1-sex">Sex</label>
              <select id="g1-sex"><option value="">Select</option><option value="female">Female</option><option value="male">Male</option></select>
              <p class="g1-fe" data-e="sex"></p></div>
          </div>
          <div class="g1-row g1-row3">
            <div class="g1-f"><label for="g1-ft">Height (ft)</label><input id="g1-ft" type="number" inputmode="numeric" min="3" max="8" /><p class="g1-fe" data-e="ft"></p></div>
            <div class="g1-f"><label for="g1-in">Height (in)</label><input id="g1-in" type="number" inputmode="numeric" min="0" max="11" /><p class="g1-fe" data-e="in"></p></div>
            <div class="g1-f"><label for="g1-wt">Weight (lb)</label><input id="g1-wt" type="number" inputmode="numeric" min="60" max="800" /><p class="g1-fe" data-e="wt"></p></div>
          </div>
          <div class="g1-f"><label for="g1-goal">Goal weight in lb (optional)</label><input id="g1-goal" type="number" inputmode="numeric" min="60" max="800" /><p class="g1-fe" data-e="goal"></p></div>

          <fieldset class="g1-grp" id="g1-conditions"><legend>Do you have any of these conditions?</legend>
            {GLP1_CONDITIONS.map((o) => <label class="g1-check"><input type="checkbox" value={o.id} /> <span>{o.label}</span></label>)}
            <p class="g1-fe" data-e="conditions"></p></fieldset>

          <fieldset class="g1-grp" id="g1-safety"><legend>Have you ever had any of these?</legend>
            {GLP1_SAFETY_HISTORY.map((o) => <label class="g1-check"><input type="checkbox" value={o.id} /> <span>{o.label}</span></label>)}
            <p class="g1-fe" data-e="safety"></p></fieldset>

          <div class="g1-f"><label for="g1-prior">Have you used a GLP-1 medicine before?</label>
            <select id="g1-prior"><option value="">Select</option><option value="never">Never</option><option value="current">Yes, I am taking one now</option><option value="past">Yes, in the past</option></select>
            <p class="g1-fe" data-e="prior"></p></div>
          <div id="g1-prior-more" hidden>
            <div class="g1-f"><label for="g1-pdrug">Which medicine?</label><input id="g1-pdrug" type="text" /><p class="g1-fe" data-e="pdrug"></p></div>
            <div class="g1-f"><label for="g1-pdose">Your last dose</label><input id="g1-pdose" type="text" placeholder="For example 1 mg weekly" /><p class="g1-fe" data-e="pdose"></p></div>
          </div>

          <fieldset class="g1-grp" id="g1-meds"><legend>Do you take any of these?</legend>
            {GLP1_INTERACTING_MEDS.map((o) => <label class="g1-check"><input type="checkbox" value={o.id} /> <span>{o.label}</span></label>)}
            <p class="g1-fe" data-e="meds"></p></fieldset>

          <div class="g1-f"><label for="g1-other">Other medications and supplements</label><textarea id="g1-other" rows="2"></textarea><p class="g1-help">Write &ldquo;None&rdquo; if none.</p><p class="g1-fe" data-e="other"></p></div>
          <div class="g1-f"><label for="g1-allergies">Allergies</label><textarea id="g1-allergies" rows="2"></textarea><p class="g1-help">Write &ldquo;None&rdquo; if none.</p><p class="g1-fe" data-e="allergies"></p></div>

          <h3>Telehealth consent</h3>
          <div class="g1-consent" tabindex="0" role="region" aria-label="Telehealth consent text">
            <p>By signing below, I consent to an asynchronous telehealth review of my order. One of our network&rsquo;s licensed physicians will review the health information I submit here, without a live video or phone visit, and decide whether a GLP-1 medicine is appropriate for me. I understand this review cannot include a physical exam, depends on my answers being complete and truthful, and that the physician may decide I am not cleared. If I am not cleared before anything is ordered for me, my payment is refunded. I agree to give accurate information about my medications, allergies, conditions and screening answers, and to tell my physician about any change in my health. Telehealth is not for emergencies; in a medical emergency I will call 911. I may withdraw this consent at any time without affecting my right to future care. My health information is handled under the My4MLife Privacy Policy and applicable privacy law. I authorize My4MLife and our network&rsquo;s licensed physicians to share my name, shipping address and phone number with the pharmacy partner that fills my order. I am of legal adult age and a resident of the United States.</p>
          </div>
          <p class="g1-help">Read the <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>.</p>
          <div class="g1-f"><label class="g1-check"><input type="checkbox" id="g1-privacy" /> <span>I acknowledge the <a href="/legal/privacy-notice" target="_blank" rel="noopener">Notice of Privacy Practices</a> and sign the <a href="/legal/authorization" target="_blank" rel="noopener">Authorization</a> to share my health information with our network&rsquo;s licensed physicians and pharmacy partner.</span></label><p class="g1-fe" data-e="privacy"></p></div>
          <div class="g1-f"><label for="g1-sign">Type your full legal name to sign</label><input id="g1-sign" type="text" autocomplete="name" /><p class="g1-help">This works as your signature for the consent, the privacy notice and the authorization. Today&rsquo;s date is recorded automatically.</p><p class="g1-fe" data-e="sign"></p></div>
        </div>
        <div class="g1-foot-bar">
          <p class="g1-missing" id="g1-missing" role="alert"></p>
          <p class="g1-err" id="g1-health-err" role="alert"></p>
          <button type="submit" class="g1-cta g1-go" id="g1-pay">Continue to payment</button>
          <button type="button" class="g1-link" id="g1-back">Back to safety check</button>
        </div>
      </form>

      <div id="g1-stop" class="g1-stop" role="alert" hidden>
        <h2>A GLP-1 isn&rsquo;t the right fit for you right now.</h2>
        <p>Based on your answers, we can&rsquo;t offer this medicine online. Please talk with your own doctor about the best options for you.</p>
        <button type="button" class="g1-link" id="g1-stop-back">Change my answers</button>
      </div>
    </div>
  </dialog>
</div>

<script>
  import { failedKnockouts, buildGlp1Body, GLP1_LANE } from '../../data/glp1';
  import type { Glp1Health } from '../../data/glp1';

  const root = document.getElementById('g1-root') as HTMLElement;
  const API = root.dataset.api as string;
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const dlg = $<HTMLDialogElement>('g1-dlg');
  const screen = $<HTMLFormElement>('g1-screen');
  const health = $<HTMLFormElement>('g1-health');
  const stop = $('g1-stop');
  const GENERIC = 'We could not open checkout. Please try again in a moment.';
  let cur: { btn: HTMLElement; skuId: string } | null = null;
  let answers: Record<string, boolean> | null = null;
  let busy = false;

  const track = (n: string, p?: object) => { try { (window as any).posthog?.capture(n, p); } catch { /* analytics only */ } };
  track('lp_glp1_view');

  const show = (w: 'screen' | 'health' | 'stop') => {
    screen.hidden = w !== 'screen'; health.hidden = w !== 'health'; stop.hidden = w !== 'stop';
    dlg.scrollTop = 0;
  };
  const val = (id: string) => ($<HTMLInputElement>(id).value ?? '').trim();
  const checked = (id: string) => Array.from($(id).querySelectorAll<HTMLInputElement>('input:checked')).map((i) => i.value);
  const setErr = (k: string, m: string) => { const e = health.querySelector(`[data-e="${k}"]`); if (e) e.textContent = m; };

  // "None of these" is exclusive: picking it clears the rest, picking another clears it.
  for (const id of ['g1-conditions', 'g1-safety', 'g1-meds']) {
    $(id).addEventListener('change', (ev) => {
      const t = ev.target as HTMLInputElement;
      if (!t.checked) return;
      $(id).querySelectorAll<HTMLInputElement>('input').forEach((i) => {
        if (i !== t && ((t.value === 'none') || i.value === 'none')) i.checked = false;
      });
    });
  }
  $<HTMLSelectElement>('g1-prior').addEventListener('change', () => {
    $('g1-prior-more').hidden = !['current', 'past'].includes($<HTMLSelectElement>('g1-prior').value);
  });
  const dob = $<HTMLInputElement>('g1-dob');
  { const t = new Date(); t.setMinutes(t.getMinutes() - t.getTimezoneOffset()); dob.max = t.toISOString().slice(0, 10); }

  function open(btn: HTMLElement) {
    cur = { btn, skuId: btn.dataset.sku as string };
    screen.reset(); health.reset(); answers = null; busy = false;
    $('g1-prior-more').hidden = true;
    $('g1-screen-err').textContent = ''; $('g1-health-err').textContent = ''; $('g1-missing').textContent = '';
    health.querySelectorAll('.g1-fe').forEach((e) => (e.textContent = ''));
    setBusy(false);
    show('screen');
    if (typeof dlg.showModal === 'function') dlg.showModal(); else dlg.setAttribute('open', '');
    document.body.style.overflow = 'hidden';
    track('lp_glp1_screen_open', { skuId: cur.skuId });
  }
  dlg.addEventListener('close', () => { document.body.style.overflow = ''; try { cur?.btn.focus(); } catch { /* */ } });
  const close = () => { if (dlg.open) dlg.close(); else dlg.removeAttribute('open'); };
  $('g1-x').addEventListener('click', close);
  dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
  $('g1-grid').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('.g1-buy') as HTMLElement | null;
    if (b) open(b);
  });
  $('g1-stop-back').addEventListener('click', () => show('screen'));
  $('g1-back').addEventListener('click', () => { if (!busy) show('screen'); });

  screen.addEventListener('submit', (e) => {
    e.preventDefault();
    const a: Record<string, boolean> = {};
    let first: HTMLElement | null = null;
    screen.querySelectorAll<HTMLElement>('.g1-q').forEach((q) => {
      const c = q.querySelector<HTMLInputElement>('input:checked');
      q.classList.toggle('g1-q-missing', !c);
      if (!c && !first) first = q;
      if (c) a[q.dataset.id as string] = c.value === 'yes';
    });
    if (first) { $('g1-screen-err').textContent = 'Please answer every question.'; (first as HTMLElement).scrollIntoView({ block: 'center' }); return; }
    $('g1-screen-err').textContent = '';
    const bad = failedKnockouts(a);
    if (bad.length) { track('lp_glp1_screen_fail', { skuId: cur?.skuId, ids: bad }); show('stop'); return; }
    answers = a;
    track('lp_glp1_screen_pass', { skuId: cur?.skuId });
    show('health');
    $('g1-health-title').focus();
  });

  function setBusy(on: boolean) {
    busy = on;
    const b = $<HTMLButtonElement>('g1-pay');
    b.disabled = on; b.textContent = on ? 'Opening secure checkout…' : 'Continue to payment';
  }
  const fail = (m: string) => { $('g1-health-err').textContent = m; setBusy(false); };
  const num = (id: string) => Number(val(id));

  function validate(): Glp1Health | null {
    health.querySelectorAll('.g1-fe').forEach((e) => (e.textContent = ''));
    let first: HTMLElement | null = null;
    const bad = (k: string, m: string, id: string) => { setErr(k, m); if (!first) first = $(id); };
    const REQ = 'This field is required.';
    if (!val('g1-first')) bad('first', REQ, 'g1-first');
    if (!val('g1-last')) bad('last', REQ, 'g1-last');
    const em = val('g1-email');
    if (!em) bad('email', REQ, 'g1-email'); else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em)) bad('email', 'Enter a valid email address.', 'g1-email');
    const ph = val('g1-phone'), dg = ph.replace(/\D/g, '');
    if (!ph) bad('phone', REQ, 'g1-phone'); else if (dg.length < 10 || dg.length > 15 || !/^[+\d\s().-]+$/.test(ph)) bad('phone', 'Enter a valid mobile number.', 'g1-phone');
    const d = val('g1-dob'), dd = d ? new Date(d + 'T00:00:00') : null;
    if (!d) bad('dob', REQ, 'g1-dob'); else if (!dd || isNaN(dd.getTime()) || dd > new Date() || dd.getFullYear() < 1900) bad('dob', 'Enter your date of birth as month, day, year.', 'g1-dob');
    else { const age = (Date.now() - dd.getTime()) / 31557600000; if (age < 18) bad('dob', 'You must be 18 or older.', 'g1-dob'); }
    if (!val('g1-sex')) bad('sex', REQ, 'g1-sex');
    const ft = num('g1-ft'), inch = num('g1-in'), wt = num('g1-wt');
    if (!val('g1-ft') || ft < 3 || ft > 8) bad('ft', 'Enter feet.', 'g1-ft');
    if (!val('g1-in') || inch < 0 || inch > 11) bad('in', 'Enter inches (0 to 11).', 'g1-in');
    if (!val('g1-wt') || wt < 60 || wt > 800) bad('wt', 'Enter your weight in pounds.', 'g1-wt');
    if (val('g1-goal') && (num('g1-goal') < 60 || num('g1-goal') > 800)) bad('goal', 'Enter a goal weight in pounds, or leave blank.', 'g1-goal');
    const conds = checked('g1-conditions'), safe = checked('g1-safety'), meds = checked('g1-meds');
    if (!conds.length) bad('conditions', 'Select at least one, or "None of these".', 'g1-conditions');
    if (!safe.length) bad('safety', 'Select at least one, or "None of these".', 'g1-safety');
    if (!meds.length) bad('meds', 'Select at least one, or "None of these".', 'g1-meds');
    const prior = val('g1-prior');
    if (!prior) bad('prior', REQ, 'g1-prior');
    if ((prior === 'current' || prior === 'past')) {
      if (!val('g1-pdrug')) bad('pdrug', REQ, 'g1-pdrug');
      if (!val('g1-pdose')) bad('pdose', REQ, 'g1-pdose');
    }
    if (!val('g1-other')) bad('other', REQ, 'g1-other');
    if (!val('g1-allergies')) bad('allergies', REQ, 'g1-allergies');
    if (!$<HTMLInputElement>('g1-privacy').checked) bad('privacy', 'Please check this box to continue.', 'g1-privacy');
    if (!val('g1-sign')) bad('sign', 'Type your full legal name to continue.', 'g1-sign');
    if (first) {
      $('g1-missing').textContent = "A few answers are still missing. We've taken you to the first one.";
      const f = first as HTMLElement; f.scrollIntoView({ block: 'center' });
      try { f.focus({ preventScroll: true }); } catch { f.focus(); }
      return null;
    }
    const h: Glp1Health = {
      dob: d, sex: val('g1-sex') as 'female' | 'male', heightFt: ft, heightIn: inch, weightLb: wt,
      conditions: conds, safetyHistory: safe, priorGlp1: prior as 'never' | 'current' | 'past',
      interactingMeds: meds, otherMeds: val('g1-other'), allergies: val('g1-allergies'),
    };
    if (val('g1-goal')) h.goalWeightLb = num('g1-goal');
    if (prior !== 'never') { h.priorGlp1Drug = val('g1-pdrug'); h.priorGlp1Dose = val('g1-pdose'); }
    return h;
  }

  health.addEventListener('input', () => { $('g1-missing').textContent = ''; });
  health.addEventListener('submit', (e) => {
    e.preventDefault();
    if (busy || !cur || !answers) return;
    $('g1-health-err').textContent = ''; $('g1-missing').textContent = '';
    const h = validate();
    if (!h) return;
    const body = buildGlp1Body({
      skuId: cur.skuId, autoShip: $<HTMLInputElement>('g1-autoship').checked, answers, health: h,
      typedName: val('g1-sign'),
      contact: { firstName: val('g1-first'), lastName: val('g1-last'), email: val('g1-email'), phone: val('g1-phone') },
      testToken: (window as any).__ppT || undefined,
    });
    setBusy(true);
    track('lp_glp1_checkout', { skuId: cur.skuId, autoShip: body.autoShip, lane: GLP1_LANE });
    fetch(API + '/api/push-patch-pre-intake', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
      .then((r) => {
        if (r.status === 400) { fail('Please complete every field and answer every question.'); return null; }
        if (r.status === 403) { setBusy(false); track('lp_glp1_screen_fail', { skuId: cur?.skuId, ids: ['server'] }); show('stop'); return null; }
        if (r.status === 503) { fail("This medicine isn't available yet. Please check back soon."); return null; }
        if (!r.ok) { fail(GENERIC); return null; }
        return r.json();
      })
      .then((res) => { if (!res) return; if (res.url) window.location.href = res.url; else fail(GENERIC); })
      .catch(() => fail('We could not open checkout. Please check your connection and try again.'));
  });
</script>

