---
import EmailCapture from './EmailCapture.astro';
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">

      <!-- (a) Brand -->
      <div class="footer-brand">
        <a href="/" class="footer-logo-link" aria-label="My4MLife — home">
          <img src="/logos/emblem/emblem.svg" alt="" width="48" height="48" class="footer-mark" aria-hidden="true" />
          <span class="footer-wordmark">My<b>4M</b>Life</span>
        </a>
        <p class="footer-tagline"><em>Begin with the end in mind.</em></p>
        <p class="footer-claim">The brain-healthspan platform. Begin with the end in mind.</p>
        <p>Doctor-guided health education and protocol design. The 4M system for optimal cognitive aging — built by an assembled team of clinicians and protocol designers under Dr. TJ's guidance, with one goal: long-term brain function.</p>
        <div class="footer-ec">
          <EmailCapture source="footer" dark={true} buttonLabel="Stay informed" />
        </div>
      </div>

      <!-- (b) Explore -->
      <div class="footer-col">
        <h4>Explore</h4>
        <ul>
          <li><a href="/assessment">Assessment</a></li>
          <li><a href="/solutions/gut">Solutions</a></li>
          <li><a href="/membership">Membership</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </div>

      <!-- (c) Care -->
      <div class="footer-col">
        <h4>Care</h4>
        <ul>
          <li><a href="/consult">Book a Consult</a></li>
          <li><a href="/rx/weight-loss">GLP-1 Weight Loss Rx</a></li>
          <li><a href="/rx/gh-peptide">Growth-Hormone Peptide Rx</a></li>
          <li><a href="/rx/testosterone-ed">Testosterone / ED Rx (Men)</a></li>
          <li><a href="/rx/menopause-hrt">Menopause &amp; HRT Rx (Women)</a></li>
          <li><a href="/rx/leaky-gut">Gut-Brain Rx</a></li>
          <li><a href="/rx/regenerative-medicine">Regenerative Medicine Rx</a></li>
          <li><a href="/rx/peptides">Peptides Rx</a></li>
        </ul>
      </div>

      <!-- (d) Legal -->
      <div class="footer-col">
        <h4>Legal</h4>
        <ul>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/terms">Terms</a></li>
          <li><a href="/refund-policy">Refund Policy</a></li>
          <li><a href="/consent">Consent</a></li>
        </ul>
      </div>

    </div>

    <!-- Credential disclosure -->
    <div class="footer-disclaimer">
      <p>My4MLife provides health education, protocol design, and AI-driven coaching. Medical care, diagnosis, and prescriptions are provided by a contracted licensed telemedicine practice. Dr. Mundheim is a Doctor of Chiropractic, NBCE-certified since 1994, and does not provide medical care through this platform.</p>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 My4MLife. All rights reserved. &middot; Telemedicine services are provided by licensed physicians.</p>
    </div>
  </div>
</footer>

<style is:global>
  .footer {
    background: #0a1f44;
    color: #f5f1e8;
    padding: 4rem 0 2rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 2.5rem;
  }
  .footer-logo-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    margin-bottom: 0.5rem;
  }
  .footer-mark {
    width: 40px;
    height: 40px;
    opacity: 0.85;
    filter: invert(1) brightness(2);
  }
  .footer-wordmark {
    font-family: 'Inter', sans-serif;
    font-size: 1.3rem;
    font-weight: 800;
    color: #f5f1e8;
    letter-spacing: -0.5px;
  }
  .footer-wordmark b {
    color: #d4af5a;
    font-weight: 800;
  }
  .footer-tagline {
    font-size: 0.82rem;
    color: rgba(245,241,232,0.6);
    margin-bottom: 0.35rem;
    font-family: 'Playfair Display', serif;
  }
  .footer-claim {
    font-size: 0.78rem;
    color: rgba(245,241,232,0.5);
    margin-bottom: 0.9rem;
    font-family: 'Inter', sans-serif;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .footer-brand p { font-size: 0.88rem; line-height: 1.7; max-width: 300px; color: rgba(245,241,232,0.7); }
  .footer-ec { margin-top: 1.2rem; max-width: 300px; }
  .footer-col h4 {
    color: #f5f1e8;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .footer-col ul { list-style: none; }
  .footer-col li { margin-bottom: 0.6rem; }
  .footer-col a {
    color: rgba(245,241,232,0.65);
    text-decoration: none;
    font-size: 0.88rem;
    transition: color 0.2s;
  }
  .footer-col a:hover { color: #d4af5a; }
  .footer-disclaimer {
    border-top: 1px solid rgba(245,241,232,0.12);
    padding: 1.5rem 0;
    margin-bottom: 1rem;
  }
  .footer-disclaimer p {
    font-size: 0.75rem;
    color: rgba(245,241,232,0.6);
    line-height: 1.7;
    max-width: 860px;
  }
  .footer-bottom {
    border-top: 1px solid rgba(245,241,232,0.14);
    padding-top: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer-bottom p { font-size: 0.82rem; color: rgba(245,241,232,0.6); }
  @media (max-width: 1024px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 768px) {
    .footer-grid { grid-template-columns: 1fr; }
    .footer-bottom { justify-content: center; text-align: center; }
    .footer-disclaimer p { font-size: 0.72rem; }
  }
</style>
