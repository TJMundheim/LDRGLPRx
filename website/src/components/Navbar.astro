---
// No MegaMenu import — 4M mega-menus removed; replaced with flat + simple dropdowns

const envItems = [
  { label: 'Light environment',  href: '/solutions/environment/light' },
  { label: 'Air quality',        href: '/solutions/environment/air' },
  { label: 'Water quality',      href: '/solutions/environment/water' },
  { label: 'EMF mitigation',     href: '/solutions/environment/emf' },
  { label: 'Grounding',          href: '/solutions/environment/grounding' },
];

const moreItems = [
  { label: 'Acute pain',              href: '/solutions/pain-acute' },
  { label: 'Chronic pain',            href: '/solutions/pain-chronic' },
  { label: 'Allergies & immune',      href: '/solutions/allergies' },
  { label: 'Stress',                  href: '/solutions/stress' },
  { label: 'Dental',                  href: '/solutions/dental' },
  { label: 'Vitamin D',               href: '/solutions/vitamin-d' },
  { label: 'Substance use',           href: '/solutions/substance-use' },
  { label: 'Nutrition',               href: '/solutions/nutrition' },
  { label: 'Morning routine',         href: '/solutions/morning-routine' },
  { label: 'Lack of purpose & goals', href: '/solutions/purpose-goals' },
  { label: 'Self-image',              href: '/solutions/self-image' },
  { label: 'Financial stress',        href: '/solutions/financial-stress' },
  { label: 'Health knowledge',        href: '/solutions/health-knowledge' },
  { label: 'Healthcare access',       href: '/solutions/healthcare-access' },
];
---

<nav class="navbar" id="navbar">
  <div class="nav-inner">

    <!-- Logo -->
    <a href="/" class="nav-logo" aria-label="My4MLife — home">
      <img
        class="logo-lockup"
        src="/logos/concept-13/lockup-color.svg"
        alt="My4MLife"
        width="160"
        height="44"
      />
      <img
        class="logo-mark"
        src="/logos/concept-13/mark-color.svg"
        alt="My4MLife"
        width="44"
        height="44"
      />
    </a>

    <!-- Desktop nav -->
    <ul class="nav-links" id="nav-links" role="menubar">

      <!-- Primary CTA -->
      <li role="none">
        <a href="/assessment" class="btn btn-assessment" role="menuitem">
          Take the Free Assessment ›
        </a>
      </li>

      <!-- 5 flat solution links -->
      <li role="none"><a href="/solutions/gut"       class="nav-link" role="menuitem">Gut Health</a></li>
      <li role="none"><a href="/solutions/hormones"  class="nav-link" role="menuitem">Hormones</a></li>
      <li role="none"><a href="/solutions/weight"    class="nav-link" role="menuitem">Weight</a></li>
      <li role="none"><a href="/solutions/sleep"     class="nav-link" role="menuitem">Sleep</a></li>
      <li role="none"><a href="/solutions/cognitive" class="nav-link" role="menuitem">Cognitive</a></li>

      <!-- Environmental Factors dropdown -->
      <li class="dd-trigger" role="none" id="dd-env">
        <button class="dd-btn" aria-haspopup="true" aria-expanded="false" aria-controls="dd-panel-env">
          Environmental Factors
          <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <ul class="dd-panel" id="dd-panel-env" role="menu" hidden>
          {envItems.map((item) => (
            <li role="none">
              <a href={item.href} class="dd-item" role="menuitem">{item.label}</a>
            </li>
          ))}
        </ul>
      </li>

      <!-- More dropdown -->
      <li class="dd-trigger" role="none" id="dd-more">
        <button class="dd-btn" aria-haspopup="true" aria-expanded="false" aria-controls="dd-panel-more">
          More
          <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <ul class="dd-panel dd-panel-wide" id="dd-panel-more" role="menu" hidden>
          {moreItems.map((item) => (
            <li role="none">
              <a href={item.href} class="dd-item" role="menuitem">{item.label}</a>
            </li>
          ))}
        </ul>
      </li>

      <!-- Membership -->
      <li role="none"><a href="/4m-cohort" class="nav-link nav-membership" role="menuitem">Membership</a></li>

      <!-- Sign In -->
      <li role="none">
        <a href="https://app.my4mlife.com" class="btn btn-primary nav-signin" role="menuitem">
          Sign In &rarr;
        </a>
      </li>
    </ul>

    <!-- Hamburger -->
    <button class="menu-toggle" id="menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">

    <!-- 1. Primary CTA -->
    <div class="mobile-top">
      <a href="/assessment" class="btn btn-assessment mobile-assessment">Take the Free Assessment ›</a>
    </div>

    <!-- 2. Flat solution links -->
    <div class="mobile-flat-solutions">
      <a href="/solutions/gut"       class="mobile-link">Gut Health</a>
      <a href="/solutions/hormones"  class="mobile-link">Hormones</a>
      <a href="/solutions/weight"    class="mobile-link">Weight</a>
      <a href="/solutions/sleep"     class="mobile-link">Sleep</a>
      <a href="/solutions/cognitive" class="mobile-link">Cognitive</a>
    </div>

    <!-- Environmental Factors accordion -->
    <div class="mobile-section">
      <button class="mobile-section-btn" aria-expanded="false" aria-controls="mobile-env">
        Environmental Factors
        <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <ul class="mobile-section-list" id="mobile-env" hidden>
        {envItems.map((item) => (
          <li><a href={item.href} class="mobile-link">• {item.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- More accordion -->
    <div class="mobile-section">
      <button class="mobile-section-btn" aria-expanded="false" aria-controls="mobile-more">
        More
        <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <ul class="mobile-section-list" id="mobile-more" hidden>
        {moreItems.map((item) => (
          <li><a href={item.href} class="mobile-link">• {item.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- 3 & 4. Membership + Sign In -->
    <div class="mobile-flat">
      <a href="/4m-cohort" class="mobile-link mobile-membership">Membership</a>
      <a href="https://app.my4mlife.com" class="btn btn-primary mobile-signin">Sign In &rarr;</a>
    </div>
  </div>
</nav>

<!-- Simple dropdown backdrop -->
<div class="dd-backdrop" id="dd-backdrop" aria-hidden="true"></div>

<style is:global>
  /* ── Base navbar ── */
  .navbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    background: rgba(255,255,255,0.96);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    transition: box-shadow 0.3s;
  }
  .navbar.scrolled { box-shadow: var(--shadow-md); }

  .nav-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    height: 72px;
    gap: 0;
  }

  /* ── Logo ── */
  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    margin-right: 1.25rem;
    flex-shrink: 0;
  }
  .logo-lockup {
    height: 40px;
    width: auto;
    display: block;
  }
  .logo-mark {
    height: 40px;
    width: auto;
    display: none;
  }

  /* ── Desktop nav links ── */
  .nav-links {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    flex: 1;
  }
  .nav-link {
    display: block;
    padding: 0.5rem 0.65rem;
    color: var(--text);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 6px;
    transition: color 0.2s, background 0.2s;
    white-space: nowrap;
  }
  .nav-link:hover { color: var(--primary); background: var(--bg-soft, #f5f0e8); }

  .nav-membership { font-weight: 600; }
  .nav-signin { margin-left: auto; }

  /* ── Assessment CTA button ── */
  .btn-assessment {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    border-radius: 50px;
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    background: var(--primary, #2d4a7a);
    color: white;
    border: none;
    cursor: pointer;
    transition: all 0.25s;
    margin-right: 0.5rem;
  }
  .btn-assessment:hover {
    background: var(--primary-dark, #1e3560);
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(45,74,122,0.3);
  }

  /* ── Simple dropdown trigger ── */
  .dd-trigger {
    position: relative;
    list-style: none;
  }
  .dd-btn {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.65rem;
    background: none;
    border: none;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text);
    border-radius: 6px;
    transition: color 0.2s, background 0.2s;
    white-space: nowrap;
  }
  .dd-btn:hover,
  .dd-btn[aria-expanded="true"] {
    color: var(--primary);
    background: var(--bg-soft, #f5f0e8);
  }
  .dd-btn .chevron { transition: transform 0.2s; flex-shrink: 0; }
  .dd-btn[aria-expanded="true"] .chevron { transform: rotate(180deg); }

  /* ── Dropdown panel ── */
  .dd-panel {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 210px;
    background: white;
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.12);
    list-style: none;
    margin: 0;
    padding: 0.4rem 0;
    z-index: 1001;
    animation: ddFadeIn 0.15s ease;
  }
  .dd-panel-wide { min-width: 240px; }
  .dd-panel[hidden] { display: none; }

  @keyframes ddFadeIn {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .dd-item {
    display: block;
    padding: 0.55rem 1rem;
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .dd-item:hover { background: var(--bg-soft, #f5f0e8); color: var(--primary); }

  /* ── Dropdown backdrop ── */
  .dd-backdrop {
    display: none;
    position: fixed;
    inset: 72px 0 0 0;
    z-index: 1000;
  }
  .dd-backdrop.open { display: block; }

  /* ── Btn helpers ── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.4rem;
    border-radius: 50px;
    font-family: 'Inter', sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.25s;
    white-space: nowrap;
  }
  .btn-primary { background: var(--accent); color: white; }
  .btn-primary:hover {
    background: var(--accent-dark, #00a884);
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(0,184,148,0.35);
  }

  /* ── Hamburger ── */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    margin-left: auto;
  }
  .hamburger-bar {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--dark, #1a1a1a);
    border-radius: 2px;
    transition: all 0.2s;
  }

  /* ── Mobile menu ── */
  .mobile-menu {
    display: none;
    flex-direction: column;
    background: white;
    border-top: 1px solid var(--border);
    padding: 1rem 1.5rem 2rem;
    max-height: calc(100vh - 72px);
    overflow-y: auto;
  }
  .mobile-menu.open { display: flex; }

  .mobile-top {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0.75rem;
  }
  .mobile-assessment { width: 100%; justify-content: center; }

  .mobile-flat-solutions {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .mobile-section { border-bottom: 1px solid var(--border); }
  .mobile-section-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.9rem 0;
    background: none;
    border: none;
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--dark, #1a1a1a);
    cursor: pointer;
    text-align: left;
  }
  .mobile-section-btn .chevron { transition: transform 0.2s; }
  .mobile-section-btn[aria-expanded="true"] .chevron { transform: rotate(180deg); }
  .mobile-section-list {
    list-style: none;
    padding: 0 0 0.75rem 0.5rem;
    margin: 0;
  }
  .mobile-section-list li { margin-bottom: 0.1rem; }

  .mobile-link {
    display: block;
    padding: 0.5rem 0.25rem;
    font-size: 0.88rem;
    color: var(--text);
    text-decoration: none;
    transition: color 0.2s;
  }
  .mobile-link:hover { color: var(--primary); }

  .mobile-flat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1rem;
  }
  .mobile-membership {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .mobile-signin { width: 100%; justify-content: center; }

  /* ── Responsive ── */
  @media (max-width: 960px) {
    .nav-links { display: none !important; }
    .menu-toggle { display: flex; }
    .logo-lockup { display: none; }
    .logo-mark { display: block; }
  }
  @media (min-width: 961px) {
    .mobile-menu { display: none !important; }
    .menu-toggle { display: none; }
  }
</style>

<script is:inline>
(function () {
  // Scroll shadow
  window.addEventListener('scroll', function () {
    var nav = document.getElementById('navbar');
    if (nav) nav.classList.toggle('scrolled', window.scrollY > 20);
  });

  // Hamburger toggle
  var toggleBtn = document.getElementById('menu-toggle');
  var mobileMenu = document.getElementById('mobile-menu');
  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', function () {
      var open = mobileMenu.classList.toggle('open');
      toggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      mobileMenu.setAttribute('aria-hidden', open ? 'false' : 'true');
    });
  }

  // Mobile accordions
  document.querySelectorAll('.mobile-section-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var id = btn.getAttribute('aria-controls');
      var panel = id ? document.getElementById(id) : null;
      if (!panel) return;
      var expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      panel.hidden = expanded;
    });
  });

  // Desktop dropdowns
  var backdrop = document.getElementById('dd-backdrop');
  var openId = null;

  function openDd(id) {
    if (openId && openId !== id) closeDd(openId);
    var panel = document.getElementById('dd-panel-' + id);
    var btn = document.querySelector('#dd-' + id + ' .dd-btn');
    if (panel && btn) {
      panel.hidden = false;
      btn.setAttribute('aria-expanded', 'true');
      if (backdrop) backdrop.classList.add('open');
      openId = id;
    }
  }

  function closeDd(id) {
    var panel = document.getElementById('dd-panel-' + id);
    var btn = document.querySelector('#dd-' + id + ' .dd-btn');
    if (panel) panel.hidden = true;
    if (btn) btn.setAttribute('aria-expanded', 'false');
    if (backdrop) backdrop.classList.remove('open');
    openId = null;
  }

  function closeAll() { if (openId) closeDd(openId); }

  ['env', 'more'].forEach(function (id) {
    var trigger = document.getElementById('dd-' + id);
    if (!trigger) return;
    var btn = trigger.querySelector('.dd-btn');
    if (!btn) return;

    btn.addEventListener('click', function () {
      if (openId === id) { closeDd(id); } else { openDd(id); }
    });

    btn.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (openId === id) { closeDd(id); } else { openDd(id); }
      }
      if (e.key === 'Escape') closeAll();
    });
  });

  if (backdrop) backdrop.addEventListener('click', closeAll);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAll(); });

  // Close mobile menu on link click
  if (mobileMenu) {
    mobileMenu.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        mobileMenu.classList.remove('open');
        if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.setAttribute('aria-hidden', 'true');
      });
    });
  }
})();
</script>
