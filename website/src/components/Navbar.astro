---
// Radically simplified navbar: Home | Services ▾ | Sign In →

const frameworkItems = [
  { label: 'Mind',     href: '/pillars/mind' },
  { label: 'Muscle',   href: '/pillars/muscle' },
  { label: 'Mitigate', href: '/pillars/mitigate' },
  { label: 'Motivate', href: '/pillars/motivate' },
];

const categoryItems = [
  { label: 'Gut Health / Leaky Gut',  href: '/solutions/gut' },
  { label: 'Testosterone Therapy',    href: '/solutions/hormones' },
  { label: 'Erectile Dysfunction',    href: '/solutions/erectile-dysfunction' },
  { label: 'GLP-1 Weight Loss',       href: '/solutions/weight' },
  { label: 'Brain Optimization',      href: '/solutions/cognitive' },
  { label: 'Peptides',                href: '/solutions/peptides' },
  { label: 'Regenerative Medicine',   href: '/regenerative-medicine' },
  { label: 'Chronic Conditions',      href: '/solutions/chronic-conditions' },
];

const envItems = [
  { label: 'Overview',      href: '/solutions/environment' },
  { label: 'Light',         href: '/solutions/environment/light' },
  { label: 'Air Quality',   href: '/solutions/environment/air' },
  { label: 'Water Quality', href: '/solutions/environment/water' },
  { label: 'EMF Mitigation',href: '/solutions/environment/emf' },
  { label: 'Grounding',     href: '/solutions/environment/grounding' },
  { label: 'Sauna',         href: '/solutions/environment/sauna' },
  { label: 'Cold Plunge',   href: '/solutions/environment/cold-plunge' },
  { label: 'Mineral Bath',  href: '/solutions/environment/mineral-bath' },
];

const moreItems = [
  { label: 'Sleep',                    href: '/solutions/sleep' },
  { label: 'Acute Pain',               href: '/solutions/pain-acute' },
  { label: 'Chronic Pain',             href: '/solutions/pain-chronic' },
  { label: 'Allergies & Immune',       href: '/solutions/allergies' },
  { label: 'Stress',                   href: '/solutions/stress' },
  { label: 'Dental',                   href: '/solutions/dental' },
  { label: 'Nutritional Supplements',  href: '/solutions/nutritional-supplements' },
  { label: 'Substance Use',            href: '/solutions/substance-use' },
  { label: 'Nutrition',                href: '/solutions/nutrition' },
  { label: 'Morning Routine',          href: '/solutions/morning-routine' },
  { label: 'Lack of Purpose & Goals',  href: '/solutions/purpose-goals' },
  { label: 'Self-Image',               href: '/solutions/self-image' },
  { label: 'Financial Stress',         href: '/solutions/financial-stress' },
  { label: 'Health Knowledge',         href: '/solutions/health-knowledge' },
  { label: 'Healthcare Access',        href: '/solutions/healthcare-access' },
];

const programItems = [
  { label: 'Take the Free Personalized Assessment', href: '/assessment' },
  { label: 'Buy the Book — $79.99', href: '/products/begin-with-the-end-in-mind' },
  { label: 'Buy the App — $69.99', href: '/products/my4mlife-app' },
  { label: 'Cohort Workbook (PDF) — $2.50', href: '/products/cohort-workbook' },
  { label: 'Blog',             href: '/blog' },
  { label: 'About',            href: '/about' },
];
---

<nav class="navbar" id="navbar">
  <div class="nav-inner">

    <!-- Home (replaces logo lockup) -->
    <a href="/" class="nav-home" aria-label="My4MLife — home">
      <img src="/logos/concept-13/mark-color.svg" alt="" width="30" height="30" aria-hidden="true" />
      <span class="nav-home-label">Home</span>
    </a>

    <!-- Desktop nav: Home + Services dropdown + Sign In (8 categories moved to homepage CTA band) -->
    <ul class="nav-links" id="nav-links" role="menubar">

      <!-- Services mega-menu -->
      <li class="dd-trigger" role="none" id="dd-services">
        <button class="dd-btn" aria-haspopup="true" aria-expanded="false" aria-controls="dd-panel-services">
          Services
          <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <!-- Mega-menu panel -->
        <div class="mega-panel" id="dd-panel-services" hidden>
          <div class="mega-grid">

            <!-- 4M Framework -->
            <div class="mega-section">
              <p class="mega-heading">4M Framework</p>
              {frameworkItems.map((item) => (
                <a href={item.href} class="mega-link">{item.label}</a>
              ))}
            </div>

            <!-- Top Categories -->
            <div class="mega-section">
              <p class="mega-heading">Top Categories</p>
              {categoryItems.map((item) => (
                <a href={item.href} class="mega-link">{item.label}</a>
              ))}
            </div>

            <!-- Environmental Factors -->
            <div class="mega-section">
              <p class="mega-heading">Environmental Factors</p>
              {envItems.map((item) => (
                <a href={item.href} class="mega-link">{item.label}</a>
              ))}
            </div>

            <!-- More Topics — spans 2 grid columns, list renders in 2 internal columns -->
            <div class="mega-section mega-section-more">
              <p class="mega-heading">More Topics</p>
              <div class="mega-more-list">
                {moreItems.map((item) => (
                  <a href={item.href} class="mega-link">{item.label}</a>
                ))}
              </div>
            </div>

            <!-- Programs — its own column -->
            <div class="mega-section">
              <p class="mega-heading">Programs</p>
              {programItems.map((item) => (
                <a href={item.href} class="mega-link">{item.label}</a>
              ))}
            </div>

          </div>
        </div>
      </li>

    </ul>

    <!-- Hamburger -->
    <button class="menu-toggle" id="menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">

    <!-- Services accordion (8 categories live inside Services mega-menu, not at top of mobile menu) -->
    <div class="mobile-section">
      <button class="mobile-section-btn" aria-expanded="false" aria-controls="mobile-services">
        Services
        <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="mobile-section-content" id="mobile-services" hidden>

        <!-- 4M Framework -->
        <button class="mobile-sub-btn" aria-expanded="false" aria-controls="mobile-framework">
          4M Framework
          <svg class="chevron" width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <ul class="mobile-sub-list" id="mobile-framework" hidden>
          {frameworkItems.map((item) => (
            <li><a href={item.href} class="mobile-link">• {item.label}</a></li>
          ))}
        </ul>

        <!-- Top Categories -->
        <button class="mobile-sub-btn" aria-expanded="false" aria-controls="mobile-categories">
          Top Categories
          <svg class="chevron" width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <ul class="mobile-sub-list" id="mobile-categories" hidden>
          {categoryItems.map((item) => (
            <li><a href={item.href} class="mobile-link">• {item.label}</a></li>
          ))}
        </ul>

        <!-- Environmental Factors -->
        <button class="mobile-sub-btn" aria-expanded="false" aria-controls="mobile-env">
          Environmental Factors
          <svg class="chevron" width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <ul class="mobile-sub-list" id="mobile-env" hidden>
          {envItems.map((item) => (
            <li><a href={item.href} class="mobile-link">• {item.label}</a></li>
          ))}
        </ul>

        <!-- More Topics -->
        <button class="mobile-sub-btn" aria-expanded="false" aria-controls="mobile-more">
          More Topics
          <svg class="chevron" width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <ul class="mobile-sub-list" id="mobile-more" hidden>
          {moreItems.map((item) => (
            <li><a href={item.href} class="mobile-link">• {item.label}</a></li>
          ))}
        </ul>

        <!-- Programs -->
        <button class="mobile-sub-btn" aria-expanded="false" aria-controls="mobile-programs">
          Programs
          <svg class="chevron" width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <ul class="mobile-sub-list" id="mobile-programs" hidden>
          {programItems.map((item) => (
            <li><a href={item.href} class="mobile-link">• {item.label}</a></li>
          ))}
        </ul>

      </div>
    </div>

  </div>
</nav>

<!-- Backdrop closes mega-menu on outside click -->
<div class="dd-backdrop" id="dd-backdrop" aria-hidden="true"></div>

<style is:global>
  /* ── Base navbar ── */
  .navbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    background: rgba(255,255,255,0.96);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    transition: box-shadow 0.3s;
  }
  .navbar.scrolled { box-shadow: var(--shadow-md); }

  .nav-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    height: 72px;
    gap: 0;
  }

  /* ── Home button (replaces logo lockup) ── */
  .nav-home {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    margin-right: 1rem;
    flex-shrink: 0;
    color: var(--dark, #1a1a1a);
    border-radius: 8px;
    padding: 0.4rem 0.6rem;
    transition: background 0.2s, color 0.2s;
  }
  .nav-home:hover { background: var(--bg-soft, #f5f0e8); color: var(--primary); }
  .nav-home img { display: block; flex-shrink: 0; }
  .nav-home-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  /* ── Desktop nav links ── */
  .nav-links {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 0.05rem;
    margin: 0;
    padding: 0;
    flex: 1;
  }
  .nav-signin-item { margin-left: auto; }

  /* ── 8-category top-level nav items ── */
  .nav-cat {
    display: inline-block;
    padding: 0.5rem 0.7rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.12s, color 0.12s;
    white-space: nowrap;
  }
  .nav-cat:hover {
    background: var(--bg-soft);
    color: var(--primary);
  }
  /* On narrower desktops, shrink the category labels */
  @media (min-width: 961px) and (max-width: 1280px) {
    .nav-cat { font-size: 0.78rem; padding: 0.45rem 0.5rem; }
  }

  /* ── Services dropdown trigger ── */
  .dd-trigger {
    position: relative;
    list-style: none;
  }
  .dd-btn {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.8rem;
    background: none;
    border: none;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    border-radius: 6px;
    transition: color 0.2s, background 0.2s;
    white-space: nowrap;
  }
  .dd-btn:hover,
  .dd-btn[aria-expanded="true"] {
    color: var(--primary);
    background: var(--bg-soft, #f5f0e8);
  }
  .dd-btn .chevron { transition: transform 0.2s; flex-shrink: 0; }
  .dd-btn[aria-expanded="true"] .chevron { transform: rotate(180deg); }

  /* ── Mega-menu panel ── */
  .mega-panel {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 1140px;
    /* Defensive on mobile: even though .nav-links is display:none < 961px,
       some browsers still measure absolute children for the document scroll
       width. Clamp here so the panel can never exceed the viewport width. */
    max-width: calc(100vw - 16px);
    background: var(--bg-parchment, #fdf8f2);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 12px 40px rgba(0,0,0,0.13);
    padding: 1.5rem;
    z-index: 1001;
    animation: ddFadeIn 0.15s ease;
  }
  .mega-panel[hidden] { display: none; }

  @keyframes ddFadeIn {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .mega-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr 1.1fr 2.2fr 1fr;
    gap: 0 1.4rem;
  }
  .mega-more-list {
    column-count: 2;
    column-gap: 1.2rem;
  }
  .mega-more-list .mega-link {
    break-inside: avoid;
  }

  .mega-section {
    display: flex;
    flex-direction: column;
  }

  .mega-heading {
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--primary, #2d4a7a);
    margin: 0 0 0.5rem 0;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
  }
  .mega-heading-spacer {
    margin-top: 1.25rem;
  }

  .mega-link {
    display: block;
    padding: 0.28rem 0.1rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    border-radius: 4px;
    transition: color 0.15s, background 0.15s;
    white-space: nowrap;
  }
  .mega-link:hover { color: var(--accent, #00b894); }

  /* ── Dropdown backdrop ── */
  .dd-backdrop {
    display: none;
    position: fixed;
    inset: 72px 0 0 0;
    z-index: 999;
  }
  .dd-backdrop.open { display: block; }

  /* ── Sign In button ── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.4rem;
    border-radius: 50px;
    font-family: 'Inter', sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.25s;
    white-space: nowrap;
  }
  .btn-primary { background: var(--accent); color: white; }
  .btn-primary:hover {
    background: var(--accent-dark, #00a884);
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(0,184,148,0.35);
  }

  /* ── Hamburger ── */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    margin-left: auto;
  }
  .hamburger-bar {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--dark, #1a1a1a);
    border-radius: 2px;
    transition: all 0.2s;
  }

  /* ── Mobile menu ── */
  .mobile-menu {
    display: none;
    flex-direction: column;
    background: white;
    border-top: 1px solid var(--border);
    padding: 0.5rem 1.5rem 2rem;
    max-height: calc(100vh - 72px);
    overflow-y: auto;
  }
  .mobile-menu.open { display: flex; }

  .mobile-section { border-bottom: 1px solid var(--border); }
  .mobile-cat-list { display: flex; flex-direction: column; border-bottom: 1px solid var(--border); padding: 0.5rem 0; }
  .mobile-link-cat { font-weight: 600; padding: 0.85rem 1.2rem; color: var(--primary); }
  .mobile-section-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.9rem 0;
    background: none;
    border: none;
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--dark, #1a1a1a);
    cursor: pointer;
    text-align: left;
  }
  .mobile-section-btn .chevron { transition: transform 0.2s; }
  .mobile-section-btn[aria-expanded="true"] .chevron { transform: rotate(180deg); }

  .mobile-section-content {
    padding-bottom: 0.75rem;
  }

  /* Sub-section accordion inside Services */
  .mobile-sub-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.6rem 0.25rem;
    background: none;
    border: none;
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--primary, #2d4a7a);
    cursor: pointer;
    text-align: left;
    border-top: 1px solid var(--border);
    margin-top: 0.25rem;
  }
  .mobile-sub-btn .chevron { transition: transform 0.2s; }
  .mobile-sub-btn[aria-expanded="true"] .chevron { transform: rotate(180deg); }

  .mobile-sub-list {
    list-style: none;
    padding: 0 0 0.5rem 0.75rem;
    margin: 0;
  }
  .mobile-sub-list li { margin-bottom: 0.05rem; }

  .mobile-link {
    display: block;
    padding: 0.45rem 0.25rem;
    font-size: 0.86rem;
    color: var(--text);
    text-decoration: none;
    transition: color 0.2s;
  }
  .mobile-link:hover { color: var(--accent, #00b894); }

  .mobile-flat {
    padding-top: 1rem;
  }
  .mobile-signin { width: 100%; justify-content: center; }

  /* ── Responsive ── */
  @media (max-width: 960px) {
    .nav-links { display: none !important; }
    .menu-toggle { display: flex; }
  }
  @media (min-width: 961px) {
    .mobile-menu { display: none !important; }
    .menu-toggle { display: none; }
  }

  /* Keep mega-panel from clipping on narrower desktops */
  @media (min-width: 961px) and (max-width: 1200px) {
    .mega-panel {
      width: 940px;
    }
    .mega-grid {
      grid-template-columns: 0.9fr 1fr 1fr 2fr 0.9fr;
      gap: 0 1rem;
    }
    .mega-link { font-size: 0.78rem; }
    .mega-more-list { column-gap: 0.8rem; }
  }
</style>

<script is:inline>
(function () {
  // Scroll shadow
  window.addEventListener('scroll', function () {
    var nav = document.getElementById('navbar');
    if (nav) nav.classList.toggle('scrolled', window.scrollY > 20);
  });

  // Hamburger toggle
  var toggleBtn = document.getElementById('menu-toggle');
  var mobileMenu = document.getElementById('mobile-menu');
  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', function () {
      var open = mobileMenu.classList.toggle('open');
      toggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      mobileMenu.setAttribute('aria-hidden', open ? 'false' : 'true');
    });
  }

  // Generic accordion helper
  function bindAccordions(selector) {
    document.querySelectorAll(selector).forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = btn.getAttribute('aria-controls');
        var panel = id ? document.getElementById(id) : null;
        if (!panel) return;
        var expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        panel.hidden = expanded;
      });
    });
  }

  bindAccordions('.mobile-section-btn');
  bindAccordions('.mobile-sub-btn');

  // Desktop mega-menu
  var backdrop = document.getElementById('dd-backdrop');
  var servicesBtn = document.querySelector('#dd-services .dd-btn');
  var servicesPanel = document.getElementById('dd-panel-services');

  function openServices() {
    if (servicesPanel) servicesPanel.hidden = false;
    if (servicesBtn) servicesBtn.setAttribute('aria-expanded', 'true');
    if (backdrop) backdrop.classList.add('open');
  }

  function closeServices() {
    if (servicesPanel) servicesPanel.hidden = true;
    if (servicesBtn) servicesBtn.setAttribute('aria-expanded', 'false');
    if (backdrop) backdrop.classList.remove('open');
  }

  if (servicesBtn) {
    servicesBtn.addEventListener('click', function () {
      var expanded = servicesBtn.getAttribute('aria-expanded') === 'true';
      if (expanded) { closeServices(); } else { openServices(); }
    });
    servicesBtn.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        var expanded = servicesBtn.getAttribute('aria-expanded') === 'true';
        if (expanded) { closeServices(); } else { openServices(); }
      }
      if (e.key === 'Escape') closeServices();
    });
  }

  if (backdrop) backdrop.addEventListener('pointerdown', closeServices);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeServices(); });

  // Close mobile menu on any link click
  if (mobileMenu) {
    mobileMenu.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        mobileMenu.classList.remove('open');
        if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.setAttribute('aria-hidden', 'true');
      });
    });
  }
})();
</script>
