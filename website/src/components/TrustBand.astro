---
// Slim proof strip mounted directly under the hero (homepage) or under the
// h1/lead (rx pages). Four fixed, verbatim claims — no invented stats/logos.
// Navy on white, hairline top/bottom borders, wraps on mobile.

const items = [
  {
    label: 'Physician-reviewed telemedicine',
    icon: 'shield',
  },
  {
    label: 'Secure payments by Stripe',
    icon: 'lock',
  },
  {
    label: 'HIPAA-conscious by design',
    icon: 'cross',
  },
  {
    label: 'Ships to all 50 states',
    icon: 'pin',
  },
];
---

<section class="trust-band" aria-label="Trust and compliance">
  <div class="container trust-inner">
    {items.map((item) => (
      <div class="trust-item">
        <span class="trust-icon" aria-hidden="true">
          {item.icon === 'shield' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3l7 3v6c0 4.5-3 8.25-7 9-4-0.75-7-4.5-7-9V6l7-3z" />
            </svg>
          )}
          {item.icon === 'lock' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="11" width="14" height="9" rx="1.5" />
              <path d="M8 11V7a4 4 0 0 1 8 0v4" />
            </svg>
          )}
          {item.icon === 'cross' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 4v16M4 12h16" />
              <rect x="3.5" y="3.5" width="17" height="17" rx="3" />
            </svg>
          )}
          {item.icon === 'pin' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" />
              <circle cx="12" cy="9.5" r="2.25" />
            </svg>
          )}
        </span>
        <span class="trust-label">{item.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
.trust-band {
  background: #fff;
  border-top: 1px solid rgba(10, 31, 68, 0.12);
  border-bottom: 1px solid rgba(10, 31, 68, 0.12);
  padding: 1.1rem 1rem;
}
.trust-inner {
  max-width: 1000px;
  margin: 0 auto;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 1.75rem 2.5rem;
}
.trust-item {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  color: var(--primary, #0a1f44);
}
.trust-icon {
  display: inline-flex;
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  color: var(--primary, #0a1f44);
}
.trust-icon svg {
  width: 100%;
  height: 100%;
}
.trust-label {
  font-size: 0.88rem;
  font-weight: 600;
  letter-spacing: 0.01em;
  white-space: nowrap;
}

@media (max-width: 640px) {
  .trust-inner {
    gap: 1.1rem 1.5rem;
  }
  .trust-label {
    white-space: normal;
  }
}
</style>
