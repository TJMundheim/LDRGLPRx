---
// Telehealth 3-step "how it works" band (Hims/Ro signature pattern).
// Numbers are meaningful sequence — Playfair numerals in gold on a thin
// connecting line, light warm background, navy text. Single column under 720px.

interface Step {
  title: string;
  body: string;
}

interface Props {
  steps?: Step[];
}

const defaultSteps: Step[] = [
  {
    title: 'Answer questions online',
    body: 'Five minutes, from your phone. No appointment, no waiting room.',
  },
  {
    title: 'A physician reviews',
    body: 'A licensed provider evaluates your history and goals.',
  },
  {
    title: 'Delivered to your door',
    body: 'Your protocol ships directly. Ongoing support included.',
  },
];

const { steps = defaultSteps } = Astro.props as Props;
---

<section class="hiw-band" aria-label="How it works">
  <div class="container hiw-inner">
    <p class="hiw-eyebrow">How It Works</p>
    <div class="hiw-steps">
      {steps.map((step, i) => (
        <div class="hiw-step">
          <div class="hiw-number-wrap">
            <span class="hiw-number">{i + 1}</span>
            {i < steps.length - 1 && <span class="hiw-line" aria-hidden="true"></span>}
          </div>
          <h3 class="hiw-title">{step.title}</h3>
          <p class="hiw-body">{step.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.hiw-band {
  background: #faf8f2;
  padding: 3.5rem 1rem;
}
.hiw-inner {
  max-width: 1000px;
  margin: 0 auto;
}
.hiw-eyebrow {
  text-align: center;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--primary, #0a1f44);
  margin: 0 0 2rem;
}
.hiw-steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}
.hiw-step {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hiw-number-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-bottom: 1.1rem;
}
.hiw-number {
  font-family: 'Playfair Display', serif;
  font-size: 2.4rem;
  font-weight: 700;
  color: var(--gold, #d4af5a);
  line-height: 1;
  position: relative;
  z-index: 1;
  background: #faf8f2;
  padding: 0 0.6rem;
}
.hiw-line {
  position: absolute;
  top: 50%;
  left: 50%;
  width: calc(100% + 2rem);
  height: 1px;
  background: rgba(10, 31, 68, 0.18);
  transform: translateY(-50%);
  z-index: 0;
}
.hiw-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--primary, #0a1f44);
  margin: 0 0 0.5rem;
  line-height: 1.3;
}
.hiw-body {
  font-size: 0.92rem;
  color: var(--text, #2d3748);
  line-height: 1.6;
  margin: 0;
  max-width: 260px;
}

@media (max-width: 720px) {
  .hiw-steps {
    grid-template-columns: 1fr;
    gap: 2.25rem;
  }
  .hiw-line {
    display: none;
  }
}
</style>
