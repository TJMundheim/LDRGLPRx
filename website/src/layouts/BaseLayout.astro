---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import JsonLd from '../components/JsonLd.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  robots?: string;
  keywords?: string;
  ogType?: string;
  schema?: unknown;
  hideChrome?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  robots,
  keywords,
  ogType,
  schema,
  hideChrome = false,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <SEO
    title={title}
    description={description}
    canonical={canonical}
    ogImage={ogImage}
    robots={robots}
    keywords={keywords}
    ogType={ogType}
  />
  {schema && <JsonLd schema={schema} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
  <slot name="head" />

  <!-- PostHog product analytics — public key is safe client-side -->
  <script is:inline>
    (function() {
      // TODO(launch): replace 'phc_PLACEHOLDER_REPLACE_BEFORE_LAUNCH' with the real project key from app.posthog.com → Project Settings → Project API Key
      var phKey = 'phc_PLACEHOLDER_REPLACE_BEFORE_LAUNCH';
      if (phKey.indexOf('PLACEHOLDER') !== -1) return;
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture identify reset register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing get_distinct_id alias people.set people.set_once set_config startSessionRecording stopSessionRecording".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init(phKey, { api_host: 'https://us.i.posthog.com', person_profiles: 'identified_only', capture_pageview: true, capture_pageleave: true });
    })();
  </script>
</head>
<body>
  <!-- Demo-mode init + banner. Inline so it runs immediately on every page. -->
  <script is:inline>
    (function() {
      try {
        var SS_FLAG = 'my4m-demo-mode';
        var SS_AUTH = 'my4m-demo-auth';
        var url = new URL(window.location.href);
        var demoParam = url.searchParams.get('demo');
        var authParam = url.searchParams.get('auth');
        var mutated = false;
        if (demoParam === 'true') {
          sessionStorage.setItem(SS_FLAG, '1');
          if (authParam) sessionStorage.setItem(SS_AUTH, authParam);
          url.searchParams.delete('demo'); url.searchParams.delete('auth');
          mutated = true;
        } else if (demoParam === 'false') {
          sessionStorage.removeItem(SS_FLAG); sessionStorage.removeItem(SS_AUTH);
          url.searchParams.delete('demo'); url.searchParams.delete('auth');
          mutated = true;
        } else if (authParam && sessionStorage.getItem(SS_FLAG) === '1') {
          sessionStorage.setItem(SS_AUTH, authParam);
          url.searchParams.delete('auth');
          mutated = true;
        }
        if (mutated) {
          var qs = url.searchParams.toString();
          history.replaceState({}, '', url.pathname + (qs ? '?' + qs : '') + url.hash);
        }
        if (sessionStorage.getItem(SS_FLAG) === '1') {
          document.addEventListener('DOMContentLoaded', function() {
            var b = document.createElement('div');
            b.setAttribute('role', 'status');
            b.style.cssText = 'position:sticky;top:0;left:0;right:0;z-index:99999;background:#ffb300;color:#1a1a1a;font-family:Inter,system-ui,sans-serif;font-size:0.85rem;font-weight:700;text-align:center;padding:0.55rem 1rem;border-bottom:2px solid #b37800;letter-spacing:0.02em;';
            b.textContent = '🧪 DEMO MODE — Stripe test cards only. Append ?demo=false to any URL to disable.';
            document.body.insertBefore(b, document.body.firstChild);
          });
        }
      } catch (e) { /* noop */ }
    })();
  </script>

  {!hideChrome && <Navbar />}
  <slot />
  {!hideChrome && <Footer />}
  {!hideChrome && <MedicalDisclaimer />}
  <CookieBanner />
</body>
</html>
