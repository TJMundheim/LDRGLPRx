---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  parent: 'Mind' | 'Muscle' | 'Mitigate' | 'Motivate';
  oneliner: string;
  slug: string;
  description?: string;
}

const { title, parent, oneliner, slug, description } = Astro.props;
const pageDescription = description ?? oneliner;
const canonical = `https://my4mlife.com/solutions/${slug}`;
---

<BaseLayout
  title={`${title} | My4MLife`}
  description={pageDescription}
  canonical={canonical}
>
  <!-- Hero band -->
  <section class="sol-hero">
    <div class="container">
      <span class="sol-kicker">{parent.toUpperCase()}</span>
      <h1 class="sol-h1">{title}</h1>
      <p class="sol-oneliner">{oneliner}</p>
    </div>
  </section>

  <!-- Page-specific content -->
  <section class="sol-body">
    <div class="container sol-content">
      <slot />
    </div>
  </section>

  <!-- CTA band -->
  <section class="sol-cta">
    <div class="container sol-cta-grid">
      <div class="sol-cta-card">
        <div class="sol-cta-icon"><i class="fas fa-mobile-alt"></i></div>
        <h3>Free: Cohort App</h3>
        <p>Download the My4MLife cohort app and start your 4M journey today.</p>
        <a href="https://app.my4mlife.com" class="btn-sol primary">Get the App</a>
      </div>

      <div class="sol-cta-card">
        <div class="sol-cta-icon"><i class="fas fa-calendar-check"></i></div>
        <h3>Schedule a 4M Consult</h3>
        <p>Work directly with the My4MLife team to map your personal 4M plan.</p>
        <a href="/consult" class="btn-sol secondary">Book a Consult</a>
      </div>

      <div class="sol-cta-card">
        <div class="sol-cta-icon"><i class="fas fa-flask"></i></div>
        <slot name="product-cta">
          <h3>Products</h3>
          <p>Protocol-matched products coming soon for this category.</p>
          <span class="btn-sol ghost">Coming Soon</span>
        </slot>
      </div>
    </div>
  </section>

  <!-- Tagline footer band -->
  <section class="sol-tagline">
    <div class="container">
      <p class="tagline-text">"Begin with the end in mind."</p>
      <p class="tagline-sub">— My4MLife</p>
    </div>
  </section>
</BaseLayout>

<style>
/* Hero */
.sol-hero {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #fff;
  padding: 5rem 0 3.5rem;
  text-align: center;
}
.sol-kicker {
  display: inline-block;
  font-family: 'Inter', sans-serif;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  color: var(--accent);
  background: rgba(0,184,148,0.15);
  border: 1px solid rgba(0,184,148,0.4);
  padding: 0.25rem 0.75rem;
  border-radius: 999px;
  margin-bottom: 1rem;
}
.sol-h1 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem, 5vw, 3.25rem);
  font-weight: 700;
  color: #fff;
  margin-bottom: 1rem;
}
.sol-oneliner {
  font-size: 1.15rem;
  color: rgba(255,255,255,0.82);
  max-width: 640px;
  margin: 0 auto;
}

/* Body */
.sol-body { padding: 4rem 0; background: var(--bg); }
.sol-content { max-width: 820px; }
.sol-content :global(h2) {
  font-family: 'Playfair Display', serif;
  font-size: 1.6rem;
  color: var(--primary);
  margin: 2.5rem 0 0.75rem;
}
.sol-content :global(p) { margin-bottom: 1rem; color: var(--text); }
.sol-content :global(.card-grid) {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 1.25rem;
  margin-top: 1.25rem;
}
.sol-content :global(.card) {
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.25rem 1.5rem;
}
.sol-content :global(.card h3) {
  font-size: 1rem;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 0.4rem;
}
.sol-content :global(.card p) { font-size: 0.9rem; color: var(--text-light); margin: 0; }

/* CTA band */
.sol-cta {
  background: var(--bg-soft);
  border-top: 1px solid var(--border);
  padding: 4rem 0;
}
.sol-cta-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1.5rem;
}
.sol-cta-card {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 2rem;
  text-align: center;
  box-shadow: var(--shadow-sm);
}
.sol-cta-icon { font-size: 1.75rem; color: var(--accent); margin-bottom: 0.75rem; }
.sol-cta-card h3 {
  font-family: 'Inter', sans-serif;
  font-size: 1rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
  color: var(--dark);
}
.sol-cta-card p { font-size: 0.9rem; color: var(--text-light); margin-bottom: 1.25rem; }
.btn-sol {
  display: inline-block;
  padding: 0.6rem 1.5rem;
  border-radius: 999px;
  font-family: 'Inter', sans-serif;
  font-size: 0.875rem;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
}
.btn-sol.primary { background: var(--accent); color: #fff; }
.btn-sol.primary:hover { background: var(--accent-dark); }
.btn-sol.secondary { background: var(--primary); color: #fff; }
.btn-sol.secondary:hover { background: var(--primary-light); }
.btn-sol.ghost { background: var(--bg-soft); color: var(--text-light); border: 1px solid var(--border); }

/* Tagline footer band */
.sol-tagline {
  background: var(--dark);
  padding: 2.5rem 0;
  text-align: center;
}
.tagline-text {
  font-family: 'Playfair Display', serif;
  font-size: 1.4rem;
  color: #fff;
  font-style: italic;
}
.tagline-sub { font-size: 0.85rem; color: rgba(255,255,255,0.5); margin-top: 0.25rem; }
</style>
