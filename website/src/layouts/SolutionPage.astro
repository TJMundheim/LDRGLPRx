---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  parent: 'Mind' | 'Muscle' | 'Mitigate' | 'Motivate';
  oneliner: string;
  slug: string;
  description?: string;
  /** Override the default canonical path (e.g. for sub-pages) */
  canonicalPath?: string;
  /** Show the 3-step Assessment → Consult → App CTA chain (default true) */
  showSolutionPath?: boolean;
  /** Show the telemedicine disclaimer footer (default true) */
  showDisclaimer?: boolean;
}

const { title, parent, oneliner, slug, description, canonicalPath, showSolutionPath = true, showDisclaimer = true } = Astro.props;
const pageDescription = description ?? oneliner;
const canonical = `https://www.my4mlife.com${canonicalPath ?? `/solutions/${slug}`}`;
---

<BaseLayout
  title={`${title} | My4MLife`}
  description={pageDescription}
  canonical={canonical}
>
  <!-- Hero band -->
  <section class="sol-hero">
    <div class="container">
      <span class="sol-kicker">{parent.toUpperCase()}</span>
      <h1 class="sol-h1">{title}</h1>
      <p class="sol-oneliner">{oneliner}</p>
    </div>
  </section>

  <!-- Page-specific content -->
  <section class="sol-body">
    <div class="container sol-content">
      <slot />
    </div>
  </section>

  <!-- Solution Path — three-step CTA chain (hidden when showSolutionPath={false}) -->
  {showSolutionPath && (
  <section class="sol-path">
    <div class="container">
      <h2 class="sol-path-heading">Take the Solution Path</h2>
      <div class="sol-path-grid">
        <div class="sol-path-step">
          <div class="sol-path-num">1</div>
          <h3>Free Assessment</h3>
          <p>Find out exactly where you stand across all 4M pillars — takes 4 minutes.</p>
          <a href="/assessment" class="btn-sol primary">Take the Free Assessment</a>
        </div>
        <div class="sol-path-step">
          <div class="sol-path-num">2</div>
          <h3>Comprehensive 4M Consult</h3>
          <p>One consult, full review — see if you're a candidate for weight loss medication (GLP-1s), peptides, hormone optimization, prescription protocols, practitioner-grade supplements, and the rest of your personalized 4M plan.</p>
          <ul class="sol-path-bullets">
            <li>Weight loss medication candidacy (GLP-1s)</li>
            <li>Hormone optimization (TRT, thyroid, peptides)</li>
            <li>Nootropic peptides &amp; cognitive support</li>
            <li>Practitioner-grade supplement protocol</li>
            <li>Prescription protocols &amp; lab review</li>
          </ul>
          <a href="/consult" class="btn-sol secondary">Schedule Your Comprehensive 4M Consult</a>
        </div>
        <div class="sol-path-step">
          <div class="sol-path-num">3</div>
          <h3>App + Products</h3>
          <p>Access the My4MLife app, workbook trackers, and protocol-matched products.</p>
          <a href="https://app.my4mlife.com" class="btn-sol accent">Get the My4MLife App + Products</a>
        </div>
      </div>
    </div>
  </section>
  )}

  <!-- Product CTA override slot (optional) -->
  <slot name="product-cta" />

  <!-- Tagline footer band -->
  <section class="sol-tagline">
    <div class="container">
      <p class="tagline-text">"Begin with the end in mind."</p>
      <p class="tagline-sub">— My4MLife</p>
    </div>
  </section>
</BaseLayout>

<style>
/* ── Hero ── */
.sol-hero {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #fff;
  padding: 5rem 0 3.5rem;
  text-align: center;
}
.sol-kicker {
  display: inline-block;
  font-family: 'Inter', sans-serif;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  color: var(--accent);
  background: rgba(0,184,148,0.15);
  border: 1px solid rgba(0,184,148,0.4);
  padding: 0.25rem 0.75rem;
  border-radius: 999px;
  margin-bottom: 1rem;
}
.sol-h1 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem, 5vw, 3.25rem);
  font-weight: 700;
  color: #fff;
  margin-bottom: 1rem;
}
.sol-oneliner {
  font-size: 1.15rem;
  color: rgba(255,255,255,0.82);
  max-width: 640px;
  margin: 0 auto;
}

/* ── Body ── */
.sol-body { padding: 4rem 0; background: var(--bg); }
.sol-content { max-width: 820px; }
.sol-content :global(h2) {
  font-family: 'Playfair Display', serif;
  font-size: 1.6rem;
  color: var(--primary);
  margin: 2.5rem 0 0.75rem;
}
.sol-content :global(h2.section-eliminate) {
  color: var(--accent);
}
.sol-content :global(p) { margin-bottom: 1rem; color: var(--text); }
.sol-content :global(ul.insult-list) {
  list-style: none;
  padding: 0;
  margin: 0.5rem 0 1.5rem;
}
.sol-content :global(ul.insult-list li) {
  display: flex;
  gap: 0.6rem;
  align-items: flex-start;
  padding: 0.55rem 0;
  border-bottom: 1px solid var(--border);
  color: var(--text);
  font-size: 0.97rem;
}
.sol-content :global(ul.insult-list li:last-child) { border-bottom: none; }
.sol-content :global(ul.insult-list li::before) {
  content: "✕";
  color: #e74c3c;
  font-weight: 700;
  flex-shrink: 0;
  margin-top: 1px;
}
.sol-content :global(.card-grid) {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 1.25rem;
  margin-top: 1.25rem;
}
.sol-content :global(.card) {
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.25rem 1.5rem;
}
.sol-content :global(.card h3) {
  font-size: 1rem;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 0.4rem;
}
.sol-content :global(.card p) { font-size: 0.9rem; color: var(--text-light); margin: 0; }

/* sub-page card links */
.sol-content :global(.card a.card-link) {
  display: inline-block;
  margin-top: 0.75rem;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--accent);
  text-decoration: none;
}
.sol-content :global(.card a.card-link:hover) { text-decoration: underline; }

/* product cards */
.sol-content :global(.product-card) {
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.25rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}
.sol-content :global(.product-card h3) {
  font-size: 1rem;
  font-weight: 700;
  color: var(--primary);
}
.sol-content :global(.product-card p) { font-size: 0.88rem; color: var(--text-light); margin: 0; }
.sol-content :global(.coming-soon-pill) {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--accent);
  background: rgba(0,184,148,0.12);
  border: 1px solid rgba(0,184,148,0.35);
  padding: 0.2rem 0.65rem;
  border-radius: 999px;
  margin-top: 0.5rem;
  align-self: flex-start;
}

/* ── Solution Path ── */
.sol-path {
  background: var(--bg-soft);
  border-top: 1px solid var(--border);
  padding: 4rem 0;
}
.sol-path-heading {
  font-family: 'Playfair Display', serif;
  font-size: 1.9rem;
  color: var(--primary);
  text-align: center;
  margin-bottom: 2.5rem;
}
.sol-path-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1.5rem;
}
.sol-path-step {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 2rem;
  text-align: center;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
}
.sol-path-num {
  width: 2.4rem;
  height: 2.4rem;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-family: 'Inter', sans-serif;
  font-weight: 800;
  font-size: 1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 0.5rem;
}
.sol-path-step h3 {
  font-family: 'Inter', sans-serif;
  font-size: 1rem;
  font-weight: 700;
  color: var(--dark);
}
.sol-path-step p { font-size: 0.9rem; color: var(--text-light); margin-bottom: 0.75rem; }
.sol-path-bullets {
  list-style: none;
  padding: 0;
  margin: 0 0 0.75rem;
  text-align: left;
  width: 100%;
}
.sol-path-bullets li {
  font-size: 0.82rem;
  color: var(--text-light);
  padding: 0.2rem 0;
  padding-left: 1.1rem;
  position: relative;
}
.sol-path-bullets li::before {
  content: "•";
  color: var(--accent);
  position: absolute;
  left: 0;
  font-weight: 700;
}

/* ── Buttons ── */
.btn-sol {
  display: inline-block;
  padding: 0.6rem 1.5rem;
  border-radius: 999px;
  font-family: 'Inter', sans-serif;
  font-size: 0.875rem;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  margin-top: 0.25rem;
}
.btn-sol.primary { background: var(--accent); color: #fff; }
.btn-sol.primary:hover { background: var(--accent-dark); }
.btn-sol.secondary { background: var(--primary); color: #fff; }
.btn-sol.secondary:hover { background: var(--primary-light); }
.btn-sol.accent { background: var(--dark); color: #fff; }
.btn-sol.accent:hover { opacity: 0.85; }
.btn-sol.ghost { background: var(--bg-soft); color: var(--text-light); border: 1px solid var(--border); }

/* ── Tagline footer ── */
.sol-tagline {
  background: var(--dark);
  padding: 2.5rem 0;
  text-align: center;
}
.tagline-text {
  font-family: 'Playfair Display', serif;
  font-size: 1.4rem;
  color: #fff;
  font-style: italic;
}
.tagline-sub { font-size: 0.85rem; color: rgba(255,255,255,0.5); margin-top: 0.25rem; }
</style>
