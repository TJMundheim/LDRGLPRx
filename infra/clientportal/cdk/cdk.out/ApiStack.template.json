  "ApiSchema510EECD7": {
   "Type": "AWS::AppSync::GraphQLSchema",
   "Properties": {
    "ApiId": {
     "Fn::GetAtt": [
      "ApiF70053CD",
      "ApiId"
     ]
    },
    "Definition": "# LDRGLPRx Client Portal — AppSync GraphQL schema\n#\n# Auth model:\n#   - Default authentication is Amazon Cognito User Pools (set on the API).\n#   - User-owned types carry `owner: ID!` (= Cognito `sub`); resolvers stamp\n#     `owner = ctx.identity.sub` on writes and filter by `owner` on reads via\n#     a `byOwner` GSI.\n#   - Admin-only fields are gated with @aws_auth(cognito_groups:[\"Admins\"]).\n#\n# Resolver intent (documented here, implemented in api-stack.ts):\n#   - On the first authenticated GraphQL call for a given identity (typically\n#     `getMyProfile` or `upsertMyProfile`), the resolver auto-creates a\n#     `UserProfile` row keyed by `ctx.identity.sub`, populating\n#     `primaryEmail` from the ID-token `email` claim. The PostConfirmation\n#     Lambda is the primary path for profile creation; this resolver-level\n#     auto-create is defense-in-depth for users who pre-date the trigger.\n#   - PostAuthentication reconciles `primaryEmail` if the Cognito email\n#     attribute has been changed since last login.\n#   - `secondaryEmail` is DynamoDB-only and is NEVER written to Cognito.\n\nschema {\n  query: Query\n  mutation: Mutation\n}\n\n# ─── Scalars / shared enums ───────────────────────────────────────────────\n\nenum TierId {\n  foundation\n  optimization\n  longevity\n  concierge\n}\n\nenum ProgramMonth {\n  M1\n  M2\n  M3\n  M4\n  MAINTENANCE\n}\n\nenum PillarId {\n  mitigate\n  muscle\n  mind\n  motivate\n}\n\nenum QueueItemKind {\n  intake_review\n  clinician_escalation\n  rx_approval\n  protocol_check\n  lab_result_review\n  outcome_flag\n}\n\nenum QueueUrgency { routine soon urgent }\nenum QueueStatus  { pending in_progress resolved deferred }\n\n# ─── UserProfile (owner-scoped; id = Cognito sub) ─────────────────────────\n\ntype Address {\n  line1: String\n  line2: String\n  city: String\n  region: String\n  postalCode: String\n  country: String\n}\n\ntype UserPrefs {\n  marketingOptIn: Boolean\n  smsOptIn: Boolean\n  timezone: String\n  units: String\n}\n\ninput AddressInput {\n  line1: String\n  line2: String\n  city: String\n  region: String\n  postalCode: String\n  country: String\n}\n\ninput UserPrefsInput {\n  marketingOptIn: Boolean\n  smsOptIn: Boolean\n  timezone: String\n  units: String\n}\n\ntype UserProfile {\n  # Cognito `sub` — also the partition key.\n  id: ID!\n  # Mirror of Cognito `email` attribute, reconciled on each login.\n  primaryEmail: AWSEmail!\n  # DynamoDB-only; never written to Cognito.\n  secondaryEmail: AWSEmail\n  firstName: String\n  lastName: String\n  displayName: String\n  dob: AWSDate\n  phone: AWSPhone\n  address: Address\n  tier: TierId\n  currentMonth: ProgramMonth\n  currentPillar: PillarId\n  prefs: UserPrefs\n  createdAt: AWSDateTime!\n  updatedAt: AWSDateTime!\n}\n\ninput UpsertMyProfileInput {\n  firstName: String\n  lastName: String\n  displayName: String\n  dob: AWSDate\n  phone: AWSPhone\n  address: AddressInput\n  tier: TierId\n  currentMonth: ProgramMonth\n  currentPillar: PillarId\n  prefs: UserPrefsInput\n}\n\n# ─── Program / curriculum (global config) ─────────────────────────────────\n\ntype MonthPillar @aws_iam @aws_cognito_user_pools {\n  month: ProgramMonth!\n  pillar: PillarId!\n  title: String!\n  summary: String\n  objectives: [String!]!\n}\n\ntype Program @aws_iam @aws_cognito_user_pools {\n  id: ID!\n  name: String!\n  description: String\n  pillars: [MonthPillar!]!\n  updatedAt: AWSDateTime!\n}\n\ntype WeeklyContent @aws_iam @aws_cognito_user_pools {\n  id: ID!\n  programId: ID!\n  month: ProgramMonth!\n  week: Int!\n  pillar: PillarId!\n  title: String!\n  bodyMarkdown: String!\n  resources: [Resource!]\n  updatedAt: AWSDateTime!\n}\n\ntype Resource @aws_iam @aws_cognito_user_pools {\n  name: String!\n  url: AWSURL!\n}\n\ninput ResourceInput {\n  name: String!\n  url: AWSURL!\n}\n\ninput MonthPillarInput {\n  month: ProgramMonth!\n  pillar: PillarId!\n  title: String!\n  summary: String\n  objectives: [String!]!\n}\n\ninput UpsertProgramInput {\n  id: ID!\n  name: String!\n  description: String\n  pillars: [MonthPillarInput!]!\n}\n\ninput UpsertWeeklyContentInput {\n  id: ID!\n  programId: ID!\n  month: ProgramMonth!\n  week: Int!\n  pillar: PillarId!\n  title: String!\n  bodyMarkdown: String!\n  resources: [ResourceInput!]\n}\n\n# ─── Tier / catalog (global config) ───────────────────────────────────────\n\ntype Tier @aws_iam @aws_cognito_user_pools {\n  id: TierId!\n  name: String!\n  tagline: String!\n  monthlyUSD: Int\n  annualUSD: Int\n  onboardingFeeUSD: Int\n  oneTimePriceUSD: Int\n  kind: String\n  includedProductSlugs: [String!]!\n  features: [String!]!\n  description: String!\n  idealFor: [String!]!\n  updatedAt: AWSDateTime!\n}\n\ntype TierCatalog @aws_iam @aws_cognito_user_pools {\n  id: ID!\n  tiers: [Tier!]!\n  updatedAt: AWSDateTime!\n}\n\ninput TierInput {\n  id: TierId!\n  name: String!\n  tagline: String!\n  monthlyUSD: Int\n  annualUSD: Int\n  onboardingFeeUSD: Int\n  oneTimePriceUSD: Int\n  kind: String\n  includedProductSlugs: [String!]!\n  features: [String!]!\n  description: String!\n  idealFor: [String!]!\n}\n\ninput UpsertTierCatalogInput {\n  id: ID!\n  tiers: [TierInput!]!\n}\n\n# ─── AppConfig (global config; admin-write, auth-read) ────────────────────\n\ntype AppConfig @aws_iam @aws_cognito_user_pools {\n  key: ID!\n  valueJson: AWSJSON!\n  updatedAt: AWSDateTime!\n}\n\ninput UpsertAppConfigInput {\n  key: ID!\n  valueJson: AWSJSON!\n}\n\n# ─── DiscoveryResponse (owner-scoped) ─────────────────────────────────────\n\ntype DiscoveryAnswer {\n  questionId: String!\n  valueJson: AWSJSON!\n}\n\ntype DiscoveryResult {\n  recommendedTier: TierId!\n  tierRationale: String!\n  triggeredProductSlugs: [String!]!\n  triggeredLabSlugs: [String!]!\n  topPriorities: [DiscoveryPriority!]!\n  clinicianFlags: [DiscoveryFlag!]!\n  summary: String!\n}\n\ntype DiscoveryPriority {\n  domain: String!\n  severity: Float!\n}\n\ntype DiscoveryFlag {\n  questionId: String!\n  reason: String!\n}\n\ntype DiscoveryResponse {\n  id: ID!\n  owner: ID!\n  answers: [DiscoveryAnswer!]!\n  result: DiscoveryResult\n  submittedAt: AWSDateTime!\n  createdAt: AWSDateTime!\n  updatedAt: AWSDateTime!\n}\n\ninput DiscoveryAnswerInput {\n  questionId: String!\n  valueJson: AWSJSON!\n}\n\ninput SubmitDiscoveryInput {\n  answers: [DiscoveryAnswerInput!]!\n}\n\n# ─── Outcome (owner-scoped weekly check-ins) ──────────────────────────────\n\ntype OutcomeScore {\n  domain: String!\n  score: Int!\n}\n\ntype Outcome {\n  id: ID!\n  owner: ID!\n  weekISO: String!\n  month: ProgramMonth!\n  week: Int!\n  scores: [OutcomeScore!]!\n  freeText: String\n  submittedAt: AWSDateTime!\n  createdAt: AWSDateTime!\n  updatedAt: AWSDateTime!\n}\n\ninput OutcomeScoreInput {\n  domain: String!\n  score: Int!\n}\n\ninput CreateOutcomeInput {\n  weekISO: String!\n  month: ProgramMonth!\n  week: Int!\n  scores: [OutcomeScoreInput!]!\n  freeText: String\n}\n\n# ─── IntakeForm (owner-scoped) ────────────────────────────────────────────\n\ntype IntakeAnswer {\n  questionId: String!\n  valueJson: AWSJSON!\n}\n\ntype IntakeForm {\n  id: ID!\n  owner: ID!\n  version: String!\n  answers: [IntakeAnswer!]!\n  status: String!\n  submittedAt: AWSDateTime\n  createdAt: AWSDateTime!\n  updatedAt: AWSDateTime!\n}\n\ninput IntakeAnswerInput {\n  questionId: String!\n  valueJson: AWSJSON!\n}\n\ninput UpsertIntakeFormInput {\n  version: String!\n  answers: [IntakeAnswerInput!]!\n  status: String!\n}\n\n# ─── AdminQueueItem (admin-only) ──────────────────────────────────────────\n\ntype AdminQueueItem {\n  id: ID!\n  kind: QueueItemKind!\n  patientId: ID!\n  patientLabel: String!\n  summary: String!\n  draftedAction: String\n  urgency: QueueUrgency!\n  status: QueueStatus!\n  createdAt: AWSDateTime!\n  updatedAt: AWSDateTime!\n}\n\ninput UpdateAdminQueueItemInput {\n  id: ID!\n  status: QueueStatus\n  draftedAction: String\n  urgency: QueueUrgency\n}\n\n# ─── Pagination ───────────────────────────────────────────────────────────\n\ntype UserProfileConnection {\n  items: [UserProfile!]!\n  nextToken: String\n}\n\ntype OutcomeConnection {\n  items: [Outcome!]!\n  nextToken: String\n}\n\ntype AdminQueueItemConnection {\n  items: [AdminQueueItem!]!\n  nextToken: String\n}\n\n# ─── Root ─────────────────────────────────────────────────────────────────\n\ntype Query {\n  # Owner-scoped reads.\n  # `getMyProfile` auto-creates the profile from `ctx.identity.sub` +\n  # ID-token email claim if missing (defense-in-depth alongside\n  # PostConfirmation Lambda).\n  getMyProfile: UserProfile!\n  listMyOutcomes(limit: Int, nextToken: String): OutcomeConnection!\n  getMyDiscoveryResponse: DiscoveryResponse\n  getMyIntakeForm: IntakeForm\n\n  # Global config (any authenticated user may read).\n  getAppConfig(key: ID!): AppConfig\n  getProgram(id: ID!): Program\n  listWeeklyContent(programId: ID!, month: ProgramMonth): [WeeklyContent!]!\n  getTierCatalog(id: ID!): TierCatalog\n  listTiers: [Tier!]!\n\n  # Admin-only.\n  adminGetProfile(userId: ID!): UserProfile\n    @aws_auth(cognito_groups: [\"Admins\"])\n  adminListUsers(limit: Int, nextToken: String): UserProfileConnection!\n    @aws_auth(cognito_groups: [\"Admins\"])\n  adminListOutcomes(\n    userId: ID\n    limit: Int\n    nextToken: String\n  ): OutcomeConnection!\n    @aws_auth(cognito_groups: [\"Admins\"])\n  adminListQueue(\n    status: QueueStatus\n    limit: Int\n    nextToken: String\n  ): AdminQueueItemConnection!\n    @aws_auth(cognito_groups: [\"Admins\"])\n}\n\ntype Mutation {\n  # Owner-scoped writes. Resolvers stamp `owner = ctx.identity.sub`.\n  # `upsertMyProfile` auto-creates the UserProfile row on first call,\n  # seeding `primaryEmail` from the ID-token `email` claim.\n  upsertMyProfile(input: UpsertMyProfileInput!): UserProfile!\n  # Updates the DynamoDB-only secondary email; never propagated to Cognito.\n  updateSecondaryEmail(secondaryEmail: AWSEmail): UserProfile!\n  submitDiscovery(input: SubmitDiscoveryInput!): DiscoveryResponse!\n  upsertMyIntakeForm(input: UpsertIntakeFormInput!): IntakeForm!\n  createOutcome(input: CreateOutcomeInput!): Outcome!\n\n  # Admin-only writes (curriculum + catalog + global config + queue).\n  upsertProgram(input: UpsertProgramInput!): Program!\n    @aws_auth(cognito_groups: [\"Admins\"])\n    @aws_iam\n  upsertWeeklyContent(input: UpsertWeeklyContentInput!): WeeklyContent!\n    @aws_auth(cognito_groups: [\"Admins\"])\n    @aws_iam\n  upsertTierCatalog(input: UpsertTierCatalogInput!): TierCatalog!\n    @aws_auth(cognito_groups: [\"Admins\"])\n    @aws_iam\n  upsertAppConfig(input: UpsertAppConfigInput!): AppConfig!\n    @aws_auth(cognito_groups: [\"Admins\"])\n    @aws_iam\n  updateAdminQueueItem(input: UpdateAdminQueueItemInput!): AdminQueueItem!\n    @aws_auth(cognito_groups: [\"Admins\"])\n    @aws_iam\n}\n"
   },
